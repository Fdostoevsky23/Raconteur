---
// src/pages/plus/index.astro — Raconteur+ homepage (skeleton for Chunk 1).
// Data layer is a faithful copy of classic index.astro (same queries, same shape).
// Chunks 3–5 build the full homepage design on this skeleton.
import PlusLayout from '../../layouts/PlusLayout.astro';
import Icon from '../../components/Icon.astro';
import { getVisibleStories, getStoryBySlug } from '../../data/stories';
import authors from '../../data/authors.json';
import { supabase } from '../../lib/supabase';
import { buildStoryFromDB } from '../../lib/storyLoader';

// 1. Get static stories
const staticStories = getVisibleStories();

// 2. Fetch published stories from the database
// Curated homepage: featured stories (max 5); falls back to newest if none featured
// Homepage shelf: everything the admin hasn't hidden; featured pinned to the top
const { data: dbRows } = await supabase
    .from('stories')
    .select('*')
    .eq('status', 'published')
    .eq('on_homepage', true)
    .order('is_featured', { ascending: false })
    .order('created_at', { ascending: false });

// 3. Convert DB rows to our Story shape
const dbStories = (dbRows || []).map(buildStoryFromDB);

// 4. Merge them! (Database stories appear first/newest)
const stories = [...dbStories, ...staticStories];
const totalWords = stories.reduce((sum, s) => sum + s.wordCount, 0);
const featuredProse = dbStories.filter(s => s.kind !== 'poem' && s.on_homepage !== false).slice(0, 4);
const featuredPoems = dbStories.filter(s => s.kind === 'poem' && s.on_homepage !== false).slice(0, 4);

// Curated homepage shelf: max 5 prose cards (DB query already puts featured first)
const proseShelf = featuredProse.slice(0, 5);

const heroImageCount = 13; // public/hero has 13 images (1.jpg-13.jpg)

const dayOfYear = Math.floor(
    (Date.now() - new Date(new Date().getFullYear(), 0, 0).getTime()) / 86400000
);
const heroIndex = (dayOfYear % heroImageCount) + 1; // deterministic daily rotation

// --- Chunk 3: kinetic hero ---
// Rotating accent word (plus-exclusive) — JS cycles .ph-hero-word spans.
const heroWords = ['want', 'love', 'crave', 'deserve'];
const two = (n: number) => String(n).padStart(2, '0'); // 01, 02, … zero-padded index
// Dust motes — hand-tuned deterministic config (no runtime randomness)
const motes = [
    { x: 6,  y: 72, d: 14, delay: 0,   size: 3 },
    { x: 14, y: 85, d: 18, delay: 2.5, size: 2 },
    { x: 22, y: 66, d: 11, delay: 5,   size: 4 },
    { x: 31, y: 90, d: 16, delay: 1,   size: 2 },
    { x: 40, y: 78, d: 12, delay: 3.5, size: 3 },
    { x: 49, y: 64, d: 17, delay: 6,   size: 2 },
    { x: 58, y: 88, d: 13, delay: 0.5, size: 3 },
    { x: 66, y: 70, d: 15, delay: 4,   size: 2 },
    { x: 74, y: 82, d: 19, delay: 7,   size: 4 },
    { x: 82, y: 68, d: 12, delay: 2,   size: 3 },
    { x: 89, y: 86, d: 16, delay: 5.5, size: 2 },
    { x: 95, y: 74, d: 14, delay: 8,   size: 3 },
];

// --- Chunk 5A: moods explorer (plus-exclusive resurrection) ---
// Each mood deep-links into /plus/stories search via ?q= — feelings become real finds.
const moods = [
    { icon: 'cloud-rain', name: 'Melancholy', query: 'rain',  teaser: 'For grey evenings and rain on glass.' },
    { icon: 'moon', name: 'Nocturnal',  query: 'night', teaser: 'For when the world goes quiet.' },
    { icon: 'heart', name: 'Tender',     query: 'love',  teaser: 'For soft hearts and open hands.' },
    { icon: 'feather', name: 'Still',      query: 'silence', teaser: 'For the space between words.' },
    { icon: 'home', name: 'Homeward',  query: 'home',  teaser: 'For letters that never got sent.' },
    { icon: 'sparkle', name: 'Wonder',     query: 'light', teaser: 'For skies worth staring at.' },
];

// --- Chunk 5A: the editor's desk note (plus-exclusive resurrection) ---
const deskNote = {
    avatarUrl: '/avatars/nzan-kikon.jpg',
    initials: 'NK',
    name: 'Nzan Kikon',
    role: 'Editor · Raconteur',
    message:
        'Welcome, reader. Raconteur was built on a simple belief — that a story does not need a printing press or a publisher\u2019s blessing to be worth your evening. Every word on this shelf was written to be remembered, and every writer here is real. So settle in. The lamp is lit, the pages are turned, and there is always room for one more reader at the fire.',
};
---
<PlusLayout title="Raconteur+ — Literature you want to read" description="A second way to read Raconteur — ink-black, brass, and built for night readers.">
    {/* ============================================ */}
    {/* HERO — full cinematic build (Chunk 3)        */}
    {/* ============================================ */}
    <section class="ph-hero" id="top">
        {/* Layer 0 — daily image backdrop with Ken Burns drift */}
        <div class="ph-hero-bg" aria-hidden="true">
            <img src={`/hero/${heroIndex}.jpg`} alt="" fetchpriority="high" />
        </div>

        {/* Layer 1 — living glow: breathing brass + sage blobs */}
        <div class="ph-hero-glow" aria-hidden="true">
            <div class="ph-hero-glow-blob ph-hero-glow-a"></div>
            <div class="ph-hero-glow-blob ph-hero-glow-b"></div>
        </div>

        {/* Layer 2 — dust motes drifting upward */}
        <div class="ph-hero-motes" aria-hidden="true">
            {motes.map((m) => (
                <span
                    class="ph-hero-mote"
                    style={`left:${m.x}%; top:${m.y}%; width:${m.size}px; height:${m.size}px; --mote-dur:${m.d}s; --mote-delay:${m.delay}s;`}
                ></span>
            ))}
        </div>

        {/* Layer 3 — editorial chrome: corner brackets + mono metadata */}
        <div class="ph-hero-chrome" aria-hidden="true">
            <span class="ph-hero-corner ph-hero-corner-tl"></span>
            <span class="ph-hero-corner ph-hero-corner-tr"></span>
            <span class="ph-hero-corner ph-hero-corner-bl"></span>
            <span class="ph-hero-corner ph-hero-corner-br"></span>
            <span class="ph-hero-meta ph-hero-meta-l">EST. 2026 · KOHIMA · IN</span>
            <span class="ph-hero-meta ph-hero-meta-r">EDITION Nº {two(dayOfYear)}</span>
        </div>

        {/* Layer 4 — the kinetic headline */}
        <div class="ph-hero-inner">
            <p class="ph-hero-eyebrow">
                <span class="ph-star">✦</span> The new Raconteur · rebuilt for readers
            </p>
            <h1 class="ph-hero-title">
                <span class="ph-hero-line"><span class="ph-hero-line-inner">Literature you</span></span>
                <span class="ph-hero-line"><span class="ph-hero-line-inner">
                    <span class="ph-hero-word-stack">
                        <span class="ph-hero-word-sizer" aria-hidden="true">deserve</span>
                        {heroWords.map((w, i) => (
                            <span class={`ph-hero-word ${i === 0 ? 'active' : ''}`}>{w}</span>
                        ))}
                    </span>
                    to read<span class="ph-hero-plus">.</span>
                </span></span>
            </h1>
            <p class="ph-hero-sub">
                Ink-black. Brass-trimmed. Every story, every poem, every writer —
                reimagined in Raconteur+, the second skin of your favourite bookshop.
            </p>
            <div class="ph-hero-actions">
                <a href="/plus/stories" class="ph-btn ph-btn-gold">Browse the shelf</a>
                <a href="#shelf" class="ph-btn ph-btn-ghost">Featured stories</a>
            </div>
            <div class="ph-hero-stats">
                <span class="ph-hero-stat"><strong>{stories.length}</strong> works</span>
                <span class="ph-hero-sep">/</span>
                <span class="ph-hero-stat"><strong>{totalWords.toLocaleString()}</strong> words</span>
                <span class="ph-hero-sep">/</span>
                <span class="ph-hero-stat"><strong>∞</strong> pages to turn</span>
            </div>
        </div>

        {/* Layer 5 — scroll cue */}
        <a href="#shelf" class="ph-hero-scrollcue" aria-label="Scroll to featured stories">
            <span class="ph-hero-scrollcue-line"></span>
            <span class="ph-hero-scrollcue-txt">scroll</span>
        </a>

        <div class="ph-hero-frame" aria-hidden="true"></div>
    </section>

    {/* ============================================ */}
    {/* MARQUEE — kinetic strip (Obsidian Editorial) */}
    {/* ============================================ */}
    <div class="ph-marquee" aria-hidden="true">
        <div class="ph-marquee-track">
            {[0, 1].map(() => (
                <span class="ph-marquee-seg">
                    <span>Literature you want to read</span>
                    <span class="ph-marquee-star">✦</span>
                    <span>Flash fiction to novellas</span>
                    <span class="ph-marquee-star">✦</span>
                    <span>Poetry with a pulse</span>
                    <span class="ph-marquee-star">✦</span>
                    <span>Worth remembering</span>
                    <span class="ph-marquee-star">✦</span>
                </span>
            ))}
        </div>
    </div>
    {/* ============================================ */}
    {/* 01 — THE SHELF: featured prose                */}
    {/* ============================================ */}
    <section class="ph-section" id="shelf">
        <header class="ph-section-head" data-reveal>
            <p class="ph-section-eyebrow">01 — Fresh from the desk</p>
            <h2 class="ph-section-title">The Featured Shelf</h2>
            <p class="ph-section-note">
                {proseShelf.length} {proseShelf.length === 1 ? 'story' : 'stories'} · hand-picked by the editor
            </p>
            <a href="/plus/stories" class="ph-section-more">Full archive →</a>
        </header>

        <div class="ph-grid">
            {proseShelf.map((story: any, i: number) => (
                <a
                    href={`/story/${story.slug}`}
                    class={`ph-card ${i === 0 ? 'ph-card-lead' : ''}`}
                    data-reveal
                    style={`--reveal-delay: ${Math.min(i * 0.08, 0.4)}s`}
                >
                    <span class="ph-card-index" aria-hidden="true">{two(i + 1)}</span>
                    {story.cover ? (
                        <div
                            class={`ph-card-cover${i === 0 ? ' ph-card-cover-letterbox' : ''}`}
                            style={i === 0 ? `background-image:url('${story.cover}');` : undefined}
                        >
                            <img src={story.cover} alt={`Cover of ${story.title}`} loading="lazy" />
                        </div>
                    ) : (
                        <div class="ph-card-cover ph-card-cover-empty">
                            <span class="ph-star">✦</span>
                        </div>
                    )}
                    <div class="ph-card-body">
                        <span class="ph-card-genre">{story.genre}</span>
                        <h3 class="ph-card-title">{story.title}</h3>
                        <p class="ph-card-excerpt">{story.excerpt}</p>
                        <div class="ph-card-meta">
                            <span>{story.author}</span>
                            <span class="ph-card-dot">·</span>
                            <span>{story.wordCount.toLocaleString()} words</span>
                            <span class="ph-card-dot">·</span>
                            <span>{story.readTime}</span>
                        </div>
                    </div>
                </a>
            ))}
        </div>
        {proseShelf.length === 0 && featuredPoems.length === 0 && (
            <p class="ph-empty">The shelf is being curated — check back soon.</p>
        )}
    </section>

    {/* ============================================ */}
    {/* 02 — VERSE: featured poetry                  */}
    {/* ============================================ */}
    {featuredPoems.length > 0 && (
        <section class="ph-section" id="verse">
            <header class="ph-section-head" data-reveal>
                <p class="ph-section-eyebrow">02 — Verse</p>
                <h2 class="ph-section-title">Featured Poetry</h2>
                <p class="ph-section-note">
                    {featuredPoems.length} {featuredPoems.length === 1 ? 'poem' : 'poems'}
                </p>
            </header>

            <div class="ph-grid">
                {featuredPoems.map((story: any, i: number) => (
                    <a
                        href={`/story/${story.slug}`}
                        class="ph-card ph-card-verse"
                        data-reveal
                        style={`--reveal-delay: ${Math.min(i * 0.08, 0.4)}s`}
                    >
                        {story.cover ? (
                            <div class="ph-card-cover">
                                <img src={story.cover} alt={`Cover of ${story.title}`} loading="lazy" />
                            </div>
                        ) : (
                            <div class="ph-card-cover ph-card-verse-text">
                                <p>
                                    "{(story.content[0]?.text || '').replace(/<[^>]+>/g, ' ').trim().slice(0, 110)}…"
                                </p>
                            </div>
                        )}
                        <div class="ph-card-body">
                            <span class="ph-card-genre">Poetry</span>
                            <h3 class="ph-card-title">{story.title}</h3>
                            <div class="ph-card-meta">
                                <span>{story.author}</span>
                                <span class="ph-card-dot">·</span>
                                <span>Poem</span>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </section>
    )}

    {/* ============================================ */}
    {/* 03 — MOODS: what are you feeling tonight?    */}
    {/* ============================================ */}
    <section class="ph-section" id="moods">
        <header class="ph-section-head" data-reveal>
            <p class="ph-section-eyebrow">03 — Find a feeling</p>
            <h2 class="ph-section-title">What are you tonight?</h2>
            <p class="ph-section-note">Pick a mood — the shelf rearranges itself around you.</p>
        </header>

        <div class="ph-mood-grid">
            {moods.map((m, i) => {
                const moodHref = '/plus/stories?q=' + encodeURIComponent(m.query);
                return (
                    <a
                        href={moodHref}
                        class="ph-mood-tile"
                        data-reveal
                        style={`--reveal-delay: ${Math.min(i * 0.06, 0.36)}s`}
                    >
                        <span class="ph-mood-emoji" aria-hidden="true"><Icon name={m.icon} size={22} /></span>
                        <span class="ph-mood-name">{m.name}</span>
                        <span class="ph-mood-teaser">{m.teaser}</span>
                    </a>
                );
            })}
        </div>
    </section>

    {/* ============================================ */}
    {/* QUOTE INTERLUDE — a moment to breathe        */}
    {/* ============================================ */}
    <section class="ph-quote" data-reveal>
        <span class="ph-quote-mark" aria-hidden="true">"</span>
        <blockquote class="ph-quote-block">
            <p class="ph-quote-text" id="rotatingQuote">
                A reader lives a thousand lives before he dies. The man who never reads lives only one.
            </p>
            <cite class="ph-quote-cite" id="rotatingCite">— George R.R. Martin</cite>
        </blockquote>
    </section>

    {/* ============================================ */}
    {/* STATS — the shelf, by the numbers             */}
    {/* ============================================ */}
    <section class="ph-section ph-stats-section" data-reveal>
        <div class="ph-stats">
            <div class="ph-stat">
                <span class="ph-stat-number" data-target={stories.length}>0</span>
                <span class="ph-stat-label">Works on the shelf</span>
            </div>
            <span class="ph-stat-rule" aria-hidden="true"></span>
            <div class="ph-stat">
                <span class="ph-stat-number" data-target={totalWords}>0</span>
                <span class="ph-stat-label">Words published</span>
            </div>
            <span class="ph-stat-rule" aria-hidden="true"></span>
            <div class="ph-stat">
                <span class="ph-stat-number">∞</span>
                <span class="ph-stat-label">Evenings waiting</span>
            </div>
        </div>
    </section>

    {/* ============================================ */}
    {/* 04 — FROM THE EDITOR'S DESK                   */}
    {/* ============================================ */}
    <section class="ph-section" id="desk">
        <header class="ph-section-head" data-reveal>
            <p class="ph-section-eyebrow">04 — From the editor's desk</p>
            <h2 class="ph-section-title">A Note Before You Read</h2>
        </header>

        <article class="ph-desk" data-reveal style="--reveal-delay: .1s">
            <span class="ph-desk-glyph" aria-hidden="true">"</span>
            <img class="ph-avatar ph-desk-avatar" src={deskNote.avatarUrl} alt={deskNote.name} />
            <div class="ph-desk-body">
                <p class="ph-desk-message">{deskNote.message}</p>
                <p class="ph-desk-signature">
                    — {deskNote.name} <span class="ph-desk-role">· {deskNote.role}</span>
                </p>
            </div>
        </article>
    </section>
</PlusLayout>

<style>
    /* Page-scoped: HERO + shelf index. Shared families live in plus.css. */

    /* === HERO — five cinematic layers === */
    .ph-hero {
        position: relative;
        min-height: 92vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    /* Layer 0 — backdrop: daily image, deep vignette, slow Ken Burns drift */
    .ph-hero-bg { position: absolute; inset: 0; z-index: 0; }

    .ph-hero-bg img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.30;
        filter: saturate(0.6) contrast(1.08);
        animation: ph-hero-drift 36s ease-in-out infinite alternate;
    }

    .ph-hero-bg::after {
        content: '';
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse 120% 90% at 50% 45%, transparent 40%, rgba(11, 11, 14, 0.85) 100%),
            linear-gradient(180deg, rgba(11, 11, 14, 0.7) 0%, transparent 22%, transparent 62%, rgba(11, 11, 14, 0.96) 100%);
    }

    @keyframes ph-hero-drift {
        from { transform: scale(1.06) translateX(-1.2%); }
        to   { transform: scale(1.12) translateX(1.2%); }
    }

    /* Layer 1 — living glow: breathing brass + sage blobs */
    .ph-hero-glow { position: absolute; inset: 0; z-index: 1; overflow: hidden; }

    .ph-hero-glow-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(90px);
        opacity: 0.16;
        animation: ph-hero-breathe 11s ease-in-out infinite alternate;
    }

    .ph-hero-glow-a {
        width: 46vw;
        height: 46vw;
        background: radial-gradient(circle, #c9a24b, transparent 70%);
        top: -12%;
        right: -10%;
        animation-delay: 0s;
    }

    .ph-hero-glow-b {
        width: 40vw;
        height: 40vw;
        background: radial-gradient(circle, #3d5a3c, transparent 70%);
        bottom: -14%;
        left: -8%;
        animation-delay: 5s;
    }

    @keyframes ph-hero-breathe {
        from { transform: scale(1) translateY(0); opacity: 0.14; }
        to   { transform: scale(1.18) translateY(-3%); opacity: 0.20; }
    }

    /* Layer 2 — dust motes drifting upward */
    .ph-hero-motes { position: absolute; inset: 0; z-index: 2; overflow: hidden; }

    .ph-hero-mote {
        position: absolute;
        border-radius: 50%;
        background: #c9a24b;
        box-shadow: 0 0 8px rgba(201, 162, 75, 0.65);
        opacity: 0;
        animation: ph-mote-rise var(--mote-dur, 14s) linear infinite;
        animation-delay: var(--mote-delay, 0s);
    }

    @keyframes ph-mote-rise {
        0%   { transform: translateY(0) translateX(0); opacity: 0; }
        8%   { opacity: 0.5; }
        50%  { transform: translateY(-42vh) translateX(14px); opacity: 0.65; }
        92%  { opacity: 0.35; }
        100% { transform: translateY(-85vh) translateX(-10px); opacity: 0; }
    }

    /* Layer 3 — editorial chrome: corner brackets + mono metadata */
    .ph-hero-chrome { position: absolute; inset: 0; z-index: 3; pointer-events: none; }

    .ph-hero-corner {
        position: absolute;
        width: 34px;
        height: 34px;
        border: 1px solid rgba(201, 162, 75, 0.45);
    }

    .ph-hero-corner-tl { top: 1.6rem; left: 1.6rem; border-right: none; border-bottom: none; }
    .ph-hero-corner-tr { top: 1.6rem; right: 1.6rem; border-left: none; border-bottom: none; }
    .ph-hero-corner-bl { bottom: 1.6rem; left: 1.6rem; border-right: none; border-top: none; }
    .ph-hero-corner-br { bottom: 1.6rem; right: 1.6rem; border-left: none; border-top: none; }

    .ph-hero-meta {
        position: absolute;
        font-family: var(--ph-font-mono);
        font-size: 0.62rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: rgba(242, 238, 227, 0.4);
    }

    .ph-hero-meta-l { top: 2.1rem; left: 6rem; }
    .ph-hero-meta-r { top: 2.1rem; right: 6rem; }

    @media (max-width: 920px) {
        .ph-hero-meta-l { left: 4.6rem; }
        .ph-hero-meta-r { right: 4.6rem; }
    }
    /* Layer 4 — kinetic headline */
    .ph-hero-inner {
        position: relative;
        z-index: 4;
        text-align: center;
        max-width: 1000px;
        padding: 7rem 2rem 6.5rem;
    }

    .ph-hero-eyebrow {
        font-family: var(--ph-font-mono);
        font-size: 0.78rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--ph-brass);
        margin-bottom: 1.6rem;
        animation: ph-hero-rise 0.9s var(--ph-ease-out) both;
    }

    .ph-hero-title {
        font-family: var(--ph-font-display);
        font-size: clamp(3rem, 8.5vw, 6.8rem);
        font-weight: 900;
        line-height: 1.04;
        color: var(--ph-bone);
        letter-spacing: -0.015em;
        text-shadow: 0 4px 60px rgba(0, 0, 0, 0.8);
    }

    .ph-hero-line { display: block; overflow: hidden; }

    .ph-hero-line-inner {
        display: inline-block;
        transform: translateY(110%);
        animation: ph-hero-rise 1s var(--ph-ease-out) forwards;
    }

    .ph-hero-line:nth-child(1) .ph-hero-line-inner { animation-delay: 0.15s; }
    .ph-hero-line:nth-child(2) .ph-hero-line-inner { animation-delay: 0.32s; }

    @keyframes ph-hero-rise {
        from { transform: translateY(110%); opacity: 0; }
        to   { transform: translateY(0); opacity: 1; }
    }

    /* The rotating accent word — stack of words, one .active at a time */
    .ph-hero-word-stack {
        position: relative;
        display: inline-block;
        vertical-align: bottom;
    }

    .ph-hero-word-sizer {
        visibility: hidden;
        display: inline-block;
        height: 0;
        overflow: hidden;
    }

    .ph-hero-word {
        position: absolute;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%) translateY(30%);
        font-style: normal;
        font-weight: inherit;
        color: var(--ph-brass);
        background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 9" preserveAspectRatio="none"><path d="M3 7 Q 30 2 60 5 T 117 4" fill="none" stroke="%23c9a24b" stroke-width="3" stroke-linecap="round"/></svg>') no-repeat left 90%/100% 0.14em;
        opacity: 0;
        transition: opacity 0.6s ease, transform 0.6s var(--ph-ease-out);
        white-space: nowrap;
    }

    .ph-hero-word.active {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }

    .ph-hero-plus { color: var(--ph-brass); }

    .ph-hero-sub {
        font-family: var(--ph-font-read);
        font-size: clamp(1.05rem, 2vw, 1.3rem);
        font-style: italic;
        color: var(--ph-bone-70);
        max-width: 560px;
        margin: 1.8rem auto 2.6rem;
        line-height: 1.8;
        animation: ph-hero-rise 1s var(--ph-ease-out) 0.5s both;
    }

    .ph-hero-actions {
        display: flex;
        gap: 1rem;
