    }

    .ph-btn-ghost:hover {
        border-color: #c9a24b;
        color: #c9a24b;
        transform: translateY(-2px);
    }

    /* Thin brass frame inside the hero — museum matting */
    .ph-hero-frame {
        position: absolute;
        inset: 1.2rem;
        border: 1px solid rgba(201, 162, 75, 0.28);
        pointer-events: none;
        z-index: 1;
    }

    /* Hero mobile rules (shared families' mobile rules live in plus.css) */
    .ph-btn-ghost {
        border: 1px solid rgba(242, 238, 227, 0.35);
        color: #f2eee3;
    }

    .ph-btn-ghost:hover {
        border-color: #c9a24b;
        color: #c9a24b;
        transform: translateY(-2px);
    }

    /* Thin brass frame inside the hero — museum matting */
    .ph-hero-frame {
        position: absolute;
        inset: 1.2rem;
        border: 1px solid rgba(201, 162, 75, 0.28);
        pointer-events: none;
        z-index: 1;
    }

    /* Hero mobile rules (shared families' mobile rules live in plus.css) */
    @media (max-width: 640px) {
        .ph-hero-frame { inset: 0.6rem; }
        .ph-hero-inner { padding: 4rem 1.2rem 3.5rem; }
    }
</style>






