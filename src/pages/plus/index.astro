<script>
    // Kinetic hero: rotate the accent word (want → love → crave → deserve)
    const heroWords = Array.from(document.querySelectorAll('.ph-hero-word'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (heroWords.length > 1 && !reducedMotion) {
        let hw = 0;
        setInterval(() => {
            heroWords[hw].classList.remove('active');
            hw = (hw + 1) % heroWords.length;
            heroWords[hw].classList.add('active');
        }, 3000);
    }
    // Reduced-motion: first word stays active — nothing else needed
</script>

<script>
    // === 5A: quote interlude — rotating literary whispers ===
    const QUOTES = [
        { text: 'A reader lives a thousand lives before he dies. The man who never reads lives only one.', cite: '— George R.R. Martin' },
        { text: 'There is no greater agony than bearing an untold story inside you.', cite: '— Maya Angelou' },
        { text: 'Stories are light. Light is precious in a world so dark.', cite: '— Kate DiCamillo' },
        { text: 'We tell ourselves stories in order to live.', cite: '— Joan Didion' },
        { text: 'The only way out of the labyrinth of suffering is to forgive.', cite: '— John Green' },
        { text: 'Everything you can imagine is real.', cite: '— Pablo Picasso' },
        { text: 'Words are, of course, the most inexhaustible source of magic we have.', cite: '— J.K. Rowling' },
    ];
    const quoteEl = document.getElementById('rotatingQuote');
    const citeEl = document.getElementById('rotatingCite');
    if (quoteEl && citeEl && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let qi = 0;
        setInterval(() => {
            quoteEl.style.opacity = '0';
            citeEl.style.opacity = '0';
            setTimeout(() => {
                qi = (qi + 1) % QUOTES.length;
                quoteEl.textContent = QUOTES[qi].text;
                citeEl.textContent = QUOTES[qi].cite;
                quoteEl.style.opacity = '1';
                citeEl.style.opacity = '1';
            }, 600);
        }, 8000);
    }

    // === 5A: stats — count-up when they scroll into view ===
    const statNums = document.querySelectorAll<HTMLElement>('.ph-stat-number[data-target]');
    const animateStat = (el: HTMLElement) => {
        const target = Number(el.dataset.target || '0');
        const dur = 1600;
        const start = performance.now();
        const step = (now: number) => {
            const p = Math.min((now - start) / dur, 1);
            const eased = 1 - Math.pow(1 - p, 3); // ease-out cubic
            el.textContent = Math.round(target * eased).toLocaleString();
            if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
    };
    if (statNums.length && 'IntersectionObserver' in window) {
        const statIO = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    animateStat(entry.target as HTMLElement);
                    statIO.unobserve(entry.target);
                }
            });
        }, { threshold: 0.4 });
        statNums.forEach((el) => statIO.observe(el));
    } else if (statNums.length) {
        statNums.forEach((el) => { el.textContent = Number(el.dataset.target || '0').toLocaleString(); });
    }
</script>








