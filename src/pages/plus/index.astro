    }

    .ph-btn-gold {
        background: #c9a24b;
        color: #0b0b0e;
    }

    .ph-btn-gold:hover {
        background: #d4af5f;
        transform: translateY(-2px);
        box-shadow: 0 10px 36px rgba(201, 162, 75, 0.4);
    }

    .ph-btn-ghost {
        border: 1px solid rgba(242, 238, 227, 0.35);
