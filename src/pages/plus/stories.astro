---
// src/pages/plus/stories.astro — Raconteur+ archive library.
// Data layer: faithful clone of classic /stories. Presentation: Obsidian Editorial.
import PlusLayout from '../../layouts/PlusLayout.astro';
import { getVisibleStories } from '../../data/stories';
import { supabase } from '../../lib/supabase';
import { buildStoryFromDB, bandFromWords } from '../../lib/storyLoader';

const staticStories = getVisibleStories();

const { data: dbRows } = await supabase
    .from('stories')
    .select('*')
    .eq('status', 'published')
    .order('created_at', { ascending: false });

const dbStories = (dbRows || []).map(buildStoryFromDB);

// Force every story (static + DB) to use the computed length band — poems keep 'Poetry'
const stories = [...dbStories, ...staticStories].map(s => ({
    ...s,
    genre: ((s as any).kind === 'poem' || s.genreTag === 'Poetry') ? 'Poetry' : bandFromWords(s.wordCount)
}));
const baseBands = ['Flash Fiction', 'Short Story', 'Novelette', 'Novella'];
const totalWords = stories.reduce((sum, s) => sum + s.wordCount, 0);
const extra = Array.from(new Set(stories.map((s) => s.genre))).filter((g) => !baseBands.includes(g) && g !== 'Poetry');
const proseStories = stories.filter((s) => s.genre !== 'Poetry');
const poemStories = stories.filter((s) => s.genre === 'Poetry');
const genres = ['All', ...baseBands, ...extra];

// Collect all unique genre tags for the second filter row
const genreTags = ['All', ...Array.from(new Set(stories.map((s) => s.genreTag).filter(Boolean) as string[]))];

// Trending — most-read in the last 7 days (reads_weekly aggregate view, RLS-safe)
const { data: weekReads } = await supabase
  .from('reads_weekly')
  .select('story_id, read_count');
const weekCounts: Record<string, number> = {};
(weekReads || []).forEach((r: any) => { weekCounts[r.story_id] = r.read_count || 0; });
const trending = (Object.entries(weekCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([id, n]) => {
    const s = stories.find((st) => st.slug === id);
    return s ? { title: s.title, slug: s.slug, n } : null;
  })
  .filter(Boolean) as { title: string; slug: string; n: number }[]).slice(0, 3);
---
<PlusLayout title="All Stories · Raconteur+" description="Browse the full Raconteur+ shelf: flash fiction, novellas, and everything between.">
    <main class="ph-archive">
        {/* ============ MASTHEAD ============ */}
        <header class="ph-archive-masthead" data-reveal>
            <p class="ph-eyebrow">The Archive · Every work on the shelf</p>
            <h1 class="ph-archive-title">The Full Shelf</h1>
            <p class="ph-archive-sub">
                <span class="ph-archive-count">{stories.length}</span>
                {stories.length === 1 ? 'work' : 'works'}
                <span class="ph-archive-dim"> · </span>
                <span class="ph-archive-count">{totalWords.toLocaleString()}</span> words
            </p>
        </header>
        {/* ============ TRENDING STRIP ============ */}
        {trending.length > 0 && (
            <div class="ph-trending" data-reveal style="--reveal-delay: .1s">
                <span class="ph-trending-label">✦ Trending this week</span>
                {trending.map((t) => (
                    <a href={`/story/${t.slug}`} class="ph-trending-item">
                        <span class="ph-trending-title">{t.title}</span>
                        <span class="ph-trending-count">{t.n} {t.n === 1 ? 'reader' : 'readers'}</span>
                    </a>
                ))}
            </div>
        )}

        {/* ============ CONTROLS: search + band chips + tag chips + sort ============ */}
        <div class="ph-controls" data-reveal style="--reveal-delay: .2s">
            <div class="ph-controls-row">
                <input
                    type="search"
                    id="storySearch"
                    class="ph-input ph-search-lg"
                    placeholder="Search by title, author, or feeling…"
                    aria-label="Search stories"
                />
                <div class="ph-sort-wrap">
                    <label for="storySort" class="ph-label ph-label-inline">Sort</label>
                    <select id="storySort" class="ph-select">
                        <option value="newest">Newest first</option>
                        <option value="oldest">Oldest first</option>
                        <option value="shortest">Shortest first</option>
                        <option value="longest">Longest first</option>
                    </select>
                </div>
            </div>

            <div class="ph-chip-row" id="genreChips" role="group" aria-label="Filter by length">
                {genres.map((g: string, i: number) => (
                    <button
                        type="button"
                        class={`ph-chip ${i === 0 ? 'active' : ''}`}
                        data-genre={g}
                    >
                        {g}
                    </button>
                ))}
            </div>

            {genreTags.length > 1 && (
                <div class="ph-chip-row ph-chip-row-tags" id="genreTagChips" role="group" aria-label="Filter by genre tag">
                    {genreTags.map((g: string, i: number) => (
                        <button
                            type="button"
                            class={`ph-chip ph-chip-tag ${i === 0 ? 'active' : ''}`}
                            data-genretag={g}
                        >
                            {g}
                        </button>
                    ))}
                </div>
            )}

            <p class="ph-result-count" id="resultCount" aria-live="polite">
                Showing <strong>{stories.length}</strong> {stories.length === 1 ? 'work' : 'works'}
            </p>
        </div>
        {/* ============ PROSE GRID ============ */}
        <div class="ph-grid ph-grid-3" id="storyGrid">
            {proseStories.map((story: any) => (
                <a
                    href={`/story/${story.slug}`}
                    class="ph-card"
                    data-genre={story.genre}
                    data-genretag={story.genreTag || ''}
                    data-title={story.title.toLowerCase()}
                    data-author={story.author.toLowerCase()}
                    data-excerpt={(story.excerpt || '').toLowerCase()}
                    data-words={story.wordCount}
                    data-date={story.publishedDate}
                >
                    {story.cover ? (
                        <div class="ph-card-cover">
                            <img src={story.cover} alt={`Cover of ${story.title}`} loading="lazy" />
                        </div>
                    ) : (
                        <div class="ph-card-cover ph-card-cover-empty">
                            <span class="ph-star">✦</span>
                        </div>
                    )}
                    <div class="ph-card-body">
                        <span class="ph-card-genre">{story.genre}</span>
                        <h3 class="ph-card-title">{story.title}</h3>
                        <p class="ph-card-excerpt">{story.excerpt}</p>
                        <div class="ph-card-meta">
                            <span>{story.author}</span>
                            <span class="ph-card-dot">·</span>
                            <span>{story.wordCount.toLocaleString()} words</span>
                            <span class="ph-card-dot">·</span>
                            <span>{story.readTime}</span>
                        </div>
                    </div>
                </a>
            ))}
        </div>

        {/* ============ POETRY ============ */}
        {poemStories.length > 0 && (
            <div class="ph-poetry-divider" id="poetryDivider">
                <div class="ph-poetry-rule"></div>
                <h2 class="ph-poetry-heading">Verse <span class="ph-poetry-star">✦</span></h2>
            </div>
        )}

        <div class="ph-grid ph-grid-3" id="poemGrid">
            {poemStories.map((story: any) => (
                <a
                    href={`/story/${story.slug}`}
                    class="ph-card ph-card-verse"
                    data-genre={story.genre}
                    data-genretag={story.genreTag || ''}
                    data-title={story.title.toLowerCase()}
                    data-author={story.author.toLowerCase()}
                    data-excerpt={(story.excerpt || '').toLowerCase()}
                    data-words={story.wordCount}
                    data-date={story.publishedDate}
                >
                    {story.cover ? (
                        <div class="ph-card-cover">
                            <img src={story.cover} alt={`Cover of ${story.title}`} loading="lazy" />
                        </div>
                    ) : (
                        <div class="ph-card-cover ph-card-verse-text">
                            <p>"{(story.content[0]?.text || '').replace(/<[^>]+>/g, ' ').substring(0, 90)}…"</p>
                        </div>
                    )}
                    <div class="ph-card-body">
                        <span class="ph-card-genre">Poetry</span>
                        <h3 class="ph-card-title">{story.title}</h3>
                        <div class="ph-card-meta">
                            <span>{story.author}</span>
                            <span class="ph-card-dot">·</span>
                            <span>{story.wordCount.toLocaleString()} words · Poem</span>
                        </div>
                    </div>
                </a>
            ))}
        </div>

        {/* Empty state */}
        <p class="ph-empty" id="emptyState" hidden>
            No stories match that search. Try another word or feeling.
        </p>

        <div class="ph-back-home">
            <a href="/plus">← Back to Raconteur+</a>
        </div>
    </main>
<style>
    /* Page-scoped archive styles. Shared card/chip/input families live in plus.css. */

    .ph-archive {
        max-width: 1320px;
        margin: 0 auto;
        padding: 3.5rem 2rem 5rem;
    }

    /* === MASTHEAD === */
    .ph-archive-masthead { text-align: center; margin-bottom: 3rem; }

    .ph-archive-title {
        font-family: var(--ph-font-display);
        font-size: clamp(2.6rem, 6vw, 4.6rem);
        font-weight: 900;
        color: var(--ph-bone);
        letter-spacing: -0.02em;
        line-height: 1.02;
        margin: 0.6rem 0 0.8rem;
    }

    .ph-archive-sub {
        font-family: var(--ph-font-mono);
        font-size: 0.78rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--ph-bone-40);
    }

    .ph-archive-count { color: var(--ph-brass); }
    .ph-archive-dim { color: rgba(201, 162, 75, 0.35); margin: 0 0.2rem; }

    /* === TRENDING STRIP === */
    .ph-trending {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1.2rem 2rem;
        margin: 0 auto 2.6rem;
        padding: 0.8rem 1.6rem;
        border: 1px solid rgba(201, 162, 75, 0.28);
        border-radius: var(--ph-radius-pill);
        background: rgba(201, 162, 75, 0.05);
        backdrop-filter: blur(8px);
    }

    .ph-trending-label {
        font-family: var(--ph-font-mono);
        font-size: 0.66rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--ph-brass);
    }

    .ph-trending-item { display: inline-flex; align-items: baseline; gap: 0.5rem; text-decoration: none; }

    .ph-trending-title {
        font-family: var(--ph-font-display);
        font-style: italic;
        font-weight: 600;
        font-size: 0.98rem;
        color: var(--ph-bone);
        border-bottom: 1px dotted rgba(201, 162, 75, 0.55);
        transition: color 0.2s;
    }

    .ph-trending-item:hover .ph-trending-title { color: var(--ph-brass); }

    .ph-trending-count {
        font-family: var(--ph-font-mono);
        font-size: 0.66rem;
        color: var(--ph-bone-40);
    }
    /* === CONTROLS === */
    .ph-controls {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        margin-bottom: 2.8rem;
    }

    .ph-controls-row {
        display: flex;
        gap: 1rem;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .ph-search-lg { flex: 1; min-width: 240px; border-radius: var(--ph-radius-pill); padding: 0.8rem 1.4rem; }

    .ph-sort-wrap { display: flex; align-items: center; gap: 0.6rem; }

    .ph-label-inline { margin-bottom: 0; white-space: nowrap; }

    .ph-chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
    }

    .ph-chip-row-tags .ph-chip-tag {
        font-size: 0.74rem;
        opacity: 0.75;
    }

    .ph-chip-row-tags .ph-chip-tag.active { opacity: 1; }

    .ph-result-count {
        font-family: var(--ph-font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ph-bone-40);
        margin-top: 0.3rem;
    }

    .ph-result-count strong { color: var(--ph-brass); font-weight: 500; }

    /* === POETRY DIVIDER === */
    .ph-poetry-divider { margin: 3.6rem 0 2rem; }

    .ph-poetry-rule {
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--ph-hairline-strong) 20%, var(--ph-hairline-strong) 80%, transparent);
    }

    .ph-poetry-heading {
        font-family: var(--ph-font-display);
        font-size: 1.9rem;
        font-weight: 900;
        color: var(--ph-bone);
        text-align: center;
        margin-top: 1.4rem;
        letter-spacing: -0.01em;
    }

    .ph-poetry-star { color: var(--ph-brass); font-size: 1.1rem; }

    /* === BACK LINK === */
    .ph-back-home { text-align: center; margin-top: 4rem; }

    .ph-back-home a {
        font-family: var(--ph-font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        color: var(--ph-brass);
        text-decoration: none;
        transition: color 0.25s, transform 0.25s;
        display: inline-block;
    }

    .ph-back-home a:hover { color: var(--ph-brass-bright); transform: translateX(-4px); }

    /* === GRID OVERRIDE: archive uses uniform 3-col (no lead span) === */
    .ph-grid-3 { grid-template-columns: repeat(3, 1fr); }
    .ph-grid-3 .ph-card { grid-column: span 1; }

    /* === MOBILE === */
    @media (max-width: 1024px) {
        .ph-grid-3 { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 640px) {
        .ph-archive { padding: 2.5rem 1.3rem 4rem; }
        .ph-grid-3 { grid-template-columns: 1fr; gap: 1.1rem; }
        .ph-controls-row { flex-direction: column; align-items: stretch; }
        .ph-sort-wrap { justify-content: space-between; }
        .ph-trending { gap: 0.8rem 1.2rem; }
    }
</style>
<script>
    // === Live search + band filter + tag filter + sort (logic cloned from classic) ===
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.ph-grid .ph-card'));
    const searchInput = document.getElementById('storySearch') as HTMLInputElement;
    const bandChips = Array.from(document.querySelectorAll<HTMLElement>('#genreChips .ph-chip'));
    const tagChips = Array.from(document.querySelectorAll<HTMLElement>('#genreTagChips .ph-chip'));
    const sortSelect = document.getElementById('storySort') as HTMLSelectElement;
    const emptyState = document.getElementById('emptyState')!;
    const resultCount = document.getElementById('resultCount')!;

    let activeBand = 'All';
    let activeTag = 'All';

    function applyFilters() {
        const query = searchInput.value.trim().toLowerCase();
        let visibleCount = 0;

        cards.forEach((card) => {
            const matchesBand = activeBand === 'All' || card.dataset.genre === activeBand;
            const matchesTag = activeTag === 'All' || card.dataset.genretag === activeTag;
            const matchesSearch =
                !query ||
                card.dataset.title!.includes(query) ||
                card.dataset.author!.includes(query) ||
                card.dataset.excerpt!.includes(query);

            const show = matchesBand && matchesTag && matchesSearch;
            card.style.display = show ? '' : 'none';
            if (show) visibleCount++;
        });

        emptyState.hidden = visibleCount !== 0;
        resultCount.innerHTML = `Showing <strong>${visibleCount}</strong> ${visibleCount === 1 ? 'work' : 'works'}`;
        const anyPoemVisible = cards.some((c) => c.closest('#poemGrid') !== null && c.style.display !== 'none');
        const divider = document.getElementById('poetryDivider');
        if (divider) divider.style.display = anyPoemVisible ? 'block' : 'none';
    }

    function applySort() {
        const mode = sortSelect.value;
        ['storyGrid', 'poemGrid'].forEach((gid) => {
            const g = document.getElementById(gid);
            if (!g) return;
            const gCards = Array.from(g.querySelectorAll<HTMLElement>('.ph-card'));
            const sorted = [...gCards].sort((a, b) => {
                if (mode === 'shortest') return Number(a.dataset.words) - Number(b.dataset.words);
                if (mode === 'longest') return Number(b.dataset.words) - Number(a.dataset.words);
                if (mode === 'oldest') return (a.dataset.date ?? '').localeCompare(b.dataset.date ?? '');
                return (b.dataset.date ?? '').localeCompare(a.dataset.date ?? '');
            });
            sorted.forEach((card) => g.appendChild(card));
        });
    }

    searchInput.addEventListener('input', applyFilters);

    // Deep-link support: /plus/stories?q=rain pre-fills the search (moods feature)
    const initialQuery = new URLSearchParams(window.location.search).get('q');
    if (initialQuery) {
        searchInput.value = initialQuery;
        applyFilters();
    }

    bandChips.forEach((chip) => {
        chip.addEventListener('click', () => {
            bandChips.forEach((c) => c.classList.remove('active'));
            chip.classList.add('active');
            activeBand = chip.dataset.genre!;
            applyFilters();
        });
    });

    tagChips.forEach((chip) => {
        chip.addEventListener('click', () => {
            tagChips.forEach((c) => c.classList.remove('active'));
            chip.classList.add('active');
            activeTag = chip.dataset.genretag!;
            applyFilters();
        });
    });

    sortSelect.addEventListener('change', applySort);
</script>
</PlusLayout>





