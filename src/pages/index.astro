---
import BaseLayout from '../layouts/BaseLayout.astro';
import LivingBackground from '../components/LivingBackground.astro';
import FeaturedAuthor from '../components/FeaturedAuthor.astro';
import LiteraryGiants from '../components/LiteraryGiants.astro';
import { getVisibleStories, getStoryBySlug } from '../data/stories';
import authors from '../data/authors.json';
import { supabase } from '../lib/supabase';
import { buildStoryFromDB } from '../lib/storyLoader';

// 1. Get static stories
const staticStories = getVisibleStories();

// 2. Fetch published stories from the database
// Curated homepage: featured stories (max 5); falls back to newest if none featured
// Homepage shelf: everything the admin hasn't hidden; featured pinned to the top
const { data: dbRows } = await supabase
    .from('stories')
    .select('*')
    .eq('status', 'published')
    .eq('on_homepage', true)
    .order('is_featured', { ascending: false })
    .order('created_at', { ascending: false });

// 3. Convert DB rows to our Story shape
const dbStories = (dbRows || []).map(buildStoryFromDB);

// 4. Merge them! (Database stories appear first/newest)
const stories = [...dbStories, ...staticStories];
const totalWords = stories.reduce((sum, s) => sum + s.wordCount, 0);
const featuredProse = dbStories.filter(s => s.kind !== 'poem' && s.on_homepage !== false).slice(0, 4);
const featuredPoems = dbStories.filter(s => s.kind === 'poem' && s.on_homepage !== false).slice(0, 4);

// Curated homepage shelf: max 5 prose cards (DB query already puts featured first)
const proseShelf = featuredProse.slice(0, 5);

const heroImageCount = 13; // public/hero now has 13 images (1.jpg-13.jpg)

const dayOfYear = Math.floor(
    (Date.now() - new Date(new Date().getFullYear(), 0, 0).getTime()) / 86400000
);
// Admin data (hardcoded for now — later pulled from profiles table)
const adminAuthor = {
    name: 'Nzan Kikon',
  avatarUrl: '/avatars/nzan-kikon.jpg',
  avatarInitials: 'NK',
  avatarGradient: 'linear-gradient(135deg, #3d5a3c, #a8763e)',
  bio: 'Nzan Kikon is a writer based in Kohima, Nagaland. He is the author of The Starry Night, The Unlikely Indians, Loving Lauren & Lauren and Raindrops of Dostoevsky. He enjoys reading, gazing at the night sky, spending time alone, and watching sci-fi movies. His personal heroes include Dostoevsky, Camus, Von Neumann, Van Gogh, Carl Jung, and Carl Sagan. A humanist and existentialist at heart, Nzan immerses himself in a variety of fields for pleasure, with his top five being science particularly physics and cosmology, philosophy, psychology, human and artificial intelligence, and mythology.',
  favoriteLine: 'Remember that I am thy creature; I ought to be thy Adam, but I am rather the fallen angel, whom thou drivest from joy for no misdeed. Everywhere I see bliss, from which I alone am irrevocably excluded. I was benevolent and good – misery made me a fiend. Make me happy, and I shall again be virtuous.',
  featuredStorySlug: 'poets-from-tomorrow',
  featuredStoryTitle: 'Poets From Tomorrow',
  socialLinks: {
    x: undefined, // Add your X URL
    instagram: undefined, // Add your Instagram URL
    facebook: undefined, // Add your Facebook URL
    email: undefined, // Add your public email
  },
  favoriteBook: 'Frankenstein',
};

// Two rotating writers (for now: Quite Verbose + Mr. Wordy; later: random from DB)
// For now: hardcode Quite Verbose + Mr. Wordy from authors.json
// Later: random selection from DB profiles
// Hardcode the two test accounts for now — we'll make this dynamic later
// Fetch real bios from profiles table
const { data: qvProfile } = await supabase
  .from('profiles')
  .select('bio, book_recs')
  .eq('pen_name', 'Quite Verbose')
  .maybeSingle();

const { data: mwProfile } = await supabase
  .from('profiles')
  .select('bio, book_recs')
  .eq('pen_name', 'Mr. Wordy')
  .maybeSingle();

// Resolve each rotating writer's featured story against stories that actually
// exist (DB uuids or static slugs) — hardcoded slugs like 'does-he-know' 302'd to
// home. Falls back to any published story by that writer; null hides the link.
const resolveFeatured = (name: string, slug: string, title: string) => {
    if (dbStories.some((s) => s.slug === slug) || getStoryBySlug(slug)) {
        return { featuredStorySlug: slug, featuredStoryTitle: title };
    }
    const own = dbStories.find((s) => s.author === name);
    if (own) return { featuredStorySlug: own.slug, featuredStoryTitle: own.title };
    return { featuredStorySlug: null as string | null, featuredStoryTitle: title };
};

const rotatingWriters = [
  {
    name: 'Quite Verbose',
    role: 'Community Writer',
    bio: qvProfile?.bio || 'I am Qverbose and I love reading and writing.',
    avatarUrl: '/avatars/quite-verbose.jpg',
    avatarInitials: 'QV',
    avatarGradient: 'linear-gradient(135deg, #4a6b6b, #6b8a8a)',
    location: 'The Raconteur Community',
    joinedDate: 'August 2026',
    storyCount: 1,
    totalWords: 500,
    favoriteLine: 'What if tomorrow makes today?',
    ...resolveFeatured('Quite Verbose', 'does-he-know', 'Does He Know?'),
    favoriteBook: qvProfile?.book_recs?.[0] || 'Brave New World',
  },
  {
    name: 'Mr. Wordy',
    role: 'Community Writer',
    bio: mwProfile?.bio || 'A writer who believes in the power of words to change the world.',
    avatarUrl: '/avatars/mr-wordy.jpg',
    avatarInitials: 'MW',
    avatarGradient: 'linear-gradient(135deg, #a85a32, #c08050)',
    location: 'The Raconteur Community',
    joinedDate: 'August 2026',
    storyCount: 3,
    totalWords: 2500,
    favoriteLine: 'The city slept, but I did not.',
    ...resolveFeatured('Mr. Wordy', 'tragedies-in-silence', 'Tragedies in Silence'),
    favoriteBook: mwProfile?.book_recs?.[0] || 'Crime and Punishment',
  },
];
const altarAuthor = (authors as any[]).find((a: any) => a.name === 'Nzan Kikon') || (authors as any[])[0];

// --- Rotating shelf: editor's book of the day + community writer of the day ---
const dayIndex = Math.floor(Date.now() / 86400000); // changes at midnight UTC
const adminSlug = String(altarAuthor.name).toLowerCase().replace(/\s+/g, '-');
const adminBooks = (altarAuthor.books as any[]) || [];
// Community pool: books uploaded by account holders
const { data: allBooks } = await supabase
  .from('books')
  .select('title, cover_url, owner_id');
const booksByOwner: Record<string, any[]> = {};
(allBooks || []).forEach((b: any) => {
  (booksByOwner[b.owner_id] = booksByOwner[b.owner_id] || []).push(b);
});
const ownerIds = Object.keys(booksByOwner);
let communitySlots: any[] = [];
if (ownerIds.length > 0) {
  const pickedOwner = ownerIds[dayIndex % ownerIds.length];
  const { data: prof } = await supabase
    .from('profiles')
    .select('pen_name')
    .eq('user_id', pickedOwner)
    .maybeSingle();
  const cName = prof?.pen_name || 'A Raconteur writer';
  const cSlug = cName.toLowerCase().replace(/\s+/g, '-');
  communitySlots = booksByOwner[pickedOwner].slice(0, 3).map((b: any) => ({ ...b, authorName: cName, authorSlug: cSlug }));
}
// Reserved slot: cycle through the editor's books, skipping any already shown via the DB
const communityTitles = new Set(communitySlots.map((b: any) => String(b.title || '').toLowerCase().trim()));
let adminPick: any = null;
for (let i = 0; i < adminBooks.length; i++) {
  const candidate = adminBooks[(dayIndex + i) % adminBooks.length];
  if (!communityTitles.has(String(candidate.title || '').toLowerCase().trim())) {
    adminPick = candidate;
    break;
  }
}
if (!adminPick && adminBooks.length) adminPick = adminBooks[dayIndex % adminBooks.length];
const adminSlot = adminPick ? [{ ...adminPick, authorName: altarAuthor.name, authorSlug: adminSlug }] : [];
// Merge — never empty: no community books today → show all 4 of the editor's books
const merged = communitySlots.length
  ? [...adminSlot, ...communitySlots]
  : adminBooks.map((b: any) => ({ ...b, authorName: altarAuthor.name, authorSlug: adminSlug }));
const seen = new Set<string>();
const shelfBooks: any[] = merged.filter((b: any) => {
  const t = String(b.title || '').toLowerCase().trim();
  if (seen.has(t)) return false;
  seen.add(t);
  return true;
});
const shelfKicker = communitySlots.length ? "Today's featured shelf" : "From the editor's bookshelf";
---

<BaseLayout
    title="Raconteur — Literature you want to read"
    description="A quiet home for short fiction, from flash pieces to novellas."
>
<LivingBackground />

    <!-- Hero: living window with rotating headline + slow zoom -->
    <section class="hero">
        <div class="hero-bg">
            {Array.from({ length: heroImageCount }, (_, i) => (
                <div class={`hero-slide ${i === 0 ? 'active' : ''}`} data-src={`/hero/${i + 1}.jpg`} />
            ))}
        </div>
        <div class="hero-overlay">
            <p class="eyebrow">A quiet place for writers</p>
            <h1 class="rotating-headline">
                <span class="line active">Stories,<br />beautifully told.</span>
                <span class="line">Poetry,<br />written with soul.</span>
                <span class="line">A warm shelf for<br />unforgettable literature.</span>
                <span class="line">Settle in.<br />Stay a while.</span>
                <span class="line">Every story here was written<br />to be remembered.</span>
                <span class="line">Every poetry here was written<br />to be loved.</span>
            </h1>
            <p class="subtitle">
                From a few hundred words to a forty-thousand-word novella and a library of poetry,
                Raconteur is where writers publish, read, and gather around the craft.
            </p>
            <a href="#stories" class="hero-cta">Begin reading</a>
        </div>
        <a href="#stories" class="scroll-cue" aria-label="Scroll to stories">
            <span></span>
        </a>
    </section>

    <!-- Whispering marquee ticker -->
    <div class="marquee">
        <div class="marquee-track">
            <span>✦ New this week: "Poets From Tomorrow" by Nzan Kikon</span>
            <span>✦ Five stories and counting</span>
            <span>✦ Flash fiction to novellas</span>
            <span>✦ Written by storytellers, for readers</span>
            <span>✦ Settle in for a page, a chapter, or an entire evening</span>
            <!-- Duplicate for seamless loop -->
            <span>✦ New this week: "Poets From Tomorrow" by Nzan Kikon</span>
            <span>✦ Five stories and counting</span>
            <span>✦ Flash fiction to novellas</span>
            <span>✦ Written by storytellers, for readers</span>
            <span>✦ Settle in for a page, a chapter, or an entire evening</span>
        </div>
    </div>

       <!-- Featured shelf: one star attraction + four supporting -->
        {/* Featured Stories */}
    <section id="stories" class="stories">
            <div class="stories-header reveal">
            <div>
                <p class="section-eyebrow">From the shelf</p>
                <h2>Featured Stories</h2>
            </div>
            <div class="stories-header-right">
                <a href="/collections" class="collections-pill">✦ Browse Collections</a>
                <span class="stories-count">{ featuredProse.length } { featuredProse.length === 1 ? 'story' : 'stories' }</span>
            </div>
        </div>
        <div class="story-grid">
            {proseShelf.map((story, i) => (
                <a
                    href={`/story/${story.slug}`}
                    class={`story-card reveal genre-${story.genre.toLowerCase().replace(/\s+/g, '-')}`}
                    style={`transition-delay: ${(i + 1) * 0.08}s`}
                >
                    {story.cover && (
                        <div class="card-cover">
                            <img src={story.cover} alt={`Cover of ${story.title}`} />
                        </div>
                    )}
                    {!story.cover && (
                        <div class="card-cover card-cover-empty">✦</div>
                    )}
                    <span class="genre">{story.genre}</span>
                    <h3>{story.title}</h3>
                    <p class="excerpt">{story.excerpt}</p>
                    <div class="meta">
                        <span>By {story.author}</span>
                        <span>·</span>
                        <span>{story.wordCount.toLocaleString()} words</span>
                        <span>·</span>
                        <span>{story.readTime}</span>
                        { ((story as any).readCount || 0) > 0 && (
                          <>
                            <span>·</span>
                            <span>✦ {(story as any).readCount} {(story as any).readCount === 1 ? 'reader' : 'readers'}</span>
                          </>
                        )}
                    </div>
                </a>
            ))}
        </div>
        {proseShelf.length === 0 && featuredPoems.length === 0 && (
            <p class="notes-empty">The shelf is being curated. Check back soon. Meanwhile, <a href="/stories" style="color:#a8b89c">browse the full archive</a>.</p>
        )}
    </section>

    {/* Poetry Section */}
    {featuredPoems.length > 0 && (
        <section class="stories poetry-section">
            <div class="poetry-divider reveal"></div>
        <div class="stories-header reveal">
            <div>
                <p class="section-eyebrow">Verse</p>
                <h2>Featured Poetry</h2>
            </div>
            <div class="stories-header-right">
                <a href="/collections" class="collections-pill">✦ Browse Collections</a>
                <span class="stories-count">{ featuredPoems.length } { featuredPoems.length === 1 ? 'poem' : 'poems' }</span>
            </div>
        </div>
            <div class="story-grid">
                {featuredPoems.map((story, i) => (
                    <a
                        href={`/story/${story.slug}`}
                        class={`story-card reveal genre-poetry`}
                        style={`transition-delay: ${(i + 1) * 0.08}s`}
                    >
                        {story.cover ? (
                            <div class="card-cover">
                                <img src={story.cover} alt={`Cover of ${story.title}`} />
                            </div>
                        ) : (
                            <div class="card-cover poem-text-cover">
                                <p class="poem-preview">"{(story.content[0]?.text || '').replace(/<[^>]+>/g, ' ').substring(0, 80)}…"</p>
                            </div>
                        )}
                        <span class="genre">Poetry</span>
                        <h3>{story.title}</h3>
                        <p class="excerpt">{story.excerpt}</p>
                        <div class="meta">
                            <span>By { story.author }</span>
                            <span>·</span>
                            <span>{ story.wordCount.toLocaleString() } words</span>
                            <span>·</span>
                            <span>Poem</span>
                            { ((story as any).readCount || 0) > 0 && (
                              <>
                                <span>·</span>
                                <span>✦ {(story as any).readCount} {(story as any).readCount === 1 ? 'reader' : 'readers'}</span>
                              </>
                            )}
                        </div>
                    </a>
                ))}
            </div>
        </section>
    )}
     <hr class="section-divider" />
    <!-- Featured author of the day -->
    <FeaturedAuthor admin={adminAuthor} writers={rotatingWriters} />    
    <!-- The green altar: admin's books (left) + literary giants (right) -->
        <section class="altar reveal">
        <div class="altar-inner">
                            <div class="shelf-panel">
                <p class="shelf-kicker">{shelfKicker}</p>
                <h2 class="shelf-title">On the bookshelf today</h2>
                <div class="shelf-books">
                    {shelfBooks.map((b: any) => (
                        <a href={`/author/${b.authorSlug}`} class="shelf-book" title={`${b.title} by ${b.authorName} · visit their page`}>
                            {(b.cover_url || b.cover) ? (
                                <img src={b.cover_url || b.cover} alt={`Cover of ${b.title}`} loading="lazy" />
                            ) : (
                                <div class="shelf-book-empty">{b.title}</div>
                            )}
                            <span class="shelf-book-title">{b.title}</span>
                            <span class="shelf-book-author">{b.authorName}</span>
                        </a>
                    ))}
                </div>
            </div>
            <div class="altar-divider"></div>
            <LiteraryGiants />
        </div>
    </section>

    <!-- Quote interlude — a moment to breathe -->
    <section class="quote-interlude reveal">
        <blockquote>
            <p id="rotatingQuote">A reader lives a thousand lives before he dies. The man who never reads lives only one.</p>
            <cite id="rotatingCite">— George R.R. Martin</cite>
        </blockquote>
    </section>
        <!-- By the numbers — quiet credibility -->
    <section class="stats reveal">
        <div class="stats-inner">
            <div class="stat">
                <span class="stat-number" data-target={stories.length}>0</span>
                <span class="stat-label">Stories on the shelf</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat">
                <span class="stat-number" data-target={totalWords}>0</span>
                <span class="stat-label">Words published</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat">
                <span class="stat-number stat-infinity">∞</span>
                <span class="stat-label">Evenings waiting</span>
            </div>
        </div>
    </section>

        <!-- The Reading Room — community whispers + notes -->
    <section class="reading-room reveal">
        <div class="room-header">
            <p class="section-eyebrow center">From the community</p>
            <h2 class="room-title">The Reading Room</h2>
        </div>
        <div class="room-split">
            <!-- Left: Whispers from the Shelf -->
            <div class="room-half">
                <h3 class="room-half-title">Whispers from the Shelf</h3>
                <p class="room-half-sub">Short thoughts, passing through. Gone in 7 days.</p>
                <div id="whispersList" class="notes-list"></div>
                <form id="whisperForm" class="note-form">
                    <input type="text" id="whisperName" class="note-name-input" placeholder="Your name (optional: leave blank for a random visitor name)" maxlength="40" />
                    <textarea id="whisperInput" class="note-input" rows="2" maxlength="140" placeholder="Share a whisper…"></textarea>
                     <span id="whisperHint" class="note-hint"></span>
                    <button type="submit" class="note-submit">Post Whisper</button>
                </form>
            </div>
            <div class="room-divider"></div>
            <!-- Right: Notes Left Behind -->
            <div class="room-half">
                <h3 class="room-half-title">Notes Left Behind</h3>
                <p class="room-half-sub">Longer thoughts, gratitude, questions. Kept for 30 days.</p>
                <div id="notesList" class="notes-list"></div>
                <form id="noteForm" class="note-form">
                    <input type="text" id="noteName" class="note-name-input" placeholder="Your name (optional: leave blank for a random visitor name)" maxlength="40" />
                    <textarea id="noteInput" class="note-input" rows="3" maxlength="500" placeholder="Leave a note…"></textarea>
                    <span id="noteHint" class="note-hint"></span>
                    <button type="submit" class="note-submit">Post Note</button>
                </form>
            </div>
        </div>
    </section>
</BaseLayout>

<style is:global>
    body {
        overflow-x: hidden;
    }
    .stories, .story-grid, .altar, .reading-room, .stats, .quote-interlude {
    max-width: 100vw;
    overflow-x: hidden;
    }
    /* === HERO — living window === */
    .hero {
        position: relative;
        width: 100%;
        min-height: 600px;
        margin-top: 1rem;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
    }

    .hero-slide {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        opacity: 0;
        transition: opacity 1.5s ease-in-out;
    }

    .hero-slide::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(rgba(20, 30, 22, 0.5), rgba(20, 30, 22, 0.64));
    }

    .hero-slide.active {
        opacity: 1;
    }

    @keyframes heroZoom {
        from { transform: scale(1); }
        to { transform: scale(1.08); }
    }

    .hero-overlay {
        position: relative;
        z-index: 2;
        max-width: 760px;
        padding: 4rem 2rem;
        text-align: center;
        color: #fdf6e3;
    }

    .eyebrow {
        font-style: italic;
        color: #ede4d3;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-size: 0.78rem;
        margin-bottom: 1.8rem;
        text-shadow: 0 1px 10px rgba(0, 0, 0, 0.4);
    }

    .rotating-headline {
        position: relative;
        font-family: 'Playfair Display', serif;
        font-size: clamp(2.4rem, 5.5vw, 4.2rem);
        font-weight: 900;
        line-height: 1.08;
        letter-spacing: -1.2px;
        margin-bottom: 1.6rem;
        min-height: 2.4em;
        text-wrap: balance;
    }

    .rotating-headline .line {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.8s ease, transform 0.8s ease;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent !important;
    }

    .rotating-headline .line.active {
        opacity: 1;
        transform: translateY(0);
    }

    .subtitle {
        font-size: 1.18rem;
        line-height: 1.7;
        color: #ede4d3;
        max-width: 580px;
        margin: 0 auto 2.2rem;
        text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
    }

    .hero-cta {
        display: inline-block;
        padding: 0.85rem 2rem;
        background: rgba(244, 237, 224, 0.95);
        color: #2e2a22;
        text-decoration: none;
        font-family: 'Playfair Display', serif;
        font-size: 1rem;
        letter-spacing: 0.5px;
        border-radius: 2px;
        transition: all 0.3s;
    }

    .hero-cta:hover {
        background: #fff;
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }

    /* Scroll cue — bouncing chevron */
    .scroll-cue {
        position: absolute;
        bottom: 1.8rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2;
        width: 28px;
        height: 44px;
        border: 2px solid rgba(253, 246, 227, 0.6);
        border-radius: 14px;
        display: flex;
        justify-content: center;
        padding-top: 7px;
    }

    .scroll-cue span {
        width: 4px;
        height: 8px;
        background: #fdf6e3;
        border-radius: 2px;
        animation: scrollDot 1.8s ease-in-out infinite;
    }

    @keyframes scrollDot {
        0% { opacity: 0; transform: translateY(0); }
        40% { opacity: 1; }
        80% { opacity: 0; transform: translateY(12px); }
        100% { opacity: 0; }
    }

    /* === MARQUEE — whispering ticker (transparent — no beige bar) === */
    .marquee {
    width: 100%;
    overflow: hidden;
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    border-top: 1px solid rgba(255,255,255,0.12);
    border-bottom: 1px solid rgba(255,255,255,0.12);
    padding: 0.9rem 0;
    }

    .marquee-track {
        display: flex;
        gap: 3rem;
        white-space: nowrap;
        animation: marqueeScroll 38s linear infinite;
        width: max-content;
    }

    .marquee:hover .marquee-track {
        animation-play-state: paused;
    }

    .marquee-track span {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.9rem;
    color: rgba(255,255,255,0.92);
    letter-spacing: 0.5px;
    line-height: 1.4;
    text-shadow: 0 1px 6px rgba(0,0,0,0.45);
    }

    @keyframes marqueeScroll {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }

       /* === SECTION EYEBROW (shared) === */
    .section-eyebrow {
        font-style: italic;
        color: #f4ede0;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-size: 0.72rem;
        margin-bottom: 0.6rem;
    }
    .section-eyebrow.center { text-align: center; }
    .moods .section-eyebrow { color: #a8b89c; }

    .stories-header .section-eyebrow {
        color: rgba(255, 255, 255, 0.85);
