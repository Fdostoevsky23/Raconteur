<script>
    // === Rotating headline — cycles every 5.5 seconds ===
    const lines = document.querySelectorAll('.rotating-headline .line');
    let current = 0;

    if (lines.length > 1) {
        setInterval(() => {
            lines[current].classList.remove('active');
            current = (current + 1) % lines.length;
            lines[current].classList.add('active');
        }, 5500);
    }

    // === Scroll reveal — fade sections in as they enter view ===
    const revealEls = document.querySelectorAll('.reveal');
    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                revealObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.12 });

    revealEls.forEach((el) => revealObserver.observe(el));

    // === Rotating quote interlude — changes every 8 seconds ===
    const quotes = [
        { text: 'A reader lives a thousand lives before he dies. The man who never reads lives only one.', cite: 'George R.R. Martin' },
        { text: 'There is no friend as loyal as a book.', cite: 'Ernest Hemingway' },
        { text: 'A word after a word after a word is power.', cite: 'Margaret Atwood' },
        { text: 'We read to know we are not alone.', cite: 'William Nicholson' },
        { text: 'Stories are the creative conversion of life itself into a more powerful, clearer, more meaningful experience.', cite: 'Robert McKee' },
        { text: 'One must always be careful of books, and what is inside them, for words have the power to change us.', cite: 'Cassandra Clare' },
        { text: 'I have always imagined that Paradise will be a kind of library.', cite: 'Jorge Luis Borges' },
        { text: 'The reading of all good books is like a conversation with the finest minds of past centuries.', cite: 'René Descartes' },
        { text: 'Books are a uniquely portable magic.', cite: 'Stephen King' },
        { text: 'Until I feared I would lose it, I never loved to read. One does not love breathing.', cite: 'Harper Lee' },
        { text: 'A room without books is like a body without a soul.', cite: 'Marcus Tullius Cicero' },
        { text: 'So many books, so little time.', cite: 'Frank Zappa' },
        { text: 'Reading is essential for those who seek to rise above the ordinary.', cite: 'Jim Rohn' },
        { text: 'The world was hers for the reading.', cite: 'Betty Smith' },
        { text: 'Literature is the most agreeable way of ignoring life.', cite: 'Fernando Pessoa' },
    ];

    const quoteEl = document.getElementById('rotatingQuote');
    const citeEl = document.getElementById('rotatingCite');

    if (quoteEl && citeEl && quotes.length > 1) {
        // Start with a random quote
        let qIndex = Math.floor(Math.random() * quotes.length);
        const render = (i: number) => {
            quoteEl.style.opacity = '0';
            citeEl.style.opacity = '0';
            setTimeout(() => {
                quoteEl.textContent = quotes[i].text;
                citeEl.textContent = '— ' + quotes[i].cite;
                quoteEl.style.opacity = '1';
                citeEl.style.opacity = '1';
            }, 600);
        };
        render(qIndex);
        setInterval(() => {
            qIndex = (qIndex + 1) % quotes.length;
            render(qIndex);
        }, 8000);
    }

    // === Stats counter — animate numbers when scrolled into view ===
    const statNumbers = document.querySelectorAll('.stat-number[data-target]');
    const statsObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            const target = parseInt(el.dataset.target || '0', 10);
            const duration = 1400;
            const start = performance.now();

            function tick(now: number) {
                const progress = Math.min((now - start) / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                el.textContent = Math.round(target * eased).toLocaleString();
                if (progress < 1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
            statsObserver.unobserve(el);
        });
    }, { threshold: 0.5 });

    statNumbers.forEach((el) => statsObserver.observe(el));
  // --- HERO LAZY LOADING ---
  const heroSlides = document.querySelectorAll('.hero-slide');
  
  if (heroSlides[0]) {
    const firstSrc = heroSlides[0].getAttribute('data-src');
    if (firstSrc) (heroSlides[0] as HTMLElement).style.backgroundImage = `url('${firstSrc}')`;
  }

  let heroIndex = 0;
  const heroTotal = heroSlides.length;

  function preloadNextHero() {
    const nextIndex = (heroIndex + 1) % heroTotal;
    const nextSlide = heroSlides[nextIndex] as HTMLElement;
    const nextSrc = nextSlide.getAttribute('data-src');
    if (nextSrc && !nextSlide.style.backgroundImage) {
      const img = new Image();
      img.src = nextSrc;
      img.onload = () => {
        nextSlide.style.backgroundImage = `url('${nextSrc}')`;
      };
    }
  }

  setInterval(() => {
    heroSlides[heroIndex].classList.remove('active');
    heroIndex = (heroIndex + 1) % heroTotal;
    heroSlides[heroIndex].classList.add('active');
    preloadNextHero();
  }, 8000);

  setTimeout(preloadNextHero, 2000);
</script>
<script>
    import { supabase } from '../lib/supabase';
    import { dvConfirm, dvToast } from '../lib/dialog';
    import { iconSvg } from '../lib/icons';
    import { esc } from '../lib/escape';

    async function loadNotes(type: 'whisper' | 'note', listId: string) {
        const { data: notes } = await supabase
            .from('community_notes')
            .select('*')
            .eq('note_type', type)
            .gt('expires_at', new Date().toISOString())
            .order('created_at', { ascending: true });
        const list = document.getElementById(listId)!;
        if (!notes || notes.length === 0) {
            list.innerHTML = `<p class="notes-empty">No ${type === 'whisper' ? 'whispers' : 'notes'} yet. Be the first.</p>`;
            return;
        }
        const byParent: Record<string, any[]> = {};
        notes.forEach(n => {
            const key = n.parent_id || 'root';
            (byParent[key] ||= []).push(n);
        });
        const renderNote = (n: any, isReply: boolean): string => {
            const replies = (byParent[n.id] || []).map(r => renderNote(r, true)).join('');
            const replyBtn = (!isReply && type === 'note')
                ? `<button class="note-reply-btn" data-id="${esc(n.id)}" data-name="${esc(n.display_name)}">Reply</button>`
                : '';
            const reportBtn = `<button class="note-report-btn" data-id="${esc(n.id)}" data-type="${type}">${iconSvg("flag", 12)}</button>`;
            return `
                <div class="note-card ${isReply ? 'note-reply' : ''}" data-id="${esc(n.id)}">
                    <p class="note-body">${esc(n.body)}</p>
                    <div class="note-meta">
                        <span class="note-author">— ${esc(n.display_name)}</span>
                        <span class="note-time">${timeAgo(n.created_at)}</span>
                        ${replyBtn}${reportBtn}
                    </div>
                    ${replies ? `<div class="note-replies">${replies}</div>` : ''}
                </div>`;
        };
        const topLevel = (byParent['root'] || []).reverse();
        list.innerHTML = topLevel.map(n => renderNote(n, false)).join('');
        // Report handlers (both whispers and notes)
        list.querySelectorAll('.note-report-btn').forEach(btn => {
            btn.addEventListener('click', () => openReportModal((btn as HTMLElement).dataset.id!, (btn as HTMLElement).dataset.type!));
        });
        if (type === 'note') {
            list.querySelectorAll('.note-reply-btn').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const noteId = (btn as HTMLElement).dataset.id!;
                    const name = (btn as HTMLElement).dataset.name!;
                    const input = document.getElementById('noteInput') as HTMLTextAreaElement;
                    input.value = `@${name} `;
                    input.focus();
                    input.dataset.replyTo = noteId;
                    const hint = document.getElementById('noteHint');
                    if (hint) hint.textContent = 'Replying. Post to send.';
                });
            });
        }
    }

    function timeAgo(iso: string): string {
        const diff = Date.now() - new Date(iso).getTime();
        const m = Math.floor(diff / 60000);
        if (m < 1) return 'just now';
        if (m < 60) return m + 'm ago';
        const h = Math.floor(m / 60);
        if (h < 24) return h + 'h ago';
        const d = Math.floor(h / 24);
        return d + 'd ago';
    }

    // Profanity blocklist — whole words only (no "hell" inside "hello")
    const BLOCKED_WORDS = ['fuck','shit','ass','bitch','cunt','dick','pussy','nigger','faggot','retard'];
    function isVulgar(text: string): boolean {
        const words: string[] = (text.toLowerCase().match(/[a-z']+/g) || []);
        return BLOCKED_WORDS.some(w => words.includes(w));
    }

    const VISITOR_NAMES = ['Wandering Reader','Quiet Guest','Night Owl','Book Wanderer','Shelf Browser','Page Turner','Ink Dreamer','Story Seeker'];

    async function postNote(type: 'whisper' | 'note', formId: string, inputId: string, listId: string): Promise<boolean> {
        const input = document.getElementById(inputId) as HTMLTextAreaElement;
        const body = input.value.trim();
        if (!body) return false;
        if (isVulgar(body)) {
            dvToast('Please keep it kind. Raconteur is a quiet place.');
            return false;
        }
        const nameEl = document.getElementById(type === 'whisper' ? 'whisperName' : 'noteName') as HTMLInputElement;
        const displayName = (nameEl && nameEl.value.trim()) ? nameEl.value.trim()
            : (type === 'whisper' ? 'Anonymous' : VISITOR_NAMES[Math.floor(Math.random() * VISITOR_NAMES.length)]);
        const days = type === 'whisper' ? 7 : 30;
        const payload: any = {
            note_type: type,
            body,
            display_name: displayName,
            expires_at: new Date(Date.now() + days * 86400000).toISOString(),
        };
        const parentId = (input as any).dataset.replyTo || null;
        if (parentId) payload.parent_id = parentId;
        const { error } = await supabase.from('community_notes').insert(payload);
        if (error) { console.error('postNote error:', error); dvToast('Something went wrong. Please try again.'); return false; }
        delete (input as any).dataset.replyTo;
        const hint = document.getElementById(type === 'whisper' ? 'whisperHint' : 'noteHint');
        if (hint) hint.textContent = '';
        input.value = '';
        if (nameEl) nameEl.value = '';
        loadNotes(type, listId);
        return true;
    }

    // Load on page ready
    loadNotes('whisper', 'whispersList');
    loadNotes('note', 'notesList');

    // Whisper cooldown — 15 seconds
    let lastWhisper = 0;
    const WHISPER_COOLDOWN = 15000;
    document.getElementById('whisperForm')!.addEventListener('submit', async (e) => {
        e.preventDefault();
        const now = Date.now();
        const btn = document.querySelector('#whisperForm button[type="submit"]') as HTMLButtonElement;
        const hint = document.getElementById('whisperHint');
        if (now - lastWhisper < WHISPER_COOLDOWN) {
            const wait = Math.ceil((WHISPER_COOLDOWN - (now - lastWhisper)) / 1000);
            if (hint) { hint.textContent = `Wait ${wait}s before another whisper.`; hint.style.color = '#8a9478'; }
            return;
        }
        if (btn) { btn.disabled = true; btn.textContent = 'Wait a moment…'; }
        const ok = await postNote('whisper', 'whisperForm', 'whisperInput', 'whispersList');
        if (ok) {
            lastWhisper = now;
            setTimeout(() => { if (btn) { btn.disabled = false; btn.textContent = 'Post Whisper'; } if (hint) hint.textContent = ''; }, WHISPER_COOLDOWN);
        } else {
            if (btn) { btn.disabled = false; btn.textContent = 'Post Whisper'; }
        }
    });

    // Note cooldown — 15 seconds
    let lastNote = 0;
    const NOTE_COOLDOWN = 15000;
    document.getElementById('noteForm')!.addEventListener('submit', async (e) => {
        e.preventDefault();
        const now = Date.now();
        const btn = document.querySelector('#noteForm button[type="submit"]') as HTMLButtonElement;
        const hint = document.getElementById('noteHint');
        if (now - lastNote < NOTE_COOLDOWN) {
            const wait = Math.ceil((NOTE_COOLDOWN - (now - lastNote)) / 1000);
            if (hint) { hint.textContent = `Wait ${wait}s before another note.`; hint.style.color = '#8a9478'; }
            return;
        }
        if (btn) { btn.disabled = true; btn.textContent = 'Wait a moment…'; }
        const ok = await postNote('note', 'noteForm', 'noteInput', 'notesList');
        if (ok) {
            lastNote = now;
            setTimeout(() => { if (btn) { btn.disabled = false; btn.textContent = 'Post Note'; } if (hint) hint.textContent = ''; }, NOTE_COOLDOWN);
        } else {
            if (btn) { btn.disabled = false; btn.textContent = 'Post Note'; }
        }
    });
        // ===== Report modal =====
    function openReportModal(targetId: string, targetType: string) {
        let modal = document.getElementById('reportModal');
        if (!modal) {
            modal = document.createElement('div');
            modal.id = 'reportModal';
            modal.className = 'report-modal';
            modal.innerHTML = `
                <div class="report-backdrop"></div>
                <div class="report-card">
                    <h3>Report this ${targetType}</h3>
                    <p class="report-sub">Help keep Raconteur quiet and kind.</p>
                    <select id="reportReason" class="report-select">
                        <option value="spam">Spam or advertising</option>
                        <option value="harassment">Harassment or abuse</option>
                        <option value="other">Something else</option>
                    </select>
                    <div class="report-actions">
                        <button id="reportCancel" class="report-btn cancel">Cancel</button>
                        <button id="reportSubmit" class="report-btn submit">Submit report</button>
                    </div>
                    <p id="reportMsg" class="report-msg"></p>
                </div>`;
            document.body.appendChild(modal);
            document.getElementById('reportCancel')!.addEventListener('click', () => modal!.classList.remove('open'));
            modal.querySelector('.report-backdrop')!.addEventListener('click', () => modal!.classList.remove('open'));
        }
        const reasonSel = document.getElementById('reportReason') as HTMLSelectElement;
        const msg = document.getElementById('reportMsg')!;
        const submitBtn = document.getElementById('reportSubmit')!;
        reasonSel.value = 'spam';
        msg.textContent = '';
        modal.classList.add('open');
        submitBtn.onclick = async () => {
            submitBtn.textContent = 'Sending...';
            const { data: { session } } = await supabase.auth.getSession();
            const { error } = await supabase.from('reports').insert({
                reporter_id: session?.user.id || null,
                target_type: targetType,
                target_id: targetId,
                reason: reasonSel.value,
            });
            if (error) { msg.textContent = 'Something went wrong.'; msg.style.color = '#8b2635'; }
            else { msg.textContent = 'Thank you. We will look into it.'; msg.style.color = '#3d5a3c'; }
            submitBtn.textContent = 'Submit report';
            setTimeout(() => modal!.classList.remove('open'), 1400);
        };
    }
        // === Live read counts on cards ===
    (async () => {
        const links = Array.from(document.querySelectorAll('a.story-card, a.feature-card')) as HTMLAnchorElement[];
        const uuids: string[] = [];
        links.forEach(a => {
            const m = (a.getAttribute('href') || '').match(/\/story\/([^/?#]+)/i);
            if (m && !uuids.includes(m[1])) uuids.push(m[1]);
        });
        if (uuids.length === 0) return;
        const { data } = await supabase.from('reads_public').select('story_id,read_count');
        if (!data) return;
        const counts: Record<string, number> = {};
        data.forEach(r => { counts[r.story_id] = r.read_count || 0; });
        links.forEach(a => {
            const m = (a.getAttribute('href') || '').match(/\/story\/([^/?#]+)/i);
            if (!m) return;
            const n = counts[m[1]] || 0;
            if (n === 0) return;
            const meta = a.querySelector('.meta');
            if (!meta || meta.querySelector('.live-reads')) return;
            const dot = document.createElement('span');
            dot.className = 'live-reads';
            dot.textContent = '·';
            const tag = document.createElement('span');
            tag.className = 'live-reads';
            tag.textContent = `✦ ${n} ${n === 1 ? 'reader' : 'readers'}`;
            meta.appendChild(dot);
            meta.appendChild(tag);
        });
    })();
</script>