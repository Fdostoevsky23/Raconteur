      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
    }
    .collection-tile h3 {
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem;
      margin: 0 0 0.6rem;
      color: #2e2a22;
    }
    .collection-tile .collection-count {
      font-size: 0.85rem;
      color: #8a7d65;
      font-style: italic;
    }
    .move-to-collection-btn {
      position: absolute;
      top: 1rem;
      right: 7.6rem;
      background: rgba(30, 36, 32, 0.55);
      border: none;
      border-radius: 4px;
      font-size: 1rem;
      cursor: pointer;
      color: #f4ede0;
      opacity: 0.75;
      transition: opacity 0.2s, transform 0.2s;
