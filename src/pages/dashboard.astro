---
// src/pages/dashboard.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { supabase } from '../lib/supabase';

// Note: In Astro, client-side auth checks for protected pages 
// are usually handled by redirecting in the browser if not logged in.
// We'll add the client-side protection script at the bottom.
---

<BaseLayout title="My Stories | Raconteur">
    <main class="dashboard-container">
        <script is:inline>
      // Kill any stale service worker + its caches (fixes stale back-button renders)
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then((regs) => regs.forEach((r) => r.unregister()));
      }
      if ('caches' in window) {
        caches.keys().then((keys) => keys.forEach((k) => caches.delete(k)));
      }
    </script>
    <header class="dash-header">
      <h1>Your Stories</h1>
      <a href="/submit" class="btn-primary" id="writeNewBtn" style="display: none;">+ Write New Story/Poetry</a>
    </header>
    <p class="badges-note">✦ Writer badges mark stories published, words written, and milestones reached. They'll appear on every writer's public page.</p>
        <div id="recsWidget" class="recs-widget" style="display:none;">
        <h3 class="recs-title">✦ Recommended for you</h3>
        <div id="recsList"></div>
    </div>
    <!-- Writer Profile Editor — single preview (H-02 fix: removed duplicate) -->
        <div id="profilePreview" class="profile-preview" style="display: none;">
      <img id="previewAvatar" class="preview-avatar" alt="" hidden />
      <div id="previewInitials" class="preview-initials">–</div>
      <div class="preview-info">
        <span id="previewName" class="preview-name"></span>
        <p id="previewBio" class="preview-bio"></p>
      </div>
      <a id="viewPublicBtn" class="view-public" href="#">View public page →</a>
    </div>
    <button id="editProfileBtn" class="btn-primary" style="display: none; margin-bottom: 1rem; margin-right: 0.8rem; background: #3d5a3c; color: #f4ede0; border: none; cursor: pointer; padding: 0.5rem 1rem; border-radius: 4px; font-weight: bold;">✎ Edit Profile</button>
    <div id="profileEditor" class="profile-editor" style="display: none;">
      <h2 class="profile-title">Writer Profile</h2>
      <div class="form-group">
        <label for="penNameInput">Pen Name</label>
        <input type="text" id="penNameInput" placeholder="How your name appears on stories..." />
      </div>
            <div class="form-group">
        <label for="bioInput">Short Bio</label>
        <textarea id="bioInput" rows="3" class="editor-input" placeholder="Tell your readers who you are..." style="width:100%;margin-top:0.4rem;padding:0.6rem;background:rgba(244,237,224,0.06);border:1px solid rgba(228,221,200,0.2);border-radius:4px;color:#f4ede0;font-family:inherit;"></textarea>

        <label class="editor-label" style="margin-top:1rem;display:block;color:#a8b89c;font-size:0.85rem;">Top 5 Book Recommendations (one per line, optional)</label>
        <textarea id="bookRecsInput" rows="5" class="editor-input" placeholder="1. The Great Gatsby&#10;2. Beloved&#10;3. ..." style="width:100%;margin-top:0.4rem;padding:0.6rem;background:rgba(244,237,224,0.06);border:1px solid rgba(228,221,200,0.2);border-radius:4px;color:#f4ede0;font-family:inherit;"></textarea>
        <button type="button" id="saveBookRecsBtn" style="margin-top:0.4rem;background:#3d5a3c;border:none;color:#f4ede0;cursor:pointer;font-size:0.85rem;padding:0.4rem 1rem;border-radius:4px;">Save Book Recommendations</button>
        <label class="editor-label" style="margin-top:1rem;display:block;color:#a8b89c;font-size:0.85rem;">Change Email</label>
        <input type="email" id="changeEmailInput" class="editor-input" placeholder="new@email.com" style="width:100%;margin-top:0.4rem;padding:0.6rem;background:rgba(244,237,224,0.06);border:1px solid rgba(228,221,200,0.2);border-radius:4px;color:#f4ede0;font-family:inherit;" />
        <button type="button" id="changeEmailBtn" style="margin-top:0.4rem;background:transparent;border:none;color:#a8b89c;cursor:pointer;font-size:0.85rem;text-decoration:underline;">Send confirmation to new email</button>

        <div style="margin-top:2rem;padding-top:1rem;border-top:1px solid rgba(228,221,200,0.1);">
          <button type="button" id="deleteAccountBtn" style="background:transparent;border:none;color:#a85a32;cursor:pointer;font-size:0.85rem;text-decoration:underline;">Delete my account permanently</button>
        </div>
      </div>
      <div class="form-group">
        <label for="avatarInput">Profile picture (optional)</label>
        <input type="file" id="avatarInput" accept="image/*" />
        <button type="button" id="removeAvatarBtn" class="link-btn" style="margin-top: 0.5rem; background: transparent; border: none; color: #a85a32; cursor: pointer; font-size: 0.85rem; text-decoration: underline;">Remove Profile Picture</button>
        <img id="avatarPreview" alt="" hidden style="max-width: 80px; border-radius: 50%; margin-top: 0.5rem; border: 1px solid #3d5a3c;" />
      </div>
      <div class="form-group">
        <label for="xUrlInput">X / Twitter link (optional)</label>
        <input type="text" id="xUrlInput" placeholder="https://x.com/yourname" />
      </div>
      <div class="form-group">
        <label for="instagramUrlInput">Instagram link (optional)</label>
        <input type="text" id="instagramUrlInput" placeholder="https://instagram.com/yourname" />
      </div>
      <div class="form-group">
        <label for="facebookUrlInput">Facebook link (optional)</label>
        <input type="text" id="facebookUrlInput" placeholder="https://facebook.com/yourname" />
      </div>
      <div class="form-group">
        <label for="publicEmailInput">Public email (optional)</label>
        <input type="text" id="publicEmailInput" placeholder="An address readers may write to" />
      </div>
      <div class="form-group">
        <label for="phoneInput">Phone (optional: stored privately, never shown)</label>
        <input type="text" id="phoneInput" placeholder="Kept private" />
      </div>
            <button id="saveProfileBtn" class="btn-primary" style="background: #3d5a3c; color: #f4ede0;">Save Profile</button>
      <span id="profileStatus" class="profile-status"></span>
    </div>

    <!-- My Books manager -->
    <button id="booksToggleBtn" class="btn-primary" style="display: none; margin-top: 1rem; margin-bottom: 1rem; background: #3d5a3c; color: #f4ede0;  border: none; cursor: pointer; padding: 0.5rem 1rem; border-radius: 4px; font-weight: bold;"><Icon name="collection" size={15} /> My Books </button>
    <a id="savedLink" href="/saved" class="btn-primary" style="display: none; margin-top: 1rem; margin-bottom: 1rem; margin-left: 0.8rem; background: #3d5a3c; color: #f4ede0; text-decoration: none; border: none; cursor: pointer; padding: 0.5rem 1rem; border-radius: 4px; font-weight: bold;"><Icon name="bookmark" size={15} /> Saved for Later </a>
    <div id="booksPanel" style="display: none; margin-bottom: 2rem; padding: 1.2rem; border: 1px solid rgba(244,237,224,0.12); border-radius: 8px;">
      <h2 style="font-family: 'Playfair Display', serif; color: #f4edda; margin-bottom: 1rem;">My Books</h2>
      <div id="booksList" style="margin-bottom: 1.2rem;"></div>
      <form id="bookForm">
        <input type="hidden" id="bookId" />
        <div class="form-group"><label for="bookTitle">Book title</label><input type="text" id="bookTitle" required /></div>
        <div class="form-group"><label for="bookBlurb">One-line blurb (optional)</label><input type="text" id="bookBlurb" placeholder="A novel about..." /></div>
        <div class="form-group"><label for="bookCover">Cover image (optional)</label><input type="file" id="bookCover" accept="image/*" /><img id="bookCoverPreview" alt="" hidden style="max-height: 120px; margin-top: 0.5rem; border: 1px solid #3d5a3c;" /></div>
        <div class="form-group">
        <label id="buyLinksLabel">Where to buy (add as many as you like)</label>
        <div id="linkRows" aria-labelledby="buyLinksLabel"></div>
          <button type="button" id="addLinkBtn" style="background: transparent; border: 1px dashed #a8b89c; color: #a8b89c; border-radius: 4px; padding: 0.4rem 0.8rem; cursor: pointer; font-family: inherit; margin-top: 0.4rem;">+ Add a store link</button>
        </div>
        <button type="submit" class="btn-primary" style="background: #3d5a3c; color: #f4ede0;">Save book</button>
        <button type="button" id="cancelBookBtn" style="display: none; background: transparent; border: 1px solid #a8b89c; color: #a8b89c; border-radius: 4px; padding: 0.5rem 1rem; cursor: pointer; font-family: inherit; margin-left: 0.5rem;">Cancel</button>
        <span id="bookStatus" style="margin-left: 1rem; font-size: 0.85rem; font-style: italic; color: #a8b89c;"></span>
      </form>
    </div>

        <div id="collectionForm" style="display: none; margin-bottom: 2rem; padding: 1.2rem; border: 1px solid rgba(244,237,224,0.12); border-radius: 8px;">
            <h3 id="collectionFormTitle" style="font-family: 'Playfair Display', serif; color: #f4ede0; margin-bottom: 1rem;">New Poetry Collection</h3>
      <div class="form-group">
        <label for="collectionName">Collection Name</label>
        <input type="text" id="collectionName" placeholder="e.g., Raindrops of Dostoevsky" />
      </div>
      <div class="form-group">
        <label for="collectionDesc">Description (optional)</label>
        <textarea id="collectionDesc" rows="2" placeholder="A collection of poems about..." style="width:100%;margin-top:0.4rem;padding:0.6rem;background:rgba(244,237,224,0.06);border:1px solid rgba(228,221,200,0.2);border-radius:4px;color:#f4ede0;font-family:inherit;"></textarea>
      </div>
            <div class="form-group">
        <label for="collectionCover">Cover image (optional)</label>
        <input type="file" id="collectionCover" accept="image/*" />
        <img id="collectionCoverPreview" alt="" hidden style="max-height: 120px; margin-top: 0.5rem; border: 1px solid #3d5a3c;" />
      </div>
      <button type="button" id="saveCollectionBtn" class="btn-primary" style="background: #3d5a3c; color: #f4ede0;">Save Collection</button>
      <button type="button" id="cancelCollectionBtn" style="margin-left: 0.8rem; background: transparent; border: 1px solid #a8b89c; color: #a8b89c; border-radius: 4px; padding: 0.5rem 1rem; cursor: pointer; font-family: inherit;">Cancel</button>
      <span id="collectionStatus" style="margin-left: 1rem; font-size: 0.85rem; font-style: italic; color: #a8b89c;"></span>
    </div>

    <div id="authCheck" class="loading-state">Checking login status...</div>

    <div id="storiesList" class="stories-grid" style="display: none;">
      <!-- Stories will be injected here by JS -->
    </div>

    <div id="emptyState" class="empty-state" style="display: none;">
      <p>You haven't written any stories yet.</p>
      <p class="subtext">Every great author started with a blank page.</p>
      <a href="/submit" class="btn-primary">Write Your First Story</a>
    </div>
  </main>

  <style>
    .badges-note { font-style: italic; font-size: 0.8rem; color: #8a9478; margin: -1rem 0 1.5rem; }
    .dashboard-container {
      max-width: 1200px;
      margin: 4rem auto;
      padding: 0 1.5rem;
      color: #f4edda; /* Matching your cream text */
    }
    .dash-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(244, 237, 218, 0.2);
      padding-bottom: 1rem;
      margin-bottom: 2rem;
    }
    .dash-header h1 {
      font-family: serif; /* Will inherit your global serif */
      font-size: 2rem;
      margin: 0;
    }
    .btn-primary {
      background: #f4ede0;
      color: #1e2420;
      padding: 0.5rem 1rem;
      border-radius: 4px;
      text-decoration: none;
      font-weight: bold;
      transition: opacity 0.2s;
    }
    .btn-primary:hover { opacity: 0.9; }
    .loading-state { text-align: center; padding: 2rem; font-style: italic; opacity: 0.7; }
    .empty-state { text-align: center; padding: 4rem 0; }
    .empty-state p { margin-bottom: 0.5rem; }
    .empty-state .subtext { opacity: 0.6; font-size: 0.9rem; margin-bottom: 2rem; }
    
    .story-card {
      background: rgba(244, 237, 218, 0.05);
      border: 1px solid rgba(244, 237, 218, 0.1);
      padding: 1.5rem;
      border-radius: 8px;
      margin-bottom: 1rem;
    }
    .story-card h3 { margin: 0 0 0.5rem 0; font-family: serif; }
    .story-meta { font-size: 0.85rem; opacity: 0.7; display: flex; gap: 1rem; }
    .status-badge {
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      font-size: 0.75rem;
      text-transform: uppercase;
    }
    .status-draft { background: rgba(255,255,255,0.1); }
        .status-published { background: rgba(76, 175, 80, 0.2); color: #81c784; }

    /* Profile Editor Styles */
    .profile-editor {
      background: rgba(244, 237, 218, 0.05);
      border: 1px solid rgba(244, 237, 218, 0.1);
      padding: 1.5rem;
      border-radius: 8px;
      margin-bottom: 2rem;
    }
    .profile-title {
      font-family: serif;
      font-size: 1.2rem;
      margin: 0 0 1rem 0;
      color: #f4edda;
    }
    .form-group {
      margin-bottom: 1rem;
    }
    .form-group label {
      display: block;
      font-size: 0.85rem;
      margin-bottom: 0.4rem;
      opacity: 0.8;
    }
    .form-group input, .form-group textarea {
      width: 100%;
      padding: 0.6rem;
      background: rgba(0, 0, 0, 0.2);
      border: 1px solid rgba(244, 237, 218, 0.2);
      border-radius: 4px;
      color: #f4edda;
      font-family: inherit;
      font-size: 0.95rem;
    }
    .form-group textarea {
      resize: vertical;
    }
        .profile-status {
      margin-left: 1rem;
      font-size: 0.85rem;
      font-style: italic;
    }

    /* Identity preview card */
    .profile-preview {
      align-items: center;
      gap: 1.2rem;
      background: rgba(244, 237, 218, 0.05);
      border: 1px solid rgba(244, 237, 218, 0.12);
      border-left: 3px solid #3d5a3c;
      border-radius: 8px;
      padding: 1.2rem 1.4rem;
      margin-bottom: 1.2rem;
    }
    .preview-avatar { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; border: 1px solid #3d5a3c; }
    .preview-initials {
      width: 64px; height: 64px; border-radius: 50%;
      background: linear-gradient(135deg, #4a5d4e, #2c3e2d);
      display: flex; align-items: center; justify-content: center;
      font-family: 'Playfair Display', serif; font-weight: 900; font-size: 1.4rem; color: #f4ede0;
    }
    .preview-info { flex: 1; }
    .preview-name { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; color: #f4edda; display: block; margin-bottom: 0.3rem; }
    .preview-bio { margin: 0; font-size: 0.9rem; font-style: italic; color: #b0a890; line-height: 1.5; }
    .view-public { white-space: nowrap; color: #a8b89c; font-size: 0.9rem; text-decoration: none; border-bottom: 1px solid rgba(168, 184, 156, 0.4); padding-bottom: 2px; }
    .view-public:hover { color: #f4ede0; border-color: #f4ede0; }

        /* Story tiles — homepage size, never giant */
    .stories-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 1.5rem;
    }
    .dash-tile {
      background: #faf5ea;
      border: 1px solid #ddd2bb;
      border-top: 3px solid #3d5a3c;
      border-radius: 2px;
      color: #2e2a22;
      box-shadow: 0 2px 14px rgba(46, 42, 34, 0.07);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .dash-tile:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25); }
    .tile-cover { overflow: hidden; }
    .tile-cover img { width: 100%; height: 220px; object-fit: cover; object-position: top; display: block; }
    .tile-cover-empty {
      height: 140px; display: flex; align-items: center; justify-content: center;
      font-style: italic; color: #8a7d65; background: #efe7d6;
    }
    .tile-body { padding: 1rem 1rem 1.2rem; }
    .tile-body h3 { font-family: 'Playfair Display', serif; font-size: 1.05rem; margin: 0 0 0.6rem; color: #2e2a22; }
    .dash-tile .story-meta { color: #8a7d65; }
    .story-card h3 { font-family: 'Playfair Display', serif; font-size: 1.2rem; margin-bottom: 0.8rem; line-height: 1.25; color: #2e2a22; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
    .story-card .excerpt { color: #5a5242; font-size: 0.88rem; margin-bottom: 1.2rem; font-style: italic; line-height: 1.55; flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
    .story-card .meta { font-size: 0.72rem; color: #8a7d65; display: flex; flex-direction: column; gap: 0.15rem; padding-top: 0.9rem; border-top: 1px solid #e8dfca; }
    .card-cover { margin: -1.6rem -1.3rem 1.4rem; overflow: hidden; }
    .card-cover img { width: 100%; height: auto; display: block; transition: transform 0.4s ease; }
    .story-card:hover .card-cover img { transform: scale(1.05); }
    .card-cover-empty { height: 180px; display: flex; align-items: center; justify-content: center; background: #efe7d6; color: #8a7d65; font-style: italic; font-size: 1.2rem; margin: -1.6rem -1.3rem 1.4rem; }
    .poem-text-cover { background: #faf5ea; display: flex; align-items: center; justify-content: center; padding: 1.2rem 1rem; height: 220px; margin: -1.6rem -1.3rem 1.4rem; overflow: hidden; }
    .poem-preview { font-family: 'Playfair Display', serif; font-size: 0.85rem; font-style: italic; color: #3a4a38; line-height: 1.6; text-align: center; margin: 0; }
    .dash-tile { display: none; } /* legacy — replaced by story-card */
    .tile-cover { overflow: hidden; }
    .tile-cover img { width: 100%; height: auto; display: block; }
    .tile-body { padding: 1rem 1rem 1.2rem; }
  </style>

  <style is:global>
  body {
    background: #1e2420;
  }
    .delete-btn {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: rgba(30, 36, 32, 0.55);
      border: none;
      border-radius: 4px;
      font-size: 1.1rem;
      cursor: pointer;
      opacity: 0.75;
      transition: opacity 0.2s, transform 0.2s;
      padding: 0.2rem 0.45rem;
    }
        .export-btn {
      position: absolute;
      top: 1rem;
      right: 5.4rem;
      background: rgba(30, 36, 32, 0.55);
      border: none;
      border-radius: 4px;
      font-size: 1rem;
      cursor: pointer;
      color: #f4ede0;
      opacity: 0.75;
      transition: opacity 0.2s, transform 0.2s;
      padding: 0.2rem 0.45rem;
    }
    .export-btn:hover {
      opacity: 1;
      transform: scale(1.1);
    }
    .edit-btn {
      position: absolute;
      top: 1rem;
      right: 3.2rem;
      background: rgba(30, 36, 32, 0.55);
      border-radius: 4px;
      font-size: 1.1rem;
      text-decoration: none;
      color: #f4ede0;
      opacity: 0.75;
      transition: opacity 0.2s, transform 0.2s;
      padding: 0.2rem 0.45rem;
    }
    .edit-btn:hover {
      opacity: 1;
      transform: scale(1.1);
    }
        .delete-btn:hover {
      opacity: 1;
      transform: scale(1.1);
    }

    /* Dashboard tiles — global so JS-injected tiles get styled */
    .stories-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 1.5rem;
    }
    .dash-tile {
      background: #faf5ea;
      border: 1px solid #ddd2bb;
      border-top: 3px solid #3d5a3c;
      border-radius: 2px;
      color: #2e2a22;
      box-shadow: 0 2px 14px rgba(46, 42, 34, 0.07);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      overflow: hidden;
    }
    .dash-tile:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25); }
    .tile-cover { overflow: hidden; }
    .tile-cover img { width: 100%; height: 220px; object-fit: cover; object-position: top; display: block; }
    .unbookmark-btn {
      position: absolute; top: 1rem; right: 1rem;
      background: rgba(30, 36, 32, 0.55); border: none; border-radius: 4px;
      font-size: 1rem; cursor: pointer; color: #f4ede0; opacity: 0.75;
      padding: 0.2rem 0.5rem;
    }
    .unbookmark-btn:hover { opacity: 1; }
        .admin-badge {
        display: inline-block; margin-left: 0.5rem; padding: 0.15rem 0.6rem;
        border-radius: 999px; background: #3d5a3c; color: #f4ede0;
        font-size: 0.7rem; letter-spacing: 1px; text-transform: uppercase; vertical-align: middle;
    }
        .recs-widget { margin: 0 0 2rem; padding: 1.5rem; background: rgba(244,237,224,0.04); border: 1px solid rgba(228,221,200,0.12); border-radius: 6px; }
    .recs-title { font-family: 'Playfair Display', serif; font-size: 1.1rem; color: #f4ede0; margin-bottom: 1rem; }
    .recs-item { display: flex; justify-content: space-between; padding: 0.6rem 0; border-bottom: 1px solid rgba(228,221,200,0.08); text-decoration: none; color: inherit; }
    .recs-item-title { font-family: 'Playfair Display', serif; color: #f4ede0; }
    .recs-item-author { font-size: 0.85rem; color: #8a9478; font-style: italic; }
    .tile-poem-cover {
      height: 220px; display: flex; align-items: center; justify-content: center;
      padding: 1.2rem; background: #faf5ea; overflow: hidden;
    }

    .saved-link {
        display: inline-block;
        font-family: 'Playfair Display', serif;
        font-size: 1.1rem;
        color: #a8b89c;
        text-decoration: none;
        border-bottom: 1px solid rgba(168, 184, 156, 0.4);
        padding-bottom: 2px;
        transition: color 0.2s, border-color 0.2s;
    }
    .saved-link:hover {
        color: #f4ede0;
        border-color: #f4ede0;
    }

    .poem-preview-text {
        font-family: 'Playfair Display', serif;
        font-size: 0.85rem;
        font-style: italic;
        color: #3a4a38;
        line-height: 1.6;
        text-align: center;
    }
    .tile-cover-empty {
      height: 140px; display: flex; align-items: center; justify-content: center;
      font-style: italic; color: #8a7d65; background: #efe7d6;
    }
    .tile-body { padding: 1rem 1rem 1.2rem; }
    .tile-body h3 { font-family: 'Playfair Display', serif; font-size: 1.05rem; margin: 0 0 0.6rem; color: #2e2a22; }
    .dash-tile .story-meta { color: #8a7d65; display: flex; gap: 0.8rem; align-items: center; font-size: 0.8rem; }

        .collection-tile {
      background: #faf5ea;
      border: 1px solid #ddd2bb;
      border-top: 3px solid #a85a32;
      border-radius: 2px;
      padding: 1.2rem;
      color: #2e2a22;
      box-shadow: 0 2px 14px rgba(46, 42, 34, 0.07);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
