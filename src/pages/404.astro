---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found · Raconteur Classic">
    <section class="not-found">
        <p class="eyebrow">Error 404</p>
        <h1>This page has wandered off.</h1>
        <p class="message">
            Like a character who leaves the story mid-chapter, the page you were looking
            for is no longer here. Perhaps it was never written. Perhaps it's still being
            drafted, somewhere quiet.
        </p>
        <a href="/" class="cta">← Return to the stories</a>
    </section>
</BaseLayout>

<style>
    :global(body) {
        background-color: #1e2420;
        color: #e4ddc8;
    }

    .not-found {
        max-width: 600px;
        margin: 6rem auto;
        padding: 0 2rem;
        text-align: center;
    }

    .eyebrow {
        font-style: italic;
        color: #a8b89c;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-size: 0.8rem;
        margin-bottom: 1.5rem;
    }

    h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 900;
        line-height: 1.15;
        letter-spacing: -0.5px;
        margin-bottom: 1.5rem;
    }

    .message {
        font-size: 1.15rem;
        color: #d8d0bc;
        margin-bottom: 2.5rem;
        font-style: italic;
    }

    .cta {
        display: inline-block;
        padding: 0.9rem 2rem;
        background: #3d5a3c;
        color: #fdf6e3;
        text-decoration: none;
        font-family: 'Playfair Display', serif;
        border-radius: 2px;
        transition: all 0.3s;
    }

    .cta:hover {
        background: #4a6b48;
        transform: translateY(-2px);
    }
</style>