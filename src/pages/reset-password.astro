---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Reset Password — Raconteur">
  <section class="reset-page">
    <div class="reset-card">
      <h1>Reset your password</h1>
      <p class="reset-sub">Enter your email and we'll send you a link to reset your password.</p>
      <form id="resetForm" class="reset-form">
        <input type="email" id="email" placeholder="your@email.com" required />
        <button type="submit" class="reset-btn">Send reset link</button>
      </form>
      <div id="resetMsg" class="reset-msg"></div>
      <p class="reset-back"><a href="/login">← Back to login</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .reset-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  .reset-card {
    background: #faf5ea;
    border: 1px solid #ddd2bb;
    border-radius: 8px;
    padding: 3rem 2.5rem;
    max-width: 420px;
    width: 100%;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }
  .reset-card h1 {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: 700;
    color: #2e2a22;
    margin-bottom: 0.8rem;
  }
  .reset-sub {
    font-size: 0.95rem;
    color: #5a5242;
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  .reset-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .reset-form input {
    padding: 0.9rem 1rem;
    border: 1px solid #ddd2bb;
    border-radius: 4px;
    font-family: inherit;
    font-size: 1rem;
    color: #2e2a22;
  }
  .reset-form input:focus {
    outline: none;
    border-color: #3d5a3c;
  }
  .reset-btn {
    padding: 0.9rem;
    background: #3d5a3c;
    color: #f4ede0;
    border: none;
    border-radius: 4px;
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .reset-btn:hover {
    background: #2d4530;
  }
  .reset-msg {
    margin-top: 1rem;
    padding: 1rem;
    border-radius: 4px;
    font-size: 0.9rem;
    display: none;
  }
  .reset-msg.success {
    background: #e8f5e8;
    color: #2d5a2d;
    border: 1px solid #a8d5a8;
  }
  .reset-msg.error {
    background: #fce8e8;
    color: #8a3a3a;
    border: 1px solid #f5b8b8;
  }
  .reset-back {
    margin-top: 2rem;
    text-align: center;
  }
  .reset-back a {
    color: #3d5a3c;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .reset-back a:hover {
    text-decoration: underline;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  
  // Handle password reset token from email — runs on page load, not on form submit.
  // Supabase sends the link in EITHER format: implicit flow puts type=recovery in
  // the URL hash; the default PKCE flow lands here with ?code=... in the query
  // string (supabase-js exchanges it for a session automatically on load).
  const hasResetCode = new URLSearchParams(window.location.search).has('code');
  function initResetMode() {
    if (!window.location.hash.includes('type=recovery') && !window.location.hash.includes('update') && !hasResetCode) return false;
    const hash = window.location.hash.substring(1);
    const params = new URLSearchParams(hash);
    const type = params.get('type');
    // Supabase sends type=recovery on the hash; token may be in hash or handled via session
    if (type === 'recovery' || window.location.hash.includes('recovery') || hasResetCode) {
      const card = document.querySelector('.reset-card') as HTMLElement | null;
      const sub = document.querySelector('.reset-sub') as HTMLElement | null;
      if (sub) sub.textContent = 'Enter your new password below.';
      document.getElementById('resetForm')!.innerHTML = `
        <input type="password" id="newPassword" placeholder="New password (min 6 characters)" required minlength="6" />
        <button type="submit" class="reset-btn">Update password</button>
      `;
      document.getElementById('resetForm')!.addEventListener('submit', async (e) => {
        e.preventDefault();
        const newPassword = (document.getElementById('newPassword') as HTMLInputElement).value;
        const msg = document.getElementById('resetMsg')!;
        if (!newPassword || newPassword.length < 6) {
          msg.textContent = 'Password must be at least 6 characters.';
          msg.className = 'reset-msg error';
          msg.style.display = 'block';
          return;
        }
        const { error } = await supabase.auth.updateUser({ password: newPassword });
        if (error) {
          msg.textContent = error.message;
          msg.className = 'reset-msg error';
        } else {
          msg.textContent = '✓ Password updated! Redirecting to login...';
          msg.className = 'reset-msg success';
          setTimeout(() => { window.location.href = '/login'; }, 2000);
        }
        msg.style.display = 'block';
      });
      return true;
    }
    return false;
  }

  // Run immediately and also on hash change
  if (!initResetMode()) {
    document.getElementById('resetForm')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      const msg = document.getElementById('resetMsg')!;
      if (!email) return;
      const { error } = await supabase.auth.resetPasswordForEmail(email, {
        redirectTo: window.location.origin + '/reset-password'
      });
      if (error) {
        msg.textContent = error.message;
        msg.className = 'reset-msg error';
      } else {
        msg.textContent = '✓ Check your email for a reset link.';
        msg.className = 'reset-msg success';
      }
      msg.style.display = 'block';
    });
  }
</script>