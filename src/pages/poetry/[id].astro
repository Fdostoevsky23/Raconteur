---
// src/pages/poetry/[id].astro — a poetry collection's own page
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';

const id = Astro.params.id ?? '';

const { data: collection } = await supabase
  .from('poetry_collections')
  .select('*')
  .eq('id', id)
  .maybeSingle();

if (!collection) return Astro.redirect('/');

const { data: poems } = await supabase
  .from('stories')
  .select('*')
  .eq('collection_id', id)
  .eq('status', 'published')
  .order('created_at', { ascending: true });

const { data: owner } = await supabase
  .from('profiles')
  .select('pen_name')
  .eq('user_id', collection.owner_id)
  .maybeSingle();

const authorName = owner?.pen_name || 'A Raconteur writer';
const authorSlug = String(authorName).toLowerCase().replace(/\s+/g, '-');
const poemCount = (poems || []).length;
---

<BaseLayout title={`${collection.name} — ${authorName} · Raconteur`}>
   <main class="coll-page">
    <div id="coll-owner" data-owner={collection.owner_id} hidden></div>
    <a href={`/author/${authorSlug}`} class="coll-back">← {authorName}</a>

    <header class="coll-header">
      {collection.cover_url && <img src={collection.cover_url} alt={`Cover of ${collection.name}`} class="coll-cover" />}
      <p class="coll-eyebrow">A Poetry Collection</p>
      <h1>{collection.name}</h1>
            {collection.description && (
        <div class="coll-desc">
          {String(collection.description).split(/\n+/).filter((s: string) => s.trim()).map((para: string) => <p>{para}</p>)}
        </div>
      )}
      <p class="coll-count">{poemCount} {poemCount === 1 ? 'poem' : 'poems'}</p>
    </header>

    <div class="coll-grid">
            {(poems || []).map((p: any) => (
        <div class="coll-tile" style="position: relative;" data-id={p.id} data-title={p.title} data-content={p.content || ''}>
          <a href={`/story/${p.id}`} style="display: block; text-decoration: none; color: inherit;">
            {p.cover_url ? (
              <img src={p.cover_url} alt={`Cover of ${p.title}`} class="coll-tile-cover" />
            ) : (
              <div class="coll-tile-text">
                <p>{(p.content || '').replace(/<[^>]+>/g, ' ').trim().slice(0, 60)}</p>
              </div>
            )}
            <div class="coll-tile-body">
              <h3>{p.title}</h3>
            </div>
          </a>
        </div>
      ))}
    </div>
  </main>

    <style is:global>
    body { background: #1e2420; }
  </style>

  <style>
    .coll-page { max-width: 1200px; margin: 3rem auto; padding: 0 1.5rem; color: #f4edda; }
    .coll-back { display: inline-block; color: #a8b89c; text-decoration: none; font-size: 0.9rem; margin-bottom: 2rem; border-bottom: 1px solid rgba(168,184,156,0.4); padding-bottom: 2px; }
    .coll-back:hover { color: #f4ede0; }
    .coll-header { text-align: center; margin-bottom: 3rem; }
    .coll-cover { width: 180px; height: 260px; object-fit: cover; border: 1px solid #3d5a3c; border-radius: 2px; margin-bottom: 1.5rem; }
    .coll-eyebrow { font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase; color: #a8b89c; margin-bottom: 0.8rem; }
    .coll-header h1 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 5vw, 3rem); font-weight: 900; color: #f4ede0; margin-bottom: 0.8rem; }
        .coll-desc { max-width: 780px; margin: 0 auto 1.2rem; }
    .coll-desc p { font-style: italic; color: #b0a890; line-height: 1.8; margin-bottom: 1rem; text-align: left; }
    .coll-count { font-size: 0.85rem; color: #8a9478; }
    .coll-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.5rem; }
    .coll-tile { background: #faf5ea; border: 1px solid #ddd2bb; border-top: 3px solid #a85a32; border-radius: 2px; color: #2e2a22; text-decoration: none; display: block; overflow: hidden; transition: transform .3s ease, box-shadow .3s ease; }
    .coll-tile:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,0.25); }
    .coll-tile-cover { width: 100%; height: 220px; object-fit: cover; object-position: top; display: block; }
    .coll-tile-text { height: 220px; display: flex; align-items: center; justify-content: center; padding: 1.2rem; background: #faf5ea; }
    .coll-tile-text p { font-family: 'Playfair Display', serif; font-style: italic; font-size: 0.85rem; color: #3a4a38; text-align: center; line-height: 1.6; }
    .coll-tile-body { padding: 1rem 1rem 1.2rem; }
    .coll-tile-body h3 { font-family: 'Playfair Display', serif; font-size: 1.05rem; margin: 0; color: #2e2a22; }
    :global(.coll-tile) { position: relative; }
    :global(.coll-tile .edit-btn) { position: absolute; top: 0.8rem; right: 3.2rem; z-index: 10; background: rgba(30,36,32,0.7); border-radius: 4px; font-size: 1rem; text-decoration: none; color: #f4ede0; opacity: 0.8; padding: 0.25rem 0.5rem; transition: opacity .2s, transform .2s; }
    :global(.coll-tile .export-btn) { position: absolute; top: 0.8rem; right: 5.4rem; z-index: 10; background: rgba(30,36,32,0.7); border: none; border-radius: 4px; font-size: 0.95rem; cursor: pointer; color: #f4ede0; opacity: 0.8; padding: 0.25rem 0.5rem; transition: opacity .2s, transform .2s; }
    :global(.coll-tile .delete-btn) { position: absolute; top: 0.8rem; right: 1rem; z-index: 10; background: rgba(30,36,32,0.7); border: none; border-radius: 4px; font-size: 1rem; cursor: pointer; opacity: 0.8; padding: 0.25rem 0.5rem; transition: opacity .2s, transform .2s; }
    :global(.coll-tile .edit-btn:hover), :global(.coll-tile .export-btn:hover), :global(.coll-tile .delete-btn:hover) { opacity: 1; transform: scale(1.1); }
  </style>
    <script>
    import { supabase } from '../../lib/supabase';

    (async () => {
      const ownerId = document.getElementById('coll-owner')?.getAttribute('data-owner') || '';
      const { data: { session } } = await supabase.auth.getSession();
      if (!session || session.user.id !== ownerId) return;

      document.querySelectorAll('.coll-tile').forEach(tile => {
        const el = tile as HTMLElement;
        const id = el.dataset.id!;
        const title = el.dataset.title || 'untitled';
        const content = el.dataset.content || '';

        const edit = document.createElement('a');
        edit.className = 'edit-btn';
        edit.href = `/submit?edit=${id}`;
        edit.title = 'Edit';
        edit.textContent = '✎';

        const exp = document.createElement('button');
        exp.className = 'export-btn';
        exp.title = 'Download as .md';
        exp.textContent = '⬇';
        exp.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const text = content
            .replace(/<br\s*\/?>/gi, '\n')
            .replace(/<\/p>/gi, '\n\n')
            .replace(/<[^>]+>/g, '')
            .replace(/&nbsp;/g, ' ')
            .replace(/&amp;/g, '&')
            .replace(/&lt;/g, '<')
            .replace(/&gt;/g, '>')
            .replace(/&quot;/g, '"')
            .replace(/&#39;/g, "'")
            .replace(/\n{3,}/g, '\n\n')
            .trim();
          const md = `# ${title}\n\n${text}\n\n---\nExported from Raconteur · raconteur.stories\n`;
          const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}.md`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        });

        const del = document.createElement('button');
        del.className = 'delete-btn';
        del.title = 'Delete';
        del.textContent = '🗑️';
        del.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (!confirm('Permanently delete this poem? This cannot be undone.')) return;
          const { error } = await supabase.from('stories').delete().eq('id', id);
          if (error) alert('Error: ' + error.message);
          else window.location.reload();
        });

        el.appendChild(edit);
        el.appendChild(exp);
        el.appendChild(del);
      });
    })();
  </script>
</BaseLayout>