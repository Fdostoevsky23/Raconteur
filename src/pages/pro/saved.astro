---
// src/pages/pro/saved.astro — stories bookmarked for later (the dark desk).
// Client logic is a faithful copy of classic /saved (feature parity): bookmarks
// join + unbookmark removal, auth-gated client rendering.
import ProLayout from '../../layouts/ProLayout.astro';
---

<ProLayout title="Saved for Later · Raconteur+" description="Stories you've bookmarked to return to.">
    <div class="pro-page">
        <header class="pro-page-head" data-pro-reveal>
            <p class="pro-browser-kicker">Your shelf of intentions</p>
            <h1 class="pro-page-title">Saved for Later</h1>
            <p class="pro-page-sub">Stories you've bookmarked to return to.</p>
        </header>

        <div id="authCheck" class="pro-empty-state">Checking login status...</div>
        <div id="savedGrid" class="pro-work-grid" hidden></div>
        <div id="emptyState" hidden>
            <div class="pro-quiet-card" data-pro-reveal>
                <p class="pro-quiet-title">No saved stories yet.</p>
                <p class="pro-quiet-sub">Tap the bookmark on any story to save it here.</p>
                <a href="/pro/stories" class="pro-btn pro-btn-amber">Browse the Library</a>
            </div>
        </div>
    </div>
</ProLayout>

<script>
    // Saved stories — faithful clone of classic /saved (story links interim → classic).
    import { supabase } from '../../lib/supabase';
    import { esc } from '../../lib/escape';
    import { iconSvg } from '../../lib/icons';

    const authCheck = document.getElementById('authCheck')!;
    const savedGrid = document.getElementById('savedGrid')!;
    const emptyState = document.getElementById('emptyState')!;

    async function initSaved() {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) { window.location.href = '/pro/login'; return; }
        authCheck.hidden = true;

        const { data: savedRows } = await supabase
            .from('bookmarks')
            .select('story_id, stories(id, title, cover_url, author_name)')
            .eq('user_id', session.user.id);

        // Static-slug stories are not rows in `stories`, so their FK join
        // comes back null — resolve those from the shared search-data island
        // (slug → title/author) so saved static stories render too.
        let savedIsland: any[] = [];
        try { savedIsland = JSON.parse(document.getElementById('all-stories-data')?.textContent || '[]'); } catch { savedIsland = []; }
        const savedBySlug: Record<string, any> = {};
        (savedIsland || []).forEach((s: any) => { if (s?.slug) savedBySlug[s.slug] = s; });
        const saved = (savedRows || []).map((r: any) => {
            if (r.stories) return { id: r.story_id, title: r.stories.title, author_name: r.stories.author_name, cover_url: r.stories.cover_url };
            const st = savedBySlug[r.story_id];
            return st ? { id: r.story_id, title: st.title, author_name: st.author, cover_url: '' } : null;
        }).filter(Boolean);
        if (saved.length === 0) { emptyState.hidden = false; return; }

        savedGrid.hidden = false;
        savedGrid.innerHTML = saved.map((r: any, i: number) => {
            const s = r;
            const cover = s.cover_url
                ? `<div class="pro-work-cover"><img src="${esc(s.cover_url)}" alt="Cover of ${esc(s.title)}" loading="lazy" /></div>`
                : `<div class="pro-work-cover"><span class="pro-work-star" aria-hidden="true">${iconSvg('bookmark', 26)}</span></div>`;
            return `
                <div class="pro-work-card pro-saved-tile" data-pro-reveal style="--pro-reveal-delay: ${Math.min(i * 0.05, 0.4)}s">
                    <a href="/pro/story/${esc(s.id)}" style="display: block; text-decoration: none; color: inherit;">
                        ${cover}
                        <div class="pro-work-body">
                            <h3 class="pro-work-title">${esc(s.title)}</h3>
                            <div class="pro-work-meta"><span>by ${esc(s.author_name)}</span></div>
                        </div>
                    </a>
                    <button class="pro-unbookmark" data-id="${esc(s.id)}" title="Remove from saved" aria-label="Remove from saved">${iconSvg('close', 14)}</button>
                </div>`;
        }).join('');
        savedGrid.querySelectorAll('[data-pro-reveal]').forEach(el => el.classList.add('pro-revealed'));

        savedGrid.querySelectorAll('.pro-unbookmark').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                e.preventDefault(); e.stopPropagation();
                const id = (btn as HTMLElement).dataset.id!;
                await supabase.from('bookmarks').delete().eq('user_id', session.user.id).eq('story_id', id);
                (btn as HTMLElement).closest('.pro-saved-tile')?.remove();
                if (savedGrid.querySelectorAll('.pro-saved-tile').length === 0) {
                    savedGrid.hidden = true;
                    emptyState.hidden = false;
                }
            });
        });
    }
    initSaved();
</script>

<style>
    .pro-page {
        position: relative;
        z-index: 1;
        max-width: 1320px;
        margin: 0 auto;
        padding: 3.4rem 1.6rem 3rem;
    }

    .pro-page-head { margin-bottom: 2.4rem; }

    .pro-page-title {
        font-family: var(--pro-font);
        font-size: clamp(2.2rem, 4.8vw, 3.4rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--pro-text);
        margin: 0.6rem 0 0;
    }

    .pro-page-sub {
        font-family: var(--pro-font-read);
        font-style: italic;
        color: var(--pro-text-2);
        margin: 0.5rem 0 0;
    }

    .pro-empty-state {
        text-align: center;
        font-family: var(--pro-font-read);
        font-style: italic;
        color: var(--pro-text-3);
        padding: 3rem 0;
    }

    .pro-quiet-card {
        max-width: 460px;
        margin: 2rem auto 0;
        padding: 3rem 2.2rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
        background: var(--pro-card);
        border: 1px solid var(--pro-line);
        border-radius: var(--pro-r-lg);
        box-shadow: var(--pro-shadow-card), var(--pro-inner-glow);
    }

    .pro-quiet-title {
        font-family: var(--pro-font);
        font-weight: 600;
        font-size: 1.25rem;
        color: var(--pro-text);
        margin: 0;
    }

    .pro-quiet-sub {
        font-family: var(--pro-font-read);
        font-style: italic;
        color: var(--pro-text-2);
        margin: 0 0 1.2rem;
    }

    .pro-saved-tile { position: relative; }

    .pro-saved-tile > a:first-child { display: block; }

    .pro-unbookmark {
        position: absolute;
        top: 0.9rem;
        right: 0.9rem;
        z-index: 5;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border: 1px solid var(--pro-line-hi);
        border-radius: var(--pro-r-sm);
        background: rgba(22, 15, 10, 0.75);
        color: var(--pro-text-2);
        cursor: pointer;
        opacity: 0.85;
        transition: opacity 0.2s, transform 0.2s, color 0.2s, border-color 0.2s;
    }

    .pro-unbookmark:hover { opacity: 1; transform: scale(1.08); color: var(--pro-amber); border-color: var(--pro-amber); }

    @media (prefers-reduced-motion: reduce) {
        .pro-unbookmark:hover { transform: none; }
    }
</style>
