---
// src/pages/pro/[...slug].astro — 404 catch-all for unmatched /pro/* routes.
import ProLayout from '../../layouts/ProLayout.astro';
---

<ProLayout title="Page not found · Raconteur Pro" description="This page has wandered off.">
    <div class="pro-page pro-notfound">
        <div class="pro-card pro-notfound-card" data-pro-reveal>
            <p class="pro-browser-kicker">Error 404</p>
            <h1 class="pro-notfound-title">This page has wandered off.</h1>
            <p class="pro-notfound-msg">
                Like a character who leaves the story mid-chapter, the page you were looking
                for is no longer here. Perhaps it was never written. Perhaps it's still being
                drafted, somewhere quiet.
            </p>
            <a href="/pro" class="pro-btn pro-btn-amber">Return to the Desk</a>
        </div>
    </div>
</ProLayout>

<style>
    .pro-page {
        position: relative;
        z-index: 1;
        max-width: 1320px;
        margin: 0 auto;
        padding: 3.4rem 1.6rem 3rem;
    }

    .pro-notfound { display: flex; justify-content: center; padding-top: 4rem; }

    .pro-notfound-card {
        max-width: 560px;
        width: 100%;
        padding: 3.4rem 2.6rem;
        text-align: center;
    }

    .pro-notfound-title {
        font-family: var(--pro-font);
        font-size: clamp(1.9rem, 4.5vw, 2.8rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--pro-text);
        margin: 1rem 0;
    }

    .pro-notfound-msg {
        font-family: var(--pro-font-read);
        font-style: italic;
        font-size: 1.08rem;
        line-height: 1.75;
        color: var(--pro-text-2);
        margin: 0 0 2.2rem;
    }

    @media (max-width: 640px) {
        .pro-page { padding: 2.2rem 1rem 2.4rem; }
    }
</style>
