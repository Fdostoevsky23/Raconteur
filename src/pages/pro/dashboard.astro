    .pro-flabel { display: block; font-size: 0.8rem; font-weight: 600; color: var(--pro-text-3); margin: 1rem 0 0.4rem; }
    .pro-field {
        width: 100%;
        padding: 0.65rem 0.8rem;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--pro-line);
        border-radius: 10px;
        color: var(--pro-text);
        font-family: var(--pro-font);
        font-size: 0.93rem;
        outline: none;
        transition: border-color 0.2s;
    }
    select.pro-field option { background: #2e2119; }
    textarea.pro-field { resize: vertical; }
    .pro-field:focus { border-color: var(--pro-amber); }
    input.pro-field::placeholder, textarea.pro-field::placeholder { color: var(--pro-text-3); }

    .pro-status { margin-left: 0.8rem; font-size: 0.85rem; font-style: italic; color: var(--pro-text-2); }
    .pro-mini-btn {
        margin-top: 0.4rem;
        background: var(--pro-amber);
        border: none;
        color: #1a0d00;
        cursor: pointer;
        font-family: var(--pro-font);
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0.45rem 0.95rem;
        border-radius: 999px;
        transition: transform 0.2s, background 0.2s;
    }
    .pro-mini-btn:hover { transform: translateY(-1px); background: var(--pro-mint); color: #04241a; }
    .pro-mini-btn.ghost { background: transparent; border: 1px dashed var(--pro-line-hi); color: var(--pro-text-2); }
    .pro-link-btn {
        margin-top: 0.4rem;
        display: inline-block;
        background: transparent;
        border: none;
        color: var(--pro-text-2);
        cursor: pointer;
        font-family: var(--pro-font);
        font-size: 0.82rem;
        text-decoration: underline;
    }
    .pro-link-btn:hover { color: var(--pro-amber); }
    .pro-link-btn.danger { color: #e05a3a; }
    .pro-danger-zone { margin-top: 1.6rem; padding-top: 0.9rem; border-top: 1px solid var(--pro-line); }

    .pro-dash-toggles { display: flex; gap: 0.7rem; margin: 0.4rem 0 1.6rem; }

    /* Story tiles (JS-injected → :global) */
    .pro-stories-grid { margin-top: 0.6rem; }
    :global(.pro-dash-tile) { position: relative; }
    :global(.pro-dash-meta) { flex-direction: row; align-items: center; gap: 0.6rem; }
    :global(.pro-status-badge) {
        font-size: 0.6rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
        padding: 0.18rem 0.55rem; border-radius: 999px;
        background: rgba(255, 255, 255, 0.08); color: var(--pro-text-2);
    }
    :global(.pro-status-badge.published) { background: var(--pro-mint-soft); color: var(--pro-mint); }

    :global(.pro-dash-btn) {
        position: absolute; top: 0.8rem; z-index: 5;
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 1.9rem; height: 1.9rem; padding: 0 0.35rem;
        background: rgba(22, 15, 10, 0.8);
        border: 1px solid var(--pro-line-hi);
        border-radius: 8px;
        color: var(--pro-text-2);
        cursor: pointer;
        opacity: 0.85;
        transition: opacity 0.2s, transform 0.2s, color 0.2s, border-color 0.2s;
    }
    :global(.pro-dash-btn:hover) { opacity: 1; transform: scale(1.1); color: var(--pro-amber); border-color: rgba(255, 106, 0, 0.45); }
    :global(.pro-dash-edit) { right: 3rem; }
    :global(.pro-dash-move) { right: 5.2rem; }
    :global(.pro-dash-export) { right: 7.4rem; }
    :global(.pro-dash-del) { right: 0.8rem; }

    :global(.pro-dash-coll-cover) { flex-direction: column; gap: 0.5rem; padding: 1.2rem; }
    :global(.pro-dash-coll-cover > span:last-child) {
        font-family: var(--pro-font); font-weight: 600; font-size: 1rem;
        color: var(--pro-text); text-align: center; line-height: 1.3; padding: 0 0.8rem;
    }

    :global(.pro-dash-divider) {
        grid-column: 1 / -1;
        display: flex; justify-content: space-between; align-items: center;
        border-top: 1px solid var(--pro-line);
        padding-top: 1.4rem; margin: 1.6rem 0 0.4rem;
    }

    .pro-section-head {
        font-family: var(--pro-font);
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--pro-text);
    }

    /* Recs */
    :global(.pro-recs-item) {
        display: flex; justify-content: space-between; gap: 1rem;
        padding: 0.6rem 0; border-bottom: 1px solid var(--pro-line);
        text-decoration: none; color: var(--pro-text);
        font-family: var(--pro-font); font-weight: 600; font-size: 0.95rem;
    }
    :global(.pro-recs-item:hover) { color: var(--pro-amber); }
    :global(.pro-recs-author) { font-family: var(--pro-font-read); font-style: italic; font-weight: 400; color: var(--pro-text-3); }

    /* Books */
    .pro-books-list { margin-bottom: 1.2rem; }
    :global(.pro-book-row) { display: flex; gap: 1rem; align-items: center; padding: 0.7rem 0; border-bottom: 1px solid var(--pro-line); }
    :global(.pro-book-thumb) { width: 50px; height: 70px; object-fit: cover; border-radius: 6px; }
    :global(.pro-book-thumb-empty) {
        background: #2e2119; display: flex; align-items: center; justify-content: center;
        color: var(--pro-text-3); font-style: italic; font-size: 0.68rem;
    }
