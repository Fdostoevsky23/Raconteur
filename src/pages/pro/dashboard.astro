    .pro-view-public { white-space: nowrap; font-size: 0.88rem; font-weight: 600; }
    .pro-admin-tag {
        display: inline-block; margin-left: 0.5rem; padding: 0.12rem 0.55rem;
        border-radius: 999px; background: var(--pro-amber); color: #1a0d00;
        font-family: var(--pro-font); font-size: 0.62rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; vertical-align: middle;
    }

    /* Forms */
    .pro-fgroup { margin-bottom: 1.1rem; }
