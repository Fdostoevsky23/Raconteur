---
// src/pages/pro/reset-password.astro — password reset + recovery mode (the dark desk).
// Logic is a faithful copy of classic /reset-password (both Supabase flows).
import ProLayout from '../../layouts/ProLayout.astro';
---

<ProLayout title="Reset Password · Raconteur Pro" description="Reset your Raconteur password.">
    <div class="pro-auth-wrap">
        <div class="pro-card pro-auth-card" data-pro-reveal>
            <h1 class="pro-auth-title">Reset your password</h1>
            <p class="pro-auth-sub" id="resetSub">Enter your email and we'll send you a link to reset your password.</p>
            <form id="resetForm" class="pro-auth-form">
                <input type="email" id="email" class="pro-field" placeholder="your@email.com" required />
                <button type="submit" class="pro-btn pro-btn-amber pro-auth-btn">Send reset link</button>
            </form>
            <div id="resetMsg" class="pro-reset-msg" hidden></div>
            <p class="pro-forgot"><a href="/pro/login">Back to login</a></p>
        </div>
    </div>
</ProLayout>

<script>
    import { supabase } from '../../lib/supabase';

    // Handles BOTH Supabase flows: implicit (type=recovery in hash) and PKCE (?code=)
    const hasResetCode = new URLSearchParams(window.location.search).has('code');
    function initResetMode() {
        if (!window.location.hash.includes('type=recovery') && !window.location.hash.includes('update') && !hasResetCode) return false;
        const hash = window.location.hash.substring(1);
        const params = new URLSearchParams(hash);
        const type = params.get('type');
        if (type === 'recovery' || window.location.hash.includes('recovery') || hasResetCode) {
            const sub = document.getElementById('resetSub') as HTMLElement | null;
            if (sub) sub.textContent = 'Enter your new password below.';
            const form = document.getElementById('resetForm')!;
            form.innerHTML = `
                <input type="password" id="newPassword" class="pro-field" placeholder="New password (min 6 characters)" required minlength="6" />
                <button type="submit" class="pro-btn pro-btn-amber pro-auth-btn">Update password</button>
            `;
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const newPassword = (document.getElementById('newPassword') as HTMLInputElement).value;
                const msg = document.getElementById('resetMsg')!;
                if (!newPassword || newPassword.length < 6) {
                    msg.textContent = 'Password must be at least 6 characters.';
                    msg.className = 'pro-reset-msg error';
                    msg.hidden = false;
                    return;
                }
                const { error } = await supabase.auth.updateUser({ password: newPassword });
                if (error) {
                    msg.textContent = error.message;
                    msg.className = 'pro-reset-msg error';
                } else {
                    msg.textContent = 'Password updated. Redirecting to login...';
                    msg.className = 'pro-reset-msg success';
                    setTimeout(() => { window.location.href = '/pro/login'; }, 2000);
                }
                msg.hidden = false;
            });
            return true;
        }
        return false;
    }

    if (!initResetMode()) {
        document.getElementById('resetForm')!.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = (document.getElementById('email') as HTMLInputElement).value.trim();
            const msg = document.getElementById('resetMsg')!;
            if (!email) return;
            const { error } = await supabase.auth.resetPasswordForEmail(email, {
                redirectTo: window.location.origin + '/pro/reset-password'
            });
            if (error) {
                msg.textContent = error.message;
                msg.className = 'pro-reset-msg error';
            } else {
                msg.textContent = 'Check your email for a reset link.';
                msg.className = 'pro-reset-msg success';
            }
            msg.hidden = false;
        });
    }
</script>

<style>
    .pro-auth-wrap { min-height: 62vh; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; }
    .pro-auth-card { width: 100%; max-width: 420px; padding: 2.6rem 2.3rem; text-align: center; }
    .pro-auth-title { font-family: var(--pro-font); font-size: 1.8rem; font-weight: 700; color: var(--pro-text); margin: 0 0 0.5rem; }
    .pro-auth-sub { font-size: 0.9rem; color: var(--pro-text-2); line-height: 1.6; margin: 0 0 1.8rem; }

    .pro-auth-form { display: flex; flex-direction: column; gap: 1rem; }
    .pro-auth-btn { width: 100%; justify-content: center; margin-top: 0.4rem; }

    .pro-field {
        width: 100%;
        padding: 0.65rem 0.8rem;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--pro-line);
        border-radius: 10px;
        color: var(--pro-text);
        font-family: var(--pro-font);
        font-size: 0.93rem;
        outline: none;
        transition: border-color 0.2s;
    }
    .pro-field:focus { border-color: var(--pro-amber); }
    .pro-field::placeholder { color: var(--pro-text-3); }

    .pro-reset-msg { margin-top: 1rem; padding: 1rem; border-radius: 12px; font-size: 0.88rem; }
    .pro-reset-msg.success { background: var(--pro-mint-soft); color: var(--pro-mint); border: 1px solid rgba(46, 230, 168, 0.3); }
    .pro-reset-msg.error { background: rgba(224, 90, 58, 0.1); color: #e05a3a; border: 1px solid rgba(224, 90, 58, 0.3); }

    .pro-forgot { margin-top: 1.6rem; }
    .pro-forgot a { color: var(--pro-text-2); text-decoration: none; font-size: 0.88rem; }
    .pro-forgot a:hover { color: var(--pro-amber); }
</style>
