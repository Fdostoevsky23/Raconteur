---
// src/pages/pro/collection/[slug].astro — one curated collection (the dark desk).
// Server logic is a faithful copy of classic /collection/[slug] (feature parity):
// ordered story ids from collection_stories, published-only, sort_order preserved.
import ProLayout from '../../../layouts/ProLayout.astro';
import Icon from '../../../components/Icon.astro';
import { supabase } from '../../../lib/supabase';
import { buildStoryFromDB } from '../../../lib/storyLoader';

const { slug } = Astro.params;
const { data: collection } = await supabase
    .from('collections')
    .select('*, collection_stories(story_id, sort_order)')
    .eq('slug', slug)
    .single();

if (!collection) {
    return Astro.redirect('/pro/collections');
}

const storyIds = (collection.collection_stories || [])
    .sort((a: any, b: any) => a.sort_order - b.sort_order)
    .map((cs: any) => cs.story_id);

const { data: storyRows } = storyIds.length > 0
    ? await supabase.from('stories').select('*').in('id', storyIds).eq('status', 'published')
    : { data: [] };

const storiesMap = new Map((storyRows || []).map((r: any) => [r.id, buildStoryFromDB(r)]));
const stories = storyIds.map((id: string) => storiesMap.get(id)).filter(Boolean);
---

<ProLayout title={`${collection.title} · Raconteur Pro`} description={collection.curator_note || 'A curated collection on Raconteur.'}>
    <div class="pro-page">
        <header class="pro-page-head" data-pro-reveal>
            <p class="pro-browser-kicker">Curated shelf</p>
            <h1 class="pro-page-title">{collection.title}</h1>
            {collection.curator_note && <p class="pro-page-sub pro-coll-note">{collection.curator_note}</p>}
            <p class="pro-coll-signature">✦ Curated by Admin</p>
        </header>

        <div class="pro-work-grid">
            {stories.map((story: any, i: number) => (
                <a
                    href={`/story/${story.slug}`}
                    class="pro-work-card"
                    data-pro-reveal
                    style={`--pro-reveal-delay: ${Math.min(i * 0.06, 0.4)}s`}
                >
                    <div class="pro-work-cover">
                        {story.cover ? (
                            <img src={story.cover} alt={`Cover of ${story.title}`} loading="lazy" />
                        ) : (
                            <span class="pro-work-star" aria-hidden="true"><Icon name="sparkle" size={30} /></span>
                        )}
                    </div>
                    <div class="pro-work-body">
                        <span class="pro-work-genre">{story.genre}</span>
                        <h3 class="pro-work-title">{story.title}</h3>
                        <p class="pro-work-excerpt">{story.excerpt}</p>
                        <div class="pro-work-meta">
                            <span>By {story.author}</span>
                            <span>{story.wordCount.toLocaleString()} words · {story.readTime}</span>
                        </div>
                    </div>
                </a>
            ))}
            {stories.length === 0 && (
                <p class="pro-empty-state">This collection is being arranged. Check back soon.</p>
            )}
        </div>

        <div class="pro-back">
            <a href="/pro/collections" class="pro-card-link">← All collections</a>
        </div>
    </div>
</ProLayout>

<style>
    .pro-page {
        position: relative;
        z-index: 1;
        max-width: 1320px;
        margin: 0 auto;
        padding: 3.4rem 1.6rem 3rem;
    }

    .pro-page-head { text-align: center; margin-bottom: 2.6rem; }

    .pro-page-title {
        font-family: var(--pro-font);
        font-size: clamp(2.2rem, 4.8vw, 3.4rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--pro-text);
        margin: 0.6rem 0 0;
    }

    .pro-page-sub {
        font-family: var(--pro-font-read);
        font-style: italic;
        font-size: 1rem;
        color: var(--pro-text-2);
        margin: 0.5rem 0 0;
    }

    .pro-coll-note { max-width: 620px; margin: 0 auto 1.2rem; }

    .pro-coll-signature {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--pro-honey);
        margin-top: 0.6rem;
    }

    .pro-empty-state {
        grid-column: 1 / -1;
        text-align: center;
        font-family: var(--pro-font-read);
        font-style: italic;
        color: var(--pro-text-3);
        padding: 2rem 0;
    }

    .pro-back { text-align: center; margin-top: 3rem; }

    @media (max-width: 640px) {
        .pro-page { padding: 2.2rem 1rem 2.4rem; }
    }
</style>
