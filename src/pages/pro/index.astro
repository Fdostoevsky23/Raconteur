    @media (prefers-reduced-motion: reduce) {
        .pro-work-card:hover { transform: none; }
        .pro-work-card:hover .pro-work-cover img { transform: none; }
    }

    /* === FEATURED WRITERS — the masthead roster === */
    .pro-writers { max-width: 1320px; margin: 0 auto; padding: 4rem 1.6rem 1rem; }

    .pro-writers-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }

    .pro-writer-card {
        display: flex;
