    .pro-strip-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pro-strip-thumb:hover { opacity: 0.8; }
    .pro-strip-thumb.active {
        opacity: 1;
        border-color: var(--pro-amber);
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(255, 106, 0, 0.15);
    }

    @media (prefers-reduced-motion: reduce) {
        .pro-hero-word { opacity: 1; transform: none; transition: none; }
        .pro-hero-word:not(:first-child) { display: none; }
    }

        /* === TICKER === */
    .pro-ticker {
        overflow: hidden;
        border-top: 1px solid var(--pro-line);
        border-bottom: 1px solid var(--pro-line);
        padding: 0.85rem 0;
        background: rgba(255, 255, 255, 0.02);
    }

    .pro-ticker-track {
        display: flex;
