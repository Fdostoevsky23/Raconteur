---
// src/pages/pro/index.astro · Raconteur Pro homepage ("The Reader's Desk").
// Feature parity with the classic homepage — hero with rotating words and
// plates, ticker, curated browsers (reserved editor slot + three random
// writers), quote interlude, stats — expressed in Pro's dark desk language.
// Everything the classic home has; nothing Pro invented.
import ProLayout from '../../layouts/ProLayout.astro';
import Icon from '../../components/Icon.astro';
import { getVisibleStories } from '../../data/stories';
import { supabase } from '../../lib/supabase';
import { buildStoryFromDB } from '../../lib/storyLoader';
import { curate, dayOfYearNow } from '../../lib/curate';

const DAY_MS = 86400000;

// 1. Static stories
const staticStories = getVisibleStories();

// 2. Published DB stories (same query as classic home)
const { data: dbRows } = await supabase
    .from('stories')
    .select('*')
    .eq('status', 'published')
    .order('created_at', { ascending: false });
const dbStories = (dbRows || []).map(buildStoryFromDB);

// 3. Merge — DB first (newest first)
const stories = [...dbStories, ...staticStories];
const totalWords = stories.reduce((sum, s) => sum + s.wordCount, 0);
const poems = stories.filter(s => (s as any).kind === 'poem' || s.genre === 'Poetry');
const prose = stories.filter(s => !((s as any).kind === 'poem' || s.genre === 'Poetry'));

// Curated browsers via the shared house engine (1 reserved + 3 random writers)
const daySeed = dayOfYearNow() * 2654435761;
const prosePool = [...prose].sort((a: any, b: any) => new Date(b.publishedDate).getTime() - new Date(a.publishedDate).getTime());
const poemPool = [...poems].sort((a: any, b: any) => new Date(b.publishedDate).getTime() - new Date(a.publishedDate).getTime());
const deskShelf = curate(prosePool, 4, daySeed);
const verseShelf = curate(poemPool, 4, daySeed);

// Hero plates — the full 13-image library, crossfading every 10s
const heroImageCount = 13;
const heroPlates = Array.from({ length: heroImageCount }, (_, i) => `/hero/${i + 1}.jpg`);

// Rotating hero headlines — the classic words
const heroHeadlines = [
    ['Stories,', 'beautifully told.'],
    ['Poetry,', 'written with soul.'],
    ['A warm shelf for', 'unforgettable literature.'],
    ['Settle in.', 'Stay a while.'],
    ['Every story here was written', 'to be remembered.'],
    ['Every poetry here was written', 'to be loved.'],
];

// Ticker — the print strip
const tickerItems = [
    'Literature you want to read',
    `${stories.length} works on the shelf`,
    `${totalWords.toLocaleString()} words and counting`,
    'No algorithms · No noise · No slush pile',
    'Writers publish instantly',
];

// Quote interlude
const interludeQuotes = [
    { text: 'A reader lives a thousand lives before he dies. The man who never reads lives only one.', cite: 'George R.R. Martin' },
    { text: 'There is no friend as loyal as a book.', cite: 'Ernest Hemingway' },
    { text: 'A word after a word after a word is power.', cite: 'Margaret Atwood' },
    { text: 'We read to know we are not alone.', cite: 'William Nicholson' },
    { text: 'I have always imagined that Paradise will be a kind of library.', cite: 'Jorge Luis Borges' },
    { text: 'Books are a uniquely portable magic.', cite: 'Stephen King' },
    { text: 'Until I feared I would lose it, I never loved to read. One does not love breathing.', cite: 'Harper Lee' },
    { text: 'A room without books is like a body without a soul.', cite: 'Marcus Tullius Cicero' },
    { text: 'The world was hers for the reading.', cite: 'Betty Smith' },
    { text: 'Literature is the most agreeable way of ignoring life.', cite: 'Fernando Pessoa' },
    { text: 'There is nothing to writing. All you do is sit down at a typewriter and bleed.', cite: 'Ernest Hemingway' },
    { text: 'Fill your paper with the breathings of your heart.', cite: 'William Wordsworth' },
];
const firstQuote = interludeQuotes[Math.floor(Math.random() * interludeQuotes.length)];
---

<ProLayout title="Raconteur Pro · The Reader's Desk" description="Literature you want to read. The Raconteur Pro desk.">
    {/* ===== HERO — rotating words left, looping plates right ===== */}
    <section class="pro-hero">
        <div class="pro-hero-type">
            <p class="pro-hero-kicker">A quiet place for writers</p>
            <h1 class="pro-hero-headline">
                {heroHeadlines.map((lines, i) => (
                    <span class={`pro-hero-line ${i === 0 ? 'active' : ''}`}>
                        {lines[0]}<br />{lines[1]}
                    </span>
                ))}
            </h1>
            <p class="pro-hero-lede">
                From a few hundred words to a forty-thousand-word novella and a library
                of poetry, Raconteur is where writers publish, read, and gather around
                the craft.
            </p>
            <div class="pro-hero-actions">
                <a href="/stories" class="pro-btn pro-btn-amber">Begin reading</a>
                <a href="/submit" class="pro-btn pro-btn-ghost">Publish a story</a>
            </div>
            <p class="pro-hero-meta">
                {stories.length} works · {totalWords.toLocaleString()} words · EST. 2026
            </p>
        </div>
        <div class="pro-hero-plate-side">
            <div class="pro-plate">
                <div class="pro-plate-stack">
                    {heroPlates.map((src, i) => (
                        <img src={src} alt="Editorial plate" class={`pro-plate-img ${i === 0 ? 'active' : ''}`} data-idx={i} loading={i === 0 ? 'eager' : 'lazy'} />
                    ))}
                </div>
                <span class="pro-plate-caption">Plate of the day</span>
            </div>
        </div>
    </section>

    {/* ===== TICKER — the print strip ===== */}
    <div class="pro-ticker" aria-hidden="true">
        <div class="pro-ticker-track">
            {[...tickerItems, ...tickerItems].map((t, i) => (
                <span class="pro-ticker-item">{t} <i>✦</i></span>
            ))}
        </div>
    </div>

    {/* ===== FRESH FROM THE DESK — curated prose (reserved + 3 writers) ===== */}
    <section class="pro-browser">
        <header class="pro-browser-head" data-pro-reveal>
            <div>
                <p class="pro-browser-kicker">From the desk</p>
                <h2 class="pro-browser-title">Fresh from the desk</h2>
            </div>
            <a href="/stories" class="pro-card-link">View the full shelf →</a>
        </header>
        <div class="pro-work-grid">
            {deskShelf.map((story: any, i: number) => (
                <a
                    href={`/story/${story.slug}`}
                    class="pro-work-card"
                    data-pro-reveal
                    style={`--pro-reveal-delay: ${Math.min(i * 0.06, 0.3)}s`}
                >
                    <div class="pro-work-cover">
                        {story.cover ? (
                            <img src={story.cover} alt={`Cover of ${story.title}`} loading="lazy" />
                        ) : (
                            <span class="pro-work-star" aria-hidden="true"><Icon name="sparkle" size={30} /></span>
                        )}
                        {story.author === 'Nzan Kikon' && <span class="pro-work-reserved">Editor's pick</span>}
                    </div>
                    <div class="pro-work-body">
                        <span class="pro-work-genre">{story.genre}</span>
                        <h3 class="pro-work-title">{story.title}</h3>
                        <div class="pro-work-meta">
                            <span>{story.author}</span>
                            <span>{story.wordCount.toLocaleString()} words · {story.readTime}</span>
                        </div>
                    </div>
                </a>
            ))}
            {deskShelf.length === 0 && (
                <p class="pro-browser-empty">The shelf is being curated. Check back soon.</p>
            )}
        </div>
    </section>

    {/* ===== FRESH POETRY — curated verse (reserved + 3 writers) ===== */}
    {verseShelf.length > 0 && (
        <section class="pro-browser">
            <header class="pro-browser-head" data-pro-reveal>
                <div>
                    <p class="pro-browser-kicker">Verse</p>
                    <h2 class="pro-browser-title">Fresh poetry</h2>
                </div>
                <a href="/stories" class="pro-card-link">View the full shelf →</a>
            </header>
            <div class="pro-work-grid">
                {verseShelf.map((story: any, i: number) => (
                    <a
                        href={`/story/${story.slug}`}
                        class="pro-work-card is-poem"
                        data-pro-reveal
                        style={`--pro-reveal-delay: ${Math.min(i * 0.06, 0.3)}s`}
                    >
                        <div class="pro-work-cover">
                            {story.cover ? (
                                <img src={story.cover} alt={`Cover of ${story.title}`} loading="lazy" />
                            ) : (
                                <span class="pro-work-quote">“{(story.excerpt || '').replace(/<[^>]+>/g, ' ').substring(0, 90)}…”</span>
                            )}
                            {story.author === 'Nzan Kikon' && <span class="pro-work-reserved">Editor's pick</span>}
                        </div>
                        <div class="pro-work-body">
                            <span class="pro-work-genre poem">Poetry</span>
                            <h3 class="pro-work-title">{story.title}</h3>
                            <div class="pro-work-meta">
                                <span>{story.author}</span>
                                <span>{story.wordCount.toLocaleString()} words</span>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </section>
    )}

    {/* ===== QUOTE INTERLUDE ===== */}
    <section class="pro-interlude" data-pro-reveal>
        <blockquote>
            <p id="proQuote">{firstQuote.text}</p>
            <cite id="proCite">— {firstQuote.cite}</cite>
        </blockquote>
    </section>

    {/* ===== STATS ===== */}
    <section class="pro-stats-band">
        <div class="pro-stat" data-pro-reveal>
            <span class="pro-stat-num">{stories.length}</span>
            <span class="pro-stat-label">works published</span>
        </div>
        <div class="pro-stat" data-pro-reveal style="--pro-reveal-delay: 0.08s">
            <span class="pro-stat-num">{totalWords.toLocaleString()}</span>
            <span class="pro-stat-label">words written</span>
        </div>
        <div class="pro-stat" data-pro-reveal style="--pro-reveal-delay: 0.16s">
            <span class="pro-stat-num">∞</span>
            <span class="pro-stat-label">stories yet to come</span>
        </div>
    </section>
</ProLayout>

<script>
    // Hero plates — the 13-image library, crossfading every 10 seconds
    const proPlates = Array.from(document.querySelectorAll<HTMLElement>('.pro-plate-img'));
    if (proPlates.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let plateIdx = 0;
        setInterval(() => {
            proPlates[plateIdx].classList.remove('active');
            plateIdx = (plateIdx + 1) % proPlates.length;
            proPlates[plateIdx].classList.add('active');
        }, 10000);
    }

    // Hero headline rotator — the classic words, every 7 seconds
    const heroLines = Array.from(document.querySelectorAll<HTMLElement>('.pro-hero-line'));
    if (heroLines.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let lineIdx = 0;
        setInterval(() => {
            heroLines[lineIdx].classList.remove('active');
            lineIdx = (lineIdx + 1) % heroLines.length;
            heroLines[lineIdx].classList.add('active');
        }, 7000);
    }

    // Quote interlude — rotates every 8 seconds
    const quotes = JSON.parse(document.getElementById('pro-quotes-data')?.textContent || '[]');
    const quoteEl = document.getElementById('proQuote');
    const citeEl = document.getElementById('proCite');
    if (quoteEl && citeEl && quotes.length > 1) {
        let qIndex = Math.floor(Math.random() * quotes.length);
        setInterval(() => {
            qIndex = (qIndex + 1) % quotes.length;
            quoteEl.style.opacity = '0';
            citeEl.style.opacity = '0';
            setTimeout(() => {
                quoteEl.textContent = quotes[qIndex].text;
                citeEl.textContent = '— ' + quotes[qIndex].cite;
                quoteEl.style.opacity = '1';
                citeEl.style.opacity = '1';
            }, 600);
        }, 8000);
    }

    // Stats count-up when scrolled into view
    const statNums = document.querySelectorAll<HTMLElement>('.pro-stats-band .pro-stat-num[data-target]');
    if ('IntersectionObserver' in window && statNums.length) {
        const statsIO = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target as HTMLElement;
                const target = parseInt(el.dataset.target || '0', 10);
                const start = performance.now();
                const tick = (now: number) => {
                    const progress = Math.min((now - start) / 1400, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    el.textContent = Math.round(target * eased).toLocaleString();
                    if (progress < 1) requestAnimationFrame(tick);
                };
                requestAnimationFrame(tick);
                statsIO.unobserve(el);
            });
        }, { threshold: 0.5 });
        statNums.forEach((el) => statsIO.observe(el));
    }
</script>

<script type="application/json" id="pro-quotes-data" set:html={JSON.stringify(interludeQuotes).replace(/</g, '\u003c')} />

<style>
    /* === HERO === */
    .pro-hero {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        min-height: 78vh;
        align-items: center;
        max-width: 1320px;
        margin: 0 auto;
        padding: 3rem 1.6rem 2rem;
        gap: 2rem;
    }

    .pro-hero-kicker {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--pro-amber);
        margin: 0 0 1.2rem;
    }

    .pro-hero-headline {
        position: relative;
        display: grid;
        font-family: var(--pro-font);
        font-size: clamp(2.6rem, 5.6vw, 4.6rem);
        font-weight: 700;
        line-height: 1.06;
        letter-spacing: -0.03em;
        color: var(--pro-text);
        margin: 0 0 1.4rem;
    }

    .pro-hero-line {
        grid-area: 1 / 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        opacity: 0;
        transform: translateY(14px);
        pointer-events: none;
        transition: opacity 0.8s ease, transform 0.8s ease;
    }

    .pro-hero-line.active { opacity: 1; transform: none; pointer-events: auto; }

    .pro-hero-lede {
        font-family: var(--pro-font-read);
        font-size: 1.12rem;
        line-height: 1.7;
        color: var(--pro-text-2);
        max-width: 46ch;
        margin: 0 0 2rem;
    }

    .pro-hero-actions { display: flex; gap: 0.7rem; flex-wrap: wrap; margin-bottom: 1.5rem; }

    .pro-hero-meta {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--pro-text-3);
        margin: 0;
    }

    /* the plate — dark frame */
    .pro-hero-plate-side { display: flex; justify-content: center; }

    .pro-plate {
        position: relative;
        width: min(80%, 440px);
        border: 1px solid var(--pro-line-hi, var(--pro-line));
        padding: 0.8rem;
        background: #0a0d10;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55), 0 0 60px rgba(255, 106, 0, 0.06);
    }

    .pro-plate-stack { position: relative; width: 100%; aspect-ratio: 4 / 5; overflow: hidden; }

    .pro-plate-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: saturate(0.92) contrast(1.03);
        opacity: 0;
        transform: scale(1.03);
        transition: opacity 1.2s ease, transform 8s linear;
    }

    .pro-plate-img.active { opacity: 1; transform: none; }

    .pro-plate-caption {
        display: block;
        margin-top: 0.7rem;
        font-size: 0.64rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--pro-amber);
    }

    @media (prefers-reduced-motion: reduce) {
        .pro-hero-line { position: static; opacity: 1; transform: none; transition: none; }
        .pro-hero-line:not(:first-child) { display: none; }
        .pro-plate-img { transition: none; }
        .pro-plate-img:not(:first-child) { display: none; }
    }

    /* === TICKER === */
    .pro-ticker {
        overflow: hidden;
        border-top: 1px solid var(--pro-line);
        border-bottom: 1px solid var(--pro-line);
        padding: 0.85rem 0;
        background: rgba(255, 255, 255, 0.02);
    }

    .pro-ticker-track {
        display: flex;
        gap: 2.6rem;
        width: max-content;
        animation: pro-ticker-run 30s linear infinite;
    }

    .pro-ticker-item {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--pro-text-2);
        white-space: nowrap;
    }

    .pro-ticker-item i { font-style: normal; color: var(--pro-amber); margin-left: 2.6rem; }

    @keyframes pro-ticker-run {
        from { transform: translateX(0); }
        to   { transform: translateX(-50%); }
    }

    @media (prefers-reduced-motion: reduce) {
        .pro-ticker-track { animation: none; }
    }

    /* === BROWSERS === */
    .pro-browser { max-width: 1320px; margin: 0 auto; padding: 4rem 1.6rem 1rem; }

    .pro-browser-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--pro-line);
    }

    .pro-browser-kicker {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--pro-amber);
        margin: 0 0 0.5rem;
    }

    .pro-browser-title {
        font-family: var(--pro-font);
        font-size: clamp(1.7rem, 3.2vw, 2.5rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--pro-text);
        margin: 0;
    }

    .pro-card-link { font-size: 0.85rem; font-weight: 500; color: var(--pro-text-2); text-decoration: none; transition: color 0.2s; }
    .pro-card-link:hover { color: var(--pro-amber); }

    .pro-browser-empty { grid-column: 1 / -1; text-align: center; font-style: italic; color: var(--pro-text-3); padding: 3rem 0; }

    /* work cards — dark, amber accent */
    .pro-work-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .pro-work-card {
        display: flex;
        flex-direction: column;
        background: #0b0e11;
        border: 1px solid var(--pro-line);
        border-radius: 16px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition: transform 0.4s var(--pro-ease, ease), border-color 0.3s, box-shadow 0.4s;
    }

    .pro-work-card:hover {
        transform: translateY(-7px);
        border-color: rgba(255, 106, 0, 0.45);
        box-shadow: 0 26px 60px rgba(0, 0, 0, 0.5), 0 0 40px rgba(255, 106, 0, 0.05);
    }

    .pro-work-card.is-poem { border-color: rgba(46, 230, 168, 0.14); }
    .pro-work-card.is-poem:hover { border-color: rgba(46, 230, 168, 0.4); box-shadow: 0 26px 60px rgba(0, 0, 0, 0.5), 0 0 40px rgba(46, 230, 168, 0.05); }

    .pro-work-cover { position: relative; height: 200px; overflow: hidden; background: #101418; }

    .pro-work-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        display: block;
        transition: transform 0.6s var(--pro-ease, ease);
    }

    .pro-work-card:hover .pro-work-cover img { transform: scale(1.05); }

    .pro-work-star {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--pro-amber);
        background: radial-gradient(80% 100% at 50% 0%, rgba(255, 106, 0, 0.12), transparent 70%), #101418;
    }

    .pro-work-quote {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.4rem;
        font-family: var(--pro-font-read);
        font-style: italic;
        font-size: 0.92rem;
        line-height: 1.7;
        text-align: center;
        color: var(--pro-text-2);
        background: #101418;
    }

    .pro-work-reserved {
        position: absolute;
        top: 0.7rem;
        right: 0.7rem;
        font-size: 0.58rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #1a0d00;
        background: var(--pro-amber);
        border-radius: 999px;
        padding: 0.22rem 0.6rem;
    }

    .pro-work-body { padding: 1.15rem 1.25rem 1.2rem; display: flex; flex-direction: column; gap: 0.45rem; flex: 1; }

    .pro-work-genre {
        align-self: flex-start;
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--pro-amber);
        border: 1px solid rgba(255, 106, 0, 0.35);
        border-radius: 999px;
        padding: 0.18rem 0.6rem;
    }

    .pro-work-genre.poem { color: var(--pro-mint); border-color: rgba(46, 230, 168, 0.35); }

    .pro-work-title {
        font-family: var(--pro-font);
        font-size: 1.08rem;
        font-weight: 600;
        line-height: 1.25;
        color: var(--pro-text);
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        overflow-wrap: anywhere;
    }

    .pro-work-meta {
        font-size: 0.74rem;
        color: var(--pro-text-3);
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        border-top: 1px solid var(--pro-line);
        padding-top: 0.7rem;
        margin-top: auto;
    }

    @media (max-width: 640px) {
        .pro-hero { grid-template-columns: 1fr; min-height: 0; padding-top: 2rem; gap: 1rem; }
        .pro-hero-plate-side { padding: 0 0 1rem; }
        .pro-plate { width: min(92%, 360px); }
        .pro-browser { padding: 3rem 1rem 0.5rem; }
        .pro-work-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
    }

    @media (prefers-reduced-motion: reduce) {
        .pro-work-card:hover { transform: none; }
        .pro-work-card:hover .pro-work-cover img { transform: none; }
    }

    /* === QUOTE INTERLUDE === */
    .pro-interlude {
        max-width: 900px;
        margin: 0 auto;
        padding: 4.5rem 1.6rem;
        text-align: center;
    }

    .pro-interlude p {
        font-family: var(--pro-font-read);
        font-style: italic;
        font-size: clamp(1.3rem, 2.8vw, 1.9rem);
        line-height: 1.5;
        color: var(--pro-text);
        max-width: 30ch;
        margin: 0 auto 1.2rem;
        transition: opacity 0.6s ease;
    }

    .pro-interlude cite {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--pro-amber);
        transition: opacity 0.6s ease;
    }

    /* === STATS === */
    .pro-stats-band {
        display: flex;
        justify-content: space-around;
        gap: 1.5rem;
        flex-wrap: wrap;
        max-width: 1320px;
