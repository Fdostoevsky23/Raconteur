---
// src/pages/pro/index.astro · Raconteur Pro homepage ("The Reader's Desk").
// Feature parity with the classic homepage — hero with rotating words and
// plates, ticker, curated browsers (reserved editor slot + three random
// writers), quote interlude, stats — expressed in Pro's dark desk language.
// Everything the classic home has; nothing Pro invented.
import ProLayout from '../../layouts/ProLayout.astro';
import Icon from '../../components/Icon.astro';
import { getVisibleStories } from '../../data/stories';
import { supabase } from '../../lib/supabase';
import { buildStoryFromDB } from '../../lib/storyLoader';
import { curate, dayOfYearNow } from '../../lib/curate';

const DAY_MS = 86400000;

// 1. Static stories
const staticStories = getVisibleStories();

// 2. Published DB stories (same query as classic home)
const { data: dbRows } = await supabase
    .from('stories')
    .select('*')
    .eq('status', 'published')
    .order('created_at', { ascending: false });
const dbStories = (dbRows || []).map(buildStoryFromDB);

// 3. Merge — DB first (newest first)
const stories = [...dbStories, ...staticStories];
const totalWords = stories.reduce((sum, s) => sum + s.wordCount, 0);
const poems = stories.filter(s => (s as any).kind === 'poem' || s.genre === 'Poetry');
const prose = stories.filter(s => !((s as any).kind === 'poem' || s.genre === 'Poetry'));

// Curated browsers via the shared house engine (1 reserved + 3 random writers)
const daySeed = dayOfYearNow() * 2654435761;
const prosePool = [...prose].sort((a: any, b: any) => new Date(b.publishedDate).getTime() - new Date(a.publishedDate).getTime());
const poemPool = [...poems].sort((a: any, b: any) => new Date(b.publishedDate).getTime() - new Date(a.publishedDate).getTime());
const deskShelf = curate(prosePool, 4, daySeed);
const verseShelf = curate(poemPool, 4, daySeed);

// Hero plates — the full 13-image library, crossfading every 10s
const heroImageCount = 13;
const heroPlates = Array.from({ length: heroImageCount }, (_, i) => `/hero/${i + 1}.jpg`);

// Rotating hero headlines — the classic words
const heroHeadlines = [
    ['Stories,', 'beautifully told.'],
    ['Poetry,', 'written with soul.'],
    ['A warm shelf for', 'unforgettable literature.'],
    ['Settle in.', 'Stay a while.'],
    ['Every story here was written', 'to be remembered.'],
    ['Every poetry here was written', 'to be loved.'],
];

// Ticker — the print strip
const tickerItems = [
    'Literature you want to read',
    `${stories.length} works on the shelf`,
    `${totalWords.toLocaleString()} words and counting`,
    'No algorithms · No noise · No slush pile',
    'Writers publish instantly',
];

// Quote interlude
const interludeQuotes = [
    { text: 'A reader lives a thousand lives before he dies. The man who never reads lives only one.', cite: 'George R.R. Martin' },
    { text: 'There is no friend as loyal as a book.', cite: 'Ernest Hemingway' },
    { text: 'A word after a word after a word is power.', cite: 'Margaret Atwood' },
    { text: 'We read to know we are not alone.', cite: 'William Nicholson' },
    { text: 'I have always imagined that Paradise will be a kind of library.', cite: 'Jorge Luis Borges' },
    { text: 'Books are a uniquely portable magic.', cite: 'Stephen King' },
    { text: 'Until I feared I would lose it, I never loved to read. One does not love breathing.', cite: 'Harper Lee' },
    { text: 'A room without books is like a body without a soul.', cite: 'Marcus Tullius Cicero' },
    { text: 'The world was hers for the reading.', cite: 'Betty Smith' },
    { text: 'Literature is the most agreeable way of ignoring life.', cite: 'Fernando Pessoa' },
    { text: 'There is nothing to writing. All you do is sit down at a typewriter and bleed.', cite: 'Ernest Hemingway' },
    { text: 'Fill your paper with the breathings of your heart.', cite: 'William Wordsworth' },
];
const firstQuote = interludeQuotes[Math.floor(Math.random() * interludeQuotes.length)];

// ===== Featured writers of the day (admin spotlight + two rotating writers) =====
import giants from '../../data/giants.json';
import authorsData from '../../data/authors.json';

const adminAuthor = {
    name: 'Nzan Kikon',
    avatarUrl: '/avatars/nzan-kikon.jpg',
    avatarInitials: 'NK',
    role: 'The editor\u2019s desk',
    place: 'Kohima, Nagaland',
    bio: 'Nzan Kikon is a writer based in Kohima, Nagaland. He is the author of The Starry Night, The Unlikely Indians, Loving Lauren & Lauren and Raindrops of Dostoevsky. He enjoys reading, gazing at the night sky, spending time alone, and watching sci-fi movies. His personal heroes include Dostoevsky, Camus, Von Neumann, Van Gogh, Carl Jung, and Carl Sagan. A humanist and existentialist at heart, Nzan immerses himself in a variety of fields for pleasure, with his top five being science particularly physics and cosmology, philosophy, psychology, human and artificial intelligence, and mythology.',
    favoriteLine: 'Remember that I am thy creature; I ought to be thy Adam, but I am rather the fallen angel, whom thou drivest from joy for no misdeed. Everywhere I see bliss, from which I alone am irrevocably excluded. I was benevolent and good, misery made me a fiend. Make me happy, and I shall again be virtuous.',
    featuredStorySlug: 'poets-from-tomorrow',
    favoriteBook: 'Frankenstein',
};

const { data: qvProfile } = await supabase.from('profiles').select('bio, book_recs').eq('pen_name', 'Quite Verbose').maybeSingle();
const { data: mwProfile } = await supabase.from('profiles').select('bio, book_recs').eq('pen_name', 'Mr. Wordy').maybeSingle();

const resolveFeatured = (name: string, slug: string, title: string) => {
    if (dbStories.some((x) => x.slug === slug) || stories.some((x: any) => x.slug === slug)) {
        return { featuredStorySlug: slug, featuredStoryTitle: title };
    }
    const own = dbStories.find((x) => x.author === name);
    if (own) return { featuredStorySlug: own.slug, featuredStoryTitle: own.title };
    return { featuredStorySlug: null as string | null, featuredStoryTitle: title };
};

const rotatingWriters = [
    {
        name: 'Quite Verbose',
        role: 'Community writer',
        bio: qvProfile?.bio || 'I am Qverbose and I love reading and writing.',
        avatarUrl: '/avatars/quite-verbose.jpg',
        avatarInitials: 'QV',
        place: 'The Raconteur Community',
        joinedDate: 'August 2026',
        totalWords: 500,
        favoriteLine: 'What if tomorrow makes today?',
        ...resolveFeatured('Quite Verbose', 'does-he-know', 'Does He Know?'),
        favoriteBook: qvProfile?.book_recs?.[0] || 'Brave New World',
    },
    {
        name: 'Mr. Wordy',
        role: 'Community writer',
        bio: mwProfile?.bio || 'A writer who believes in the power of words to change the world.',
        avatarUrl: '/avatars/mr-wordy.jpg',
        avatarInitials: 'MW',
        place: 'The Raconteur Community',
        joinedDate: 'August 2026',
        totalWords: 2500,
        favoriteLine: 'The city slept, but I did not.',
        ...resolveFeatured('Mr. Wordy', 'tragedies-in-silence', 'Tragedies in Silence'),
        favoriteBook: mwProfile?.book_recs?.[0] || 'Crime and Punishment',
    },
];

// ===== Bookshelf today: reserved editor pick + community covers, daily rotation =====
const altarAuthor = (authorsData as any[]).find((a: any) => a.name === 'Nzan Kikon') || (authorsData as any[])[0];
const dayIndex = Math.floor(Date.now() / DAY_MS);
const adminSlug = String(altarAuthor.name).toLowerCase().replace(/[ ]/g, '-');
const adminBooks = (altarAuthor.books as any[]) || [];

const { data: allBooks } = await supabase.from('books').select('title, cover_url, owner_id');
const booksByOwner: Record<string, any[]> = {};
(allBooks || []).forEach((b: any) => {
    (booksByOwner[b.owner_id] = booksByOwner[b.owner_id] || []).push(b);
});
const ownerIds = Object.keys(booksByOwner);
let communitySlots: any[] = [];
if (ownerIds.length > 0) {
    const pickedOwner = ownerIds[dayIndex % ownerIds.length];
    const { data: prof } = await supabase.from('profiles').select('pen_name').eq('user_id', pickedOwner).maybeSingle();
    const cName = prof?.pen_name || 'A Raconteur writer';
    const cSlug = cName.toLowerCase().replace(/[ ]/g, '-');
    communitySlots = booksByOwner[pickedOwner].slice(0, 3).map((b: any) => ({ ...b, authorName: cName, authorSlug: cSlug }));
}
const communityTitles = new Set(communitySlots.map((b: any) => String(b.title || '').toLowerCase().trim()));
let adminPick: any = null;
for (let i = 0; i < adminBooks.length; i++) {
    const candidate = adminBooks[(dayIndex + i) % adminBooks.length];
    if (!communityTitles.has(String(candidate.title || '').toLowerCase().trim())) {
        adminPick = candidate;
        break;
    }
}
if (!adminPick && adminBooks.length) adminPick = adminBooks[dayIndex % adminBooks.length];
const adminSlot = adminPick ? [{ ...adminPick, authorName: altarAuthor.name, authorSlug: adminSlug }] : [];
const mergedBooks = communitySlots.length
    ? [...adminSlot, ...communitySlots]
    : adminBooks.map((b: any) => ({ ...b, authorName: altarAuthor.name, authorSlug: adminSlug }));
const seenBooks = new Set<string>();
const shelfBooks: any[] = mergedBooks.filter((b: any) => {
    const t = String(b.title || '').toLowerCase().trim();
    if (seenBooks.has(t)) return false;
    seenBooks.add(t);
    return true;
});
const shelfKicker = communitySlots.length ? "Today's featured shelf" : "From the editor's bookshelf";

// ===== Literary giants: three featured per day =====
const giantsFirst = (dayOfYearNow() * 3) % giants.length;
const todaysGiants = [giants[giantsFirst], giants[(giantsFirst + 1) % giants.length], giants[(giantsFirst + 2) % giants.length]];
---

<ProLayout title="Raconteur Pro · The Reader's Desk" description="Literature you want to read. The Raconteur Pro desk.">
    {/* ===== HERO — the desk briefing: centered words, plate filmstrip beneath ===== */}
    <section class="pro-hero">
        <div class="pro-hero-core" data-pro-reveal>
            <p class="pro-hero-kicker">A quiet place for writers</p>
            <h1 class="pro-hero-headline">
                {heroHeadlines.map((lines, i) => (
                    <span class={`pro-hero-word ${i === 0 ? 'active' : ''}`}>{lines[0]} {lines[1]}</span>
                ))}
            </h1>
            <p class="pro-hero-lede">
                From a few hundred words to a forty-thousand-word novella and a library
                of poetry, Raconteur is where writers publish, read, and gather around
                the craft.
            </p>
            <div class="pro-hero-actions">
                <a href="/pro/stories" class="pro-btn pro-btn-amber">Begin reading</a>
                <a href="/pro/submit" class="pro-btn pro-btn-ghost">Publish a story</a>
            </div>
            <p class="pro-hero-meta">
                {stories.length} works · {totalWords.toLocaleString()} words · EST. 2026
            </p>
        </div>
        <div class="pro-filmstrip" data-pro-reveal>
            <p class="pro-strip-caption">Plate of the day · cycling every 10 seconds</p>
            <div class="pro-strip-stage">
                <img id="proStripStage" src={heroPlates[0]} alt="Plate of the day" />
            </div>
            <div class="pro-strip-row" id="proFilmstrip">
                {heroPlates.map((src, i) => (
                    <button class={`pro-strip-thumb ${i === 0 ? 'active' : ''}`} data-idx={i} aria-label={`Plate ${i + 1}`}>
                        <img src={src} alt="" loading={i < 4 ? 'eager' : 'lazy'} />
                    </button>
                ))}
            </div>
        </div>
    </section>

    {/* ===== TICKER — the print strip ===== */}
    <div class="pro-ticker" aria-hidden="true">
        <div class="pro-ticker-track">
            {[...tickerItems, ...tickerItems].map((t, i) => (
                <span class="pro-ticker-item">{t} <i>✦</i></span>
            ))}
        </div>
    </div>

    {/* ===== FRESH FROM THE DESK — curated prose (reserved + 3 writers) ===== */}
    <section class="pro-browser">
        <header class="pro-browser-head" data-pro-reveal>
            <div>
                <p class="pro-browser-kicker">From the desk</p>
                <h2 class="pro-browser-title">Fresh from the desk</h2>
            </div>
            <a href="/pro/stories" class="pro-card-link">View the full shelf →</a>
        </header>
        <div class="pro-work-grid">
            {deskShelf.map((story: any, i: number) => (
                <a
                    href={`/pro/story/${story.slug}`}
                    class="pro-work-card"
                    data-pro-reveal
                    style={`--pro-reveal-delay: ${Math.min(i * 0.06, 0.3)}s`}
                >
                    <div class="pro-work-cover">
                        {story.cover ? (
                            <img src={story.cover} alt={`Cover of ${story.title}`} loading="lazy" />
                        ) : (
                            <span class="pro-work-star" aria-hidden="true"><Icon name="sparkle" size={30} /></span>
                        )}
                    </div>
                    <div class="pro-work-body">
                        <span class="pro-work-genre">{story.genre}</span>
                        <h3 class="pro-work-title">{story.title}</h3>
                        <div class="pro-work-meta">
                            <span>{story.author}</span>
                            <span>{story.wordCount.toLocaleString()} words · {story.readTime}</span>
                        </div>
                    </div>
                </a>
            ))}
            {deskShelf.length === 0 && (
                <p class="pro-browser-empty">The shelf is being curated. Check back soon.</p>
            )}
        </div>
    </section>

    {/* ===== FRESH POETRY — curated verse (reserved + 3 writers) ===== */}
    {verseShelf.length > 0 && (
        <section class="pro-browser">
            <header class="pro-browser-head" data-pro-reveal>
                <div>
                    <p class="pro-browser-kicker">Verse</p>
                    <h2 class="pro-browser-title">Fresh poetry</h2>
                </div>
                <a href="/pro/stories" class="pro-card-link">View the full shelf →</a>
            </header>
            <div class="pro-work-grid">
                {verseShelf.map((story: any, i: number) => (
                    <a
                        href={`/pro/story/${story.slug}`}
                        class="pro-work-card is-poem"
                        data-pro-reveal
                        style={`--pro-reveal-delay: ${Math.min(i * 0.06, 0.3)}s`}
                    >
                        <div class="pro-work-cover">
                            {story.cover ? (
                                <img src={story.cover} alt={`Cover of ${story.title}`} loading="lazy" />
                            ) : (
                                <span class="pro-work-quote">“{(story.excerpt || '').replace(/<[^>]+>/g, ' ').substring(0, 90)}…”</span>
                            )}
                        </div>
                        <div class="pro-work-body">
                            <span class="pro-work-genre poem">Poetry</span>
                            <h3 class="pro-work-title">{story.title}</h3>
                            <div class="pro-work-meta">
                                <span>{story.author}</span>
                                <span>{story.wordCount.toLocaleString()} words</span>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </section>
    )}

    {/* ===== FEATURED WRITERS OF THE DAY — the masthead roster ===== */}
    <section class="pro-writers">
        <header class="pro-browser-head" data-pro-reveal>
            <div>
                <p class="pro-browser-kicker">The masthead</p>
                <h2 class="pro-browser-title">Featured writers of the day</h2>
            </div>
        </header>
        <div class="pro-writers-grid">
            <article class="pro-writer-card lead" data-pro-reveal>
                <a href={`/pro/author/${adminAuthor.name.toLowerCase().replace(/\s+/g, '-')}`} class="pro-writer-portrait pro-writer-portrait-link">
                    {adminAuthor.avatarUrl
                        ? <img src={adminAuthor.avatarUrl} alt={`Portrait of ${adminAuthor.name}`} />
                        : <span class="pro-writer-initials">{adminAuthor.avatarInitials}</span>}
                </a>
                <div class="pro-writer-body">
                    <div class="pro-writer-namebar">
                        <h3 class="pro-writer-name"><a href={`/pro/author/${adminAuthor.name.toLowerCase().replace(/\s+/g, '-')}`} class="pro-writer-link">{adminAuthor.name}</a></h3>
                        <span class="pro-writer-tag">Admin</span>
                    </div>
                    <p class="pro-writer-place">{adminAuthor.place}</p>
                    <p class="pro-writer-bio">{adminAuthor.bio}</p>
                    <p class="pro-writer-line">“{adminAuthor.favoriteLine}”</p>
                    <div class="pro-writer-meta">
                        <span><Icon name="book" size={13} /> Favorite book: {adminAuthor.favoriteBook}</span>
                        {adminAuthor.featuredStorySlug && <a href={`/pro/story/${adminAuthor.featuredStorySlug}`} class="pro-card-link">Read their featured story →</a>}
                    </div>
                </div>
            </article>
            {rotatingWriters.map((w: any) => (
                <article class="pro-writer-card" data-pro-reveal>
                    <a href={`/pro/author/${w.name.toLowerCase().replace(/\s+/g, '-')}`} class="pro-writer-portrait pro-writer-portrait-link">
                        {w.avatarUrl
                            ? <img src={w.avatarUrl} alt={`Portrait of ${w.name}`} />
                            : <span class="pro-writer-initials">{w.avatarInitials}</span>}
                    </a>
                    <div class="pro-writer-body">
                        <div class="pro-writer-namebar">
                            <h3 class="pro-writer-name"><a href={`/pro/author/${w.name.toLowerCase().replace(/\s+/g, '-')}`} class="pro-writer-link">{w.name}</a></h3>
                        </div>
                        <p class="pro-writer-place">{w.place} · Joined {w.joinedDate}</p>
                        <p class="pro-writer-bio">{w.bio}</p>
                        <p class="pro-writer-line">“{w.favoriteLine}”</p>
                        <div class="pro-writer-meta">
                            <span><Icon name="book" size={13} /> Favorite book: {w.favoriteBook}</span>
                            <span><Icon name="edit" size={13} /> {w.totalWords.toLocaleString()} words written</span>
                            {w.featuredStorySlug && <a href={`/pro/story/${w.featuredStorySlug}`} class="pro-card-link">Read their featured story →</a>}
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </section>

    {/* ===== THE BOOKSHELF — reserved editor cover + community covers, daily rotation ===== */}
    <section class="pro-bookshelf" data-pro-reveal>
        <header class="pro-browser-head" data-pro-reveal>
            <div>
                <p class="pro-browser-kicker">{shelfKicker}</p>
                <h2 class="pro-browser-title">The bookshelf</h2>
            </div>
        </header>
        <div class="pro-book-row">
            {shelfBooks.map((b: any) => (
                <a
                    href={`/pro/author/${b.authorSlug}`}
                    class="pro-book"
                    title={`${b.title} by ${b.authorName} · visit their page`}
                >
                    {(b.cover_url || b.cover) ? (
                        <img src={b.cover_url || b.cover} alt={`Cover of ${b.title}`} loading="lazy" />
                    ) : (
                        <div class="pro-book-empty">{b.title}</div>
                    )}
                    <span class="pro-book-title">{b.title}</span>
                    <span class="pro-book-author">{b.authorName}</span>
                </a>
            ))}
            {(shelfBooks.length === 0) && (
                <p class="pro-browser-empty">The shelf is being arranged.</p>
            )}
        </div>
        <div class="pro-book-ledge" data-pro-reveal="rule"></div>
    </section>

    {/* ===== THE CANON — three giants per day, dossiers on tap ===== */}
    <section class="pro-canon" data-pro-reveal>
        <header class="pro-browser-head" data-pro-reveal>
            <div>
                <p class="pro-browser-kicker">The Eternal Canon</p>
                <h2 class="pro-browser-title">Know your literary giants</h2>
            </div>
        </header>
        <div class="pro-giant-row">
            {todaysGiants.map((g: any, i: number) => (
                <button class="pro-giant-card" data-giant={i} data-pro-reveal style={`--pro-reveal-delay: ${i * 0.08}s`}>
                    <span class="pro-giant-portrait"><img src={g.portrait} alt={`Portrait of ${g.name}`} loading="lazy" /></span>
                    <span class="pro-giant-name">{g.name}</span>
                    <span class="pro-giant-years">{g.born} – {g.died}</span>
                    <span class="pro-giant-line">“{g.greatestLine}”</span>
                    <span class="pro-giant-open">Open dossier</span>
                </button>
            ))}
        </div>
    </section>

    {/* ===== GIANTS DOSSIER MODAL ===== */}
    <div id="proGiantModal" class="pro-modal" hidden>
        <div class="pro-modal-backdrop"></div>
        <div class="pro-modal-card">
            <button class="pro-modal-close" aria-label="Close">×</button>
            <h4 class="pro-gm-name"></h4>
            <p class="pro-gm-years"></p>
            <p class="pro-gm-bio"></p>
            <div class="pro-gm-grid">
                <div><span class="pro-gm-label">Magnum Opus</span><p class="pro-gm-opus"></p></div>
                <div><span class="pro-gm-label">Active Years</span><p class="pro-gm-years-inline"></p></div>
            </div>
            <span class="pro-gm-label">Books</span>
            <p class="pro-gm-books"></p>
            <span class="pro-gm-label">A Fact Few Know</span>
            <p class="pro-gm-fact"></p>
            <blockquote class="pro-gm-line"></blockquote>
        </div>
    </div>
    {/* ===== QUOTE INTERLUDE ===== */}
    <section class="pro-interlude" data-pro-reveal>
        <blockquote>
            <p id="proQuote">{firstQuote.text}</p>
            <cite id="proCite">— {firstQuote.cite}</cite>
        </blockquote>
    </section>

    {/* ===== STATS ===== */}
    <section class="pro-stats-band">
        <div class="pro-stat" data-pro-reveal>
            <span class="pro-stat-num">{stories.length}</span>
            <span class="pro-stat-label">works published</span>
        </div>
        <div class="pro-stat" data-pro-reveal style="--pro-reveal-delay: 0.08s">
            <span class="pro-stat-num">{totalWords.toLocaleString()}</span>
            <span class="pro-stat-label">words written</span>
        </div>
        <div class="pro-stat" data-pro-reveal style="--pro-reveal-delay: 0.16s">
            <span class="pro-stat-num">∞</span>
            <span class="pro-stat-label">stories yet to come</span>
        </div>
    </section>

    {/* ===== THE READING ROOM — whispers + notes, desk language ===== */}
    <section class="pro-room" data-pro-reveal>
        <header class="pro-browser-head" data-pro-reveal>
            <div>
                <p class="pro-browser-kicker">From the community</p>
                <h2 class="pro-browser-title">The Reading Room</h2>
            </div>
        </header>
        <div class="pro-room-split">
            <div class="pro-room-half whispers">
                <h3 class="pro-room-half-title">Whispers from the Shelf</h3>
                <p class="pro-room-half-sub">Short thoughts, passing through. Gone in 7 days.</p>
                <div id="whispersList" class="pro-notes-list"></div>
                <form id="whisperForm" class="pro-note-form">
                    <input type="text" id="whisperName" class="pro-field" placeholder="Your name (optional: leave blank for a random visitor name)" maxlength="40" />
                    <textarea id="whisperInput" class="pro-field" rows="2" maxlength="140" placeholder="Share a whisper…"></textarea>
                    <span id="whisperHint" class="pro-note-hint"></span>
                    <button type="submit" class="pro-btn pro-btn-ghost pro-note-submit">Post Whisper</button>
                </form>
            </div>
            <div class="pro-room-half notes">
                <h3 class="pro-room-half-title mint">Notes Left Behind</h3>
                <p class="pro-room-half-sub">Longer thoughts, gratitude, questions. Kept for 30 days.</p>
                <div id="notesList" class="pro-notes-list"></div>
                <form id="noteForm" class="pro-note-form">
                    <input type="text" id="noteName" class="pro-field" placeholder="Your name (optional: leave blank for a random visitor name)" maxlength="40" />
                    <textarea id="noteInput" class="pro-field" rows="3" maxlength="500" placeholder="Leave a note…"></textarea>
                    <span id="noteHint" class="pro-note-hint"></span>
                    <button type="submit" class="pro-btn pro-btn-ghost pro-note-submit">Post Note</button>
                </form>
            </div>
        </div>
    </section>
</ProLayout>

<script type="application/json" id="pro-giants-data" set:html={JSON.stringify(todaysGiants).replace(/</g, '\u003c')} />

<script>
    // Plate filmstrip — 13 images, the stage swaps every 10 seconds
    const stripThumbs = Array.from(document.querySelectorAll<HTMLElement>('.pro-strip-thumb'));
    const stripStage = document.getElementById('proStripStage') as HTMLImageElement | null;
    const plateSrcs = stripThumbs.map(t => t.querySelector('img')?.src || '');
    if (stripThumbs.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let plateIdx = 0;
        setInterval(() => {
            plateIdx = (plateIdx + 1) % stripThumbs.length;
            stripThumbs.forEach((t, i) => t.classList.toggle('active', i === plateIdx));
            if (stripStage) stripStage.src = plateSrcs[plateIdx];
        }, 10000);
    }
    stripThumbs.forEach((t, i) => t.addEventListener('click', () => {
        stripThumbs.forEach((x, xi) => x.classList.toggle('active', xi === i));
        if (stripStage) stripStage.src = plateSrcs[i];
    }));

    // Hero word rotator — the classic lines, every 7 seconds
    const heroWords = Array.from(document.querySelectorAll<HTMLElement>('.pro-hero-word'));
    if (heroWords.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let wordIdx = 0;
        setInterval(() => {
            heroWords[wordIdx].classList.remove('active');
            wordIdx = (wordIdx + 1) % heroWords.length;
            heroWords[wordIdx].classList.add('active');
        }, 7000);
    }
</script>

<script>
    // RESTORED ENGINES — the r2 hero splice ate this script: quote rotator + dossier + reading room
    // Quote interlude — rotates every 8 seconds
    const quotes = JSON.parse(document.getElementById('pro-quotes-data')?.textContent || '[]');
    const quoteEl = document.getElementById('proQuote');
    const citeEl = document.getElementById('proCite');
    if (quoteEl && citeEl && quotes.length > 1) {
        let qIndex = Math.floor(Math.random() * quotes.length);
        setInterval(() => {
            qIndex = (qIndex + 1) % quotes.length;
            quoteEl.style.opacity = '0';
            citeEl.style.opacity = '0';
            setTimeout(() => {
                quoteEl.textContent = quotes[qIndex].text;
                citeEl.textContent = '— ' + quotes[qIndex].cite;
                quoteEl.style.opacity = '1';
                citeEl.style.opacity = '1';
            }, 600);
        }, 8000);
    }

    // Giants dossier modal
    const giantsData = JSON.parse(document.getElementById('pro-giants-data')?.textContent || '[]');
    const giantModal = document.getElementById('proGiantModal');
    function fillGiant(i: number) {
        const g = giantsData[i];
        if (!g || !giantModal) return;
        giantModal.querySelector('.pro-gm-name')!.textContent = g.name;
        giantModal.querySelector('.pro-gm-years')!.textContent = `${g.born} – ${g.died} · Active ${g.active}`;
        giantModal.querySelector('.pro-gm-bio')!.textContent = g.bio;
        giantModal.querySelector('.pro-gm-opus')!.textContent = g.magnumOpus;
        giantModal.querySelector('.pro-gm-years-inline')!.textContent = g.active;
        giantModal.querySelector('.pro-gm-books')!.textContent = g.books.join(' · ');
        giantModal.querySelector('.pro-gm-fact')!.textContent = g.unknownFact;
        giantModal.querySelector('.pro-gm-line')!.textContent = '“' + g.greatestLine + '”';
    }
    document.querySelectorAll('.pro-giant-card').forEach((tile, i) => {
        tile.addEventListener('click', () => {
            fillGiant(i);
            giantModal?.removeAttribute('hidden');
            document.body.style.overflow = 'hidden';
        });
    });
    function closeGiant() {
        giantModal?.setAttribute('hidden', '');
        document.body.style.overflow = '';
    }
    giantModal?.querySelector('.pro-modal-close')?.addEventListener('click', closeGiant);
    giantModal?.addEventListener('click', (e) => { if (e.target === giantModal) closeGiant(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeGiant(); });

    // ===== The Reading Room — whispers + notes (faithful clone of classic) =====
    import { supabase } from '../../lib/supabase';
    import { dvToast } from '../../lib/dialog';
    import { iconSvg } from '../../lib/icons';
    import { esc } from '../../lib/escape';

    function timeAgo(iso: string): string {
        const m = Math.floor((Date.now() - new Date(iso).getTime()) / 60000);
        if (m < 1) return 'just now';
        if (m < 60) return m + 'm ago';
        const h = Math.floor(m / 60);
        if (h < 24) return h + 'h ago';
        return Math.floor(h / 24) + 'd ago';
    }

    const BLOCKED_WORDS = ['fuck','shit','ass','bitch','cunt','dick','pussy','nigger','faggot','retard'];
    function isVulgar(text: string): boolean {
        const words: string[] = (text.toLowerCase().match(/[a-z']+/g) || []);
        return BLOCKED_WORDS.some(w => words.includes(w));
    }

    const VISITOR_NAMES = ['Wandering Reader','Quiet Guest','Night Owl','Book Wanderer','Shelf Browser','Page Turner','Ink Dreamer','Story Seeker'];

    async function loadNotes(type: 'whisper' | 'note', listId: string) {
        const { data: notes } = await supabase
            .from('community_notes')
            .select('*')
            .eq('note_type', type)
            .gt('expires_at', new Date().toISOString())
            .order('created_at', { ascending: true });
        const list = document.getElementById(listId)!;
        if (!notes || notes.length === 0) {
            list.innerHTML = `<p class="pro-notes-empty">No ${type === 'whisper' ? 'whispers' : 'notes'} yet. Be the first.</p>`;
            return;
        }
        const byParent: Record<string, any[]> = {};
        notes.forEach(n => {
            const key = n.parent_id || 'root';
            (byParent[key] ||= []).push(n);
        });
        const renderNote = (n: any, isReply: boolean): string => {
            const replies = (byParent[n.id] || []).map(r => renderNote(r, true)).join('');
            const replyBtn = (!isReply && type === 'note')
                ? `<button class="pro-note-reply" data-id="${esc(n.id)}" data-name="${esc(n.display_name)}">Reply</button>`
                : '';
            const reportBtn = `<button class="pro-note-report" data-id="${esc(n.id)}" data-type="${type}" aria-label="Report">${iconSvg('flag', 12)}</button>`;
            return `
                <div class="pro-note-card ${isReply ? 'reply' : ''}" data-id="${esc(n.id)}">
                    <p class="pro-note-body">${esc(n.body)}</p>
                    <div class="pro-note-meta">
                        <span class="pro-note-author">— ${esc(n.display_name)}</span>
                        <span class="pro-note-time">${timeAgo(n.created_at)}</span>
                        ${replyBtn}${reportBtn}
                    </div>
                    ${replies ? `<div class="pro-note-replies">${replies}</div>` : ''}
                </div>`;
        };
        const topLevel = (byParent['root'] || []).reverse();
        list.innerHTML = topLevel.map(n => renderNote(n, false)).join('');
        list.querySelectorAll('.pro-note-report').forEach(btn => {
            btn.addEventListener('click', () => openReportModal((btn as HTMLElement).dataset.id!, (btn as HTMLElement).dataset.type!));
        });
        if (type === 'note') {
            list.querySelectorAll('.pro-note-reply').forEach(btn => {
                btn.addEventListener('click', () => {
                    const input = document.getElementById('noteInput') as HTMLTextAreaElement;
                    input.value = `@${(btn as HTMLElement).dataset.name} `;
                    input.focus();
                    input.dataset.replyTo = (btn as HTMLElement).dataset.id!;
                    const hint = document.getElementById('noteHint');
                    if (hint) hint.textContent = 'Replying. Post to send.';
                });
            });
        }
    }

    async function postNote(type: 'whisper' | 'note', inputId: string, listId: string): Promise<boolean> {
        const input = document.getElementById(inputId) as HTMLTextAreaElement;
        const body = input.value.trim();
        if (!body) return false;
        if (isVulgar(body)) {
            dvToast('Please keep it kind. Raconteur is a quiet place.');
            return false;
        }
        const nameEl = document.getElementById(type === 'whisper' ? 'whisperName' : 'noteName') as HTMLInputElement;
        const displayName = (nameEl && nameEl.value.trim()) ? nameEl.value.trim()
            : (type === 'whisper' ? 'Anonymous' : VISITOR_NAMES[Math.floor(Math.random() * VISITOR_NAMES.length)]);
        const days = type === 'whisper' ? 7 : 30;
        const payload: any = {
            note_type: type,
            body,
            display_name: displayName,
            expires_at: new Date(Date.now() + days * 86400000).toISOString(),
        };
        const parentId = (input as any).dataset.replyTo || null;
        if (parentId) payload.parent_id = parentId;
        const { error } = await supabase.from('community_notes').insert(payload);
        if (error) { console.error('postNote error:', error); dvToast('Something went wrong. Please try again.'); return false; }
        delete (input as any).dataset.replyTo;
        const hint = document.getElementById(type === 'whisper' ? 'whisperHint' : 'noteHint');
        if (hint) hint.textContent = '';
        input.value = '';
        if (nameEl) nameEl.value = '';
        loadNotes(type, listId);
        return true;
    }

    loadNotes('whisper', 'whispersList');
    loadNotes('note', 'notesList');

    let lastWhisper = 0;
    const WHISPER_COOLDOWN = 15000;
    document.getElementById('whisperForm')!.addEventListener('submit', async (e) => {
        e.preventDefault();
        const now = Date.now();
        const btn = document.querySelector('#whisperForm button[type="submit"]') as HTMLButtonElement;
        const hint = document.getElementById('whisperHint');
        if (now - lastWhisper < WHISPER_COOLDOWN) {
            const wait = Math.ceil((WHISPER_COOLDOWN - (now - lastWhisper)) / 1000);
            if (hint) hint.textContent = `Wait ${wait}s before another whisper.`;
            return;
        }
        if (btn) { btn.disabled = true; btn.textContent = 'Wait a moment…'; }
        const ok = await postNote('whisper', 'whisperInput', 'whispersList');
        if (ok) {
            lastWhisper = now;
            setTimeout(() => { if (btn) { btn.disabled = false; btn.textContent = 'Post Whisper'; } if (hint) hint.textContent = ''; }, WHISPER_COOLDOWN);
        } else {
            if (btn) { btn.disabled = false; btn.textContent = 'Post Whisper'; }
        }
    });

    let lastNote = 0;
    const NOTE_COOLDOWN = 15000;
    document.getElementById('noteForm')!.addEventListener('submit', async (e) => {
        e.preventDefault();
        const now = Date.now();
        const btn = document.querySelector('#noteForm button[type="submit"]') as HTMLButtonElement;
        const hint = document.getElementById('noteHint');
        if (now - lastNote < NOTE_COOLDOWN) {
            const wait = Math.ceil((NOTE_COOLDOWN - (now - lastNote)) / 1000);
            if (hint) hint.textContent = `Wait ${wait}s before another note.`;
            return;
        }
        if (btn) { btn.disabled = true; btn.textContent = 'Wait a moment…'; }
        const ok = await postNote('note', 'noteInput', 'notesList');
        if (ok) {
            lastNote = now;
            setTimeout(() => { if (btn) { btn.disabled = false; btn.textContent = 'Post Note'; } if (hint) hint.textContent = ''; }, NOTE_COOLDOWN);
        } else {
            if (btn) { btn.disabled = false; btn.textContent = 'Post Note'; }
        }
    });

    // Report modal — dark glass
    function openReportModal(targetId: string, targetType: string) {
        let modal = document.getElementById('proRoomReportModal');
        if (!modal) {
            modal = document.createElement('div');
            modal.id = 'proRoomReportModal';
            modal.className = 'pro-modal';
            modal.innerHTML = `
                <div class="pro-modal-backdrop"></div>
                <div class="pro-modal-card">
                    <button class="pro-modal-close" aria-label="Close">×</button>
                    <h3 class="pro-gm-name" style="font-size:1.2rem;">Report this ${targetType}</h3>
                    <p class="pro-report-sub">Help keep Raconteur quiet and kind.</p>
                    <select id="proReportReason" class="pro-field">
                        <option value="spam">Spam or advertising</option>
                        <option value="harassment">Harassment or abuse</option>
                        <option value="other">Something else</option>
                    </select>
                    <div class="pro-report-actions">
                        <button id="proReportCancel" class="pro-btn pro-btn-ghost">Cancel</button>
                        <button id="proReportSubmit" class="pro-btn pro-btn-amber">Submit report</button>
                    </div>
                    <p id="proReportMsg" class="pro-report-msg"></p>
                </div>`;
            document.body.appendChild(modal);
            modal.querySelector('.pro-modal-close')!.addEventListener('click', () => modal!.setAttribute('hidden', ''));
            modal.querySelector('.pro-modal-backdrop')!.addEventListener('click', () => modal!.setAttribute('hidden', ''));
        }
        const reasonSel = document.getElementById('proReportReason') as HTMLSelectElement;
        const msg = document.getElementById('proReportMsg')!;
        const submitBtn = document.getElementById('proReportSubmit')!;
        reasonSel.value = 'spam';
        msg.textContent = '';
        modal.removeAttribute('hidden');
        submitBtn.onclick = async () => {
            submitBtn.textContent = 'Sending...';
            const { data: { session } } = await supabase.auth.getSession();
            const { error } = await supabase.from('reports').insert({
                reporter_id: session?.user.id || null,
                target_type: targetType,
                target_id: targetId,
                reason: reasonSel.value,
            });
            if (error) { msg.textContent = 'Something went wrong.'; msg.style.color = '#ff6b6b'; }
            else { msg.textContent = 'Thank you. We will look into it.'; msg.style.color = '#2ee6a8'; }
            submitBtn.textContent = 'Submit report';
            setTimeout(() => modal!.setAttribute('hidden', ''), 1400);
        };
    }
</script>

<script type="application/json" id="pro-quotes-data" set:html={JSON.stringify(interludeQuotes).replace(/</g, '\u003c')} />

<style>
