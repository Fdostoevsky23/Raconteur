{/* Chart area gradient — defined once, referenced by the growth chart */}
<svg width="0" height="0" aria-hidden="true" style="position:absolute">
    <defs>
        <linearGradient id="proGrowthFill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="rgba(46, 230, 168, 0.32)" />
            <stop offset="100%" stop-color="rgba(46, 230, 168, 0)" />
        </linearGradient>
    </defs>
</svg>

<script>
    // Chart window filters — re-slice the 12-month series client-side.
    const deskCard = document.querySelector('.pro-desk-card');
    const filterBtns = document.querySelectorAll('.pro-filter');
    const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (deskCard && filterBtns.length) {
        const svg = deskCard.querySelector('.pro-growth-svg');
        const areaEl = svg?.querySelector('.pro-growth-area');
        const lineEl = svg?.querySelector('.pro-growth-line');
        const monthsEl = deskCard.querySelector('.pro-chart-months');

        const labels = Array.from(monthsEl?.children || []).map(s => s.textContent?.trim() || '');
        const parsePoints = (attr: string) => (attr || '').split(/\s+/).filter(Boolean).map(p => p.split(',').map(Number));

        const render = (windowCount: number) => {
            if (!lineEl || !areaEl) return;
            const pts = parsePoints(lineEl.getAttribute('points') || '');
            if (!pts.length) return;
            const slice = pts.slice(-windowCount);
            const W = 100, H = 40, PAD = 2;
            const line = slice.map(p => `${p[0]},${p[1]}`).join(' ');
            const area = `M${slice[0][0]},${H - PAD} L` + line.split(' ').join(' L') + ` L${slice[slice.length - 1][0]},${H - PAD} Z`;
            lineEl.setAttribute('points', line);
            areaEl.setAttribute('d', area);
            if (monthsEl) {
                const lab = labels.slice(-windowCount);
                monthsEl.innerHTML = lab.map(l => `<span>${l}</span>`).join('');
            }
        };

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                const w = btn.getAttribute('data-window');
                const n = w === 'month' ? 2 : w === 'quarter' ? 3 : w === 'half' ? 6 : 12;
                render(n);
            });
        });

        // Chart line draw-in on first reveal (skipped for reduced motion)
        if (!REDUCED && lineEl) {
            const line = lineEl as SVGPolylineElement;
            const len = line.getTotalLength();
            line.style.strokeDasharray = `${len}`;
            line.style.strokeDashoffset = `${len}`;
            requestAnimationFrame(() => {
                line.style.transition = 'stroke-dashoffset 1.4s cubic-bezier(0.2, 0.7, 0.2, 1)';
                line.style.strokeDashoffset = '0';
            });
        }
    }
</script>
</style>
