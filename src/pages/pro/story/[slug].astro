---
// src/pages/pro/story/[slug].astro — Raconteur+ story reader ("the dark desk" edition).
// Every feature of the classic reader, faithfully cloned; presented in Pro's
// language: a dark reading sheet on the ledger night — the skin's one focal
// surface — with amber applause, quiet chapter pager, three sheet themes.
import ProLayout from '../../../layouts/ProLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getAllStorySlugs, getStoryBySlug, getVisibleStories } from '../../../data/stories';
import { supabase } from '../../../lib/supabase';
import { buildStoryFromDB } from '../../../lib/storyLoader';
import { esc } from '../../../lib/escape';
import { iconSvg } from '../../../lib/icons';

// (Server-rendered on every request — slugs are static names or DB uuids.)
const { slug } = Astro.params;
const slugValue = slug ?? '';

// 1. Static file first
let story = getStoryBySlug(slugValue);

// 2. Database UUID?
if (!story) {
    const { data: dbRow } = await supabase
        .from('stories')
        .select('*')
        .eq('id', slugValue)
        .eq('status', 'published')
        .single();

    if (dbRow) {
        story = buildStoryFromDB(dbRow);
        const { data: readRow } = await supabase
            .from('reads_public')
            .select('read_count')
            .eq('story_id', slugValue)
            .maybeSingle();
        (story as any).readCount = readRow?.read_count ?? 0;
    }
}

// All published DB stories for merge + keyboard nav
const { data: dbRows } = await supabase
    .from('stories')
    .select('*')
    .eq('status', 'published');
const dbStories = (dbRows || []).map(buildStoryFromDB);

const allStories = [...getVisibleStories(), ...dbStories];
const allStorySlugs = getAllStorySlugs();
const _allSlugsForNav = [...new Set([...allStorySlugs, ...dbStories.map(s => s.slug)])];
const moreByAuthor = story ? allStories.filter((s) => s.author === story.author && s.slug !== story.slug).slice(0, 3) : [];

if (!story) {
    return Astro.redirect('/pro/stories');
}

// OpenGraph
const siteOrigin = Astro.url.origin;
const ogImage = story.cover
    ? (story.cover.startsWith('http') ? story.cover : siteOrigin + story.cover)
    : `${siteOrigin}/hero/1.jpg`;
const rawFirst = ((story as any).content?.[0]?.text || story.title) || '';
const firstLine = rawFirst.replace(/<[^>]*>/g, '').replace(/"/g, "'").replace(/\n/g, ' ').trim().slice(0, 150);
const isPoem = (story as any).genre === 'Poetry' || (story as any).kind === 'poem';
const poemLines = isPoem ? story.content.reduce((n: number, b: any) => n + ((b.text || '').split('<br>').length), 0) : 0;

// Sanitizer — identical rules to the classic reader
function renderText(t: string): string {
    let out = t || '';
    out = out.replace(/<(script|style)[\s\S]*?<\/\1>/gi, '');
    out = out.replace(/<\/?([a-zA-Z][a-zA-Z0-9]*)([^>]*)>/g, (match, tagName, attrs) => {
        const name = tagName.toLowerCase();
        const ok = ['em', 'i', 'strong', 'b', 'u', 's', 'br', 'p', 'span', 'div'];
        if (!ok.includes(name)) return '';
        if (match.startsWith('</')) return `</${name}>`;
        let cleanAttrs = '';
        if (attrs) {
            const styleMatch = attrs.match(/style\s*=\s*["']([^"']*)["']/i);
            if (styleMatch) {
                const align = styleMatch[1].match(/text-align\s*:\s*(left|center|right)/i);
                if (align) cleanAttrs = ` style="text-align: ${align[1]}"`;
            }
        }
        return `<${name}${cleanAttrs}>`;
    });
    out = out.replace(/\*([^*\n]+)\*/g, '<em>$1</em>');
    return out;
}

function safeCover(c: any): string | null {
    if (!c || typeof c !== 'string') return null;
    if (!(c.startsWith('http') || c.startsWith('/'))) return null;
    return c;
}

const coverUrl = safeCover(story.cover);
const authorSlug = story.author.toLowerCase().replace(/\s+/g, '-');
---

<ProLayout title={`${story.title} · ${story.author} · Raconteur+`} description={firstLine} ogImage={ogImage}>
    <div class="pro-progress" id="progressBar"></div>

    <article class={`pro-story ${isPoem ? 'poem-mode' : ''}`} id="storyContent">
        <script type="application/json" id="story-slugs" set:html={JSON.stringify(_allSlugsForNav).replace(/</g, '\\u003c')} />
        <script type="application/json" id="current-slug" set:html={JSON.stringify(slugValue).replace(/</g, '\\u003c')} />

        {/* === THE READING SHEET — the desk's focal surface === */}
        <div class="pro-sheet" data-pro-reveal="false">
            {/* Controls — dark bar */}
            <div class="pro-reader-controls">
                <a href="/pro/stories" class="pro-back-link">← Library</a>
                <div class="pro-controls-right">
                    <div class="pro-font-control" title="Adjust text size">
                        <span class="pro-font-label small">A</span>
                        <input type="range" id="fontSlider" min="0.9" max="1.5" step="0.05" value="1.15" aria-label="Text size" />
                        <span class="pro-font-label large">A</span>
                    </div>
                    <div class="pro-mode-switcher" role="group" aria-label="Reading mode">
                        <button type="button" data-mode="light" title="Light mode" aria-label="Light mode"><Icon name="sun" size={15} /></button>
                        <button type="button" data-mode="sepia" title="Sepia mode" aria-label="Sepia mode"><Icon name="book" size={15} /></button>
                        <button type="button" data-mode="dark" title="Dark mode" aria-label="Dark mode"><Icon name="moon" size={15} /></button>
                    </div>
                </div>
            </div>

            {/* Header */}
            <header class="pro-story-header">
                <span class={`pro-genre ${isPoem ? 'poem' : ''}`}>{story.genre}</span>
                <h1 class="pro-title">{story.title}</h1>
                <div class="pro-byline">
                    <a href={`/pro/author/${authorSlug}`} class="pro-author-link">By {story.author}</a>
                    <span class="dot">·</span>
                    <span>{story.wordCount.toLocaleString()} words</span>
                    <span class="dot">·</span>
                    <span>{isPoem ? `${poemLines} lines` : story.readTime}</span>
                    {((story as any).readCount || 0) > 0 && (
                        <>
                            <span class="dot">·</span>
                            <span>✦ {(story as any).readCount} {(story as any).readCount === 1 ? 'reader' : 'readers'}</span>
                        </>
                    )}
                </div>
                {coverUrl && (
                    <div class="pro-cover-frame">
                        <img src={coverUrl} alt={`Cover of ${story.title}`} />
                    </div>
                )}
            </header>

            {/* Body — chapter pager */}
            <div class="pro-story-body">
                {(() => {
                    const chapters = {} as any;
                    story.content.forEach((block) => {
                        const ch = block.chapter ?? 0;
                        if (!chapters[ch]) chapters[ch] = [];
                        chapters[ch].push(block);
                    });
                    const chapterKeys = Object.keys(chapters).sort((a, b) => Number(a) - Number(b));
                    const chapterCount = chapterKeys.length;

                    return chapterKeys.map((chKey, idx) => {
                        const blocks = chapters[chKey];
                        return (
                            <section
                                class={`pro-chapter ${idx === 0 ? 'active' : ''}`}
                                data-chapter={chKey}
                                style={idx === 0 ? '' : 'display: none;'}
                            >
                                {blocks.map((block: any) => {
                                    if (block.type === 'heading') {
                                        return <h2 class={`pro-heading ${block.text === '✦' ? 'divider' : ''}`}><Fragment set:html={renderText(block.text)} /></h2>;
                                    } else if (block.type === 'quote') {
                                        return <blockquote class="pro-quote"><p><Fragment set:html={renderText(block.text)} /></p></blockquote>;
                                    } else {
                                        return (
                                            <p class={`pro-para ${block.dropcap ? 'dropcap' : ''} ${block.align ? `align-${block.align}` : ''}`}>
                                                <Fragment set:html={renderText(block.text)} />
                                            </p>
                                        );
                                    }
                                })}

                                {chapterCount > 1 && (
                                    <div class="pro-chapter-nav">
                                        {idx > 0 && (
                                            <button class="pro-chapter-btn prev" data-target={idx - 1}>← Previous Chapter</button>
                                        )}
                                        {idx < chapterCount - 1 && (
                                            <button class="pro-chapter-btn next" data-target={idx + 1}>Next Chapter →</button>
                                        )}
                                        {idx === chapterCount - 1 && chapterCount > 1 && (
                                            <button class="pro-chapter-btn first" data-target={0}>↑ First Chapter</button>
                                        )}
                                    </div>
                                )}
                            </section>
                        );
                    });
                })()}
            </div>

            {/* Quiet applause — like + bookmark */}
            <div class="pro-like-row">
                <button id="likeBtn" class="pro-like-btn" type="button" aria-label="Appreciate this story">
                    <span id="likeHeart"><Icon name="heart" size={16} /></span>
                    <span id="likeCount">0</span>
                </button>
                <button id="bookmarkBtn" class="pro-like-btn" type="button" aria-label="Save for later">
                    <Icon name="bookmark" size={16} />
                    <span id="bookmarkLabel">Save</span>
                </button>
                <span id="likeHint" class="pro-like-hint"></span>
            </div>
        </div>

        {/* More by this author — dark cards */}
        {moreByAuthor.length > 0 && (
            <section class="pro-more-by">
                <h3>More by {story.author}</h3>
                <div class="pro-mba-grid">
                    {moreByAuthor.map((s) => (
                        <a href={`/pro/story/${s.slug}`} class="pro-card pro-mba-card">
                            {s.cover && <img src={s.cover} alt={`Cover of ${s.title}`} loading="lazy" />}
                            <div class="pro-mba-info">
                                <span class="pro-mba-title">{s.title}</span>
                                <span class="pro-mba-meta">{s.wordCount.toLocaleString()} words · {s.readTime}</span>
                            </div>
                        </a>
                    ))}
                </div>
                <a href={`/pro/author/${authorSlug}`} class="pro-card-link pro-mba-all">View all stories by {story.author} →</a>
            </section>
        )}

        {/* Story footer — the end-mark the completion tracker observes */}
        <footer class="pro-story-footer">
            <div class="pro-end-mark">✦ ✦</div>
            <p class="pro-end-note">Thank you for reading.</p>

            <div class="pro-share-row">
                <span class="pro-share-label">Share this story</span>
                <button type="button" class="pro-share-btn" id="shareCopy" title="Copy link"><Icon name="link" size={14} /> Copy</button>
                <a class="pro-share-btn" id="shareX" target="_blank" rel="noopener" title="Share on X" href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(story.title)}`}>𝕏</a>
                <a class="pro-share-btn" id="shareFb" target="_blank" rel="noopener" title="Share on Facebook" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}>f</a>
                <a class="pro-share-btn" id="shareMail" target="_blank" rel="noopener" title="Share by email" href={`https://mail.google.com/mail/?view=cm&fs=1&su=${encodeURIComponent(story.title)}&body=${encodeURIComponent('I thought you might enjoy this on Raconteur: ' + Astro.url.href)}`}><Icon name="mail" size={15} /></a>
                <a class="pro-share-btn" id="shareWa" target="_blank" rel="noopener" title="Share on WhatsApp" href={`https://wa.me/?text=${encodeURIComponent(story.title + ' ' + Astro.url.href)}`}>WhatsApp</a>
            </div>

            <a href="/pro/stories" class="pro-btn pro-btn-amber pro-more-btn">← More stories</a>
        </footer>

        {/* Comments */}
        <section id="commentsSection" class="pro-comments" style="display: none;">
            <h2 class="pro-comments-title"><span id="commentCount">0</span> Comments</h2>
            <form id="commentForm" class="pro-comment-form">
                <textarea id="commentBody" class="pro-comment-input" rows="3" maxlength="2000" placeholder="Leave a comment…"></textarea>
                <div class="pro-comment-form-row">
                    <span id="commentHint" class="pro-comment-hint"></span>
                    <button type="submit" class="pro-btn pro-btn-amber pro-comment-submit">Post Comment</button>
                </div>
            </form>
            <div id="commentList" class="pro-comment-list"></div>
        </section>
    </article>

    <button id="backToTop" class="pro-back-top" aria-label="Back to top" title="Back to top">↑</button>

    {/* Recommendations widget (logged-in) */}
    <div id="recsWidget" class="pro-recs" style="display:none;">
        <h3 class="pro-recs-title">Recommended for you</h3>
        <div id="recsList"></div>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": story.title,
        "author": { "@type": "Person", "name": story.author },
        "datePublished": story.publishedDate,
        "wordCount": story.wordCount,
        "description": story.excerpt,
        "image": story.cover || undefined,
        "publisher": { "@type": "Organization", "name": "Raconteur", "url": Astro.url.origin }
    })} />
</ProLayout>

<script>
    // === Chapter pager — ebook-style, one chapter per page (classic clone) ===
    (() => {
        const chapters = Array.from(document.querySelectorAll('.pro-chapter')) as HTMLElement[];
        if (chapters.length === 0) return;
        const progressBar = document.getElementById('progressBar');

        function topOf(el: HTMLElement) {
            return el.getBoundingClientRect().top + window.scrollY;
        }

        function showChapter(target: number) {
            const next = chapters[target];
            if (!next) return;
            chapters.forEach((ch) => {
                ch.classList.toggle('active', ch === next);
                ch.style.display = ch === next ? '' : 'none';
            });
            const header = document.querySelector('.pro-story-header') as HTMLElement | null;
            if (header) {
                window.scrollTo({ top: Math.max(0, topOf(header) - 80), behavior: 'auto' });
            } else {
                window.scrollTo({ top: 0, behavior: 'auto' });
            }
            if (progressBar) progressBar.style.width = '0%';
        }

        chapters.forEach((chapter) => {
            chapter.querySelectorAll<HTMLButtonElement>('.pro-chapter-btn').forEach((btn) => {
                btn.addEventListener('click', () => {
                    const target = Number(btn.dataset.target);
                    if (!Number.isNaN(target)) showChapter(target);
                });
            });
        });
    })();
</script>

<script>
    // === Likes + bookmarks (classic clone) ===
    import { supabase } from '../../../lib/supabase';
    import { iconSvg } from '../../../lib/icons';

    const likeBtn = document.getElementById('likeBtn')!;
    const likeHeart = document.getElementById('likeHeart')!;
    const likeCount = document.getElementById('likeCount')!;
    const slug = JSON.parse(document.getElementById('current-slug')?.textContent || '""');

    async function initLikes() {
        // story_id is text now — static-slug stories take likes too.

        const { count } = await supabase
            .from('likes')
            .select('id', { count: 'exact', head: true })
            .eq('story_id', slug);
        likeCount.textContent = String(count ?? 0);

        const { data: { session } } = await supabase.auth.getSession();
        let liked = false;
        if (session) {
            const { data: mine } = await supabase
                .from('likes')
                .select('id')
                .eq('story_id', slug)
                .eq('user_id', session.user.id)
                .maybeSingle();
            liked = !!mine;
        }

        const VISITOR_NAMES = ['Wandering Reader', 'Passing Stranger', 'Quiet Guest', 'Night Owl', 'Library Ghost'];
        function guestKey() { return 'raconteur_guest_' + slug; }
        function getGuest() {
            try { return JSON.parse(localStorage.getItem(guestKey()) || 'null'); } catch { return null; }
        }
        function setGuest(name: string) {
            localStorage.setItem(guestKey(), JSON.stringify({ name, liked: true }));
        }
        function clearGuest() { localStorage.removeItem(guestKey()); }

        const guest = getGuest();
        if (guest?.liked) { liked = true; }
        paint(liked);

        likeBtn.addEventListener('click', async () => {
            const { data: { session: s } } = await supabase.auth.getSession();
            if (s) {
                if (liked) {
                    await supabase.from('likes').delete().eq('story_id', slug).eq('user_id', s.user.id);
                    liked = false;
                    likeCount.textContent = String(Math.max(0, Number(likeCount.textContent) - 1));
                } else {
                    await supabase.from('likes').insert({ story_id: slug, user_id: s.user.id });
                    liked = true;
                    likeCount.textContent = String(Number(likeCount.textContent) + 1);
                    const { data: storyRow } = await supabase
                        .from('stories').select('author_id').eq('id', slug).maybeSingle();
                    if (storyRow?.author_id && storyRow.author_id !== s.user.id) {
                        await supabase.from('notifications').insert({
                            user_id: storyRow.author_id, actor_id: s.user.id, type: 'like', story_id: slug,
                        });
                    }
                }
            } else {
                if (liked) {
                    clearGuest();
                    liked = false;
                    likeCount.textContent = String(Math.max(0, Number(likeCount.textContent) - 1));
                } else {
                    const name = VISITOR_NAMES[Math.floor(Math.random() * VISITOR_NAMES.length)];
                    setGuest(name);
                    liked = true;
                    likeCount.textContent = String(Number(likeCount.textContent) + 1);
                }
            }
            paint(liked);
        });
    }

    function paint(liked: boolean) {
        likeBtn.classList.toggle('liked', liked);
        likeHeart.innerHTML = liked ? iconSvg('heart-filled', 16) : iconSvg('heart', 16);
    }

    initLikes();
</script>

<script>
    // === Bookmarks + completion + read counter (classic clone) ===
    import { supabase } from '../../../lib/supabase';

    const slug2 = JSON.parse(document.getElementById('current-slug')?.textContent || '""');
    const isDbStory2 = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(slug2);
    const bookmarkBtn = document.getElementById('bookmarkBtn')!;
    const bookmarkLabel = document.getElementById('bookmarkLabel')!;
    const likeHint2 = document.getElementById('likeHint')!;

    async function initBookmarks() {
        // story_id is text now — static-slug stories can be saved too.
        const { data: { session: bSession } } = await supabase.auth.getSession();
        if (!bSession) {
            bookmarkBtn.addEventListener('click', () => { likeHint2.textContent = 'Log in to save stories for later.'; });
            return;
        }
        let saved = false;
        const check = async () => {
            const { data } = await supabase.from('bookmarks').select('id')
                .eq('user_id', bSession.user.id).eq('story_id', slug2).maybeSingle();
            saved = !!data;
            bookmarkBtn.classList.toggle('liked', saved);
            bookmarkLabel.textContent = saved ? 'Saved' : 'Save';
        };
        await check();
        bookmarkBtn.addEventListener('click', async () => {
            if (saved) {
                await supabase.from('bookmarks').delete().eq('user_id', bSession.user.id).eq('story_id', slug2);
            } else {
                await supabase.from('bookmarks').insert({ user_id: bSession.user.id, story_id: slug2 });
            }
            await check();
        });
    }
    initBookmarks();

    // === Completion rate — the reader reached the end ===
    (async () => {
        const storyEl = document.getElementById('storyContent');
        if (!storyEl) return;
        let marked = false;
        const observer = new IntersectionObserver(async (entries) => {
            for (const entry of entries) {
                if (entry.isIntersecting && !marked) {
                    marked = true;
                    observer.disconnect();
                    try {
                        await supabase.from('reads').insert({ story_id: slug2, finished: true });
                    } catch { /* silent */ }
                }
            }
        }, { threshold: 0.9 });
        const endMark = storyEl.querySelector('.pro-story-footer') || storyEl.querySelector('.pro-end-mark');
        if (endMark) observer.observe(endMark);
    })();

    // === Read counter (one per visitor per story) ===
    (async () => {
        if (!isDbStory2) return;
        const key = 'raconteur_read_' + slug2;
        try { if (localStorage.getItem(key)) return; } catch { return; }
        const { data: { session } } = await supabase.auth.getSession();
        const payload: any = { story_id: slug2 };
        if (session) {
            payload.user_id = session.user.id;
        } else {
            let gid = localStorage.getItem('raconteur_guest_id');
            if (!gid) {
                gid = Math.random().toString(36).slice(2) + Date.now().toString(36);
                localStorage.setItem('raconteur_guest_id', gid);
            }
            payload.guest_key = gid;
        }
        const { error } = await supabase.from('reads').insert(payload);
        if (!error) { try { localStorage.setItem(key, '1'); } catch {} }
    })();
</script>

<script>
    // === Comments with replies + reports (classic clone) ===
    import { supabase } from '../../../lib/supabase';
    import { esc } from '../../../lib/escape';
    import { iconSvg } from '../../../lib/icons';

    const slug = JSON.parse(document.getElementById('current-slug')?.textContent || '""');
    const section = document.getElementById('commentsSection')!;
    const list = document.getElementById('commentList')!;
    const countEl = document.getElementById('commentCount')!;
    const form = document.getElementById('commentForm') as HTMLFormElement;
    const bodyInput = document.getElementById('commentBody') as HTMLTextAreaElement;
    const hint = document.getElementById('commentHint')!;

    let me: any = null;
    let meIsAdmin = false;

    // Interactive writes go through the dedicated write client (see lib/supabase-write.ts).
    import { restInsert } from '../../../lib/supabase-write';
    

    // Warm the write path at load — the first comment insert can otherwise sit
    // queued for seconds while the supabase client finishes initializing.

    function timeAgo(iso: string) {
        const diff = Date.now() - new Date(iso).getTime();
        const m = Math.floor(diff / 60000);
        if (m < 1) return 'just now';
        if (m < 60) return m + 'm ago';
        const h = Math.floor(m / 60);
        if (h < 24) return h + 'h ago';
        const d = Math.floor(h / 24);
        return d + 'd ago';
    }

    async function loadComments() {
        const { data: rows } = await supabase
            .from('comments')
            .select('id, body, created_at, user_id, parent_id, display_name')
            .eq('story_id', slug)
            .order('created_at', { ascending: true });
        const all = rows || [];
        countEl.textContent = String(all.length);

        const byParent: Record<string, any[]> = {};
        all.forEach(c => { const k = c.parent_id || 'root'; (byParent[k] ||= []).push(c); });

        const renderOne = (c: any, isReply: boolean): string => {
            const name = c.display_name || 'reader';
            const canDelete = me && (me.id === c.user_id || meIsAdmin);
            const replyBtn = (!isReply)
                ? `<button class="pro-c-reply" data-id="${c.id}" data-name="${esc(name)}">Reply</button>` : '';
            const delBtn = canDelete
                ? `<button class="pro-c-del" data-id="${c.id}">${iconSvg("trash", 14)}</button>` : '';
            const reportBtn = `<button class="pro-c-report" data-id="${c.id}">${iconSvg("flag", 14)}</button>`;
            const replies: string = (byParent[c.id] || []).map((r: any) => renderOne(r, true)).join('');

            const isGuest = !c.user_id;
            const avatarContent = isGuest
                ? `<span class="pro-c-guest" style="filter:hue-rotate(${(Math.abs(c.id.charCodeAt(0)) % 5) * 47}deg)">${iconSvg("feather", 14)}</span>`
                : name.substring(0, 2).toUpperCase();
            const avatarClass = isGuest ? 'pro-c-avatar guest' : 'pro-c-avatar';

            return `
              <div class="pro-c-card ${isReply ? 'reply' : ''}" data-id="${c.id}">
                <div class="pro-c-head">
                  <div class="${avatarClass}">${avatarContent}</div>
                  <div class="pro-c-meta">
                    <span class="pro-c-author">${esc(name)}</span>
                    <span class="pro-c-time">${timeAgo(c.created_at)}</span>
                  </div>
                </div>
                <p class="pro-c-body">${esc(c.body)}</p>
                <div class="pro-c-actions">${replyBtn}${delBtn}${reportBtn}</div>
                ${replies ? `<div class="pro-c-replies">${replies}</div>` : ''}
              </div>`;
        };
        list.innerHTML = (byParent['root'] || []).map(c => renderOne(c, false)).join('')
            || '<p class="pro-c-none">No comments yet. Be the first to leave one.</p>';

        list.querySelectorAll('.pro-c-del').forEach(b => b.addEventListener('click', async () => {
            const id = (b as HTMLElement).dataset.id!;
            await supabase.from('comments').delete().eq('id', id);
            loadComments();
        }));
        list.querySelectorAll('.pro-c-report').forEach(b => b.addEventListener('click', () => {
            const cid = (b as HTMLElement).dataset.id!;
            openCommentReport(cid);
        }));
        list.querySelectorAll('.pro-c-reply').forEach(b => b.addEventListener('click', () => {
            const name = (b as HTMLElement).dataset.name!;
            bodyInput.value = `@${name} `;
            bodyInput.focus();
            bodyInput.dataset.replyTo = (b as HTMLElement).dataset.id!;
            hint.textContent = 'Replying. Post to send.';
        }));
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const body = bodyInput.value.trim();
        if (!body) return;
        const parentId = bodyInput.dataset.replyTo || null;

        let userId: string | null = null;
        const VISITOR_NAMES = ['Wandering Reader', 'Passing Stranger', 'Quiet Guest', 'Night Owl', 'Library Ghost'];
        let displayName = VISITOR_NAMES[Math.floor(Math.random() * VISITOR_NAMES.length)];
        if (me) {
            userId = me.id;
            const { data: prof } = await supabase
                .from('profiles').select('pen_name').eq('user_id', me.id).maybeSingle();
            displayName = prof?.pen_name || (me.email ?? 'reader').split('@')[0];
        }

        let error: any = null;
        let newComment: any = null;
        try {
            const res: any = await Promise.race([
                restInsert('comments', {
                    story_id: slug, user_id: userId, body, parent_id: parentId, display_name: displayName,
                }, { single: true }),
                new Promise((_, rej) => setTimeout(() => rej(new Error('timeout')), 25000)),
            ]);
            error = res?.error ?? null;
            newComment = res?.data ?? null;
        } catch (e: any) {
            error = e;
        }
        if (error) { hint.textContent = error.message === 'timeout'
            ? 'The desk is busy — your comment did not post. Please try again.'
            : 'Could not post: ' + error.message; return; }

        // Notify: reply → parent comment author; top-level → story author
        let notifyUserId: string | null = null;
        if (parentId) {
            const { data: parent } = await supabase
                .from('comments').select('user_id').eq('id', parentId).maybeSingle();
            notifyUserId = parent?.user_id || null;
        } else {
            const { data: storyRow } = await supabase
                .from('stories').select('author_id').eq('id', slug).maybeSingle();
            notifyUserId = storyRow?.author_id || null;
        }
        if (notifyUserId && notifyUserId !== userId) {
            await supabase.from('notifications').insert({
                user_id: notifyUserId,
                actor_id: userId,
                type: parentId ? 'reply' : 'comment',
                story_id: slug,
                comment_id: newComment?.id || null,
                body_preview: body.slice(0, 120),
            });
        }
        bodyInput.value = '';
        delete bodyInput.dataset.replyTo;
        hint.textContent = '';
        loadComments();
    });

    function openCommentReport(commentId: string) {
        let modal = document.getElementById('commentReportModal') as HTMLDivElement | null;
        if (!modal) {
            modal = document.createElement('div');
            modal.id = 'commentReportModal';
            modal.className = 'pro-report-modal';
            modal.innerHTML = `
                <div class="pro-report-backdrop"></div>
                <div class="pro-report-card">
                    <h3>Report this comment</h3>
                    <p class="pro-report-sub">Help keep Raconteur quiet and kind.</p>
                    <select id="commentReportReason" class="pro-report-select">
                        <option value="spam">Spam or advertising</option>
                        <option value="harassment">Harassment or abuse</option>
                        <option value="other">Something else</option>
                    </select>
                    <textarea id="reportDetails" placeholder="Describe the issue…" style="display:none"></textarea>
                    <div class="pro-report-actions">
                        <button id="commentReportCancel" class="pro-btn pro-btn-ghost">Cancel</button>
                        <button id="commentReportSubmit" class="pro-btn pro-btn-amber">Submit report</button>
                    </div>
                    <p id="commentReportMsg" class="pro-report-msg"></p>
                </div>`;
            document.body.appendChild(modal);
            document.getElementById('commentReportCancel')!.addEventListener('click', () => modal!.classList.remove('open'));
            modal.querySelector('.pro-report-backdrop')!.addEventListener('click', () => modal!.classList.remove('open'));
            const reasonSelInit = document.getElementById('commentReportReason') as HTMLSelectElement;
            reasonSelInit.addEventListener('change', (e) => {
                const details = document.getElementById('reportDetails') as HTMLTextAreaElement;
                if ((e.target as HTMLSelectElement).value === 'other') {
                    details.style.display = 'block';
                    details.required = true;
                } else {
                    details.style.display = 'none';
                    details.required = false;
                    details.value = '';
                }
            });
        }
        const reasonSel = document.getElementById('commentReportReason') as HTMLSelectElement;
        const msg = document.getElementById('commentReportMsg')!;
        const submitBtn = document.getElementById('commentReportSubmit')!;
        reasonSel.value = 'spam';
        msg.textContent = '';
        modal.classList.add('open');
        submitBtn.onclick = async () => {
            submitBtn.textContent = 'Sending…';
            const { data: { session } } = await supabase.auth.getSession();
            const { error } = await supabase.from('reports').insert({
                reporter_id: session?.user.id || null,
                target_type: 'comment',
                target_id: commentId,
                reason: reasonSel.value === 'other' ? `Other: ${(document.getElementById('reportDetails') as HTMLTextAreaElement).value.trim()}` : reasonSel.value,
            });
            if (error) { msg.textContent = 'Something went wrong.'; msg.style.color = '#e05a3a'; }
            else { msg.textContent = 'Thank you. We will look into it.'; msg.style.color = '#2ee6a8'; }
            submitBtn.textContent = 'Submit report';
            setTimeout(() => modal!.classList.remove('open'), 1400);
        };
    }

    async function initComments() {
        // story_id is text now — static-slug stories take comments too.
        section.style.display = 'block';
        const { data: { session } } = await supabase.auth.getSession();
        me = session?.user || null;
        if (me) {
            const { data: myProf } = await supabase.from('profiles').select('is_admin').eq('user_id', me.id).maybeSingle();
            meIsAdmin = !!myProf?.is_admin;
        }
        if (!me) hint.textContent = 'Commenting as a Wandering Reader.';
        await loadComments();
    }

    initComments();
</script>

<script is:inline>
    // === Reader controls: progress bar, font size, reading modes, keys (classic clone) ===
    // Pro default is dark — the sheet matches the desk until the reader says otherwise.
    const savedTheme = localStorage.getItem('Raconteur-theme') || 'dark';
    document.body.dataset.theme = savedTheme;

    const progressBar = document.getElementById('progressBar');
    const storyEl = document.querySelector('.pro-story-body');
    const fontSlider = document.getElementById('fontSlider');
    const modeButtons = document.querySelectorAll('.pro-mode-switcher button');

    let currentSize = parseFloat(localStorage.getItem('Raconteur-fontsize') || '1.15');
    if (storyEl) storyEl.style.fontSize = `${currentSize}rem`;
    if (fontSlider) fontSlider.value = String(currentSize);

    window.addEventListener('scroll', () => {
        if (!progressBar) return;
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        progressBar.style.width = `${progress}%`;
    });

    let _fontRaf = null;
    let _saveTimer = null;
    const _applyFont = (v) => {
        if (!storyEl) return;
        currentSize = v;
        if (_fontRaf) cancelAnimationFrame(_fontRaf);
        _fontRaf = requestAnimationFrame(() => { storyEl.style.fontSize = `${v}rem`; });
    };
    fontSlider?.addEventListener('pointerdown', () => { document.body.classList.add('dragging'); document.documentElement.classList.add('dragging'); });
    const _endDrag = () => {
        document.body.classList.remove('dragging');
        document.documentElement.classList.remove('dragging');
        localStorage.setItem('Raconteur-fontsize', String(currentSize));
    };
    fontSlider?.addEventListener('pointerup', _endDrag);
    fontSlider?.addEventListener('pointercancel', _endDrag);
    fontSlider?.addEventListener('lostpointercapture', _endDrag);
    fontSlider?.addEventListener('input', () => {
        _applyFont(parseFloat(fontSlider.value));
        if (_saveTimer) clearTimeout(_saveTimer);
        _saveTimer = setTimeout(() => localStorage.setItem('Raconteur-fontsize', String(parseFloat(fontSlider.value))), 400);
    });
    fontSlider?.addEventListener('change', () => localStorage.setItem('Raconteur-fontsize', String(parseFloat(fontSlider.value))));

    function setActiveModeButton(mode) {
        modeButtons.forEach((btn) => {
            btn.classList.toggle('active', btn.dataset.mode === mode);
        });
    }
    setActiveModeButton(savedTheme);

    modeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
            const mode = btn.dataset.mode;
            document.body.dataset.theme = mode;
            localStorage.setItem('Raconteur-theme', mode);
            setActiveModeButton(mode);
        });
    });

    const backToTop = document.getElementById('backToTop');
    window.addEventListener('scroll', () => {
        if (!backToTop) return;
        if (window.scrollY > 600) backToTop.classList.add('visible');
        else backToTop.classList.remove('visible');
    });
    backToTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    const modeOrder = ['light', 'sepia', 'dark'];
    function cycleTheme() {
        const current = document.body.dataset.theme || 'dark';
        const idx = modeOrder.indexOf(current);
        const next = modeOrder[(idx + 1) % modeOrder.length];
        document.body.dataset.theme = next;
        localStorage.setItem('Raconteur-theme', next);
        setActiveModeButton(next);
    }

    const allSlugs = JSON.parse(document.getElementById('story-slugs')?.textContent || '[]');
    const slugValue = JSON.parse(document.getElementById('current-slug')?.textContent || '""');
    const currentSlug = allSlugs.indexOf(slugValue);

    document.addEventListener('keydown', (e) => {
        const target = e.target;
        if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA') return;
        if (e.key === 'd' || e.key === 'D') {
            e.preventDefault();
            cycleTheme();
        } else if (e.key === 'Escape') {
            window.location.href = '/pro/stories';
        } else if (e.key === 'ArrowLeft' && currentSlug > 0) {
            window.location.href = `/pro/story/${allSlugs[currentSlug - 1]}`;
        } else if (e.key === 'ArrowRight' && currentSlug < allSlugs.length - 1) {
            window.location.href = `/pro/story/${allSlugs[currentSlug + 1]}`;
        }
    });
</script>

<script>
    // === Recommendations widget (classic clone) ===
    import { supabase } from '../../../lib/supabase';
    import { esc } from '../../../lib/escape';
    (async () => {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return;
        const currentSlug = window.location.pathname.split('/').pop();
        const { data: rec } = await supabase.from('recommendations')
            .select('admin_story_id, random_story_id').eq('user_id', session.user.id).maybeSingle();
        if (!rec) return;

        const { data: myProf } = await supabase.from('profiles')
            .select('pen_name').eq('user_id', session.user.id).maybeSingle();

        const ids = [rec.admin_story_id, rec.random_story_id]
            .filter(Boolean)
            .filter((id: string) => id !== currentSlug);
        if (ids.length === 0) return;

        const { data: recStories } = await supabase.from('stories')
            .select('id, title, author_name').in('id', ids).eq('status', 'published');

        const filtered = (recStories || []).filter((s: any) => s.author_name !== myProf?.pen_name);
        if (filtered.length === 0) return;

        const widget = document.getElementById('recsWidget')!;
        const list = document.getElementById('recsList')!;
        list.innerHTML = filtered.map((s: any) =>
            `<a href="/pro/story/${esc(s.id)}" class="pro-recs-item"><span class="pro-recs-item-title">${esc(s.title)}</span><span class="pro-recs-item-author">${esc(s.author_name)}</span></a>`
        ).join('');
        widget.style.display = 'block';
    })();
</script>

