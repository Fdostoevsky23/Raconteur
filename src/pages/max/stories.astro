---
// src/pages/max/stories.astro — Raconteur Max library ("The Editorial Split" inner page).
// Bright glassmorphism: white-glass cards floating over drifting colour fields,
// with movements and effects throughout (reveal staggers, hover floats, cover zooms).
// Server logic is a faithful copy of classic /stories (feature parity).
import MaxLayout from '../../layouts/MaxLayout.astro';
import Icon from '../../components/Icon.astro';
import { getVisibleStories } from '../../data/stories';
import { supabase } from '../../lib/supabase';
import { buildStoryFromDB, bandFromWords } from '../../lib/storyLoader';

const staticStories = getVisibleStories();

const { data: dbRows } = await supabase
    .from('stories')
    .select('*')
    .eq('status', 'published')
    .order('created_at', { ascending: false });

const dbStories = (dbRows || []).map(buildStoryFromDB);

// Force every story (static + DB) to use the computed length band — poems keep 'Poetry'
const stories = [...dbStories, ...staticStories].map(s => ({
    ...s,
    genre: ((s as any).kind === 'poem' || s.genreTag === 'Poetry') ? 'Poetry' : bandFromWords(s.wordCount)
}));
const baseBands = ['Flash Fiction', 'Short Story', 'Novelette', 'Novella'];
const extra = Array.from(new Set(stories.map((s) => s.genre))).filter((g) => !baseBands.includes(g) && g !== 'Poetry');
const proseStories = stories.filter((s) => s.genre !== 'Poetry');
const poemStories = stories.filter((s) => s.genre === 'Poetry');
const genres = ['All', ...baseBands, ...extra];
const genreTags = ['All', ...Array.from(new Set(stories.map((s) => s.genreTag).filter(Boolean) as string[]))];

// Trending — most-read in the last 7 days (reads_weekly aggregate view)
const { data: weekReads } = await supabase
    .from('reads_weekly')
    .select('story_id, read_count');
const weekCounts: Record<string, number> = {};
(weekReads || []).forEach((r: any) => { weekCounts[r.story_id] = r.read_count || 0; });
const trending = (Object.entries(weekCounts)
    .sort((a, b) => b[1] - a[1])
    .map(([id, n]) => {
        const s = stories.find((st) => st.slug === id);
        return s ? { title: s.title, slug: s.slug, n } : null;
    })
    .filter(Boolean) as { title: string; slug: string; n: number }[]).slice(0, 3);
---

<MaxLayout title="The Library · Raconteur Max" description="Browse the full Raconteur shelf: flash fiction, novellas, poetry, and everything between.">
    <div class="mx-archive">
        {/* ===== Header ===== */}
        <header class="mx-archive-head" data-mx-reveal>
            <p class="mx-eyebrow">The Full Shelf</p>
            <h1 class="mx-display mx-archive-title">The Library</h1>
            <p class="mx-archive-sub">
                {stories.length} {stories.length === 1 ? 'work' : 'works'} on the shelf
            </p>
        </header>

        {/* ===== Trending — floating glass pill strip ===== */}
        {trending.length > 0 && (
            <div class="mx-glass mx-trending" data-mx-reveal style="--mx-reveal-delay: 0.06s">
                <span class="mx-trending-label">✦ Trending this week</span>
                {trending.map((t) => (
                    <a href={`/max/story/${t.slug}`} class="mx-trending-item">
                        <span class="mx-trending-title">{t.title}</span>
                        <span class="mx-trending-count">{t.n} {t.n === 1 ? 'reader' : 'readers'}</span>
                    </a>
                ))}
            </div>
        )}

        {/* ===== Controls: search + genre chips + tag chips + sort ===== */}
        <div class="mx-controls" data-mx-reveal style="--mx-reveal-delay: 0.12s">
            <div class="mx-searchbar">
                <input
                    type="search"
                    id="storySearch"
                    class="mx-searchbar-input"
                    placeholder="Search by title, author, or feeling…"
                    aria-label="Search stories"
                />
                <span class="mx-searchbar-icon" aria-hidden="true"><Icon name="search" size={16} /></span>
            </div>

            <div class="mx-chiprow" id="genreChips">
                {genres.map((g, i) => (
                    <button type="button" class={`mx-chip ${i === 0 ? 'active' : ''}`} data-genre={g}>{g}</button>
                ))}
            </div>

            <div class="mx-chiprow" id="genreTagChips">
                {genreTags.map((g, i) => (
                    <button type="button" class={`mx-chip mx-chip-tag ${i === 0 ? 'active' : ''}`} data-genretag={g}>{g}</button>
                ))}
            </div>

            <div class="mx-sortrow">
                <label for="storySort" class="mx-sort-label">Sort</label>
                <select id="storySort" class="mx-sort-select">
                    <option value="newest">Newest first</option>
                    <option value="oldest">Oldest first</option>
                    <option value="shortest">Shortest first</option>
                    <option value="longest">Longest first</option>
                </select>
            </div>
        </div>

        {/* ===== Prose grid ===== */}
        <div class="mx-grid" id="storyGrid">
            {proseStories.map((story: any, i: number) => (
                <a
                    href={`/max/story/${story.slug}`}
                    class="mx-glass mx-card"
                    data-genre={story.genre}
                    data-genretag={story.genreTag || ''}
                    data-title={story.title.toLowerCase()}
                    data-author={story.author.toLowerCase()}
                    data-excerpt={(story.excerpt || '').toLowerCase()}
                    data-words={story.wordCount}
                    data-date={story.publishedDate}
                    data-mx-reveal
                    style={`--mx-reveal-delay: ${Math.min(i * 0.05, 0.4)}s`}
                >
                    <div class="mx-card-cover">
                        {story.cover ? (
                            <img src={story.cover} alt={`Cover of ${story.title}`} loading="lazy" />
                        ) : (
                            <span class="mx-card-star" aria-hidden="true">✦</span>
                        )}
                    </div>
                    <div class="mx-card-body">
                        <span class="mx-card-genre">{story.genre}</span>
                        <h3 class="mx-card-title">{story.title}</h3>
                        <p class="mx-card-excerpt">{story.excerpt}</p>
                        <div class="mx-card-meta">
                            <span>{story.author}</span>
                            <span>{story.wordCount.toLocaleString()} words · {story.readTime}</span>
                        </div>
                    </div>
                </a>
            ))}
        </div>

        {/* ===== Poetry divider ===== */}
        {poemStories.length > 0 && (
            <div class="mx-poetry-divider" id="poetryDivider">
                <hr class="mx-rule" />
                <h2 class="mx-poetry-heading">Verse <span class="mx-poetry-star">✦</span></h2>
            </div>
        )}

        {/* ===== Poetry grid ===== */}
        <div class="mx-grid" id="poemGrid">
            {poemStories.map((story: any, i: number) => (
                <a
                    href={`/max/story/${story.slug}`}
                    class="mx-glass mx-card mx-card-poem"
                    data-genre={story.genre}
                    data-genretag={story.genreTag || ''}
                    data-title={story.title.toLowerCase()}
                    data-author={story.author.toLowerCase()}
                    data-excerpt={(story.excerpt || '').toLowerCase()}
                    data-words={story.wordCount}
                    data-date={story.publishedDate}
                    data-mx-reveal
                    style={`--mx-reveal-delay: ${Math.min(i * 0.05, 0.4)}s`}
                >
                    <div class="mx-card-cover">
                        {story.cover ? (
                            <img src={story.cover} alt={`Cover of ${story.title}`} loading="lazy" />
                        ) : (
                            <span class="mx-card-quote">“{(story.content[0]?.text || '').replace(/<[^>]+>/g, ' ').substring(0, 90)}…”</span>
                        )}
                    </div>
                    <div class="mx-card-body">
                        <span class="mx-card-genre poem">{story.genre}</span>
                        <h3 class="mx-card-title">{story.title}</h3>
                        <p class="mx-card-excerpt">{story.excerpt}</p>
                        <div class="mx-card-meta">
                            <span>{story.author}</span>
                            <span>{story.wordCount.toLocaleString()} words · Poem</span>
                        </div>
                    </div>
                </a>
            ))}
        </div>

        {/* ===== Empty state ===== */}
        <p class="mx-empty" id="emptyState" hidden>
            No stories match that search. Try another word or feeling.
        </p>

        <div class="mx-back">
            <a href="/max" class="mx-ulink">← Back to the Max edition</a>
        </div>
    </div>
</MaxLayout>

<script>
    // === Live search + genre filter + sort — faithful clone of classic /stories ===
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.mx-card'));
    const searchInput = document.getElementById('storySearch') as HTMLInputElement;
    const bandChips = Array.from(document.querySelectorAll<HTMLElement>('#genreChips .mx-chip'));
    const tagChips = Array.from(document.querySelectorAll<HTMLElement>('#genreTagChips .mx-chip'));
    const sortSelect = document.getElementById('storySort') as HTMLSelectElement;
    const emptyState = document.getElementById('emptyState')!;

    let activeBand = 'All';
    let activeTag = 'All';

    function applyFilters() {
        const query = searchInput.value.trim().toLowerCase();
        let visibleCount = 0;

        cards.forEach((card) => {
            const matchesBand = activeBand === 'All' || card.dataset.genre === activeBand;
            const matchesTag = activeTag === 'All' || card.dataset.genretag === activeTag;
            const matchesSearch =
                !query ||
                card.dataset.title!.includes(query) ||
                card.dataset.author!.includes(query) ||
                card.dataset.excerpt!.includes(query);

            const show = matchesBand && matchesTag && matchesSearch;
            card.style.display = show ? '' : 'none';
            if (show) visibleCount++;
        });

        emptyState.hidden = visibleCount !== 0;
        const anyPoemVisible = cards.some((c) => c.closest('#poemGrid') !== null && c.style.display !== 'none');
        const divider = document.getElementById('poetryDivider');
        if (divider) divider.style.display = anyPoemVisible ? 'block' : 'none';
    }

    function applySort() {
        const mode = sortSelect.value;
        ['storyGrid', 'poemGrid'].forEach((gid) => {
            const g = document.getElementById(gid);
            if (!g) return;
            const gCards = Array.from(g.querySelectorAll<HTMLElement>('.mx-card'));
            const sorted = [...gCards].sort((a, b) => {
                if (mode === 'shortest') return Number(a.dataset.words) - Number(b.dataset.words);
                if (mode === 'longest') return Number(b.dataset.words) - Number(a.dataset.words);
                if (mode === 'oldest') return (a.dataset.date ?? '').localeCompare(b.dataset.date ?? '');
                return (b.dataset.date ?? '').localeCompare(a.dataset.date ?? '');
            });
            sorted.forEach((card) => g.appendChild(card));
        });
    }

    searchInput.addEventListener('input', applyFilters);

    // Deep-link support: /max/stories?q=rain pre-fills the search (moods feature)
    const initialQuery = new URLSearchParams(window.location.search).get('q');
    if (initialQuery) {
        searchInput.value = initialQuery;
        applyFilters();
    }

    bandChips.forEach((chip) => {
        chip.addEventListener('click', () => {
            bandChips.forEach((c) => c.classList.remove('active'));
            chip.classList.add('active');
            activeBand = chip.dataset.genre!;
            applyFilters();
        });
    });

    tagChips.forEach((chip) => {
        chip.addEventListener('click', () => {
            tagChips.forEach((c) => c.classList.remove('active'));
            chip.classList.add('active');
            activeTag = chip.dataset.genretag!;
            applyFilters();
        });
    });

    sortSelect.addEventListener('change', applySort);
</script>

<style>
    /* === SHELL === */
    .mx-archive {
        position: relative;
        z-index: 1;
        max-width: 1240px;
        margin: 0 auto;
        padding: 2.6rem 1.6rem 4rem;
    }

    /* === HEADER === */
    .mx-archive-head { text-align: center; margin-bottom: 2.4rem; }

    .mx-archive-title {
        font-size: clamp(2.4rem, 5.4vw, 4rem);
        margin: 0.8rem 0 0.6rem;
    }

    .mx-archive-sub {
        font-family: var(--mx-font-read);
        font-style: italic;
        font-size: 1rem;
        color: var(--mx-ink-soft);
    }

    /* === TRENDING — floating glass pill === */
    .mx-trending {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1.1rem;
        padding: 0.85rem 1.4rem;
        border-radius: 999px;
        margin: 0 auto 2rem;
    }

    .mx-trending-label {
        font-family: var(--mx-font-display);
        font-style: italic;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--mx-vermilion);
    }

    .mx-trending-item { display: inline-flex; align-items: baseline; gap: 0.45rem; text-decoration: none; }

    .mx-trending-title {
        font-family: var(--mx-font-display);
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--mx-ink);
        border-bottom: 1px dotted rgba(216, 52, 28, 0.55);
        transition: color 0.2s;
    }

    .mx-trending-item:hover .mx-trending-title { color: var(--mx-vermilion); }
    .mx-trending-count { font-size: 0.72rem; font-style: italic; color: var(--mx-ink-faint); }

    /* === CONTROLS === */
    .mx-controls {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        margin-bottom: 2.6rem;
    }

    .mx-searchbar { position: relative; max-width: 560px; width: 100%; margin: 0 auto; }

    .mx-searchbar-input {
        width: 100%;
        padding: 0.95rem 1.3rem 0.95rem 2.7rem;
        font-size: 0.95rem;
        font-family: var(--mx-font-body);
        background: var(--mx-glass-bg);
        border: 1px solid var(--mx-glass-line);
        border-radius: 999px;
        color: var(--mx-ink);
        outline: none;
        box-shadow: var(--mx-glass-shadow), inset 0 1px 0 rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(var(--mx-glass-blur)) saturate(1.3);
        -webkit-backdrop-filter: blur(var(--mx-glass-blur)) saturate(1.3);
        transition: border-color 0.25s, box-shadow 0.25s, background 0.25s;
    }

    .mx-searchbar-input:focus {
        border-color: var(--mx-vermilion);
        background: var(--mx-glass-bg-hi);
        box-shadow: 0 24px 60px rgba(216, 52, 28, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    }

    .mx-searchbar-input::placeholder { color: var(--mx-ink-faint); }

    .mx-searchbar-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--mx-ink-faint);
        pointer-events: none;
    }

    /* === CHIPS — glass pills that pour ink when active === */
    .mx-chiprow { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }

    .mx-chip {
        padding: 0.42rem 1rem;
        font-size: 0.8rem;
        font-family: var(--mx-font-body);
        font-weight: 500;
        letter-spacing: 0.02em;
        background: var(--mx-glass-bg);
        border: 1px solid var(--mx-glass-line);
        border-radius: 999px;
        color: var(--mx-ink-soft);
        cursor: pointer;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
        transition: color 0.25s, background 0.25s, border-color 0.25s, transform 0.25s var(--mx-ease), box-shadow 0.25s;
    }

    .mx-chip:hover {
        color: var(--mx-ink);
        transform: translateY(-2px);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7), 0 10px 26px rgba(84, 62, 40, 0.12);
    }

    .mx-chip.active {
        background: var(--mx-ink);
        border-color: var(--mx-ink);
        color: var(--mx-paper);
    }

    .mx-sortrow { display: flex; align-items: center; justify-content: center; gap: 0.6rem; }

    .mx-sort-label {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--mx-ink-faint);
    }

    .mx-sort-select {
        padding: 0.5rem 1rem;
        font-family: var(--mx-font-body);
        font-size: 0.85rem;
        background: var(--mx-glass-bg);
        border: 1px solid var(--mx-glass-line);
        border-radius: 999px;
        color: var(--mx-ink);
        cursor: pointer;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .mx-sort-select option { background: #fffdf9; color: var(--mx-ink); }

    /* === GRID + CARDS: the shared .mx-grid/.mx-card family now lives in max.css (§7b) === */

    /* === POETRY DIVIDER === */
    .mx-poetry-divider { margin: 3rem 0 2rem; }
    .mx-poetry-divider .mx-rule { margin-bottom: 1.4rem; }
    .mx-poetry-heading {
        font-family: var(--mx-font-display);
        font-size: 1.9rem;
        font-weight: 900;
        text-align: center;
        color: var(--mx-ink);
    }
    .mx-poetry-star { color: var(--mx-vermilion); }

    /* === RESPONSIVE + MANNERS (page-specific; shared card rules live in max.css §7b) === */
    @media (max-width: 640px) {
        .mx-archive { padding: 1.8rem 1rem 3rem; }
    }

    @media (prefers-reduced-motion: reduce) {
        .mx-chip:hover { transform: none; }
    }
</style>
