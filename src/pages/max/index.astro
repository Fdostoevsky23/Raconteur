    }
    .mx-altar-book-title { font-family: var(--mx-font-display); font-size: 0.82rem; font-weight: 600; line-height: 1.25; }
    .mx-altar-book-author { font-size: 0.7rem; color: var(--mx-ink-faint); }

    .mx-altar-giants { border-left: 1px solid var(--mx-line); padding-left: 2rem; }
    .mx-giants-title { font-family: var(--mx-font-display); font-weight: 900; font-size: 1.5rem; color: var(--mx-ink); margin: 0.8rem 0 1.6rem; }
    .mx-giants-row { display: flex; gap: 1.6rem; flex-wrap: wrap; }
    .mx-giant {
        display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
