<script>
    // Giants modal — glass
    import { supabase } from '../../lib/supabase';
    import { dvToast } from '../../lib/dialog';
    import { iconSvg } from '../../lib/icons';
    import { esc } from '../../lib/escape';
    import { restInsert } from '../../lib/supabase-write';

    // Warm the auth/session machinery at load — the very first insert after page
    // load can otherwise hang on the client's internal session lock.
    supabase.auth.getSession().catch(() => {});

    const giantsData = JSON.parse(document.getElementById('giants-data')?.textContent || '[]');
    const giantModal = document.getElementById('mxGiantModal');
    function fillGiant(i) {
        const g = giantsData[i];
        if (!g || !giantModal) return;
        giantModal.querySelector('.mx-gm-name').textContent = g.name;
        giantModal.querySelector('.mx-gm-years').textContent = `${g.born} – ${g.died} · Active ${g.active}`;
        giantModal.querySelector('.mx-gm-bio').textContent = g.bio;
        giantModal.querySelector('.mx-gm-opus').textContent = g.magnumOpus;
        giantModal.querySelector('.mx-gm-books').textContent = g.books.join(' · ');
        giantModal.querySelector('.mx-gm-fact').textContent = g.unknownFact;
        giantModal.querySelector('.mx-gm-line').textContent = '"' + g.greatestLine + '"';
    }
    document.querySelectorAll('.mx-giant').forEach((tile, i) => {
        tile.addEventListener('click', () => {
            fillGiant(i);
            giantModal?.removeAttribute('hidden');
            document.body.style.overflow = 'hidden';
        });
    });
    function closeGiant() {
        giantModal?.setAttribute('hidden', '');
        document.body.style.overflow = '';
    }
    giantModal?.querySelector('.mx-modal-close')?.addEventListener('click', closeGiant);
    giantModal?.addEventListener('click', (e) => { if (e.target === giantModal) closeGiant(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeGiant(); });

    // Canon carousel — the three giants take turns speaking
    if (giantsData.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let canonIdx = 0;
        const lineEl = document.getElementById('mxCanonLine');
        const nameEl = document.getElementById('mxCanonName');
        const cameoEl = document.getElementById('mxCameoImg');
        const dots = Array.from(document.querySelectorAll('.mx-canon-dot'));
        const show = (i: number) => {
            const g = giantsData[i];
            if (!g || !lineEl || !nameEl) return;
            lineEl.style.opacity = '0';
            nameEl.style.opacity = '0';
            setTimeout(() => {
                lineEl.textContent = '\u201C' + g.greatestLine + '\u201D';
                nameEl.textContent = g.name + ' \u00B7 ' + g.born + '\u2013' + g.died;
                if (cameoEl) cameoEl.src = g.portrait;
                lineEl.style.opacity = '1';
                nameEl.style.opacity = '1';
            }, 400);
            dots.forEach((d, di) => d.classList.toggle('active', di === i));
        };
        setInterval(() => { canonIdx = (canonIdx + 1) % giantsData.length; show(canonIdx); }, 6500);
        dots.forEach((d, di) => d.addEventListener('click', () => { canonIdx = di; show(di); }));
        document.getElementById('mxCanonOpen')?.addEventListener('click', () => {
            fillGiant(canonIdx);
            giantModal?.removeAttribute('hidden');
            document.body.style.overflow = 'hidden';
        });
    }
</script>

<script>
    // Quote interlude — rotates every 8s
    const quotes = JSON.parse(document.getElementById('mx-quotes-data')?.textContent || '[]');
    const quoteEl = document.getElementById('mxQuote');
    const citeEl = document.getElementById('mxCite');
    if (quoteEl && citeEl && quotes.length > 1) {
        let qIndex = Math.floor(Math.random() * quotes.length);
        setInterval(() => {
            qIndex = (qIndex + 1) % quotes.length;
            quoteEl.style.opacity = '0';
            citeEl.style.opacity = '0';
            setTimeout(() => {
                quoteEl.textContent = quotes[qIndex].text;
                citeEl.textContent = '\u2014 ' + quotes[qIndex].cite;
                quoteEl.style.opacity = '1';
                citeEl.style.opacity = '1';
            }, 600);
        }, 8000);
    }

    // Stats count-up when scrolled into view
    const statNums = document.querySelectorAll('.mx-stats-band .mx-stat-num[data-target]');
    if ('IntersectionObserver' in window && statNums.length) {
        const statsIO = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target;
                const target = parseInt(el.dataset.target || '0', 10);
                const start = performance.now();
                const tick = (now) => {
                    const progress = Math.min((now - start) / 1400, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    el.textContent = Math.round(target * eased).toLocaleString();
                    if (progress < 1) requestAnimationFrame(tick);
                };
                requestAnimationFrame(tick);
                statsIO.unobserve(el);
            });
        }, { threshold: 0.5 });
        statNums.forEach((el) => statsIO.observe(el));
    }
</script>

<script>
    // The Reading Room — whispers + notes (faithful clone of classic)
    import { supabase } from '../../lib/supabase';
    // Client-side day constant (the frontmatter DAY_MS doesn't exist in module scope)
    const DAY_MS = 86400000;
    import { dvToast } from '../../lib/dialog';
    import { iconSvg } from '../../lib/icons';
    import { esc } from '../../lib/escape';
    import { restInsert } from '../../lib/supabase-write';

    function timeAgo(iso) {
        const diff = Date.now() - new Date(iso).getTime();
        const m = Math.floor(diff / 60000);
        if (m < 1) return 'just now';
        if (m < 60) return m + 'm ago';
        const h = Math.floor(m / 60);
        if (h < 24) return h + 'h ago';
        return Math.floor(h / 24) + 'd ago';
    }

    const BLOCKED_WORDS = ['fuck','shit','ass','bitch','cunt','dick','pussy','nigger','faggot','retard'];
    function isVulgar(text) {
        const words = (text.toLowerCase().match(/[a-z']+/g) || []);
        return BLOCKED_WORDS.some(w => words.includes(w));
    }

    const VISITOR_NAMES = ['Wandering Reader','Quiet Guest','Night Owl','Book Wanderer','Shelf Browser','Page Turner','Ink Dreamer','Story Seeker'];

    async function loadNotes(type, listId) {
        const { data: notes } = await supabase
            .from('community_notes')
            .select('*')
            .eq('note_type', type)
            .gt('expires_at', new Date().toISOString())
            .order('created_at', { ascending: true });
        const list = document.getElementById(listId);
        if (!notes || notes.length === 0) {
            list.innerHTML = `<p class="mx-notes-empty">No ${type === 'whisper' ? 'whispers' : 'notes'} yet. Be the first.</p>`;
            return;
        }
        const byParent = {};
        notes.forEach(n => {
            const key = n.parent_id || 'root';
            (byParent[key] = byParent[key] || []).push(n);
        });
        const renderNote = (n, isReply) => {
            const replies = (byParent[n.id] || []).map(r => renderNote(r, true)).join('');
            const replyBtn = (!isReply && type === 'note')
                ? `<button class="mx-note-reply" data-id="${esc(n.id)}" data-name="${esc(n.display_name)}">Reply</button>`
                : '';
            const reportBtn = `<button class="mx-note-report" data-id="${esc(n.id)}" data-type="${type}" aria-label="Report">${iconSvg('flag', 12)}</button>`;
            return `
                <div class="mx-note-card ${isReply ? 'reply' : ''}" data-id="${esc(n.id)}">
                    <p class="mx-note-body">${esc(n.body)}</p>
                    <div class="mx-note-meta">
                        <span class="mx-note-author">\u2014 ${esc(n.display_name)}</span>
                        <span class="mx-note-time">${timeAgo(n.created_at)}</span>
                        ${replyBtn}${reportBtn}
                    </div>
                    ${replies ? `<div class="mx-note-replies">${replies}</div>` : ''}
                </div>`;
        };
        const topLevel = (byParent['root'] || []).reverse();
        list.innerHTML = topLevel.map(n => renderNote(n, false)).join('');
        list.querySelectorAll('.mx-note-report').forEach(btn => {
            btn.addEventListener('click', () => openReportModal(btn.dataset.id, btn.dataset.type));
        });
        if (type === 'note') {
            list.querySelectorAll('.mx-note-reply').forEach(btn => {
                btn.addEventListener('click', () => {
                    const noteId = btn.dataset.id;
                    const name = btn.dataset.name;
                    const input = document.getElementById('noteInput');
                    input.value = `@${name} `;
                    input.focus();
                    input.dataset.replyTo = noteId;
                    const hint = document.getElementById('noteHint');
                    if (hint) hint.textContent = 'Replying. Post to send.';
                });
            });
        }
    }

    async function postNote(type, inputId, listId) {
        const input = document.getElementById(inputId);
        const body = input.value.trim();
        if (!body) return false;
        if (isVulgar(body)) {
            dvToast('Please keep it kind. Raconteur is a quiet place.');
            return false;
        }
        const nameEl = document.getElementById(type === 'whisper' ? 'whisperName' : 'noteName');
        const displayName = (nameEl && nameEl.value.trim()) ? nameEl.value.trim()
            : (type === 'whisper' ? 'Anonymous' : VISITOR_NAMES[Math.floor(Math.random() * VISITOR_NAMES.length)]);
        const days = type === 'whisper' ? 7 : 30;
        const payload = {
            note_type: type,
            body,
            display_name: displayName,
            expires_at: new Date(Date.now() + days * DAY_MS).toISOString(),
        };
        const parentId = input.dataset.replyTo || null;
        if (parentId) payload.parent_id = parentId;
        let error: any = null;
        try {
            const res: any = await Promise.race([
                restInsert('community_notes', payload),
                new Promise((_, rej) => setTimeout(() => rej(new Error('timeout')), 25000)),
            ]);
            error = res?.error ?? null;
        } catch (e: any) {
            error = e;
        }
        if (error) {
            console.error('postNote error:', error);
            dvToast(error.message === 'timeout'
                ? 'The desk is busy — your note did not go through. Please try again.'
                : 'Something went wrong. Please try again.');
            return false;
        }
        delete input.dataset.replyTo;
        const hint = document.getElementById(type === 'whisper' ? 'whisperHint' : 'noteHint');
        if (hint) hint.textContent = '';
        input.value = '';
        if (nameEl) nameEl.value = '';
        // Optimistic render — the reader sees their note instantly; a delayed
        // re-sync reconciles with the database in case the insert lands late.
        const listEl = document.getElementById(listId);
        if (listEl) {
            const empty = listEl.querySelector('.' + 'mx-notes-empty');
            if (empty) empty.remove();
            const card = document.createElement('div');
            card.className = 'mx-note-card';
            card.innerHTML = `<p class="mx-note-body">${esc(body)}</p>
                <div class="mx-note-meta"><span class="mx-note-author">— ${esc(displayName)}</span><span class="mx-note-time">just now</span></div>`;
            listEl.prepend(card);
        }
        loadNotes(type, listId);
        setTimeout(() => loadNotes(type, listId), 4000);
        return true;
    }

    loadNotes('whisper', 'whispersList');
    loadNotes('note', 'notesList');

    let lastWhisper = 0;
    const WHISPER_COOLDOWN = 15000;
    document.getElementById('whisperForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const now = Date.now();
        const btn = document.querySelector('#whisperForm button[type="submit"]');
        const hint = document.getElementById('whisperHint');
        if (now - lastWhisper < WHISPER_COOLDOWN) {
            const wait = Math.ceil((WHISPER_COOLDOWN - (now - lastWhisper)) / 1000);
            if (hint) hint.textContent = `Wait ${wait}s before another whisper.`;
            return;
        }
        if (btn) { btn.disabled = true; btn.textContent = 'Wait a moment\u2026'; }
        const ok = await postNote('whisper', 'whisperInput', 'whispersList');
        if (ok) {
            lastWhisper = now;
            setTimeout(() => { if (btn) { btn.disabled = false; btn.textContent = 'Post Whisper'; } if (hint) hint.textContent = ''; }, WHISPER_COOLDOWN);
        } else {
            if (btn) { btn.disabled = false; btn.textContent = 'Post Whisper'; }
        }
    });

    let lastNote = 0;
    const NOTE_COOLDOWN = 15000;
    document.getElementById('noteForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const now = Date.now();
        const btn = document.querySelector('#noteForm button[type="submit"]');
        const hint = document.getElementById('noteHint');
        if (now - lastNote < NOTE_COOLDOWN) {
            const wait = Math.ceil((NOTE_COOLDOWN - (now - lastNote)) / 1000);
            if (hint) hint.textContent = `Wait ${wait}s before another note.`;
            return;
        }
        if (btn) { btn.disabled = true; btn.textContent = 'Wait a moment\u2026'; }
        const ok = await postNote('note', 'noteInput', 'notesList');
        if (ok) {
            lastNote = now;
            setTimeout(() => { if (btn) { btn.disabled = false; btn.textContent = 'Post Note'; } if (hint) hint.textContent = ''; }, NOTE_COOLDOWN);
        } else {
            if (btn) { btn.disabled = false; btn.textContent = 'Post Note'; }
        }
    });

    // Report modal — glass
    function openReportModal(targetId, targetType) {
        let modal = document.getElementById('mxRoomReportModal');
        if (!modal) {
            modal = document.createElement('div');
            modal.id = 'mxRoomReportModal';
            modal.className = 'mx-modal';
            modal.innerHTML = `
                <div class="mx-modal-backdrop"></div>
                <div class="mx-modal-card">
                    <button class="mx-modal-close" aria-label="Close">×</button>
                    <h3 class="mx-modal-title">Report this ${targetType}</h3>
                    <p class="mx-report-sub">Help keep Raconteur quiet and kind.</p>
                    <select id="mxReportReason" class="mx-field">
                        <option value="spam">Spam or advertising</option>
                        <option value="harassment">Harassment or abuse</option>
                        <option value="other">Something else</option>
                    </select>
                    <div class="mx-report-actions">
                        <button id="mxReportCancel" class="mx-btn mx-btn-ghost">Cancel</button>
                        <button id="mxReportSubmit" class="mx-btn mx-btn-ink">Submit report</button>
                    </div>
                    <p id="mxReportMsg" class="mx-report-msg"></p>
                </div>`;
            document.body.appendChild(modal);
            modal.querySelector('.mx-modal-close').addEventListener('click', () => modal.setAttribute('hidden', ''));
            modal.querySelector('.mx-modal-backdrop').addEventListener('click', () => modal.setAttribute('hidden', ''));
        }
        const reasonSel = document.getElementById('mxReportReason');
        const msg = document.getElementById('mxReportMsg');
        const submitBtn = document.getElementById('mxReportSubmit');
        reasonSel.value = 'spam';
        msg.textContent = '';
        modal.removeAttribute('hidden');
        submitBtn.onclick = async () => {
            submitBtn.textContent = 'Sending...';
            const { data: { session } } = await supabase.auth.getSession();
            const { error } = await supabase.from('reports').insert({
                reporter_id: session?.user.id || null,
                target_type: targetType,
                target_id: targetId,
                reason: reasonSel.value,
            });
            if (error) { msg.textContent = 'Something went wrong.'; msg.style.color = '#b3261e'; }
            else { msg.textContent = 'Thank you. We will look into it.'; msg.style.color = '#2e7d32'; }
            submitBtn.textContent = 'Submit report';
            setTimeout(() => modal.setAttribute('hidden', ''), 1400);
        };
    }
</script>

<script>
    // Split browsers — hover/focus a title and its plate crossfades (shelf + poetry)
    function wireBrowser(itemSel: string, plateWrapId: string, captionId: string) {
        const items = Array.from(document.querySelectorAll<HTMLElement>(itemSel));
        const plates = Array.from(document.querySelectorAll<HTMLElement>(`#${plateWrapId} .mx-shelf-plate-img`));
        const caption = document.getElementById(captionId);
        items.forEach((item, i) => {
            const show = () => {
                plates.forEach((pl) => pl.classList.toggle('active', Number(pl.dataset.idx) === i));
                if (caption && item.dataset.genre) caption.textContent = item.dataset.genre;
            };
            item.addEventListener('mouseenter', show);
            item.addEventListener('focus', show);
        });
    }
    wireBrowser('.mx-shelf-list .mx-shelf-item', 'mxShelfPlates', 'mxShelfCaption');
    wireBrowser('.mx-poem-item', 'mxPoemPlates', 'mxPoemCaption');

    // Hero plates — the 13-image library, crossfading every 10 seconds
    const heroPlates = Array.from(document.querySelectorAll<HTMLElement>('.mx-plate-img'));
    if (heroPlates.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let heroIdx = 0;
        setInterval(() => {
            heroPlates[heroIdx].classList.remove('active');
            heroIdx = (heroIdx + 1) % heroPlates.length;
            heroPlates[heroIdx].classList.add('active');
        }, 10000);
    }

    // Hero headline rotator — the classic words, looping every 7 seconds
    const heroLines = Array.from(document.querySelectorAll<HTMLElement>('.mx-hero-line'));
    if (heroLines.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let lineIdx = 0;
        setInterval(() => {
            heroLines[lineIdx].classList.remove('active');
            lineIdx = (lineIdx + 1) % heroLines.length;
            heroLines[lineIdx].classList.add('active');
        }, 7000);
    }
</script>

