    }
    .mx-giant-portrait img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(0.85); }
    .mx-giant-name { font-family: var(--mx-font-display); font-size: 0.82rem; font-weight: 700; color: var(--mx-ink); max-width: 120px; text-align: center; line-height: 1.2; }
    .mx-giant-years { font-size: 0.66rem; color: var(--mx-ink-faint); letter-spacing: 0.08em; }

    /* Giants dossier modal */
    .mx-gm-card { max-width: 620px; }
    .mx-gm-name { font-family: var(--mx-font-display); font-size: 1.7rem; font-weight: 900; color: var(--mx-ink); margin: 0 0 0.3rem; }
    .mx-gm-years { font-size: 0.8rem; color: var(--mx-ink-faint); letter-spacing: 0.08em; margin: 0 0 1rem; }
    .mx-gm-bio { font-size: 0.95rem; line-height: 1.7; font-style: italic; color: var(--mx-ink-soft); margin: 0 0 1rem; }
    .mx-gm-grid { display: flex; gap: 2.2rem; flex-wrap: wrap; }
    .mx-gm-label { display: block; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mx-vermilion); margin: 1rem 0 0.3rem; }
    .mx-gm-opus { font-family: var(--mx-font-display); font-size: 1.05rem; font-weight: 700; color: var(--mx-ink); margin: 0; }
    .mx-gm-books, .mx-gm-fact { font-size: 0.9rem; line-height: 1.6; color: var(--mx-ink-soft); margin: 0; }
    .mx-gm-line {
        margin: 1.4rem 0 0; padding: 1.1rem 1.3rem;
        border-left: 3px solid var(--mx-vermilion); background: rgba(216, 52, 28, 0.05);
        font-family: var(--mx-font-display); font-style: italic; font-size: 1.05rem; line-height: 1.55; color: var(--mx-ink);
    }

   /* === THE BOOKSHELF — covers standing on the ledge === */
    .mx-altar { padding: 4.5rem clamp(1.4rem, 5vw, 5rem) 3rem; border-top: 1px solid var(--mx-line); }
    .mx-altar-head { text-align: center; margin-bottom: 3rem; }
    .mx-altar-title { font-size: clamp(2rem, 4vw, 3.2rem); margin: 0.9rem 0 0; }

    .mx-altar-head { text-align: center; margin-bottom: 3.2rem; }
    .mx-altar-title { font-size: clamp(2.2rem, 4.4vw, 3.4rem); margin: 0.9rem 0 0; }
    .mx-altar-sub {
        font-family: var(--mx-font-read);
        font-style: italic;
        font-size: 0.95rem;
        color: var(--mx-ink-faint);
        margin: 0.7rem 0 0;
    }

    .mx-altar-shelf {
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 2.6rem;
        flex-wrap: wrap;
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .mx-altar-book {
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        width: 158px;
        text-decoration: none;
        color: var(--mx-ink);
        transition: transform 0.35s var(--mx-ease);
    }

    .mx-altar-book:hover { transform: translateY(-8px); }

    .mx-altar-book img {
        width: 158px;
        height: 226px;
        object-fit: cover;
        object-position: top;
        display: block;
        border: 1px solid var(--mx-line-strong);
        box-shadow: 0 16px 40px rgba(28, 25, 23, 0.18);
    }

    .mx-altar-book-empty {
        width: 158px;
        height: 226px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fffdf9;
        border: 1px solid var(--mx-line-strong);
        font-family: var(--mx-font-display);
