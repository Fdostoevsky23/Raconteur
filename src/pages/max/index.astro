    }

    .mx-altar-book-title {
        font-family: var(--mx-font-display);
        font-weight: 700;
        font-size: 0.88rem;
        line-height: 1.25;
    }

    .mx-altar-book-author { font-size: 0.7rem; color: var(--mx-ink-faint); }

    .mx-spine-base {
        max-width: 980px;
        margin: 1.6rem auto 0;
        height: 7px;
        border-top: 3px solid var(--mx-ink);
        border-bottom: 1px solid var(--mx-ink);
    }

        /* === THE CANON — giants speak in their own words === */
    .mx-canon {
        padding: 4.5rem clamp(1.4rem, 5vw, 5rem);
        text-align: center;
        border-top: 1px solid var(--mx-line);
        background: var(--mx-paper-deep);
    }

    .mx-canon-eyebrow { margin-bottom: 2rem; }

    .mx-canon-stage { max-width: 760px; margin: 0 auto; }

    .mx-cameo {
        display: inline-flex;
        width: 84px;
        height: 84px;
        border-radius: 50%;
        overflow: hidden;
        border: 3px solid var(--mx-ink);
        box-shadow: 0 12px 30px rgba(28, 25, 23, 0.2);
        margin-bottom: 1.6rem;
    }

    .mx-cameo img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.3) contrast(1.05); display: block; }

    .mx-canon-line {
        font-size: clamp(1.6rem, 3.4vw, 2.6rem);
        line-height: 1.35;
        font-style: italic;
        transition: opacity 0.4s ease;
        margin: 0 0 1.2rem;
        min-height: 2.7em;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .mx-canon-name {
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--mx-vermilion);
        transition: opacity 0.4s ease;
        margin: 0 0 0.8rem;
    }

    .mx-canon-hint { font-family: var(--mx-font-read); font-style: italic; font-size: 0.78rem; color: var(--mx-ink-faint); margin: 0 0 0.6rem; }

    .mx-canon-open {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.6rem;
        height: 2.6rem;
        border-radius: 50%;
        border: 1px solid var(--mx-line-strong);
        background: #fffdf9;
        color: var(--mx-ink);
        cursor: pointer;
        transition: border-color 0.2s, color 0.2s, transform 0.2s;
    }

    .mx-canon-open:hover { border-color: var(--mx-vermilion); color: var(--mx-vermilion); transform: translateY(-2px); }

    .mx-canon-dots { display: flex; gap: 0.5rem; justify-content: center; margin-top: 1.4rem; }

    .mx-canon-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        border: 1px solid var(--mx-ink);
        background: transparent;
        cursor: pointer;
        padding: 0;
        transition: background 0.2s, transform 0.2s;
    }

    .mx-canon-dot.active { background: var(--mx-vermilion); border-color: var(--mx-vermilion); transform: scale(1.2); }

    /* === QUOTE INTERLUDE === */    /* === QUOTE INTERLUDE === */
    .mx-interlude {
        padding: 4.5rem clamp(1.4rem, 6vw, 7rem);
        text-align: center;
        border-top: 1px solid var(--mx-line);
    }
    .mx-interlude p {
        font-family: var(--mx-font-display); font-weight: 600; font-style: italic;
        font-size: clamp(1.3rem, 2.6vw, 1.9rem); line-height: 1.5;
        color: var(--mx-ink); max-width: 26ch; margin: 0 auto 1.2rem;
        transition: opacity 0.6s ease;
    }
    .mx-interlude cite {
        font-family: var(--mx-font-read); font-style: italic;
        font-size: 0.9rem; color: var(--mx-vermilion);
        transition: opacity 0.6s ease;
    }

    /* === READING ROOM === */
    .mx-room { padding: 4rem clamp(1.4rem, 5vw, 5rem) 5rem; }
    .mx-room-head { text-align: center; margin-bottom: 2.6rem; }
    .mx-room-title { font-size: clamp(2rem, 4vw, 3rem); margin: 0.9rem 0 0; }
    .mx-room-split { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; max-width: 1100px; margin: 0 auto; }
    .mx-room-half {
        position: relative;
        background:
            repeating-linear-gradient(to bottom, transparent 0 27px, rgba(28, 25, 23, 0.05) 27px 28px),
            #fffefb;
        border: 1px solid var(--mx-line-strong);
        box-shadow: 0 18px 50px rgba(28, 25, 23, 0.14), 0 4px 14px rgba(28, 25, 23, 0.08);
        padding: 1.8rem 1.6rem 1.8rem 2.2rem;
        display: flex; flex-direction: column;
        border-radius: 4px;
        transition: box-shadow 0.3s ease;
    }

    .mx-room-half:hover { box-shadow: 0 24px 60px rgba(28, 25, 23, 0.18), 0 6px 18px rgba(28, 25, 23, 0.1); }

    /* the notebook's red margin line */
    .mx-room-half::before {
        content: '';
        position: absolute;
        top: 0; bottom: 0; left: 1.4rem;
        width: 1px;
        background: rgba(216, 52, 28, 0.25);
    }
    .mx-room-half-title {
        font-family: var(--mx-font-display);
        font-style: italic;
        font-weight: 900;
        font-size: 1.3rem;
        color: var(--mx-ink);
        margin: 0 0 0.3rem;
        padding-bottom: 0.35rem;
        display: inline-block;
        border-bottom: 2px solid var(--mx-vermilion);
        width: fit-content;
    }
    .mx-room-half-sub { font-family: var(--mx-font-read); font-style: italic; font-size: 0.84rem; color: var(--mx-ink-faint); margin: 0 0 1.4rem; }
    .mx-notes-list { flex: 1; display: flex; flex-direction: column; gap: 0.8rem; margin-bottom: 1.4rem; max-height: 420px; overflow-y: auto; }
    :global(.mx-notes-empty) { font-family: var(--mx-font-read); font-style: italic; color: var(--mx-ink-faint); font-size: 0.88rem; }
    :global(.mx-note-card) {
        position: relative;
        border: 1px solid var(--mx-line);
        background: #fffdf9;
        padding: 1rem 1rem 0.8rem;
        border-radius: 4px;
        box-shadow: 0 8px 22px rgba(28, 25, 23, 0.09);
        transform: rotate(-0.7deg);
    }
    :global(.mx-note-card:nth-child(even)) { transform: rotate(0.9deg); }
    :global(.mx-note-card:hover) { transform: rotate(0deg) translateY(-2px); }
    :global(.mx-note-card::before) {
        content: '';
        position: absolute;
        top: -5px;
        left: 50%;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--mx-vermilion);
        box-shadow: 0 2px 5px rgba(28, 25, 23, 0.35);
    }
    :global(.mx-note-card.reply) { margin: 0.8rem 0 0 1.4rem; background: var(--mx-paper-deep); transform: rotate(0.6deg); }
    :global(.mx-note-card.reply::before) { background: var(--mx-ink-faint); width: 7px; height: 7px; }
    :global(.mx-note-body) { font-size: 0.9rem; line-height: 1.6; color: var(--mx-ink); margin: 0 0 0.5rem; overflow-wrap: anywhere; }
    :global(.mx-note-meta) { display: flex; align-items: center; gap: 0.6rem; font-size: 0.72rem; color: var(--mx-ink-faint); flex-wrap: wrap; }
    :global(.mx-note-author) { font-family: var(--mx-font-display); font-weight: 600; color: var(--mx-vermilion); }
    :global(.mx-note-reply), :global(.mx-note-report) {
        background: transparent; border: none; color: var(--mx-ink-faint);
        font-family: var(--mx-font-body); font-size: 0.72rem; cursor: pointer;
        display: inline-flex; align-items: center; padding: 0.1rem;
        transition: color 0.2s;
    }
    :global(.mx-note-reply:hover), :global(.mx-note-report:hover) { color: var(--mx-vermilion); }
    :global(.mx-note-replies) { margin-top: 0.6rem; }
    .mx-note-form { display: flex; flex-direction: column; gap: 0.6rem; }

    /* handwriting on the ruled page: no boxes, just the line */
    .mx-note-form .mx-field {
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--mx-line-strong);
        border-radius: 0;
        padding: 0.45rem 0.1rem;
        font-family: var(--mx-font-read);
        font-style: italic;
    }

    .mx-note-form .mx-field:focus {
        border-bottom-color: var(--mx-vermilion);
