---
// src/pages/max/submit.astro — the writing desk (bright glassmorphism).
// Client logic is a faithful copy of classic /submit (feature parity): story/poem
// modes, band meter from live word count, cover upload, edit mode, collections.
// The TiptapEditor component is reused as-is (shared core).
import MaxLayout from '../../layouts/MaxLayout.astro';
import TiptapEditor from '../../components/TiptapEditor.astro';
---

<MaxLayout title="Write a Story · Raconteur Max" description="Publish your work on Raconteur.">
    <div class="mx-page mx-page-narrow">
        <header class="mx-page-head" data-mx-reveal>
            <p class="mx-eyebrow">Writing Desk</p>
            <h1 class="mx-display mx-page-title" id="pageTitle">Publish Your Work</h1>
        </header>

        <div id="authArea" class="mx-empty">Checking login status...</div>

        <div id="loginPrompt" class="mx-glass mx-submit-login" hidden>
            <p>To publish a story directly to your dashboard, you need an account.</p>
            <a href="/login" class="mx-btn mx-btn-ink">Log in to Write</a>
        </div>

        <div id="editorArea" hidden>
            <form id="storyForm" class="mx-glass mx-submit-form" data-mx-reveal>
                <div class="mx-fgroup">
                    <div class="mx-kind-toggle" role="group" aria-label="What are you writing?">
                        <button type="button" class="mx-kind-btn active" data-kind="story">Story</button>
                        <button type="button" class="mx-kind-btn" data-kind="poem">Poem</button>
                    </div>
                </div>
                <div class="mx-fgroup">
                    <label for="storyTitle">Title</label>
                    <input type="text" id="storyTitle" class="mx-field" placeholder="The Last Letter Home" required />
                </div>
                <div class="mx-fgroup">
                    <label for="storyGenreTag">Genre</label>
                    <select id="storyGenreTag" class="mx-field">
                        <option value="Romance/Love">Romance/Love</option>
                        <option value="Mystery/Crime">Mystery/Crime</option>
                        <option value="Action/Adventure">Action/Adventure</option>
                        <option value="Thriller/Suspense">Thriller/Suspense</option>
                        <option value="Horror">Horror</option>
                        <option value="Science Fiction">Science Fiction</option>
                        <option value="Fantasy">Fantasy</option>
                        <option value="Humor/Comedy">Humor/Comedy</option>
                        <option value="Drama/Play">Drama/Play</option>
                        <option value="Literary Fiction">Literary Fiction</option>
                        <option value="Poetry">Poetry</option>
                        <option value="custom">+ Add your own...</option>
                    </select>
                    <input type="text" id="customGenreTag" class="mx-field" placeholder="Type your custom genre..." hidden />
                </div>

                <div class="mx-fgroup" id="lengthGroup">
                    <label>Length &amp; Category <span id="liveWordCount" class="mx-wordcount">0 words</span></label>
                    <input type="hidden" id="storyGenre" name="genre" value="Flash Fiction" />
                    <div class="mx-band-meter">
                        <div class="mx-band-segment active" data-band="Flash Fiction">
                            <span class="mx-band-label">Flash</span>
                            <span class="mx-band-sub">&lt; 1k</span>
                        </div>
                        <div class="mx-band-segment" data-band="Short Story">
                            <span class="mx-band-label">Short</span>
                            <span class="mx-band-sub">1k–7.5k</span>
                        </div>
                        <div class="mx-band-segment" data-band="Novelette">
                            <span class="mx-band-label">Novelette</span>
                            <span class="mx-band-sub">7.5k–17.5k</span>
                        </div>
                        <div class="mx-band-segment" data-band="Novella">
                            <span class="mx-band-label">Novella</span>
                            <span class="mx-band-sub">17.5k+</span>
                        </div>
                    </div>
                </div>

                <div class="mx-fgroup">
                    <label for="storyCover">Cover image <span class="mx-wordcount">(optional: a book-jacket portrait looks best)</span></label>
                    <input type="file" id="storyCover" accept="image/*" class="mx-field" />
                    <img id="coverPreview" alt="" hidden style="max-width: 140px; margin-top: 0.75rem; border-radius: 8px;" />
                </div>

                <div class="mx-fgroup">
                    <label>Your Story <span class="mx-wordcount">(tip: start each chapter with a line like "Chapter 1" and it will automatically get its own page, like an ebook)</span></label>
                    <input type="hidden" id="storyContent" />
                    <TiptapEditor />
                </div>

                <div id="collectionSelector" class="mx-fgroup" hidden>
                    <label for="collectionSelect">Add to collection (optional)</label>
                    <select id="collectionSelect" class="mx-field">
                        <option value="">None (standalone poem)</option>
                    </select>
                    <a href="/max/dashboard" class="mx-link-btn">Create a new collection</a>
                </div>

                <div class="mx-form-actions">
                    <button type="button" id="publishBtn" class="mx-btn mx-btn-ink">Publish Story</button>
                    <button type="button" id="draftBtn" class="mx-btn mx-btn-ghost">Save as Draft</button>
                    <span id="formStatus" class="mx-status"></span>
                </div>
            </form>
        </div>
    </div>
</MaxLayout>

<script>
    // Writing desk engine — faithful clone of classic /submit (links in-skin).
    import { supabase } from '../../lib/supabase';

    const authArea = document.getElementById('authArea')!;
    const loginPrompt = document.getElementById('loginPrompt')!;
    const editorArea = document.getElementById('editorArea')!;
    const formStatus = document.getElementById('formStatus')!;
    const titleInput = document.getElementById('storyTitle') as HTMLInputElement;
    const genreInput = document.getElementById('storyGenre') as HTMLInputElement;
    const contentInput = document.getElementById('storyContent') as HTMLTextAreaElement;
    const publishBtn = document.getElementById('publishBtn') as HTMLButtonElement;
    const draftBtn = document.getElementById('draftBtn') as HTMLButtonElement;
    let currentKind: 'story' | 'poem' = 'story';
    let isEditing = false;
    const kindButtons = document.querySelectorAll('.mx-kind-btn');
    const lengthGroup = document.getElementById('lengthGroup');
    const pageTitleEl = document.getElementById('pageTitle');
    const poemHint = document.getElementById('poemHint');

    function setKind(kind: 'story' | 'poem') {
        currentKind = kind;
        (window as any).raconteurPoemMode = (kind === 'poem');
        kindButtons.forEach(b => b.classList.toggle('active', (b as HTMLElement).dataset.kind === kind));
        if (lengthGroup) lengthGroup.style.display = kind === 'poem' ? 'none' : 'block';
        if (poemHint) poemHint.style.display = kind === 'poem' ? 'block' : 'none';
        publishBtn.textContent = isEditing
            ? (kind === 'poem' ? 'Update Poetry' : 'Update & Publish')
            : (kind === 'poem' ? 'Publish Poetry' : 'Publish Story');
        if (pageTitleEl) pageTitleEl.textContent = isEditing
            ? (kind === 'poem' ? 'Edit Your Poetry' : 'Edit Your Story')
            : (kind === 'poem' ? 'Publish Your Poetry' : 'Publish Your Story');
    }
    kindButtons.forEach(b => b.addEventListener('click', () => setKind((b as HTMLElement).dataset.kind as 'story' | 'poem')));

    async function initSubmitPage() {
        const { data: { session } } = await supabase.auth.getSession();
        authArea.hidden = true;

        if (!session) {
            loginPrompt.hidden = false;
            return;
        }

        editorArea.hidden = false;

        // --- EDIT MODE ---
        const editId = new URLSearchParams(window.location.search).get('edit');
        let editingId: string | null = null;

        if (editId) {
            const { data: existing } = await supabase
                .from('stories')
                .select('*')
                .eq('id', editId)
                .eq('author_id', session.user.id) // security: only YOUR stories
                .single();

            if (existing) {
                editingId = existing.id;
                titleInput.value = existing.title;
                contentInput.value = existing.content;
                genreInput.value = existing.genre || 'Community';
                if ((existing as any).kind === 'poem') setKind('poem');
                setTimeout(() => {
                    if ((window as any).setTiptapContent) {
                        const htmlContent = existing.content.includes('<p>')
                            ? existing.content
                            : existing.content.split('\n\n').map((p: string) => `<p>${p.replace(/\n/g, '<br>')}</p>`).join('');
                        (window as any).setTiptapContent(htmlContent);
                    }
                }, 500);
                const genreTagSelect = document.getElementById('storyGenreTag') as HTMLSelectElement;
                const customGenreInput = document.getElementById('customGenreTag') as HTMLInputElement;
                if (existing.genre_tag) {
                    const options = Array.from(genreTagSelect.options).map(o => o.value);
                    if (options.includes(existing.genre_tag)) {
                        genreTagSelect.value = existing.genre_tag;
                    } else {
                        genreTagSelect.value = 'custom';
                        customGenreInput.hidden = false;
                        customGenreInput.value = existing.genre_tag;
                    }
                }
                isEditing = true;
                publishBtn.textContent = 'Update & Publish';
                draftBtn.textContent = 'Update Draft';
                document.getElementById('pageTitle')!.textContent = 'Edit Your Story';
                if ((existing as any).kind === 'poem') setKind('poem');
            }
        }

        // === Collections for poems ===
        const collectionSelector = document.getElementById('collectionSelector')!;
        const collectionSelect = document.getElementById('collectionSelect') as HTMLSelectElement;

        async function loadCollections() {
            if (currentKind !== 'poem') {
                collectionSelector.hidden = true;
                return;
            }
            collectionSelector.hidden = false;
            const { data: collections } = await supabase
                .from('poetry_collections')
                .select('id, name')
                .eq('owner_id', session!.user.id)
                .order('name');

            collectionSelect.innerHTML = '<option value="">None (standalone poem)</option>';
            if (collections && collections.length > 0) {
                collections.forEach((c: any) => {
                    const option = document.createElement('option');
                    option.value = c.id;
                    option.textContent = c.name;
                    collectionSelect.appendChild(option);
                });
            }

            if (editingId) {
                const { data: story } = await supabase
                    .from('stories')
                    .select('collection_id')
                    .eq('id', editingId)
                    .maybeSingle();
                if (story?.collection_id) {
                    collectionSelect.value = story.collection_id;
                }
            }
        }

        await loadCollections();
        kindButtons.forEach(b => b.addEventListener('click', () => loadCollections()));

        async function saveStory(status: 'published' | 'draft') {
            const title = titleInput.value;
            const content = (window as any).getTiptapContent ? (window as any).getTiptapContent() : contentInput.value;
            const genre = genreInput.value;

            const genreTagSelect = document.getElementById('storyGenreTag') as HTMLSelectElement;
            const customGenreInput = document.getElementById('customGenreTag') as HTMLInputElement;
            const genreTag = genreTagSelect.value === 'custom'
                ? (customGenreInput.value.trim() || 'Literary Fiction')
                : genreTagSelect.value;

            if (!title || !content) {
                formStatus.textContent = 'Please add a title and some text.';
                formStatus.style.color = '#b3261e';
                return;
            }
            // Poems: unlimited, tagged Poetry. Stories: 40,000-word cap.
            let effectiveGenre = genre;
            let effectiveTag = genreTag;
            if (currentKind === 'poem') {
                effectiveGenre = 'Poetry';
                effectiveTag = 'Poetry';
            } else {
                const words = content.replace(/<[^>]+>/g, ' ').trim().split(/\s+/).filter(Boolean).length;
                if (words > 40000) {
                    formStatus.textContent = 'Raconteur hosts stories up to 40,000 words. The novella ceiling.';
                    formStatus.style.color = '#b3261e';
                    return;
                }
            }

            publishBtn.disabled = true;
            draftBtn.disabled = true;
            formStatus.textContent = editingId
                ? 'Updating...'
                : (status === 'published' ? 'Publishing...' : 'Saving draft...');

            let error: any;
            let coverUrl: string | undefined = undefined;

            const coverInput = document.getElementById('storyCover') as HTMLInputElement;
            const coverFile = coverInput?.files?.[0];

            if (coverFile) {
                formStatus.textContent = 'Uploading cover...';
                const fileExt = coverFile.name.split('.').pop();
                const fileName = `${Date.now()}.${fileExt}`;
                const filePath = `${session!.user.id}/${fileName}`;

                const { data: uploadData, error: uploadError } = await supabase.storage
                    .from('covers')
                    .upload(filePath, coverFile);

                if (uploadError) {
                    console.error(uploadError);
                    formStatus.textContent = 'Error uploading cover.';
                    formStatus.style.color = '#b3261e';
                    publishBtn.disabled = false;
                    draftBtn.disabled = false;
                    return;
                }

                const { data: urlData } = supabase.storage.from('covers').getPublicUrl(uploadData.path);
                coverUrl = urlData.publicUrl;
            }

            if (editingId) {
                const payload: any = {
                    title, content,
                    genre: currentKind === 'poem' ? 'Poetry' : genre,
                    genre_tag: currentKind === 'poem' ? 'Poetry' : genreTag,
                    status, kind: currentKind, updated_at: new Date().toISOString(),
                    collection_id: currentKind === 'poem' ? (collectionSelect.value || null) : null
                };
                if (coverUrl) payload.cover_url = coverUrl;
                const res = await supabase.from('stories').update(payload).eq('id', editingId);
                error = res.error;
            } else {
                // Use pen name from profiles if available, otherwise email prefix
                const { data: writerProfile } = await supabase
                    .from('profiles')
                    .select('pen_name')
                    .eq('user_id', session!.user.id)
                    .maybeSingle();
                const displayName = writerProfile?.pen_name || (session!.user.email ?? 'writer').split('@')[0];

                const payload: any = {
                    author_id: session!.user.id,
                    author_name: displayName,
                    title, content,
                    genre: currentKind === 'poem' ? 'Poetry' : genre,
                    genre_tag: currentKind === 'poem' ? 'Poetry' : genreTag,
                    status, kind: currentKind,
                    collection_id: currentKind === 'poem' ? (collectionSelect.value || null) : null
                };
                if (coverUrl) payload.cover_url = coverUrl;

                const res = await supabase.from('stories').insert([payload]);
                error = res.error;
            }

            if (error) {
                console.error(error);
                formStatus.textContent = 'Error saving. Please try again.';
                formStatus.style.color = '#b3261e';
                publishBtn.disabled = false;
                draftBtn.disabled = false;
            } else {
                formStatus.textContent = editingId
                    ? 'Story updated.'
                    : (status === 'published' ? 'Story is live.' : 'Draft saved.');
                formStatus.style.color = '#2e7d32';
                setTimeout(() => { window.location.href = '/max/dashboard'; }, 1500);
            }
        }

        publishBtn.addEventListener('click', async (e) => {
            e.preventDefault();
            await saveStory('published');
        });

        draftBtn.addEventListener('click', async (e) => {
            e.preventDefault();
            await saveStory('draft');
        });
    }

    initSubmitPage();

    const wordCountDisplay = document.getElementById('liveWordCount');
    const bandSegments = document.querySelectorAll('.mx-band-segment');

    const updateBandMeter = () => {
        // Count from Tiptap editor, not the hidden input
        const editor = (window as any).tiptapEditor;
        const raw = editor ? editor.getText() : contentInput.value;
        const text = (raw || '').trim();
        const words = text ? text.split(/\s+/).filter(Boolean).length : 0;
        wordCountDisplay!.textContent = `${words.toLocaleString()} words`;

        let currentBand = 'Flash Fiction';
        if (words >= 17500) currentBand = 'Novella';
        else if (words >= 7500) currentBand = 'Novelette';
        else if (words >= 1000) currentBand = 'Short Story';

        genreInput!.value = currentBand;

        bandSegments.forEach((seg) => {
            if (seg.getAttribute('data-band') === currentBand) {
                seg.classList.add('active');
            } else {
                seg.classList.remove('active');
            }
        });
    };

    function bindBandMeter() {
        const ed = (window as any).tiptapEditor;
        if (ed && ed.on) { ed.on('update', updateBandMeter); ed.on('create', updateBandMeter); updateBandMeter(); return true; }
        return false;
    }
    if (!bindBandMeter()) {
        let tries = 0;
        const iv = setInterval(() => { tries++; if (bindBandMeter() || tries > 20) clearInterval(iv); }, 300);
    }
    contentInput.addEventListener('input', updateBandMeter);

    const coverInput = document.getElementById('storyCover') as HTMLInputElement;
    const coverPreview = document.getElementById('coverPreview') as HTMLImageElement;
    coverInput?.addEventListener('change', () => {
        const file = coverInput.files?.[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                coverPreview.src = e.target?.result as string;
                coverPreview.hidden = false;
            };
            reader.readAsDataURL(file);
        } else {
            coverPreview.hidden = true;
        }
    });

    const genreTagSelect = document.getElementById('storyGenreTag') as HTMLSelectElement;
    const customGenreInput = document.getElementById('customGenreTag') as HTMLInputElement;
    genreTagSelect?.addEventListener('change', () => {
        if (genreTagSelect.value === 'custom') {
            customGenreInput.hidden = false;
            customGenreInput.focus();
        } else {
            customGenreInput.hidden = true;
            customGenreInput.value = '';
        }
    });
</script>

<style>
    .mx-submit-login {
        max-width: 460px;
        margin: 2rem auto 0;
        padding: 2.6rem 2.2rem;
        text-align: center;
    }

    .mx-submit-login p {
        font-family: var(--mx-font-read);
        font-style: italic;
        color: var(--mx-ink-soft);
        margin: 0 0 1.2rem;
    }

    .mx-submit-form { padding: 2.2rem 2.2rem 1.8rem; }

    .mx-fgroup { margin-bottom: 1.6rem; }
    .mx-fgroup > label { display: block; font-family: var(--mx-font-display); font-weight: 600; font-size: 1.02rem; color: var(--mx-ink); margin-bottom: 0.5rem; }

    /* Kind toggle — ink pills */
    .mx-kind-toggle { display: flex; gap: 6px; }
    .mx-kind-btn {
        flex: 0 0 120px;
        background: rgba(255, 255, 255, 0.45);
        border: 1px solid var(--mx-glass-line);
        color: var(--mx-ink-soft);
        padding: 0.55rem 1rem;
        border-radius: 999px;
        font-family: var(--mx-font-display);
        font-size: 0.92rem;
        cursor: pointer;
        opacity: 0.6;
        transition: all 0.3s ease;
    }
    .mx-kind-btn.active {
        background: var(--mx-ink);
        border-color: var(--mx-ink);
        color: var(--mx-paper);
        opacity: 1;
    }

    .mx-wordcount { font-weight: 400; color: var(--mx-ink-faint); font-size: 0.82rem; margin-left: 0.5rem; }

    /* Band meter — glass segments, active pours ink */
    .mx-band-meter { display: flex; gap: 6px; margin-top: 0.5rem; }
    .mx-band-segment {
        flex: 1;
        background: rgba(255, 255, 255, 0.4);
        border: 1px solid var(--mx-glass-line);
        padding: 0.5rem;
        border-radius: 12px;
        text-align: center;
        transition: all 0.3s ease;
        opacity: 0.5;
    }
    .mx-band-segment.active { background: var(--mx-ink); border-color: var(--mx-ink); opacity: 1; }
    .mx-band-label { display: block; color: var(--mx-ink); font-size: 0.85rem; font-weight: 600; }
    .mx-band-sub { display: block; color: var(--mx-ink-faint); font-size: 0.68rem; margin-top: 2px; }
    .mx-band-segment.active .mx-band-label { color: var(--mx-paper); }
    .mx-band-segment.active .mx-band-sub { color: rgba(250, 246, 239, 0.7); }

    .mx-form-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
</style>
