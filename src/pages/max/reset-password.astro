---
// src/pages/max/reset-password.astro — password reset + recovery mode (bright glassmorphism).
// Logic is a faithful copy of classic /reset-password (both Supabase flows).
import MaxLayout from '../../layouts/MaxLayout.astro';
---

<MaxLayout title="Reset Password · Raconteur Pro" description="Reset your Raconteur password.">
    <div class="mx-auth-wrap">
        <div class="mx-auth-card" data-mx-reveal>
            <p class="mx-eyebrow">Account recovery</p>
            <h1 class="mx-auth-title">Reset your password<span class="mx-auth-stop">.</span></h1>
            <p class="mx-auth-sub" id="resetSub">Enter your email and we'll send you a link to reset your password.</p>
            <form id="resetForm" class="mx-auth-form">
                <input type="email" id="email" class="mx-field" placeholder="your@email.com" required />
                <button type="submit" class="mx-btn mx-btn-ink mx-auth-btn">Send reset link</button>
            </form>
            <div id="resetMsg" class="mx-reset-msg" hidden></div>
            <p class="mx-forgot"><a href="/max/login">Back to login</a></p>
        </div>
        <p class="mx-auth-foot">The bright-glass edition of Raconteur</p>
    </div>
</MaxLayout>

<script>
    import { supabase } from '../../lib/supabase';

    // Handles BOTH Supabase flows: implicit (type=recovery in hash) and PKCE (?code=)
    const hasResetCode = new URLSearchParams(window.location.search).has('code');
    function initResetMode() {
        if (!window.location.hash.includes('type=recovery') && !window.location.hash.includes('update') && !hasResetCode) return false;
        const hash = window.location.hash.substring(1);
        const params = new URLSearchParams(hash);
        const type = params.get('type');
        if (type === 'recovery' || window.location.hash.includes('recovery') || hasResetCode) {
            const sub = document.getElementById('resetSub') as HTMLElement | null;
            if (sub) sub.textContent = 'Enter your new password below.';
            const form = document.getElementById('resetForm')!;
            form.innerHTML = `
                <input type="password" id="newPassword" class="mx-field" placeholder="New password (min 6 characters)" required minlength="6" />
                <button type="submit" class="mx-btn mx-btn-ink mx-auth-btn">Update password</button>
            `;
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const newPassword = (document.getElementById('newPassword') as HTMLInputElement).value;
                const msg = document.getElementById('resetMsg')!;
                if (!newPassword || newPassword.length < 6) {
                    msg.textContent = 'Password must be at least 6 characters.';
                    msg.className = 'mx-reset-msg error';
                    msg.hidden = false;
                    return;
                }
                const { error } = await supabase.auth.updateUser({ password: newPassword });
                if (error) {
                    msg.textContent = error.message;
                    msg.className = 'mx-reset-msg error';
                } else {
                    msg.textContent = 'Password updated. Redirecting to login...';
                    msg.className = 'mx-reset-msg success';
                    setTimeout(() => { window.location.href = '/max/login'; }, 2000);
                }
                msg.hidden = false;
            });
            return true;
        }
        return false;
    }

    if (!initResetMode()) {
        document.getElementById('resetForm')!.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = (document.getElementById('email') as HTMLInputElement).value.trim();
            const msg = document.getElementById('resetMsg')!;
            if (!email) return;
            const { error } = await supabase.auth.resetPasswordForEmail(email, {
                redirectTo: window.location.origin + '/max/reset-password'
            });
            if (error) {
                msg.textContent = error.message;
                msg.className = 'mx-reset-msg error';
            } else {
                msg.textContent = 'Check your email for a reset link.';
                msg.className = 'mx-reset-msg success';
            }
            msg.hidden = false;
        });
    }
</script>

<style>
    .mx-auth-wrap {
        min-height: 72vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1rem;
    }

    .mx-auth-card {
        position: relative;
        width: 100%;
        max-width: 440px;
        padding: 3.2rem 2.8rem 2.6rem;
        text-align: center;
        background: var(--mx-paper, #fffdf9);
        border: 1px solid var(--mx-line-strong, rgba(28, 25, 23, 0.14));
        border-radius: 18px;
        box-shadow: 0 34px 90px rgba(28, 25, 23, 0.16), 0 2px 8px rgba(28, 25, 23, 0.06);
        overflow: hidden;
    }

    .mx-auth-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 18%;
        right: 18%;
        height: 3px;
        background: var(--mx-vermilion);
        border-radius: 0 0 3px 3px;
    }

    .mx-auth-title {
        font-family: var(--mx-font-display);
        font-size: 2.1rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        color: var(--mx-ink);
        margin: 0.7rem 0 0.5rem;
        line-height: 1.1;
    }

    .mx-auth-stop { color: var(--mx-vermilion); }

    .mx-auth-sub {
        font-family: var(--mx-font-read);
        font-style: italic;
        font-size: 1rem;
        color: var(--mx-ink-soft);
        line-height: 1.6;
        margin: 0 0 2rem;
    }

    .mx-auth-form { display: flex; flex-direction: column; gap: 1rem; }
    .mx-auth-btn { width: 100%; justify-content: center; margin-top: 0.4rem; padding: 0.9rem 1.5rem; font-size: 0.98rem; letter-spacing: 0.02em; }

    .mx-field {
        width: 100%;
        padding: 0.8rem 1rem;
        background: #fff;
        border: 1px solid rgba(28, 25, 23, 0.18);
        border-radius: 10px;
        color: var(--mx-ink);
        font-family: var(--mx-font-body);
        font-size: 0.95rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .mx-field:focus {
        border-color: var(--mx-vermilion);
        box-shadow: 0 0 0 3px rgba(216, 52, 28, 0.1);
    }
    .mx-field::placeholder { color: var(--mx-ink-faint); }

    .mx-reset-msg { margin-top: 1rem; padding: 1rem; border-radius: 12px; font-size: 0.88rem; }
    .mx-reset-msg.success { background: rgba(61, 107, 60, 0.12); color: #3d6b3c; border: 1px solid rgba(61, 107, 60, 0.3); }
    .mx-reset-msg.error { background: rgba(216, 52, 28, 0.08); color: var(--mx-vermilion); border: 1px solid rgba(216, 52, 28, 0.3); }

    .mx-forgot { margin-top: 1.6rem; }
    .mx-forgot a {
        color: var(--mx-ink-soft);
        text-decoration: none;
        font-size: 0.88rem;
        border-bottom: 1px dotted rgba(216, 52, 28, 0.5);
        padding-bottom: 1px;
    }
    .mx-forgot a:hover { color: var(--mx-vermilion); }

    .mx-auth-foot {
        margin-top: 1.6rem;
        font-size: 0.64rem;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--mx-ink-faint);
    }
</style>
