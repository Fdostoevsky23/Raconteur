---
// src/pages/max/saved.astro — stories bookmarked for later (bright glassmorphism).
// Server logic is a faithful copy of classic /saved (feature parity): bookmarks
// join + unbookmark removal, auth-gated client rendering.
import MaxLayout from '../../layouts/MaxLayout.astro';
---

<MaxLayout title="Saved for Later · Raconteur Pro" description="Stories you've bookmarked to return to.">
    <div class="mx-page">
        <header class="mx-page-head" data-mx-reveal>
            <p class="mx-eyebrow">Your shelf of intentions</p>
            <h1 class="mx-display mx-page-title">Saved for Later</h1>
            <p class="mx-page-sub">Stories you've bookmarked to return to.</p>
        </header>

        <div id="authCheck" class="mx-empty">Checking login status...</div>
        <div id="savedGrid" class="mx-grid" hidden></div>
        <div id="emptyState" hidden>
            <div class="mx-glass mx-saved-empty" data-mx-reveal>
                <p class="mx-saved-empty-title">No saved stories yet.</p>
                <p class="mx-saved-empty-sub">Tap the bookmark on any story to save it here.</p>
                <a href="/max/stories" class="mx-btn mx-btn-ink">Browse the Library</a>
            </div>
        </div>
    </div>
</MaxLayout>

<script>
    // Saved stories — faithful clone of classic /saved (links in-skin).
    import { supabase } from '../../lib/supabase';
    import { esc } from '../../lib/escape';
    import { iconSvg } from '../../lib/icons';

    const authCheck = document.getElementById('authCheck')!;
    const savedGrid = document.getElementById('savedGrid')!;
    const emptyState = document.getElementById('emptyState')!;

    async function initSaved() {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) { window.location.href = '/max/login'; return; }
        authCheck.hidden = true;

        const { data: savedRows } = await supabase
            .from('bookmarks')
            .select('story_id, stories(id, title, cover_url, author_name)')
            .eq('user_id', session.user.id);

        const saved = (savedRows || []).filter((r: any) => r.stories);
        if (saved.length === 0) { emptyState.hidden = false; return; }

        savedGrid.hidden = false;
        savedGrid.innerHTML = saved.map((r: any, i: number) => {
            const s = r.stories;
            const cover = s.cover_url
                ? `<div class="mx-card-cover"><img src="${esc(s.cover_url)}" alt="Cover of ${esc(s.title)}" loading="lazy" /></div>`
                : `<div class="mx-card-cover"><span class="mx-card-star" aria-hidden="true">${iconSvg('bookmark', 26)}</span></div>`;
            return `
                <div class="mx-glass mx-card mx-saved-tile" style="--mx-reveal-delay: ${Math.min(i * 0.05, 0.4)}s">
                    <a href="/max/story/${esc(s.id)}" style="display: block; text-decoration: none; color: inherit;">
                        ${cover}
                        <div class="mx-card-body">
                            <h3 class="mx-card-title">${esc(s.title)}</h3>
                            <div class="mx-card-meta"><span>by ${esc(s.author_name)}</span></div>
                        </div>
                    </a>
                    <button class="mx-unbookmark" data-id="${esc(s.id)}" title="Remove from saved" aria-label="Remove from saved">${iconSvg('close', 14)}</button>
                </div>`;
        }).join('');
        savedGrid.querySelectorAll('.mx-glass').forEach(el => el.classList.add('mx-revealed'));

        savedGrid.querySelectorAll('.mx-unbookmark').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                e.preventDefault(); e.stopPropagation();
                const id = (btn as HTMLElement).dataset.id!;
                await supabase.from('bookmarks').delete().eq('user_id', session.user.id).eq('story_id', id);
                (btn as HTMLElement).closest('.mx-saved-tile')?.remove();
                if (savedGrid.querySelectorAll('.mx-saved-tile').length === 0) {
                    savedGrid.hidden = true;
                    emptyState.hidden = false;
                }
            });
        });
    }
    initSaved();
</script>

<style>
    .mx-saved-tile { position: relative; }

    .mx-saved-tile > a:first-child { display: block; }

    .mx-unbookmark {
        position: absolute;
        top: 0.9rem;
        right: 0.9rem;
        z-index: 5;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border: 1px solid var(--mx-glass-line);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.65);
        color: var(--mx-ink-soft);
        cursor: pointer;
        opacity: 0.85;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: opacity 0.2s, transform 0.2s, color 0.2s;
    }

    .mx-unbookmark:hover { opacity: 1; transform: scale(1.08); color: var(--mx-vermilion); }

    .mx-saved-empty {
        max-width: 460px;
        margin: 2rem auto 0;
        padding: 3rem 2.2rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
    }

    .mx-saved-empty-title {
        font-family: var(--mx-font-display);
        font-weight: 900;
        font-size: 1.3rem;
        color: var(--mx-ink);
        margin: 0;
    }

    .mx-saved-empty-sub {
        font-family: var(--mx-font-read);
        font-style: italic;
        color: var(--mx-ink-soft);
        margin: 0 0 1.2rem;
    }
</style>
