---
// src/pages/max/feed.astro — stories from writers you follow (bright glassmorphism).
// Server logic is a faithful copy of classic /feed (feature parity): follow-graph
// query + latest published stories, auth-gated client rendering.
import MaxLayout from '../../layouts/MaxLayout.astro';
---

<MaxLayout title="Your Feed · Raconteur Max" description="New stories from the writers you follow.">
    <div class="mx-page">
        <header class="mx-page-head" data-mx-reveal>
            <p class="mx-eyebrow">From writers you follow</p>
            <h1 class="mx-display mx-page-title">Your Feed</h1>
        </header>

        <div id="authCheck" class="mx-empty">Checking login status...</div>
        <div id="feedList" class="mx-grid" hidden></div>
        <div id="emptyState" hidden>
            <div class="mx-glass mx-feed-empty" data-mx-reveal>
                <p class="mx-feed-empty-title">You're not following anyone yet.</p>
                <p class="mx-feed-empty-sub">Visit a writer's page and tap Follow, and their new stories will appear here.</p>
                <a href="/max/stories" class="mx-btn mx-btn-ink">Browse the Library</a>
            </div>
        </div>
    </div>
</MaxLayout>

<script>
    // Follow-graph feed — faithful clone of classic /feed (links in-skin).
    import { supabase } from '../../lib/supabase';
    import { esc } from '../../lib/escape';
    import { iconSvg } from '../../lib/icons';

    const authCheck = document.getElementById('authCheck')!;
    const feedList = document.getElementById('feedList')!;
    const emptyState = document.getElementById('emptyState')!;

    async function initFeed() {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) { window.location.href = '/login'; return; }
        authCheck.hidden = true;

        // Who do I follow?
        const { data: follows } = await supabase
            .from('follows')
            .select('followed_id')
            .eq('follower_id', session.user.id);
        const ids = (follows || []).map((f: any) => f.followed_id);
        if (ids.length === 0) { emptyState.hidden = false; return; }

        // Their published stories, newest first
        const { data: stories } = await supabase
            .from('stories')
            .select('id, title, author_name, created_at, kind, genre_tag, cover_url')
            .in('author_id', ids)
            .eq('status', 'published')
            .order('created_at', { ascending: false })
            .limit(40);
        if (!stories || stories.length === 0) { emptyState.hidden = false; return; }

        feedList.hidden = false;
        feedList.innerHTML = stories.map((s: any, i: number) => {
            const isPoem = s.kind === 'poem' || s.genre_tag === 'Poetry';
            const date = new Date(s.created_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
            const cover = s.cover_url
                ? `<div class="mx-card-cover"><img src="${esc(s.cover_url)}" alt="Cover of ${esc(s.title)}" loading="lazy" /></div>`
                : `<div class="mx-card-cover">${isPoem
                    ? `<span class="mx-card-quote">“${esc(s.title)}”</span>`
                    : `<span class="mx-card-star" aria-hidden="true">${iconSvg('sparkle', 26)}</span>`}</div>`;
            return `
                <a href="/max/story/${esc(s.id)}" class="mx-glass mx-card" data-mx-reveal style="--mx-reveal-delay: ${Math.min(i * 0.05, 0.4)}s">
                    ${cover}
                    <div class="mx-card-body">
                        <span class="mx-card-genre ${isPoem ? 'poem' : ''}">${isPoem ? 'Poem' : 'Story'}</span>
                        <h3 class="mx-card-title">${esc(s.title)}</h3>
                        <div class="mx-card-meta">
                            <span>${esc(s.author_name)}</span>
                            <span>${date}</span>
                        </div>
                    </div>
                </a>`;
        }).join('');
        feedList.querySelectorAll('[data-mx-reveal]').forEach(el => el.classList.add('mx-revealed'));
    }
    initFeed();
</script>

<style>
    .mx-feed-empty {
        max-width: 460px;
        margin: 2rem auto 0;
        padding: 3rem 2.2rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
    }

    .mx-feed-empty-title {
        font-family: var(--mx-font-display);
        font-weight: 900;
        font-size: 1.3rem;
        color: var(--mx-ink);
        margin: 0;
    }

    .mx-feed-empty-sub {
        font-family: var(--mx-font-read);
        font-style: italic;
        color: var(--mx-ink-soft);
        margin: 0 0 1.2rem;
    }
</style>
