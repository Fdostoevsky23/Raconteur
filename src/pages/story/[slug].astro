            const elWa = document.getElementById('shareWa');
            if (elWa) elWa.setAttribute('href', `https://wa.me/?text=${enc(shareTitle)}%20${enc(shareUrl)}`);
            const elCopy = document.getElementById('shareCopy');
            if (elCopy) elCopy.addEventListener('click', async (e) => {
                const btn = e.currentTarget;
                try {
