---
// Dynamic story reader — serves both static .txt stories AND live database stories
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllStorySlugs, getStoryBySlug, getVisibleStories } from '../../data/stories';
import { supabase } from '../../lib/supabase';
import { buildStoryFromDB } from '../../lib/storyLoader';
import authors from '../../data/authors.json';
import { esc } from '../../lib/escape';

// (Server-rendered on every request — output:'server', so getStaticPaths does
// nothing here and was removed. Slugs are static names or DB uuids.)
const { slug } = Astro.params;
const slugValue = slug ?? '';

// 1. Try to find it in the static files first
let story = getStoryBySlug(slugValue);

// 2. If not found statically, check if it's a database UUID
if (!story) {
    const { data: dbRow } = await supabase
        .from('stories')
        .select('*')
        .eq('id', slugValue)
        .eq('status', 'published')
        .single();

        if ( dbRow ) {
        story = buildStoryFromDB ( dbRow );
        // Live read count (no trigger needed)
        const { data: readRow } = await supabase
            .from('reads_public')
            .select('read_count')
            .eq('story_id', slugValue)
            .maybeSingle();
        (story as any).readCount = readRow?.read_count ?? 0;
    }
}

const allStorySlugs = getAllStorySlugs();

// Fetch published DB stories to merge with static ones
const { data: dbRows } = await supabase
    .from('stories')
    .select('*')
    .eq('status', 'published');
const dbStories = (dbRows || []).map(buildStoryFromDB);

const allStories = [...getVisibleStories(), ...dbStories];
// Merge with DB slugs so keyboard nav works for published DB stories too
const _allSlugsForNav = [...new Set([...allStorySlugs, ...dbStories.map(s => s.slug)])];
const moreByAuthor = story ? allStories.filter((s) => s.author === story.author && s.slug !== story.slug).slice(0, 3) : [];

if (!story) {
    return Astro.redirect('/');
}
// --- OpenGraph card data ---
const siteOrigin = Astro.url.origin;
const ogImage = story.cover
  ? (story.cover.startsWith('http') ? story.cover : siteOrigin + story.cover)
  : `${siteOrigin}/hero/1.jpg`;
const rawFirst = ((story as any).content?.[0]?.text || story.title) || '';
const firstLine = rawFirst.replace(/<[^>]*>/g, '').replace(/"/g, "'").replace(/\n/g, ' ').trim().slice(0, 150);
const isPoem = (story as any).genre === 'Poetry' || (story as any).kind === 'poem';
const poemLines = isPoem ? story.content.reduce((n: number, b: any) => n + ((b.text || '').split('<br>').length), 0) : 0;
const poemShort = isPoem && poemLines <= 24;

// --- 2.4 Author bio blurb ---
let authorName = story.author;
let authorRole = '';
let authorBio = '';
const staticAuthor = (authors as any[]).find((a) => a.name === story.author);
if (staticAuthor) {
    authorRole = staticAuthor.role || '';
    authorBio = staticAuthor.bio || '';
} else {
        const { data: profile } = await supabase
        .from('profiles')
        .select('pen_name, bio')
        .eq('user_id', story.author_id)
        .maybeSingle();
    if (profile?.bio) {
        authorName = profile.pen_name || story.author;
        authorBio = profile.bio;
    } else {
        authorBio = 'A new voice on Raconteur. Every story here was written to be remembered — this writer is just beginning theirs.';
    }
}

// Tiny helper: render *italic* markers inside paragraph text — esc first to prevent XSS, then allow <em>
function renderText(t: string): string {
  let out = t || '';
  
  // 1. Kill scripts/styles entirely
  out = out.replace(/<(script|style)[\s\S]*?<\/\1>/gi, '');
  
  // 2. Sanitize tags: keep safe ones, preserve ONLY text-align style
  out = out.replace(/<\/?([a-zA-Z][a-zA-Z0-9]*)([^>]*)>/g, (match, tagName, attrs) => {
    const name = tagName.toLowerCase();
    const ok = ['em', 'i', 'strong', 'b', 'u', 's', 'br', 'p', 'span', 'div'];
    
    if (!ok.includes(name)) return ''; // Strip unsafe tags
    if (match.startsWith('</')) return `</${name}>`; // Keep closing tags clean
    
    // Extract ONLY text-align from style attribute
    let cleanAttrs = '';
    if (attrs) {
      const styleMatch = attrs.match(/style\s*=\s*["']([^"']*)["']/i);
      if (styleMatch) {
        const align = styleMatch[1].match(/text-align\s*:\s*(left|center|right)/i);
        if (align) {
          cleanAttrs = ` style="text-align: ${align[1]}"`;
        }
      }
    }
    
    return `<${name}${cleanAttrs}>`;
  });
  
  // 3. Markdown italics
  out = out.replace(/\*([^*\n]+)\*/g, '<em>$1</em>');
  
  return out;
}

function safeCover(c: any): string | null {
    if (!c || typeof c !== 'string') return null;
    if (!(c.startsWith('http') || c.startsWith('/'))) return null;
    return c;
}
---

<BaseLayout title={`${story.title} — ${story.author} · Raconteur`} description={firstLine} ogImage={ogImage}>
    {safeCover(story.cover) && (
        <div class="story-backdrop" style={`background-image: url('${safeCover(story.cover)!.replace(/'/g, "%27")}')`}></div>
    )}
        <div class={`reader-column ${story.cover ? 'has-backdrop' : ''}`}>
    <article class={"story" + (isPoem ? " poem-mode" : "")} id="storyContent">
    <script type="application/json" id="story-slugs" set:html={JSON.stringify(_allSlugsForNav).replace(/</g, '\\u003c')} />
    <script type="application/json" id="current-slug" set:html={JSON.stringify(slugValue).replace(/</g, '\\u003c')} />

    <div class="progress-bar" id="progressBar"></div>

    <div class="reader-controls">
    <a href="/" class="back-link">← Back</a>

    <div class="controls-right">
        <!-- Font size slider -->
        <div class="font-control" title="Adjust text size">
            <span class="font-label-small">A</span>
            <input
                type="range"
                id="fontSlider"
                min="0.9"
                max="1.5"
                step="0.05"
                value="1.15"
                aria-label="Text size"
            />
            <span class="font-label-large">A</span>
        </div>

        <!-- Three-mode switcher -->
        <div class="mode-switcher" role="group" aria-label="Reading mode">
            <button type="button" data-mode="light" title="Light mode">☀️</button>
            <button type="button" data-mode="sepia" title="Sepia mode">🌙</button>
            <button type="button" data-mode="dark" title="Dark mode">🌑</button>
        </div>
    </div>
</div>
    
        <header class="story-header">
            <span class="genre">{story.genre}</span>
            <h1>{story.title}</h1>
            <div class="byline">
                <a href={`/author/${story.author.toLowerCase().replace(/\s+/g, '-')}`} class="author-link author">By {story.author}</a>
                <span class="dot">·</span>
                <span class="wordcount">{story.wordCount.toLocaleString()} words</span>
             <span class="dot">·</span>
                <span class="readtime">{isPoem ? `${poemLines} lines` : story.readTime}</span>
                { ((story as any).readCount || 0) > 0 && (
                <>
                  <span class="dot">·</span>
                  <span class="readtime">✦ {(story as any).readCount} {(story as any).readCount === 1 ? 'reader' : 'readers'}</span>
                </>
              )}
            </div>
        </header>

        <div class="story-body">
            {story.content.map((block) => {
                if (block.type === 'heading') {
                    return <h2>{block.text}</h2>;
                }
                if (block.type === 'quote') {
                    return <blockquote set:html={renderText(block.text)} />;
                }
                if (isPoem && block.type === 'paragraph' && /^(\s*(✦|\*{3}|-{3})\s*)+$/.test(block.text)) {
                    return <div class="poem-break">✦ ✦ ✦</div>;
                }
                // paragraph
                const classes = ['para'];
                if (block.dropcap) classes.push('dropcap');
                if (block.ending) classes.push('ending');
                const alignStyle = (block as any).align ? `text-align: ${(block as any).align}` : undefined;
                return <p class={classes.join(' ')} style={alignStyle} set:html={renderText(block.text)} />;
            })}
        </div>

                {/* About the author — hidden per owner request (bio already on author page) */}

        {moreByAuthor.length > 0 && (
            <section class="more-by-author">
                <h3>More by {story.author}</h3>
                <div class="mba-grid">
                    {moreByAuthor.map((s) => (
                        <a href={`/story/${s.slug}`} class="mba-card">
                            {s.cover && <img src={s.cover} alt={`Cover of ${s.title}`} />}
                            <div class="mba-info">
                                <span class="mba-title">{s.title}</span>
                                <span class="mba-meta">{s.wordCount.toLocaleString()} words · {s.readTime}</span>
                            </div>
                        </a>
                    ))}
                </div>
                <a href={`/author/${story.author.toLowerCase().replace(/\s+/g, '-')}`} class="mba-all">
                    View all stories by {story.author} →
                </a>
            </section>
        )}

        <div class="like-row">
            <button id="likeBtn" class="like-btn" type="button" aria-label="Appreciate this story">
                <span id="likeHeart" class="like-heart">♡</span>
                <span id="likeCount" class="like-count">0</span>
            </button>
            <button id="bookmarkBtn" class="like-btn" type="button" aria-label="Save for later">
                <span>🔖</span>
                <span id="bookmarkLabel">Save</span>
            </button>
            <span id="likeHint" class="like-hint"></span>
        </div>

        <script>
            import { supabase } from '../../lib/supabase';

            const likeBtn = document.getElementById('likeBtn')!;
            const likeHeart = document.getElementById('likeHeart')!;
            const likeCount = document.getElementById('likeCount')!;
            const likeHint = document.getElementById('likeHint')!;
            const slug = JSON.parse(document.getElementById('current-slug')?.textContent || '""');
            const isDbStory = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(slug);

            async function initLikes() {
                if (!isDbStory) { likeBtn.closest('.like-row')?.remove(); return; }

                const { count } = await supabase
                    .from('likes')
                    .select('id', { count: 'exact', head: true })
                    .eq('story_id', slug);
                likeCount.textContent = String(count ?? 0);

                const { data: { session } } = await supabase.auth.getSession();
                let liked = false;
                if (session) {
                    const { data: mine } = await supabase
                        .from('likes')
                        .select('id')
                        .eq('story_id', slug)
                        .eq('user_id', session.user.id)
                        .maybeSingle();
                    liked = !!mine;
                }
                paint(liked);

                                const VISITOR_NAMES = ['Wandering Reader', 'Passing Stranger', 'Quiet Guest', 'Night Owl', 'Library Ghost'];
                function guestKey() { return 'raconteur_guest_' + slug; }
                function getGuest() {
                    try { return JSON.parse(localStorage.getItem(guestKey()) || 'null'); } catch { return null; }
                }
                function setGuest(name: string) {
                    localStorage.setItem(guestKey(), JSON.stringify({ name, liked: true }));
                }
                function clearGuest() { localStorage.removeItem(guestKey()); }

                // On load, restore guest state
                const guest = getGuest();
                if (guest?.liked) { liked = true; paint(true); }

                likeBtn.addEventListener('click', async () => {
                    const { data: { session: s } } = await supabase.auth.getSession();

                    if (s) {
                        // Logged-in path
                        if (liked) {
                            await supabase.from('likes').delete().eq('story_id', slug).eq('user_id', s.user.id);
                            liked = false;
                            likeCount.textContent = String(Math.max(0, Number(likeCount.textContent) - 1));
                        } else {
                            await supabase.from('likes').insert({ story_id: slug, user_id: s.user.id });
                            liked = true;
                            likeCount.textContent = String(Number(likeCount.textContent) + 1);
                            const { data: storyRow } = await supabase
                                .from('stories').select('author_id').eq('id', slug).maybeSingle();
                            if (storyRow?.author_id && storyRow.author_id !== s.user.id) {
                                await supabase.from('notifications').insert({
                                    user_id: storyRow.author_id, actor_id: s.user.id, type: 'like', story_id: slug,
                                });
                            }
                        }
                    } else {
                        // Guest path — local-only toggle. No DB notification because RLS requires auth.uid() and anon has none.
                        // Keeping guest likes ephemeral avoids a silent RLS rejection (see C-05).
                        if (liked) {
                            clearGuest();
                            liked = false;
                            likeCount.textContent = String(Math.max(0, Number(likeCount.textContent) - 1));
                        } else {
                            const name = VISITOR_NAMES[Math.floor(Math.random() * VISITOR_NAMES.length)];
                            setGuest(name);
                            liked = true;
                            likeCount.textContent = String(Number(likeCount.textContent) + 1);
                        }
                    }
                    paint(liked);
                });
            }

            function paint(liked: boolean) {
                likeBtn.classList.toggle('liked', liked);
                likeHeart.textContent = liked ? '♥' : '♡';
            }

                    initLikes ();
            // === Bookmarks (6.8) ===
            const bookmarkBtn = document.getElementById('bookmarkBtn')!;
            const bookmarkLabel = document.getElementById('bookmarkLabel')!;
            async function initBookmarks() {
                if (!isDbStory) { bookmarkBtn.remove(); return; }
                const { data: { session: bSession } } = await supabase.auth.getSession();
                if (!bSession) {
                    bookmarkBtn.addEventListener('click', () => { likeHint.textContent = 'Log in to save stories for later.'; });
                    return;
                }
                let saved = false;
                const check = async () => {
                    const { data } = await supabase.from('bookmarks').select('id')
                        .eq('user_id', bSession.user.id).eq('story_id', slug).maybeSingle();
                    saved = !!data;
                    bookmarkBtn.classList.toggle('liked', saved);
                    bookmarkLabel.textContent = saved ? 'Saved' : 'Save';
                };
                await check();
                bookmarkBtn.addEventListener('click', async () => {
                    if (saved) {
                        await supabase.from('bookmarks').delete().eq('user_id', bSession.user.id).eq('story_id', slug);
                    } else {
                        await supabase.from('bookmarks').insert({ user_id: bSession.user.id, story_id: slug });
                    }
                    await check();
                });
            }
            initBookmarks();
                  // === 7.3 Completion rate — track when reader reaches the end ===
      (async () => {
        const storyEl = document.getElementById('storyContent');
        if (!storyEl) return;
        let marked = false;
        const observer = new IntersectionObserver(async (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting && !marked) {
              marked = true;
              observer.disconnect();
              // Insert a finished read row
              try {
                await supabase.from('reads').insert({
                  story_id: slug,
                  finished: true,
                });
              } catch { /* silent */ }
            }
          }
        }, { threshold: 0.9 });
        // Observe the story footer — the visible end of the piece. (The old target
        // '.story-end' doesn't exist, and lastElementChild is an invisible <script>,
        // which never intersects, so finished reads were never recorded.)
        const endMark = storyEl.querySelector('.story-footer') || storyEl.querySelector('.end-mark');
        if (endMark) observer.observe(endMark);
      })();
        </script>

        {/* === Comments (with replies) === */}
        <section id="commentsSection" class="comments-section" style="display: none;">
            <h2 class="comments-title"><span id="commentCount">0</span> Comments</h2>

            <form id="commentForm" class="comment-form">
                <textarea id="commentBody" class="comment-input" rows="3" maxlength="2000"
                placeholder="Leave a comment..."></textarea>
                <div class="comment-form-row">
                    <span id="commentHint" class="comment-hint"></span>
                    <button type="submit" class="comment-submit">Post Comment</button>
                </div>
            </form>

            <div id="commentList" class="comment-list"></div>
        </section>

        <script>
            import { supabase } from '../../lib/supabase';

            const slug = JSON.parse(document.getElementById('current-slug')?.textContent || '""');
            const isDbStory = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(slug);
            const section = document.getElementById('commentsSection')!;
            const list = document.getElementById('commentList')!;
            const countEl = document.getElementById('commentCount')!;
            const form = document.getElementById('commentForm') as HTMLFormElement;
            const bodyInput = document.getElementById('commentBody') as HTMLTextAreaElement;
            const hint = document.getElementById('commentHint')!;

            let me: any = null;
            let storyAuthorId: string | null = null;

            function esc(s: string) {
                return s.replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]!));
            }
            function timeAgo(iso: string) {
                const diff = Date.now() - new Date(iso).getTime();
                const m = Math.floor(diff / 60000);
                if (m < 1) return 'just now';
                if (m < 60) return m + 'm ago';
                const h = Math.floor(m / 60);
                if (h < 24) return h + 'h ago';
                const d = Math.floor(h / 24);
                return d + 'd ago';
            }

            async function loadComments() {
                const { data: rows } = await supabase
                    .from('comments')
                    .select('id, body, created_at, user_id, parent_id, display_name')
                    .eq('story_id', slug)
                    .order('created_at', { ascending: true });
                const all = rows || [];
                countEl.textContent = String(all.length);

                const byParent: Record<string, any[]> = {};
                all.forEach(c => { const k = c.parent_id || 'root'; (byParent[k] ||= []).push(c); });

                                    const renderOne = (c: any, isReply: boolean): string => {
                    const name = c.display_name || 'reader';
                    const canDelete = me && (me.id === c.user_id || me.id === storyAuthorId);
                    const replyBtn = (!isReply)
                        ? `<button class="reply-btn" data-id="${c.id}" data-name="${esc(name)}">Reply</button>` : '';
                    const delBtn = canDelete
                        ? `<button class="del-btn" data-id="${c.id}">🗑️</button>` : '';
                    const   reportBtn   =   `<button class="report-btn" data-id="${c.id}">⚑</button>`;
                    const replies: string = (byParent[c.id] || []).map((r: any) => renderOne(r, true)).join('');
                    
                    const isGuest = !c.user_id;
                    const avatarContent = isGuest 
                        ? ['🦉', '🌙', '📚', '✨', '🍃'][Math.abs(c.id.charCodeAt(0)) % 5]
                        : name.substring(0, 2).toUpperCase();
                    const avatarClass = isGuest ? 'comment-avatar guest' : 'comment-avatar';

                    return `
                      <div class="comment-card ${isReply ? 'comment-reply' : ''}" data-id="${c.id}">
                        <div class="comment-header">
                          <div class="${avatarClass}">${avatarContent}</div>
                          <div class="comment-meta">
                            <span class="comment-author">${esc(name)}</span>
                            <span class="comment-time">${timeAgo(c.created_at)}</span>
                          </div>
                        </div>
                        <p class="comment-body">${esc(c.body)}</p>
                        <div class="comment-actions"> ${ replyBtn }${ delBtn }${ reportBtn } </div>
                        ${replies ? `<div class="comment-replies">${replies}</div>` : ''}
                      </div>`;
                };
                list.innerHTML = (byParent['root'] || []).map(c => renderOne(c, false)).join('')
                    || '<p class="no-comments">No comments yet — be the first to leave one.</p>';

                list.querySelectorAll('.del-btn').forEach(b => b.addEventListener('click', async () => {
                    const id = (b as HTMLElement).dataset.id!;
                    await supabase.from('comments').delete().eq('id', id);
                    loadComments();
                }));
                list . querySelectorAll ( '.report-btn' ). forEach ( b   =>   b . addEventListener ( 'click' , ()  =>  {
                    const   cid   =  ( b   as   HTMLElement ). dataset .id ! ;
                    openCommentReport ( cid );
                }));
                list.querySelectorAll('.reply-btn').forEach(b => b.addEventListener('click', () => {
                    const name = (b as HTMLElement).dataset.name!;
                    bodyInput.value = `@${name} `;
                    bodyInput.focus();
                    bodyInput.dataset.replyTo = (b as HTMLElement).dataset.id!;
                    hint.textContent = 'Replying — post to send.';
                }));
            }

                 form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const body = bodyInput.value.trim();
                if (!body) return;
                const parentId = bodyInput.dataset.replyTo || null;

                let userId: string | null = null;
                const VISITOR_NAMES = ['Wandering Reader', 'Passing Stranger', 'Quiet Guest', 'Night Owl', 'Library Ghost'];
                let displayName = VISITOR_NAMES[Math.floor(Math.random() * VISITOR_NAMES.length)];
                if (me) {
                    userId = me.id;
                    const { data: prof } = await supabase
                        .from('profiles').select('pen_name').eq('user_id', me.id).maybeSingle();
                    displayName = prof?.pen_name || (me.email ?? 'reader').split('@')[0];
                }

                                const { error, data: newComment } = await supabase.from('comments').insert({
                    story_id: slug, user_id: userId, body, parent_id: parentId, display_name: displayName,
                }).select('id').single();
                if (error) { hint.textContent = 'Could not post: ' + error.message; return; }

                // Notify: reply → parent comment author; top-level → story author
                let notifyUserId: string | null = null;
                if (parentId) {
                    const { data: parent } = await supabase
                        .from('comments').select('user_id').eq('id', parentId).maybeSingle();
                    notifyUserId = parent?.user_id || null;
                } else {
                    const { data: storyRow } = await supabase
                        .from('stories').select('author_id').eq('id', slug).maybeSingle();
                    notifyUserId = storyRow?.author_id || null;
                }
                if (notifyUserId && notifyUserId !== userId) {
                    await supabase.from('notifications').insert({
                        user_id: notifyUserId,
                        actor_id: userId,
                        type: parentId ? 'reply' : 'comment',
                        story_id: slug,
                        comment_id: newComment?.id || null,
                        body_preview: body.slice(0, 120),
                    });
                }
                bodyInput.value = '';
                delete bodyInput.dataset.replyTo;
                hint.textContent = '';
                loadComments();
            });

            function   openCommentReport ( commentId :  string )  {
                let   modal   =   document . getElementById ( 'commentReportModal' );
                if  ( ! modal )  {
                    modal   =   document . createElement ( 'div' );
                    modal . id   =   'commentReportModal' ;
                    modal . className   =   'report-modal' ;
                    modal . innerHTML   =   `
                        <div class="report-backdrop"></div>
                        <div class="report-card">
                            <h3>Report this comment</h3>
                            <p class="report-sub">Help keep Raconteur quiet and kind.</p>
                            <select id="commentReportReason" class="report-select">
                                <option value="spam">Spam or advertising</option>
                                <option value="harassment">Harassment or abuse</option>
                                <option value="other">Something else</option>
                            </select>
                            <textarea id="reportDetails" placeholder="Describe the issue..." style="display:none; width:100%; margin-top:0.8rem; padding:0.8rem; border:1px solid #ddd2bb; border-radius:4px; font-family:inherit; font-size:0.9rem; resize:vertical; min-height:80px;"></textarea>
                            <div class="report-actions">
                                <button id="commentReportCancel" class="report-btn-cancel">Cancel</button>
                                <button id="commentReportSubmit" class="report-btn-submit">Submit report</button>
                            </div>
                            <p id="commentReportMsg" class="report-msg"></p>
                        </div>` ;
                    document . body . appendChild ( modal );
                    document . getElementById ( 'commentReportCancel' ) ! . addEventListener ( 'click' , ()  =>   modal ! . classList . remove ( 'open' ));
                    modal . querySelector ( '.report-backdrop' ) ! . addEventListener ( 'click' , ()  =>   modal ! . classList . remove ( 'open' ));
                    // Wire the reason select ONCE here — attaching it per-open stacked listeners
                    const reasonSelInit = document.getElementById('commentReportReason') as HTMLSelectElement;
                    reasonSelInit.addEventListener('change', (e) => {
                        const details = document.getElementById('reportDetails') as HTMLTextAreaElement;
                        if ((e.target as HTMLSelectElement).value === 'other') {
                            details.style.display = 'block';
                            details.required = true;
                        } else {
                            details.style.display = 'none';
