---
// src/components/TiptapEditor.astro
// A clean, distraction-free Tiptap editor with Smart Paste
---
<div class="tiptap-wrapper">
        <div class="tiptap-toolbar">
        <button type="button" class="tiptap-btn" data-command="bold" title="Bold (Ctrl+B)"><strong>B</strong></button>
        <button type="button" class="tiptap-btn" data-command="italic" title="Italic (Ctrl+I)"><em>I</em></button>
        <span class="tiptap-divider"></span>
        <button type="button" class="tiptap-btn" data-command="align-left" title="Align left">←</button>
        <button type="button" class="tiptap-btn" data-command="align-center" title="Align center">↔</button>
        <button type="button" class="tiptap-btn" data-command="align-right" title="Align right">→</button>
    </div>
    <div id="tiptap-editor" class="tiptap-content"></div>
</div>

<style>
    .tiptap-wrapper {
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(244, 237, 218, 0.2);
        border-radius: 4px;
        padding: 1rem;
        min-height: 300px;
        color: #f4edda;
        font-family: 'Georgia', serif;
        font-size: 1.05rem;
        line-height: 1.8;
        transition: border-color 0.2s;
    }
    .tiptap-wrapper:focus-within {
        border-color: #a8b89c;
    }
    /* Tiptap internal styles */
    :global(.ProseMirror) {
        outline: none;
        min-height: 280px;
    }
    :global(.ProseMirror p.is-editor-empty:first-child::before) {
        content: attr(data-placeholder);
        float: left;
        color: rgba(244, 237, 218, 0.4);
        pointer-events: none;
        height: 0;
        font-style: italic;
    }
            :global(.ProseMirror p) {
        margin-bottom: 1.2rem;
    }
    
    /* Explicit fallbacks if 'revert' isn't supported */
    :global(.ProseMirror p[style*="text-align: center"]) {
        text-align: center !important;
    }
    :global(.ProseMirror p[style*="text-align: right"]) {
        text-align: right !important;
    }
    :global(.ProseMirror p[style*="text-align: left"]) {
        text-align: left !important;
    }
    :global(.ProseMirror em) {
        font-style: italic;
    }
    :global(.ProseMirror strong) {
        font-weight: bold;
    }
    :global(.ProseMirror blockquote) {
        border-left: 3px solid #a8b89c;
        padding-left: 1rem;
        margin-left: 0;
        font-style: italic;
        color: #d8d0bc;
    }
       .tiptap-toolbar {
        display: flex;
        gap: 0.4rem;
        margin-bottom: 0.8rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid rgba(244, 237, 218, 0.15);
    }
    .tiptap-btn {
        background: transparent;
        border: 1px solid rgba(244, 237, 218, 0.25);
        border-radius: 4px;
        color: #f4edda;
        font-family: 'Georgia', serif;
        font-size: 0.95rem;
        padding: 0.3rem 0.7rem;
        cursor: pointer;
        transition: all 0.2s;
        min-width: 2.2rem;
        text-align: center;
    }
    .tiptap-btn:hover {
        background: rgba(244, 237, 218, 0.1);
        border-color: #a8b89c;
    }
    .tiptap-btn.is-active {
        background: #3d5a3c;
        color: #f4ede0;
        border-color: #3d5a3c;
    }
        .tiptap-divider {
        width: 1px;
        background: rgba(244, 237, 218, 0.2);
        margin: 0 0.3rem;
        align-self: stretch;
    }
</style>

<script>
    import { Editor } from '@tiptap/core';
    import StarterKit from '@tiptap/starter-kit';
    import Placeholder from '@tiptap/extension-placeholder';
        import Paragraph from '@tiptap/extension-paragraph';

    // Paragraph + text-align attribute (no external extension needed)
    const AlignedParagraph = Paragraph.extend({
        addAttributes() {
            return {
                ...this.parent?.(),
                textAlign: {
                    default: null,
                    parseHTML: (el: HTMLElement) => el.style.textAlign || null,
                    renderHTML: (attrs: any) => attrs.textAlign ? { style: `text-align: ${attrs.textAlign}` } : {},
                },
            };
        },
    });

    // Expose a global function so submit.astro can grab the HTML content
        (window as any).getTiptapContent = () => {
        const editor = (window as any).tiptapEditor;
        return editor ? editor.getHTML() : '';
    };

    // Expose a global function so submit.astro can set content (for Edit mode)
       (window as any).setTiptapContent = (html: string) => {
        const editor = (window as any).tiptapEditor;
        if (editor) {
            editor.commands.setContent(html);
        }
    };

    document.addEventListener('DOMContentLoaded', () => {
        const editorElement = document.getElementById('tiptap-editor');
        if (!editorElement) return;

        const editor = new Editor({
            element: editorElement,
                        extensions: [
                    StarterKit.configure({
                    paragraph: false,
                    heading: false,
                    bulletList: false,
                    orderedList: false,
                    listItem: false,
                }),
                Placeholder.configure({
                    placeholder: 'Begin your story here...',
                }),
                               AlignedParagraph,
            ],
            content: '',
                editorProps: {
                    handlePaste(view, event) {
                    const rawHtml = event.clipboardData?.getData('text/html');
                    const rawText = event.clipboardData?.getData('text/plain');

                    // POETRY MODE: every line stays a line; blank line = stanza break
                    if ((window as any).raconteurPoemMode && rawText) {
    event.preventDefault();
    const stanzas: string[] = [];
    let current: string[] = [];
    rawText.split(/\r?\n/).forEach(line => {
        const t = line.trim();
        if (t === '') {
            if (current.length) { stanzas.push(current.join('<br>')); current = []; }
        } else {
            current.push(t);
        }
    });
    if (current.length) stanzas.push(current.join('<br>'));
    if (stanzas.length) {
        editor.chain().focus().insertContent(stanzas.map(s => `<p>${s}</p>`).join('')).run();
    }
    return true;
}

                    // PREFERRED: cleaned HTML — rebuild ONLY non-empty paragraphs
                    if (rawHtml) {
                        const stripped = rawHtml
                            .replace(/<style[^>]*>[\s\S]*?<\/style>/gi, '')
                            .replace(/<!--[\s\S]*?-->/g, '')
                            // keep only literary tags
                            .replace(/<\/?(?!p|br|em|i|strong|b|blockquote)[a-z][^>]*>/gi, '')
                            // strip every attribute
                            .replace(/<([a-z]+)[^>]*>/gi, '<$1>');
                        const blocks = Array.from(stripped.matchAll(/<(p|blockquote)>([\s\S]*?)<\/\1>/gi))
                            .map(m => ({
                                tag: m[1],
                                inner: m[2].replace(/<br\s*\/?>/gi, ' ').replace(/\s+/g, ' ').trim(),
                            }))
                            .filter(b => b.inner.length > 0);
                        if (blocks.length > 0) {
                            event.preventDefault();
                            const html = blocks.map(b => `<${b.tag}>${b.inner}</${b.tag}>`).join('');
                            editor.chain().focus().insertContent(html).run();
                            return true;
                        }
                    }

                    // FALLBACK: plain text — every newline becomes a paragraph
                    if (rawText) {
                        event.preventDefault();
                        const paragraphs = rawText
                            .split(/\r?\n/)
                            .map(p => p.replace(/\s+/g, ' ').trim())
                            .filter(Boolean);
                        editor.chain().focus().insertContent(
                            paragraphs.map(p => ({ type: 'paragraph', content: [{ type: 'text', text: p }] }))
                        ).run();
                        return true;
                    }
                    return false;
                },
            },
        });

                (window as any).tiptapEditor = editor;

               // Wire toolbar buttons
        const toolbar = document.querySelector('.tiptap-toolbar');
        if (toolbar) {
            toolbar.querySelectorAll('.tiptap-btn').forEach(btn => {
                                // Keep the editor's text selection alive — without this, mousedown
                // blurs the editor and the align command lands on the wrong block
                btn.addEventListener('mousedown', (e) => e.preventDefault());
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const ed = (window as any).tiptapEditor;
                    if (!ed) return;
                    const command = (btn as HTMLElement).dataset.command;
                    if (command === 'bold') ed.chain().focus().toggleBold().run();
                    if (command === 'italic') ed.chain().focus().toggleItalic().run();
                                        if (command === 'align-left') ed.chain().focus().updateAttributes('paragraph', { textAlign: 'left' }).run();
                    if (command === 'align-center') ed.chain().focus().updateAttributes('paragraph', { textAlign: 'center' }).run();
                    if (command === 'align-right') ed.chain().focus().updateAttributes('paragraph', { textAlign: 'right' }).run();
                    updateToolbarState();
                });
            });
        }

        // Update active states when selection changes
        function updateToolbarState() {
            const ed = (window as any).tiptapEditor;
            if (!ed) return;
            const boldBtn = document.querySelector('[data-command="bold"]');
            const italicBtn = document.querySelector('[data-command="italic"]');
            const leftBtn = document.querySelector('[data-command="align-left"]');
            const centerBtn = document.querySelector('[data-command="align-center"]');
            const rightBtn = document.querySelector('[data-command="align-right"]');
            if (boldBtn) boldBtn.classList.toggle('is-active', ed.isActive('bold'));
            if (italicBtn) italicBtn.classList.toggle('is-active', ed.isActive('italic'));
                        if (leftBtn) leftBtn.classList.toggle('is-active', ed.isActive('paragraph', { textAlign: 'left' }));
            if (centerBtn) centerBtn.classList.toggle('is-active', ed.isActive('paragraph', { textAlign: 'center' }));
            if (rightBtn) rightBtn.classList.toggle('is-active', ed.isActive('paragraph', { textAlign: 'right' }));
        }

        editor.on('selectionUpdate', updateToolbarState);
        editor.on('transaction', updateToolbarState);
    });
</script>