---
// SkinToggle.astro — the skin switcher: Raconteur Classic / Raconteur+ / Raconteur Pro.
// Self-contained: works on ALL THREE skins (classic pages, /pro pages, /max pages).
// Pure server-rendered anchors — no client JS, no state to hydrate.
// Query strings are preserved so ?edit=, ?next=, etc. survive the switch.
// variant="regal" — the brass-and-obsidian crown used in the Raconteur+ masthead;
// variant="editorial" — the paper pill used in the Raconteur Pro masthead;
// default (no prop) keeps the classic cream pill untouched.
import { isProPath, isMaxPath, isHomePath, toProPath, toMaxPath, toClassicPath } from '../../lib/skin';
import Icon from '../Icon.astro';

const here = Astro.url.pathname;
const onPro = isProPath(here);
const onMax = isMaxPath(here);
const onNew = onPro || onMax; // either modern edition
const onHome = isHomePath(here); // the switch only lives on the home pages
// Cross-skin arrivals carry ?welcome=1 so the destination renders
// born-covered: every skin — Classic included — greets its visitors with
// the letter-by-letter wordmark ceremony. In-skin buttons stay clean.
const q = Astro.url.search;
const suffix = (flag: string) => (q ? '&' : '?') + flag;
const classicHref = onNew ? toClassicPath(here) + q + suffix('welcome=1') : toClassicPath(here) + q;
const proHref = onPro ? toProPath(here) + q : toProPath(here) + q + suffix('welcome=1');
const maxHref = onMax ? toMaxPath(here) + q : toMaxPath(here) + q + suffix('welcome=1');

interface Props {
    variant?: 'classic' | 'regal' | 'editorial';
}
const { variant = 'classic' } = Astro.props;

// Boss mandate (Session 16): the skin switch appears on the home pages
// ONLY — inner pages of every skin carry no toggle. The layouts also gate
// their wrapper divs, but the component self-guards so it can never leak
// onto an inner page regardless of where it's mounted.
if (!onHome) return;
---

<div class={`skin-toggle-row ${variant === 'regal' ? 'regal' : variant === 'editorial' ? 'editorial' : ''}`}>
    <div class={`skin-toggle ${variant === 'regal' ? 'regal' : variant === 'editorial' ? 'editorial' : ''}`} data-skin={onMax ? 'max' : (onPro ? 'pro' : 'classic')} role="group" aria-label="Choose site design">
        <a
            href={classicHref}
            data-dest="classic"
            data-cross={onNew ? '1' : undefined}
            class={`toggle-btn classic ${!onNew ? 'active' : ''}`}
            aria-current={!onNew ? 'page' : undefined}
            title="The original Raconteur — the Classic edition"
        >
            Raconteur <span class="classic-sign">Classic</span>
        </a>
        <a
            href={proHref}
            data-dest="pro"
            data-cross={onPro ? undefined : '1'}
            class={`toggle-btn pro ${onPro ? 'active' : ''}`}
            aria-current={onPro ? 'page' : undefined}
            title="The Reader's Desk · the Raconteur+ edition"
        >
            Raconteur<span class="pro-sign">+</span>
        </a>
        <a
            href={maxHref}
            data-dest="max"
            data-cross={onMax ? undefined : '1'}
            class={`toggle-btn max ${onMax ? 'active' : ''}`}
            aria-current={onMax ? 'page' : undefined}
            title="The Editorial Split · the Raconteur Pro edition"
        >
            Raconteur <span class="max-sign">Pro</span>
        </a>
    </div>
    {/* The ceremony voice — mute control (boss order, 2026-09-14). Both
        glyphs ship server-rendered; CSS swaps them via aria-pressed, so
        no JS-injected markup ever needs the scoped styles. */}
    <button
        type="button"
        class="skin-mute-btn"
        aria-pressed="true"
        title="Mute the ceremony sounds"
        aria-label="Toggle the skin ceremony sounds"
    >
        <span class="snd-on"><Icon name="volume-2" size={14} stroke={2} /></span>
        <span class="snd-off"><Icon name="volume-x" size={14} stroke={2} /></span>
    </button>
</div>

<script is:inline>
    // Born-correct glyph: sync the pressed state from localStorage the
    // instant the row parses — no module import, no flash of the wrong
    // icon for muted visitors. Key mirrors AUDIO_KEY in lib/ceremony-audio.
    (function () {
        try {
            if (localStorage.getItem('raconteur.ceremony-audio') === 'off') {
                var b = document.querySelector('.skin-mute-btn');
                if (b) b.setAttribute('aria-pressed', 'false');
            }
        } catch (e) { /* no storage → default ON */ }
    })();
</script>

<style>
    .skin-toggle-row {
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .skin-toggle {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px;
        border: 1px solid rgba(228, 221, 200, 0.35);
        border-radius: 999px;
        background: rgba(30, 36, 32, 0.35);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .toggle-btn {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        padding: 0.3rem 0.95rem;
        border-radius: 999px;
        font-family: 'Lora', Georgia, serif;
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.4px;
        color: rgba(228, 221, 200, 0.75);
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.25s, background 0.25s, box-shadow 0.25s;
    }

    .toggle-btn:hover {
        color: #f4ede0;
    }

    .toggle-btn.active {
        background: #f4ede0;
        color: #1e2420;
        box-shadow: 0 2px 10px rgba(244, 237, 224, 0.25);
    }

    /* The Classic button carries the aged-ink identity in every skin.
       Boss polish (2026-09-14): the edition word becomes a small raised
       seal — 0.58em, lifted off the baseline like a superscript stamp —
       so it stops crowding the pill. The "Pro" tail below gets the same
       lift so both edition seals sit at one height. */
    .toggle-btn.classic .classic-sign {
        font-weight: 700;
        margin-left: 3px;
        font-size: 0.58em;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        position: relative;
        top: -0.7em;
        color: #8a7f6a; /* the aged-ink grey of the classic paper */
        transition: color 0.25s;
    }

    .toggle-btn.classic.active .classic-sign { color: #57504a; } /* deep ink on cream pill */

    .toggle-btn.classic:hover:not(.active) {
        box-shadow: inset 0 0 0 1px rgba(138, 127, 106, 0.5);
    }

    /* The Raconteur+ button carries the amber identity in every skin */
    .toggle-btn.pro .pro-sign {
        font-weight: 700;
        margin-left: 1px;
        font-size: 0.95em;
        color: #ff6a00;
        transition: color 0.25s;
    }

    .toggle-btn.pro.active .pro-sign { color: #7a3400; } /* dark amber on cream pill */

    .toggle-btn.pro:hover:not(.active) {
        box-shadow: inset 0 0 0 1px rgba(255, 106, 0, 0.5);
    }

    /* The Raconteur Pro button carries the vermilion identity in every skin */
    .toggle-btn.max .max-sign {
        font-weight: 700;
        margin-left: 3px;
        font-size: 0.62em;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        position: relative;
        top: -0.7em; /* the same raised seal as "Classic" — one height */
        color: #d8341c;
        transition: color 0.25s;
    }

    .toggle-btn.max.active .max-sign { color: #7d1e12; } /* dark vermilion on cream pill */

    .toggle-btn.max:hover:not(.active) {
        box-shadow: inset 0 0 0 1px rgba(216, 52, 28, 0.5);
    }

    /* === REGAL VARIANT — the /plus masthead crown ===
       Brass-and-obsidian: gilded brass border on deep obsidian glass,
       active pill poured in brass gradient. The classic cream pill
       above stays untouched — this only styles .skin-toggle.regal. */
    .skin-toggle.regal {
        padding: 3px;
        gap: 3px;
        border: 1px solid rgba(201, 162, 75, 0.42);
        background: rgba(26, 18, 12, 0.6);
        backdrop-filter: blur(12px) saturate(1.15);
        -webkit-backdrop-filter: blur(12px) saturate(1.15);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45), inset 0 0 0 1px rgba(201, 162, 75, 0.08);
    }

    .skin-toggle.regal .toggle-btn {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.07em;
        padding: 0.3rem 0.95rem;
        color: rgba(242, 238, 227, 0.6);
    }

    .skin-toggle.regal .toggle-btn:hover {
        color: #f2eee3;
    }

    .skin-toggle.regal .toggle-btn.active {
        background: linear-gradient(135deg, #e6cc7d 0%, #c9a24b 55%, #a8842f 100%);
        color: #17110a;
        box-shadow:
            0 2px 12px rgba(201, 162, 75, 0.45),
            inset 0 1px 0 rgba(255, 244, 214, 0.55);
    }

    .skin-toggle.regal .toggle-btn.classic .classic-sign {
        color: rgba(242, 238, 227, 0.75);
    }

    .skin-toggle.regal .toggle-btn.classic.active .classic-sign {
        color: #17110a;
    }

    /* === EDITORIAL VARIANT — the Max masthead pill ============================
       Paper on paper: hairline ink border on translucent warm paper, the
       active pill pours ink (vermilion for the max button). The classic
       cream pill and the regal crown above stay untouched. */
    .skin-toggle.editorial {
        padding: 3px;
        gap: 3px;
        border: 1px solid rgba(28, 25, 23, 0.22);
        background: rgba(250, 246, 239, 0.75);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: 0 4px 18px rgba(28, 25, 23, 0.08);
    }

    .skin-toggle.editorial .toggle-btn {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        padding: 0.3rem 0.9rem;
        color: rgba(28, 25, 23, 0.55);
    }

    .skin-toggle.editorial .toggle-btn:hover { color: #1c1917; }

    .skin-toggle.editorial .toggle-btn.active {
        background: #1c1917;
        color: #faf6ef;
        box-shadow: 0 2px 10px rgba(28, 25, 23, 0.25);
    }

    .skin-toggle.editorial .toggle-btn.classic .classic-sign { color: #8a7f6a; }
    .skin-toggle.editorial .toggle-btn.pro .pro-sign { color: #c25a12; }
    .skin-toggle.editorial .toggle-btn.max .max-sign { color: #d8341c; }

    .skin-toggle.editorial .toggle-btn.classic.active .classic-sign { color: #f4ede0; }
    .skin-toggle.editorial .toggle-btn.pro.active .pro-sign { color: #ffb27a; }
    .skin-toggle.editorial .toggle-btn.max.active .max-sign { color: #ff6a4a; }

    .skin-toggle.editorial .toggle-btn:hover:not(.active) {
        box-shadow: inset 0 0 0 1px rgba(28, 25, 23, 0.28);
    }

    @media (max-width: 640px) {
        .toggle-btn { padding: 0.25rem 0.75rem; font-size: 0.75rem; }
        .skin-toggle.regal .toggle-btn { font-size: 0.68rem; padding: 0.26rem 0.8rem; }
        .skin-toggle.editorial .toggle-btn { font-size: 0.66rem; padding: 0.26rem 0.62rem; }
    }

    /* === THE CEREMONY VOICE — the mute button (boss order, 2026-09-14) ===
       A quiet round switch beside the pill. Both glyphs ship server-rendered;
       aria-pressed swaps them — zero JS-injected markup, so these scoped
       styles always apply (the scoping-bug lesson from the bells). */
    .skin-mute-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        padding: 0;
        border: 1px solid rgba(228, 221, 200, 0.35);
        border-radius: 50%;
        background: rgba(30, 36, 32, 0.35);
        color: rgba(228, 221, 200, 0.75);
        cursor: pointer;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: color 0.25s, border-color 0.25s, box-shadow 0.25s;
    }

    .skin-mute-btn:hover { color: #f4ede0; }

    .skin-mute-btn .snd-off { display: none; }
    .skin-mute-btn[aria-pressed='false'] .snd-on { display: none; }
    .skin-mute-btn[aria-pressed='false'] .snd-off { display: inline-flex; }
    .skin-mute-btn[aria-pressed='false'] { color: rgba(228, 221, 200, 0.45); }

    /* The regal crown beside the brass pill (Raconteur+ home) */
    .skin-toggle-row.regal .skin-mute-btn {
        border-color: rgba(201, 162, 75, 0.42);
        background: rgba(26, 18, 12, 0.6);
        color: rgba(242, 238, 227, 0.7);
        box-shadow: inset 0 0 0 1px rgba(201, 162, 75, 0.08);
    }

    .skin-toggle-row.regal .skin-mute-btn:hover { color: #f2eee3; border-color: rgba(201, 162, 75, 0.6); }

    /* The editorial paper pill beside the ink pill (Raconteur Pro home) */
    .skin-toggle-row.editorial .skin-mute-btn {
        border-color: rgba(28, 25, 23, 0.22);
        background: rgba(250, 246, 239, 0.75);
        color: rgba(28, 25, 23, 0.55);
    }

    .skin-toggle-row.editorial .skin-mute-btn:hover { color: #1c1917; }
</style>

<script is:inline>
    // === DEPARTURE VEIL ======================================================
    // A skin switch should never be a hard cut: when a visitor clicks the
    // OTHER skin's button, a full-screen veil fades up over the current
    // page FIRST — wearing the destination's exact cover — and only then
    // do we navigate. Color never leaves the screen between click and
    // reveal. Runs only on the three home pages, where the toggle lives.
    (function () {
        // Reduced motion → plain navigation; arrivals still self-clean and
        // the no-JS failsafes still fire.
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        var sealed = false; // one-shot guard

        function veilThenGo(href) {
            if (sealed) return;
            sealed = true;
            var v = document.createElement('div');
            v.className = 'skin-veil';
            v.setAttribute('aria-hidden', 'true');
            document.body.appendChild(v);
            document.documentElement.classList.add('ss-lock');

            // The veil wears the DESTINATION's exact cover so the handoff
            // at navigation time is pixel-identical:
            // → pro: the Reader's Desk amber-on-void (matches .skin-splash-pro)
            // → max: Editorial paper + vermilion (matches .skin-splash-max)
            // → classic: the homecoming cream (matches .skin-splash-classic)
            var path = href.replace(/^https?:\/\/[^/]+/, '').split('?')[0];
            var bg;
            if (path === '/max') {
                bg = 'radial-gradient(90% 80% at 85% 90%, rgba(216, 52, 28, 0.30) 0%, rgba(216, 52, 28, 0) 55%),'
                   + 'radial-gradient(80% 70% at 10% 8%, rgba(201, 162, 75, 0.18) 0%, rgba(201, 162, 75, 0) 50%),'
                   + '#faf6ef';
            } else if (path === '/pro') {
                bg = 'radial-gradient(85% 70% at 78% 6%, rgba(255, 106, 0, 0.34) 0%, rgba(255, 106, 0, 0) 60%),'
                   + 'radial-gradient(70% 60% at 8% 96%, rgba(46, 230, 168, 0.22) 0%, rgba(46, 230, 168, 0) 60%),'
                   + '#241a12';
            } else {
                bg = 'radial-gradient(120% 100% at 50% 30%, #fffdf5 0%, #f7f0dd 61%, #efe5cc 100%)';
            }
            v.style.background = bg;
            v.style.opacity = '0';
            requestAnimationFrame(function () {
                v.style.transition = 'opacity 0.5s cubic-bezier(0.4, 0, 0.23, 1)';
                v.style.opacity = '1';
            });

            // Fade completes at 0.5s; hold fully covered a beat so the
            // navigation lands on a saturated screen, then go.
            window.setTimeout(function () { window.location.assign(href); }, 850);

            // Failsafe: if we're somehow still here 5s later (navigation
            // died), quietly undo the veil and unlock.
            window.setTimeout(function () {
                v.style.opacity = '0';
                v.style.pointerEvents = 'none';
                window.setTimeout(function () { v.remove(); }, 500);
                document.documentElement.classList.remove('ss-lock');
                sealed = false;
            }, 5000);
        }

        // Capture-phase listener — one handler covers every toggle instance
        // (cream pill on the Classic home, regal crown on the Raconteur+ home,
        // paper pill on the Raconteur Pro home). Modifier
        // clicks (new tab etc.) are left to the browser.
        document.addEventListener('click', function (ev) {
            if (sealed) return;
            var a = ev.target && ev.target.closest ? ev.target.closest('a[data-cross="1"]') : null;
            if (!a) return;
            if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey || ev.button !== 0) return;
            ev.preventDefault();
            ev.stopPropagation();
            veilThenGo(a.href);
        }, true);

        // bfcache: if the visitor returns to the departing page mid-veil
        // (back button), lift the veil instantly — never trap them.
        window.addEventListener('pageshow', function (e) {
            if (e.persisted && sealed) {
                var v = document.querySelector('.skin-veil');
                if (v) v.remove();
                document.documentElement.classList.remove('ss-lock');
                sealed = false;
            }
        });
    })();
</script>

<script>
    // === THE CEREMONY VOICE (boss order, 2026-09-14) =========================
    // Bundled (Vite-processed): the departure chime plays INSIDE the click
    // gesture — the one moment every browser allows audio — and the mute
    // button persists its state. The veil mechanic above stays is:inline
    // and dependency-free by design.
    import { playDeparture, readAudioEnabled, writeAudioEnabled } from '../../lib/ceremony-audio';

    // The departure chime — one listener covers every toggle instance.
    document.addEventListener('click', function (ev: MouseEvent) {
        const target = ev.target as HTMLElement | null;
        const a = target && target.closest ? target.closest<HTMLAnchorElement>('a[data-cross="1"]') : null;
        if (!a) return;
        if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey || ev.button !== 0) return;
        playDeparture(a.dataset.dest);
    }, true);

    // The mute button — one tap flips the glyph (aria-pressed) and the
    // stored state; every ceremony on every skin goes silent until flipped
    // back. Both glyphs ship server-rendered, CSS swaps them.
    const muteBtn = document.querySelector<HTMLElement>('.skin-mute-btn');
    if (muteBtn) {
        muteBtn.addEventListener('click', function () {
            const on = readAudioEnabled();
            writeAudioEnabled(!on);
            muteBtn.setAttribute('aria-pressed', String(!on));
            muteBtn.title = !on ? 'Mute the ceremony sounds' : 'Play the ceremony sounds';
        });
    }
</script>

<style is:global>
    /* Scroll lock while any curtain is up (shared rule — ships with the
       toggle, so it exists on every skin's pages). */
    html.ss-lock { overflow: hidden; }

    /* === DEPARTURE VEIL — full-screen cover, above the page, one step
       below the arrival curtains so handoffs always render correctly. */
    .skin-veil {
        position: fixed;
        inset: 0;
        z-index: 2147483646; /* one below the splash (…647) — arrival wins */
        opacity: 0;
    }
</style>
