---
// SkinSplash.astro — the royal entrance interstitial.
// When a visitor switches skins (Raconteur → Raconteur+), the SkinToggle
// appends ?welcome=1 to the destination link. This component detects that
// param, covers the screen, spells the brand letter-by-letter, holds for
// a beat when the "+" lands, then lifts to reveal the page beneath.
//
// The MECHANIC (letter-by-letter reveal → hold → lift) is shared by every
// skin; the LOOK is per-variant. variant="plus" uses the boss's Mesher
// settings (csshero.org/mesher): bg hsla(263,100%,50%,1) with palette
// blobs hsla(28,100%,74%,1) + hsla(189,100%,56%,1), grain 0.
// variant="pro" / "max" are reserved — they will get their own landing
// looks (NOT this gradient) when those skins are built.
//
// No splash without the param (direct visits, refreshes, in-skin nav) and
// the param is scrubbed from the URL the instant it's read. Click skips.
interface Props {
    variant?: 'plus' | 'pro' | 'max';
    /** Server-side activation (?welcome=1): the page is BORN covered — no
     *  flash of content before the curtain and no dependence on JS timing.
     *  The departure veil on the old page hands off to this seamlessly
     *  because both wear the identical Mesher background. */
    eager?: boolean;
}
const { variant = 'plus', eager = false } = Astro.props as any;
const isPro = variant === 'pro';

// Letter-by-letter timing — Session 17: the full ceremony re-tempoed for
// a professional, unhurried reveal. First letter at 0.50s, +0.25s per
// glyph, each entrance takes 1.05s (expo-out) → the accent fully landed
// shortly after; hold 1.5s; lift takes 1.1s.
const glyphs = (isPro ? 'Raconteur Pro' : 'Raconteur+').split('');
const stagger = 0.25;
const first = 0.50;
const letterDur = 1.05;
const hold = 1.5;
// The accent tail: "+" for plus (index 9), "Pro" for pro (indices 10-12)
const accentFrom = isPro ? 10 : 9;
const lastArrives = first + (glyphs.length - 1) * stagger + letterDur;
const duration = Math.round((lastArrives + hold) * 1000); // ms until lift begins
---

<div
    class:list={['skin-splash', `skin-splash-${variant}`]}
    id="skinSplash"
    data-variant={variant}
    data-duration={String(duration)}
    data-active={eager ? 'true' : 'false'}
    aria-hidden="true"
>
    <div class="ss-bg" aria-hidden="true"></div>
    <div class="ss-core">
        <div class="ss-word" aria-label={isPro ? 'Raconteur Pro' : 'Raconteur+'}>
            {glyphs.map((ch: string, i: number) => (
                <span
                    class:list={['ss-letter', { 'ss-plus': !isPro && ch === '+', 'ss-accent-pro': isPro && i >= accentFrom }]}
                    style={`animation-delay:${(first + i * stagger).toFixed(2)}s`}
                    aria-hidden="true"
                >
                    {ch === ' ' ? '\u00A0' : ch}
                </span>
            ))}
        </div>
        <p class="ss-tagline" style={`animation-delay:${(lastArrives - 0.6).toFixed(2)}s`}>
            Literature you want to read
        </p>
    </div>
</div>

{/* No-JS safety: an eagerly-rendered curtain must never trap a visitor
    who has scripting disabled — hide it entirely and show the page. */}
<noscript>
    <style>.skin-splash { display: none !important; }</style>
</noscript>

<style>
    /* === The cover === */
    .skin-splash {
        position: fixed;
        inset: 0;
        z-index: 2147483647; /* above everything, film-grain included */
        display: none; /* stays out of the way until summoned */
        align-items: center;
        justify-content: center;
        overflow: hidden;
        cursor: pointer;
    }

    .skin-splash[data-active='true'] {
        display: flex;
    }

    .skin-splash[data-leaving='true'] {
        opacity: 0;
        transform: scale(1.04);
        pointer-events: none;
        transition: opacity 1.1s cubic-bezier(0.4, 0, 0.2, 1), transform 1.1s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* === VARIANT: plus — the Mesher gradient, exactly as exported ===
       bg hsla(263,100%,50%,1) · palette hsla(28,100%,74%,1) + hsla(189,100%,56%,1) · grain 0 */
    .skin-splash-plus .ss-bg {
        position: absolute;
        inset: 0;
        background-color: hsla(263, 100%, 50%, 1);
        background-image:
            radial-gradient(at 10% 15%, hsla(28, 100%, 74%, 1) 0px, transparent 55%),
            radial-gradient(at 38% 28%, hsla(28, 100%, 74%, 1) 0px, transparent 45%),
            radial-gradient(at 2% 55%, hsla(28, 100%, 70%, 1) 0px, transparent 40%),
            radial-gradient(at 78% 8%, hsla(189, 100%, 56%, 1) 0px, transparent 50%),
            radial-gradient(at 100% 38%, hsla(189, 100%, 56%, 1) 0px, transparent 45%),
            radial-gradient(at 65% 100%, hsla(263, 100%, 45%, 1) 0px, transparent 50%);
        animation: ss-bg-swell 9s ease-in-out infinite alternate;
    }

    /* === VARIANT: pro — The Reader's Desk: near-black void, desk-lamp
       amber bloom + reading-nook mint at the floor. Original expression
       (boss mandate: Pro does NOT reuse the plus gradient). === */
    .skin-splash-pro .ss-bg {
        position: absolute;
        inset: 0;
        background-color: #06080a;
        background-image:
            radial-gradient(85% 70% at 78% 6%, rgba(255, 106, 0, 0.34) 0%, rgba(255, 106, 0, 0) 60%),
            radial-gradient(70% 60% at 8% 96%, rgba(46, 230, 168, 0.22) 0%, rgba(46, 230, 168, 0) 60%);
        animation: ss-bg-swell 9s ease-in-out infinite alternate;
    }

    @keyframes ss-bg-swell {
        from { transform: scale(1); }
        to   { transform: scale(1.06); }
    }

    /* === The word — giant Fraunces, letters materialise one by one === */
    .ss-core {
        position: relative;
        text-align: center;
        padding: 0 1.5rem;
    }

    .ss-word {
        display: flex;
        justify-content: center;
        font-family: 'Fraunces', Georgia, serif;
        font-weight: 900;
        font-size: clamp(3.2rem, 13vw, 8.5rem);
        line-height: 1;
        letter-spacing: 0.01em;
        color: #fdfbf6;
    }

    /* Pro wordmark — Outfit (the Pro system font), a touch tighter */
    .skin-splash-pro .ss-word {
        font-family: 'Outfit', 'Segoe UI', system-ui, sans-serif;
        font-weight: 700;
        font-size: clamp(2.9rem, 11vw, 7.2rem);
        letter-spacing: -0.015em;
        color: #f4f6f7;
    }

    .ss-letter {
        display: inline-block;
        opacity: 0;
        animation: ss-letter-in 1.05s cubic-bezier(0.16, 1, 0.3, 1) both;
        text-shadow: 0 6px 44px rgba(20, 0, 50, 0.45);
    }

    /* The "+" lands in Mesher peach — the payoff moment */
    .ss-letter.ss-plus {
        color: hsla(28, 100%, 74%, 1);
        text-shadow: 0 0 70px rgba(255, 255, 255, 0.4);
    }

    /* Pro: the "Pro" tail lands in amber, mint glow beneath */
    .skin-splash-pro .ss-letter.ss-accent-pro {
        color: #ff6a00;
        text-shadow: 0 0 60px rgba(255, 106, 0, 0.55);
    }

    @keyframes ss-letter-in {
        from {
            opacity: 0;
            transform: translateY(0.5em) scale(0.92);
            filter: blur(18px);
        }
        to {
            opacity: 1;
            transform: none;
            filter: blur(0);
        }
    }

    .ss-tagline {
        margin: 1.6rem 0 0;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.38em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.88);
        opacity: 0;
        animation: ss-letter-in 1s ease both;
    }

    /* === Manners === */
    @media (prefers-reduced-motion: reduce) {
        .ss-letter, .ss-tagline { animation-duration: 0.01s; }
        .skin-splash-plus .ss-bg, .skin-splash-pro .ss-bg { animation: none; }
        .skin-splash[data-leaving='true'] { transition-duration: 0.3s; }
    }

    /* Scroll lock while the curtain is up — the script below adds .ss-lock
       to <html>; this rule (found missing at the Session 14 handoff) keeps
       the page beneath from scrolling behind the splash. */
    :global(html.ss-lock) {
        overflow: hidden;
    }
</style>

<script is:inline>
    (function () {
        var splash = document.getElementById('skinSplash');
        if (!splash) return;

        // Only ever summoned by a skin switch (?welcome=1 on the landing URL).
        var params = new URLSearchParams(window.location.search);
        if (params.get('welcome') !== '1') {
            splash.remove();
            return;
        }

        // Scrub the flag from the address bar immediately — refreshes and
        // re-shares of this URL are just the page, never a replay.
        params.delete('welcome');
        var rest = params.toString();
        var clean = window.location.pathname + (rest ? '?' + rest : '') + window.location.hash;
        window.history.replaceState({}, '', clean);

        // Lock scroll while the curtain is up. (When the page arrived via
        // the toggle, the splash is already active from the server — eager
        // mode — so this is a no-op and there is no flash of the page.)
        document.documentElement.classList.add('ss-lock');
        splash.dataset.active = 'true';

        // Reduced motion: the word shows statically for a beat, then a
        // quick fade — no long held curtain for visitors who opted out.
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var total = reduced ? 1400 : (Number(splash.dataset.duration) || 5300);
        var done = false;
        var finish = function () {
            if (done) return;
            done = true;
            splash.dataset.leaving = 'true';
            window.setTimeout(function () {
                splash.remove();
                document.documentElement.classList.remove('ss-lock');
            }, reduced ? 350 : 1200);
        };

        window.setTimeout(finish, total);
        splash.addEventListener('click', finish); // the impatient exit

        // bfcache: if the page is restored mid-ceremony (back button),
        // end it instantly rather than trapping the visitor.
        window.addEventListener('pageshow', function (e) {
            if (e.persisted) finish();
        });
    })();
</script>

