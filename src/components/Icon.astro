---
// src/components/Icon.astro — the shared inline-SVG icon system (de-vibe DR1).
// One stroke-based set, 24px grid, currentColor — replaces emoji-as-icons in
// the new skins (plus / pro / max). Classic skin stays untouched (frozen).
import { iconPaths as paths } from '../lib/iconPaths';

interface Props {
    name: string;
    size?: number;
    class?: string;
    stroke?: number;
}
const { name, size = 18, class: className = '', stroke = 1.8 } = Astro.props;

const d = paths[name] || paths.sparkle;
---

<svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={stroke}
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
    set:html={d}
/>
