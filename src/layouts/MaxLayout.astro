---
// MaxLayout.astro — the Raconteur Pro shell ("The Editorial Split").
// DUAL-MODE skin per boss brief (Session 20):
//   · HOME (/max): editorial design — paper, ink, split compositions.
//   · INNER (/max/**): bright glassmorphism with movement.
// The body carries data-max-mode so max.css can switch systems.
import { getVisibleStories } from '../data/stories';
import { supabase } from '../lib/supabase';
import SkinToggle from '../components/skin/SkinToggle.astro';
import SkinSplash from '../components/skin/SkinSplash.astro';
import Icon from '../components/Icon.astro';
import '../styles/max.css';

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
}

// Same search-index queries as BaseLayout (feature parity — no schema changes)
const { data: searchDbRows } = await supabase
    .from('stories')
    .select('id,title,author_name,genre_tag,kind')
    .eq('status', 'published');
const searchStories = [
    ...getVisibleStories().map((s: any) => ({ slug: s.slug, title: s.title, author: s.author, genre: s.genre })),
    ...(searchDbRows || []).map((r: any) => ({ slug: r.id, title: r.title, author: r.author_name, genre: r.genre_tag || (r.kind === 'poem' ? 'Poetry' : '') })),
];

const { title, description = 'Literature you want to read.', ogImage = '' } = Astro.props as any;

// Mode: editorial on the home, bright glass on every inner page
const isHome = Astro.url.pathname === '/max' || Astro.url.pathname === '/max/';
const mode = isHome ? 'editorial' : 'glass';

// Canonical → classic counterpart (SEO: max is a mirror skin, classic stays canonical)
const canonical = Astro.url.href.replace('/max', '');

// NAV LINKS — max pages exist only for the ones built; everything else
// points at classic pages so nothing 404s mid-build.
const navHref = {
    stories: '/max/stories',
    about: '/max/about',
    feed: '/max/feed',
    login: '/max/login',
    signup: '/max/signup',
    dashboard: '/max/dashboard',
    digest: '/max/digest',
};
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#faf6ef" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow" />

    <title>{title}</title>

    <meta property="og:site_name" content="Raconteur Pro" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={Astro.url.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,900;1,9..144,400;1,9..144,900&family=Hanken+Grotesk:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="max-skin" data-max-mode={mode}>
    {/* Search data island — same queries as classic, lives in layout so search works everywhere */}
    <script type="application/json" id="all-stories-data" set:html={JSON.stringify(searchStories).replace(/</g,'\\u003c')} />

    {/* The Manuscript — ruled sheet + red margin + drifting letterpress ghosts */}
    <div class="mx-manuscript" aria-hidden="true">
        <div class="mx-manuscript-rules"></div>
        <div class="mx-manuscript-margin"></div>
        <div class="mx-manuscript-ghosts" id="mxGhosts"></div>
    </div>

    {/* Bright-glass colour fields — inner-mode only (max.css hides the wrapper otherwise) */}
    {!isHome && (
        <div class="mx-glass-field" aria-hidden="true">
            <span></span><span></span><span></span>
        </div>
    )}

    {/* Royal entrance — max variant, born covered on skin switches (?welcome=1) */}
    <SkinSplash variant="max" eager={Astro.url.searchParams.get('welcome') === '1'} />

    {isHome && (
        <div class="mx-toggle-row">
            <SkinToggle variant="editorial" />
        </div>
    )}
    {isHome ? (
        <header class="mx-topbar">
            <div class="mx-masthead">
                <a href="/max" class="mx-brand mx-brand-masthead" aria-label="Raconteur Pro home">
                    Raconteur <span class="mx-brand-max">Pro</span>
                </a>
                <p class="mx-masthead-tagline">Literature you want to read</p>
            </div>
            <div class="mx-toolbar">
                <div class="mx-toolbar-search">
                    <div class="mx-search" id="mxSearchWrap">
                        <input
                            type="text"
                            id="searchInput"
                            placeholder="Search…"
                            autocomplete="off"
                            aria-label="Search stories and writers"
                        />
                        <span class="mx-search-icon" aria-hidden="true"><Icon name="search" size={15} /></span>
                        <div id="searchDropdown" class="mx-search-dropdown" style="display: none;">
                            <div id="searchResults" class="mx-search-results"></div>
                        </div>
                    </div>
                </div>
                <nav class="mx-topnav" aria-label="Primary">
                    <a href={navHref.stories}>Library</a>
                    <a href={navHref.feed}>Feed</a>
                    <a href={navHref.about}>About</a>
                </nav>
                <div class="mx-toolbar-auth">
                    <div class="mx-auth" id="authArea">
                        <a href={navHref.login} class="mx-auth-pill ghost">Log in</a>
                        <a href={navHref.signup} class="mx-auth-pill">Sign up</a>
                    </div>
                </div>
            </div>
        </header>
    ) : (
        <header class="mx-inner-bar">
            <a href="/max" class="mx-inner-back">← Back to the Pro edition</a>
            <a href="/max" class="mx-brand mx-inner-brand" aria-label="Raconteur Pro home">
                Raconteur <span class="mx-brand-max">Pro</span>
            </a>
            <p class="mx-inner-tagline">Literature you want to read</p>
        </header>
    )}


    <main class="mx-main">
        <slot />
    </main>

    <footer class={`mx-footer ${isHome ? '' : 'mx-footer-inner'}`}>
        <div class="mx-rain" aria-hidden="true" id="mxRain"></div>
        <div class="mx-footer-core">
            <p class="mx-footer-name">Raconteur <em>Pro</em></p>
            <p class="mx-footer-tagline">Literature you want to read</p>
            <nav class="mx-footer-links" aria-label="Footer">
                <a href="/max">Home</a>
                <a href="/max/stories">Library</a>
                <a href={navHref.feed}>Feed</a>
                <a href="/max/about">About</a>
                <a href="/max/admin">Editor's Desk</a>
            </nav>
            <p class="mx-footer-legal"><a href="/max/tos">Terms</a> · <a href="/max/privacy">Privacy</a></p>
            <p class="mx-fineprint">Made for writers, by a writer · © {new Date().getFullYear()} Raconteur</p>
        </div>
    </footer>
    ) : (
    <script>
        // The word rain — writer quotes falling like weather over the footer
        (() => {
            const rain = document.getElementById('mxRain');
            if (!rain) return;
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

            const QUOTES = [
                { text: 'There is nothing to writing. All you do is sit down at a typewriter and bleed.', author: 'Ernest Hemingway' },
                { text: 'We are all apprentices in a craft where no one ever becomes a master.', author: 'Ernest Hemingway' },
                { text: 'Prose is architecture, not interior decoration.', author: 'Ernest Hemingway' },
                { text: 'All you have to do is write one true sentence. Write the truest sentence that you know.', author: 'Ernest Hemingway' },
                { text: 'Writing is mainly work.', author: 'E.B. White' },
                { text: 'Get it down. Take chances. It may be bad, but it is the only way you can do anything really good.', author: 'William Faulkner' },
                { text: 'You cannot wait for inspiration, you have to go after it with a club.', author: 'Jack London' },
                { text: 'It is perfectly okay to write garbage, as long as you edit brilliantly.', author: 'C.J. Cherryh' },
                { text: 'You can always edit a bad page. You cannot edit a blank page.', author: 'Jodi Picoult' },
                { text: 'If you do not have time to read, you do not have the time to write. Simple as that.', author: 'Stephen King' },
                { text: 'The road to hell is paved with adverbs.', author: 'Stephen King' },
                { text: 'The difference between the almost right word and the right word is really a large matter.', author: 'Mark Twain' },
                { text: 'Do not tell me the moon is shining; show me the glint of light on broken glass.', author: 'Anton Chekhov' },
                { text: 'Read, read, read. Read everything and see how they do it. Just like a carpenter who studies the master.', author: 'William Faulkner' },
                { text: 'There is no greater agony than bearing an untold story inside you.', author: 'Maya Angelou' },
                { text: 'You can make anything by writing.', author: 'C.S. Lewis' },
                { text: 'Write what should not be forgotten.', author: 'Isabel Allende' },
                { text: 'Good fiction comforts the disturbed and disturbs the comfortable.', author: 'David Foster Wallace' },
                { text: 'I write entirely to find out what I am thinking, what I am looking at, what I see, and what it means.', author: 'Joan Didion' },
                { text: 'The worst enemy to creativity is self-doubt.', author: 'Sylvia Plath' },
                { text: 'A blank piece of paper is God\u2019s way of telling us how hard it is to be God.', author: 'Sidney Sheldon' },
                { text: 'You do not write because you want to say something; you write because you have something to say.', author: 'F. Scott Fitzgerald' },
                { text: 'Fill your paper with the breathings of your heart.', author: 'William Wordsworth' },
                { text: 'The scariest moment is always just before you start.', author: 'Stephen King' },
                { text: 'You fail only if you stop writing.', author: 'Ray Bradbury' },
                { text: 'If there is a book that you want to read, but it has not been written yet, then you must write it.', author: 'Toni Morrison' },
                { text: 'The heart of another is a dark forest, always.', author: 'Willa Cather' },
                { text: 'A writer is someone for whom writing is more difficult than it is for other people.', author: 'Thomas Mann' },
                { text: 'Stories are a communal currency of humanity.', author: 'Tahir Shah' },
                { text: 'Words are, of course, the most inexhaustible source of magic we have.', author: 'J.K. Rowling' },
                { text: 'One must always be careful of books, for words have the power to change us.', author: 'Cassandra Clare' },
                { text: 'Not that the story need be long, but it will take a long while to make it short.', author: 'Henry David Thoreau' },
                { text: 'Every story here was written to be remembered.', author: 'Raconteur' },
                { text: 'Settle in. Stay a while.', author: 'Raconteur' },
            ];

            let qi = 0;
            let lastAuthor = 0;

            function dropWord(text, isAuthor) {
                if (rain.childElementCount > 60) return;
                const el = document.createElement('span');
                el.className = 'mx-rain-word' + (isAuthor ? ' is-author' : '');
                el.textContent = isAuthor ? '\u2014 ' + text : text;
                el.style.left = (2 + Math.random() * 92) + '%';
                el.style.setProperty('--fall', (rain.offsetHeight + 90) + 'px');
                el.style.setProperty('--rot', (Math.random() * 10 - 5).toFixed(1) + 'deg');
                el.style.animationDuration = (2.4 + Math.random() * 2.2) + 's';
                el.addEventListener('animationend', () => el.remove());
                rain.appendChild(el);
            }

            setInterval(() => {
                // spawn a burst of words from the current quote, fast — like a squall
                const q = QUOTES[qi % QUOTES.length];
                const words = q.text.split(' ');
                for (let k = 0; k < 3; k++) {
                    const w = words[(qi * 3 + k) % words.length];
                    if (w) dropWord(w, false);
                }
                // the author's name falls occasionally, in small caps
                if (qi % 4 === 0 && Date.now() - lastAuthor > 4000) {
                    dropWord(q.author, true);
                    lastAuthor = Date.now();
                }
                qi++;
            }, 130);
        })();
    </script>

    <script>
        // Letterpress ghosts — giant words drifting behind the manuscript
        (() => {
            const stage = document.getElementById('mxGhosts');
            if (!stage) return;
            const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            const WORDS = ['STORIES', 'POETRY', 'VERSE', 'PROSE', 'FICTION', 'EDIT', 'DRAFT', 'INK', 'CANON', 'CHAPTER'];

            function spawnWord() {
                if (stage.childElementCount >= 3) return;
                const el = document.createElement('span');
                el.className = 'mx-ghost-word';
                el.textContent = WORDS[Math.floor(Math.random() * WORDS.length)];
                if (Math.random() < 0.3) el.classList.add('is-vermilion');
                el.style.top = (4 + Math.random() * 66) + '%';
                el.style.left = (Math.random() * 52 - 6) + '%';
                el.style.setProperty('--dur', (Math.round((70 + Math.random() * 50)) + 's'));
                el.style.setProperty('--dx', (Math.random() * 12 - 6).toFixed(1) + 'vw');
                el.style.setProperty('--dy', (Math.random() * 8 - 4).toFixed(1) + 'vh');
                el.style.setProperty('--rot', (Math.random() * 4 - 2).toFixed(1) + 'deg');
                el.addEventListener('animationend', () => el.remove());
                stage.appendChild(el);
            }

            if (reduced) {
                spawnWord();
                stage.querySelector('.mx-ghost-word')?.style.setProperty('animation', 'none');
                return;
            }
            spawnWord();
            setInterval(spawnWord, 15000);
        })();
    </script>

    <script>
        // The colour cycle — the manuscript turns to a new ink mood every 60 seconds.
        // 8 hand-picked scenes: airy brights and deep dusks, always readable ink-on-paper.
        (() => {
            const SCENES = 8;
            const SECONDS = 60;
            let current = 0;
            setInterval(() => {
                document.body.classList.remove('scene-' + current);
                current = (current + 1) % SCENES;
                if (current !== 0) document.body.classList.add('scene-' + current);
            }, SECONDS * 1000);
        })();
    </script>

    <script is:inline>
        // Service worker disabled — same policy as classic (unregister + clear caches)
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.getRegistrations().then((regs) => regs.forEach((r) => r.unregister()));
        }
        if ('caches' in window) {
            caches.keys().then((keys) => keys.forEach((k) => caches.delete(k)));
        }
    </script>

    <script>
        // De-vibe DR4 — the colour fields respond to the reader: they swell gently
        // with scroll movement and settle when idle. Reduced-motion: stays quiet.
        {
            const fields = document.querySelector('.mx-glass-field');
            const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (fields && !reduced) {
                let lastY = window.scrollY;
                let boost = 0;
                let decay = 0;
                const tick = () => {
                    const y = window.scrollY;
                    const delta = Math.min(1, Math.abs(y - lastY) / 500);
                    lastY = y;
                    boost = Math.min(1, Math.max(boost * 0.92, delta));
                    fields.style.setProperty('--mx-field-boost', boost.toFixed(3));
                };
                window.addEventListener('scroll', () => {
                    requestAnimationFrame(tick);
                }, { passive: true });
                decay = setInterval(() => {
                    boost *= 0.94;
                    if (boost < 0.01) { boost = 0; fields.style.setProperty('--mx-field-boost', '0'); }
                    else fields.style.setProperty('--mx-field-boost', boost.toFixed(3));
                    if (boost === 0) { /* keep interval, cheap */ }
                }, 160);
            }
        }
    </script>

    <script>
        // Reveal engine — IntersectionObserver adds .mx-revealed to [data-mx-reveal].
        const mxRevealEls = document.querySelectorAll('[data-mx-reveal]');
        if ('IntersectionObserver' in window && mxRevealEls.length) {
            const io = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('mx-revealed');
                        io.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
            mxRevealEls.forEach((el) => io.observe(el));
        } else {
            mxRevealEls.forEach((el) => el.classList.add('mx-revealed'));
        }
    </script>

    <script>
        // Split wipe — the home's split screens unclip on load (hero) or in view.
        const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const wipes = document.querySelectorAll('.mx-split[data-wipe]');
        if (wipes.length && !REDUCED) {
            const wipeIO = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('mx-wiped');
                        wipeIO.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.25 });
            wipes.forEach((el) => wipeIO.observe(el));
        } else {
            wipes.forEach((el) => el.classList.add('mx-wiped'));
        }
    </script>

    <script>
        // Parallax-lite — data-mx-parallax elements drift with scroll (max ±px).
        const mxReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>('[data-mx-parallax]'));
        if (parallaxEls.length && !mxReduced) {
            let ticking = false;
            const onScroll = () => {
                if (ticking) return;
                ticking = true;
                requestAnimationFrame(() => {
                    parallaxEls.forEach((el) => {
                        const amt = Number(el.dataset.mxParallax || '10');
                        const rect = el.getBoundingClientRect();
                        const mid = rect.top + rect.height / 2 - window.innerHeight / 2;
                        const p = Math.max(-1, Math.min(1, mid / window.innerHeight));
                        el.style.transform = `translateY(${(-p * amt).toFixed(1)}px)`;
                    });
                    ticking = false;
                });
            };
            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll();
        }
    </script>

    <script>
        // Auth widget — feature parity with PlusLayout's auth + notifications
        import { supabase } from '../lib/supabase';
        import { esc } from '../lib/escape';
import { iconSvg } from '../lib/icons';

        const authArea = document.getElementById('authArea');

        async function renderAuth(user: { email?: string; id?: string } | null) {
            if (!authArea) return;
            if (user) {
                const fallback = (user.email ?? 'reader').split('@')[0];
                let name = fallback;
                if (user.id) {
                    const { data: profile } = await supabase
                        .from('profiles')
                        .select('pen_name')
                        .eq('user_id', user.id)
                        .maybeSingle();
                    if (profile?.pen_name) name = profile.pen_name;
                }
                const safeName = esc(name);
                const profileSlug = esc(name.toLowerCase().replace(/\s+/g, '-'));
                authArea.innerHTML = `
                    <a href="/max/dashboard" class="mx-auth-pill">${iconSvg('book', 14)} My Shelf</a>
                    <a href="/max/author/${profileSlug}" class="mx-auth-pill ghost" title="Your public writer page">${iconSvg('user', 14)} ${safeName}</a>
                    <span class="mx-notif-wrap">
                        <button id="notifBell" class="mx-notif-bell" type="button" aria-label="Notifications">${iconSvg('bell', 15)}<span id="notifDot" class="mx-notif-dot" hidden></span></button>
                        <div id="notifPanel" class="mx-notif-panel" hidden>
                            <div class="mx-notif-head">Notifications</div>
                            <div id="notifList" class="mx-notif-list"></div>
                        </div>
                    </span>
                    <a href="#" id="logoutBtn" class="mx-auth-pill ghost danger">${iconSvg('logout', 14)} Log out</a>`;
                if (user.id) initNotifications(user.id);
                document.getElementById('logoutBtn')?.addEventListener('click', async (e) => {
                    e.preventDefault();
                    await supabase.auth.signOut();
                    window.location.href = '/max';
                });
            } else {
                authArea.innerHTML = `<a href="/max/login" class="mx-auth-pill ghost">Log in</a><a href="/max/signup" class="mx-auth-pill">Sign up</a>`;
            }
        }

        async function initNotifications(userId: string) {
            const bell = document.getElementById('notifBell')!;
            const dot = document.getElementById('notifDot')!;
            const panel = document.getElementById('notifPanel')!;
            const list = document.getElementById('notifList')!;

            const actorLabel = (n: any) => n.actor_id ? (n._actorName || 'Someone') : (n.body_preview || 'A Wandering Reader');
            const icon = (t: string) => (({ like: iconSvg('heart'), comment: iconSvg('comment'), reply: iconSvg('reply'), follow: iconSvg('user'), message: iconSvg('mail') } as any)[t] || iconSvg('sparkle'));
            const text = (n: any) => {
                if (n.type === 'like') return `${actorLabel(n)} appreciated your story`;
                if (n.type === 'follow') return `${actorLabel(n)} started following you`;
                if (n.type === 'reply') return `${actorLabel(n)} replied: “${(n.body_preview || '').slice(0, 60)}”`;
                if (n.type === 'message') return `${actorLabel(n)} messaged you: “${(n.body_preview || '').slice(0, 60)}”`;
                return `${actorLabel(n)} commented: “${(n.body_preview || '').slice(0, 60)}”`;
            };
            const href = (n: any) => n.type === 'message' ? '/max/messages' : (n.story_id ? `/max/story/${n.story_id}` : '#');

            async function load() {
                const { data: all } = await supabase
                    .from('notifications')
                    .select('*')
                    .eq('user_id', userId)
                    .order('created_at', { ascending: false })
                    .limit(12);
                let enriched: any[] = all || [];
                if (enriched.some((n: any) => n.actor_id)) {
                    const actorIds = Array.from(new Set(enriched.map((n: any) => n.actor_id).filter(Boolean)));
                    const { data: profs } = await supabase
                        .from('profiles')
                        .select('user_id,pen_name')
                        .in('user_id', actorIds);
                    const nameMap: Record<string, string> = {};
                    (profs || []).forEach((p: any) => { nameMap[p.user_id] = p.pen_name; });
                    enriched = enriched.map((r: any) => ({ ...r, _actorName: r.actor_id ? nameMap[r.actor_id] : null }));
                }
                const unread = enriched.filter((n: any) => !n.read).length;
                dot.hidden = unread === 0;
                list.innerHTML = enriched.length === 0
                    ? '<p class="mx-notif-empty">No notifications yet.</p>'
                    : enriched.map((n: any) => `
                        <a href="${esc(href(n))}" class="mx-notif-item ${n.read ? '' : 'unread'}" data-id="${esc(n.id)}">
                          <span class="mx-notif-icon">${icon(n.type)}</span>
                          <span class="mx-notif-text">${esc(text(n))}</span>
                          <span class="mx-notif-time">${timeAgo(n.created_at)}</span>
                        </a>`).join('');
                list.querySelectorAll('.mx-notif-item.unread').forEach(el => el.addEventListener('click', async () => {
                    const id = (el as HTMLElement).dataset.id;
                    await supabase.from('notifications').update({ read: true }).eq('id', id);
                }));
            }

            function timeAgo(iso: string) {
                const m = Math.floor((Date.now() - new Date(iso).getTime()) / 60000);
                if (m < 1) return 'now'; if (m < 60) return m + 'm'; const h = Math.floor(m / 60);
                if (h < 24) return h + 'h'; return Math.floor(h / 24) + 'd';
            }

            bell.addEventListener('click', async (e) => {
                e.stopPropagation();
                const open = !panel.hidden;
                panel.hidden = open;
                if (!open) {
                    await load();
                    await supabase.from('notifications').update({ read: true }).eq('user_id', userId).eq('read', false);
                    dot.hidden = true;
                }
            });
            document.addEventListener('click', (e) => {
                if (!panel.hidden && !panel.contains(e.target as Node) && e.target !== bell) panel.hidden = true;
            });

            await load();
            setInterval(load, 30000);
        }

        supabase.auth.getSession().then(({ data }) => renderAuth(data.session?.user ?? null));
        supabase.auth.onAuthStateChange((_e, session) => renderAuth(session?.user ?? null));
    </script>

    <script>
        // Live search — stories AND writers (same queries as classic)
        import { supabase } from '../lib/supabase';
        import { esc } from '../lib/escape';
import { iconSvg } from '../lib/icons';

        const searchInput = document.getElementById('searchInput') as HTMLInputElement;
        const searchDropdown = document.getElementById('searchDropdown');
        const searchResults = document.getElementById('searchResults');

        document.addEventListener('click', (e) => {
            if (searchDropdown && searchDropdown.style.display === 'block') {
                if (!searchDropdown.contains(e.target as Node) && e.target !== searchInput) {
                    searchDropdown.style.display = 'none';
                }
            }
        });

        searchInput?.addEventListener('focus', () => {
            if (searchInput.value.trim().length > 0 && searchDropdown) {
                searchDropdown.style.display = 'block';
            }
        });

        let allStories: any[] = [];
        async function loadAllStories() {
            if (allStories.length > 0) return;
            const staticData = JSON.parse((document.getElementById('all-stories-data') as HTMLScriptElement).textContent || '[]');
            const { data: dbRows } = await supabase.from('stories').select('id, title, author_name, genre').eq('status', 'published');
            const dbStories = (dbRows || []).map(r => ({ slug: r.id, title: r.title, author: r.author_name, genre: r.genre }));
            allStories = [...staticData, ...dbStories];
        }

        searchInput?.addEventListener('input', async (e) => {
            const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
            if (!searchResults || !searchDropdown) return;
            if (!query) {
                searchDropdown.style.display = 'none';
                return;
            }
            searchDropdown.style.display = 'block';
            await loadAllStories();

            const writerMap = new Map<string, string>();
            allStories.forEach(s => {
                if (s.author) {
                    const slug = s.author.toLowerCase().replace(/\s+/g, '-');
                    writerMap.set(slug, s.author);
                }
            });
            const writerMatches = Array.from(writerMap.entries())
                .filter(([, name]) => name.toLowerCase().includes(query))
                .slice(0, 3)
                .map(([slug, name]) => `
                    <a href="/max/author/${esc(slug)}" class="mx-search-item mx-search-writer">
                      <h4>${iconSvg('user', 14)} ${esc(name)}</h4>
                      <p>View writer page</p>
                    </a>
                `);

            const storyMatches = allStories.filter(s =>
                s.title.toLowerCase().includes(query) ||
                (s.author && s.author.toLowerCase().includes(query))
            ).slice(0, 6).map(s => `
                <a href="/max/story/${esc(s.slug)}" class="mx-search-item">
                  <h4>${esc(s.title)}</h4>
                  <p>By ${esc(s.author || 'Anonymous')} · ${esc(s.genre || 'Story')}</p>
                </a>
            `);

            const combined = [...writerMatches, ...storyMatches];
            searchResults.innerHTML = combined.length === 0
                ? '<p class="mx-search-empty">No stories or writers found.</p>'
                : combined.join('');
        });
    </script>
</body>
</html>

