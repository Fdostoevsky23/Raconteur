    /* Auth cluster is JS-injected — global styles (scoped never applied) */
    .notif-bell { display: inline-flex; align-items: center; justify-content: center; width: 2.1rem; height: 2.1rem; border: 1px solid rgba(228,221,200,0.35); border-radius: 50%; background: transparent; cursor: pointer; color: #e4ddc8; position: relative; transition: border-color 0.2s, color 0.2s; }
    .notif-bell:hover { border-color: #a8b89c; color: #f4ede0; }
    .notif-bell svg { width: 16px; height: 16px; display: block; }
</style>

<script>
    import { supabase } from '../lib/supabase';
    import { iconSvg } from '../lib/icons';
    import { esc } from '../lib/escape';

    const authArea = document.getElementById('authArea');

        async function renderAuth(user: { email?: string; id?: string } | null) {
        if (!authArea) return;
        if (user) {
            const fallback = (user.email ?? 'reader').split('@')[0];
            let name = fallback;
            if (user.id) {
                const { data: profile } = await supabase
                    .from('profiles')
                    .select('pen_name')
                    .eq('user_id', user.id)
                    .maybeSingle();
                if (profile?.pen_name) name = profile.pen_name;
            }
            const safeName = esc(name);
            const profileSlug = esc(name.toLowerCase().replace(/\s+/g, '-'));
            authArea.innerHTML = `<a href="/dashboard" class="auth-login">My Shelf</a><a href="/feed" class="auth-login">Feed</a><a href="/digest" class="auth-login">Digest</a><a href="/author/${profileSlug}" class="auth-hello" style="text-decoration: none;" title="Your public writer page">Hello, ${safeName}</a><span class="notif-wrap"><button id="notifBell" class="notif-bell" type="button" aria-label="Notifications">${iconSvg("bell", 14)}<span id="notifDot" class="notif-dot" hidden></span></button><div id="notifPanel" class="notif-panel" hidden><div class="notif-head">Notifications</div><div id="notifList" class="notif-list"></div></div></span><a href="#" id="logoutBtn" class="auth-login">Log out</a>`;
             if (user.id) initNotifications(user.id);
            document.getElementById('logoutBtn')?.addEventListener('click', async (e) => {
                e.preventDefault();
                await supabase.auth.signOut();
                window.location.href = '/';
            });
        } else {
            authArea.innerHTML = `<a href="/login">Log in</a><a href="/signup" class="auth-signup">Sign up</a>`;
        }
    }

        async function initNotifications(userId: string) {
        const bell = document.getElementById('notifBell')!;
        const dot = document.getElementById('notifDot')!;
        const panel = document.getElementById('notifPanel')!;
        const list = document.getElementById('notifList')!;

        const actorLabel = (n: any) => n.actor_id ? (n._actorName || 'Someone') : (n.body_preview || 'A Wandering Reader');
        const icon = (t: string) => (({ like: iconSvg('heart'), comment: iconSvg('comment'), reply: iconSvg('reply'), follow: iconSvg('user'), message: iconSvg('mail') } as any)[t] || iconSvg('sparkle'));
        const text = (n: any) => {
            if (n.type === 'like') return `${actorLabel(n)} appreciated your story`;
            if (n.type === 'follow') return `${actorLabel(n)} started following you`;
            if (n.type === 'reply') return `${actorLabel(n)} replied: “${(n.body_preview || '').slice(0, 60)}”`;
            if (n.type === 'message') return `${actorLabel(n)} messaged you: “${(n.body_preview || '').slice(0, 60)}”`;
            return `${actorLabel(n)} commented: “${(n.body_preview || '').slice(0, 60)}”`;
        };
        const href = (n: any) => n.type === 'message' ? '/messages' : (n.story_id ? `/story/${n.story_id}` : '#');

            async function load() {
            const fourDaysAgo = new Date(Date.now() - 4 * 24 * 60 * 60 * 1000).toISOString();
            const { data: rows } = await supabase
                .from('notifications')
                .select('id, type, body_preview, read, created_at, story_id, actor_id')
                .eq('user_id', userId)
                .gte('created_at', fourDaysAgo)
                .order('created_at', { ascending: false })
                .limit(20);
            const all = rows || [];
            // Resolve actor pen names in one batch
            const actorIds = Array.from(new Set(all.map((n: any) => n.actor_id).filter(Boolean)));
            let nameMap: Record<string, string> = {};
            if (actorIds.length) {
                const { data: profs } = await supabase.from('profiles').select('user_id, pen_name').in('user_id', actorIds);
                (profs || []).forEach((p: any) => { nameMap[p.user_id] = p.pen_name; });
            }
            const enriched = all.map((r: any) => ({ ...r, _actorName: r.actor_id ? nameMap[r.actor_id] : null }));
            const unread = enriched.filter((n: any) => !n.read).length;
            dot.hidden = unread === 0;
            list.innerHTML = enriched.length === 0
                ? '<p class="notif-empty">No notifications yet.</p>'
                : enriched.map((n: any) => `
                    <a href="${esc(href(n))}" class="notif-item ${n.read ? '' : 'unread'}" data-id="${esc(n.id)}">
                      <span class="notif-icon">${icon(n.type)}</span>
                      <span class="notif-text">${esc(text(n))}</span>
                      <span class="notif-time">${timeAgo(n.created_at)}</span>
                    </a>`).join('');
            list.querySelectorAll('.notif-item.unread').forEach(el => el.addEventListener('click', async () => {
                const id = (el as HTMLElement).dataset.id;
                await supabase.from('notifications').update({ read: true }).eq('id', id);
            }));
        }

        function timeAgo(iso: string) {
            const m = Math.floor((Date.now() - new Date(iso).getTime()) / 60000);
            if (m < 1) return 'now'; if (m < 60) return m + 'm'; const h = Math.floor(m / 60);
            if (h < 24) return h + 'h'; return Math.floor(h / 24) + 'd';
        }

        bell.addEventListener('click', async (e) => {
            e.stopPropagation();
            const open = !panel.hidden;
            panel.hidden = open;
            if (!open) {
                await load();
                // Mark all as read when opened
                await supabase.from('notifications').update({ read: true }).eq('user_id', userId).eq('read', false);
                dot.hidden = true;
            }
        });
        document.addEventListener('click', (e) => {
            if (!panel.hidden && !panel.contains(e.target as Node) && e.target !== bell) panel.hidden = true;
        });

        await load();
        setInterval(load, 30000); // refresh badge every 30s
    }

    supabase.auth.getSession().then(({ data }) => renderAuth(data.session?.user ?? null));
    supabase.auth.onAuthStateChange((_e, session) => renderAuth(session?.user ?? null));
</script>
<script>
  import { supabase } from '../lib/supabase';
  import { iconSvg } from '../lib/icons';
  import { esc } from '../lib/escape';

  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const searchDropdown = document.getElementById('searchDropdown');
  const searchResults = document.getElementById('searchResults');

  // Close dropdown when clicking outside
  document.addEventListener('click', (e) => {
    if (searchDropdown && searchDropdown.style.display === 'block') {
      if (!searchDropdown.contains(e.target as Node) && e.target !== searchInput) {
        searchDropdown.style.display = 'none';
      }
    }
  });

  // Show dropdown when typing
  searchInput?.addEventListener('focus', () => {
    if (searchInput.value.trim().length > 0 && searchDropdown) {
      searchDropdown.style.display = 'block';
    }
  });

  // Fetch all stories once
  let allStories: any[] = [];
  async function loadAllStories() {
    if (allStories.length > 0) return;
    
    const staticData = JSON.parse(document.getElementById('all-stories-data')?.textContent || '[]');
    const { data: dbRows } = await supabase.from('stories').select('id, title, author_name, genre').eq('status', 'published');
    const dbStories = (dbRows || []).map(r => ({ slug: r.id, title: r.title, author: r.author_name, genre: r.genre }));

    allStories = [...staticData, ...dbStories];
  }

    // Live Search — stories AND writers
  searchInput?.addEventListener('input', async (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
    if (!searchResults || !searchDropdown) return;
    if (!query) {
      searchDropdown.style.display = 'none';
      return;
    }
    searchDropdown.style.display = 'block';
    await loadAllStories();

    // Unique writers derived from the story data (pen names already synced)
    const writerMap = new Map<string, string>();
    allStories.forEach(s => {
      if (s.author) {
        const slug = s.author.toLowerCase().replace(/\s+/g, '-');
        writerMap.set(slug, s.author);
      }
    });
    const writerMatches = Array.from(writerMap.entries())
      .filter(([, name]) => name.toLowerCase().includes(query))
      .slice(0, 3)
      .map(([slug, name]) => `
        <a href="/author/${esc(slug)}" class="search-result-item search-writer-item">
          <h4>${iconSvg("user", 14)} ${esc(name)}</h4>
          <p>View writer page</p>
        </a>
      `);

    const storyMatches = allStories.filter(s =>
      s.title.toLowerCase().includes(query) ||
      (s.author && s.author.toLowerCase().includes(query))
    ).slice(0, 6).map(s => `
      <a href="/story/${esc(s.slug)}" class="search-result-item">
        <h4>${esc(s.title)}</h4>
        <p>By ${esc(s.author || 'Anonymous')} · ${esc(s.genre || 'Story')}</p>
      </a>
    `);

    const combined = [...writerMatches, ...storyMatches];
    searchResults.innerHTML = combined.length === 0
      ? '<p class="search-no-results">No stories or writers found.</p>'
      : combined.join('');
  });
</script>