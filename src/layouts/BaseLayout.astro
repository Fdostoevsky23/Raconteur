      /* ... keep the rest ... */
      font-family: inherit;
      font-size: 0.9rem;
      padding: 0.25rem 0.5rem;
      outline: none;
    }

    /* merged — see pill style below */

    /* Dropdown Results (Right below the bar) */
    .nav-left { position: relative; }
    .search-dropdown {
      position: absolute;
      top: calc(100% + 0.5rem); /* Drops right below the search bar */
      left: 0;
      width: 350px;
      background: #1e2420;
