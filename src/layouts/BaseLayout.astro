---
// BaseLayout.astro — Raconteur's shared shell
// Centered logo + tagline, nav row with divider, shared footer.
import { getVisibleStories } from '../data/stories';
import { supabase } from '../lib/supabase';
import SkinToggle from '../components/skin/SkinToggle.astro';
import SkinSplash from '../components/skin/SkinSplash.astro';
import Icon from '../components/Icon.astro';
interface Props {
    title: string;
    description?: string;
    ogImage?: string;
}
const { data: searchDbRows } = await supabase
    .from('stories')
    .select('id,title,author_name,genre_tag,kind')
    .eq('status', 'published');
const searchStories = [
    ...getVisibleStories().map((s: any) => ({ slug: s.slug, title: s.title, author: s.author, genre: s.genre })),
    ...(searchDbRows || []).map((r: any) => ({ slug: r.id, title: r.title, author: r.author_name, genre: r.genre_tag || (r.kind === 'poem' ? 'Poetry' : '') })),
];
const { title, description = 'Literature you want to read .', ogImage = '' } = Astro.props as any;
const isHome = Astro.url.pathname === '/';
const isStory = Astro.url.pathname.startsWith('/story/');
const   showNav  =  isHome ;
const   showAuth  =  isHome ;
// Static stories for search (available on every page so search isn't home-only)
const _staticSearchData = getVisibleStories().map(s => ({ slug: s.slug, title: s.title, author: s.author, genre: s.genre }));
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1e2420" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>

        <meta property="og:site_name" content="Raconteur Classic" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={Astro.url.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>

<body>
    {/* Search data island — lives in layout so search works on every page, not just / */}
    <script type="application/json" id="all-stories-data" set:html={JSON.stringify(searchStories).replace(/</g,'\\u003c')} />

    {/* The Classic entrance — the letter-by-letter wordmark ceremony, born
        covered when arriving from another skin (?welcome=1), same mechanic
        as the Raconteur+ and Raconteur Pro editions. */}
    <SkinSplash variant="classic" eager={Astro.url.searchParams.get('welcome') === '1'} />

      <header class={`site-header ${isStory ? 'on-story' : ''}`}>
        {/* Raconteur Classic / Raconteur+ / Raconteur Pro skin switcher —
            HOME PAGES ONLY (the wrapper is gated too so no empty gap pads
            inner pages) */}
        {Astro.url.pathname === '/' && (
            <div class="skin-switch-row">
                <SkinToggle />
            </div>
        )}
        <a href="/" class="logo-block">
            <span class="logo-edition">Classic</span>
            <span class="logo">RACONTEUR</span>
            <span class="tagline">Literature you want to read</span>
        </a>
        <style>
            /* The Classic edition plate — a quiet print-convention mark that
               sits above the wordmark, the way a newspaper names its edition. */
            .logo-edition {
                display: block;
                font-family: 'Lora', Georgia, serif;
                font-style: italic;
                font-size: 0.72rem;
                letter-spacing: 0.44em;
                text-transform: uppercase;
                color: #8a7f6a;
                margin-bottom: 0.4rem;
                animation: edition-in 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
            }
            .logo-edition::before,
            .logo-edition::after {
                content: '—';
                font-style: normal;
                margin: 0 0.65em;
                color: rgba(138, 127, 106, 0.5);
            }
            @keyframes edition-in {
                from { opacity: 0; transform: translateY(10px); letter-spacing: 0.7em; }
                to   { opacity: 1; transform: none; letter-spacing: 0.44em; }
            }
            @media (prefers-reduced-motion: reduce) {
                .logo-edition { animation: none; }
            }
        </style>

        <div class="header-divider"></div>
        {showAuth && (

        
            <div class="header-nav-container">
            <!-- Left: YouTube-style Search -->
            {showNav && (
            <div class="nav-left">
                <div class="search-wrapper">
                    <input type="text" id="searchInput" placeholder="Search" autocomplete="off" />
                    <button id="searchToggle" class="nav-search-btn" aria-label="Search"><Icon name="search" size={16} /></button>
                </div>
                <!-- The dropdown results box -->
                <div id="searchDropdown" class="search-dropdown" style="display: none;">
                    <div id="searchResults" class="search-results-dropdown"></div>
                </div>
            </div>
            
            )}

            <!-- Center: Main Links -->
            {showNav && (
            <div class="nav-center">
                <a href="/stories">Stories</a>
                <a href="/about">About</a>
            </div>
            )}

            <!-- Right: Auth Area -->
            <div class="nav-right" style="margin-left: auto;">
                <div id="authArea" class="auth-area">
                    <!-- Your login/signup buttons or "Hello, [name]" will render here via JS -->
                    <a href="/login" class="auth-login">Log in</a>
                    <a href="/signup" class="auth-signup">Sign up</a>
                </div>
            </div>
        </div>

      )}
    </header>

    <main>
              <slot />
    </main>

        {isHome && (
        <footer class="site-footer">
            <div class="footer-inner footer-cinematic">
            <div class="footer-rain-left" id="footerRainLeft"></div>
            <div class="footer-center-stack">
                <span class="footer-logo-stretched">RACONTEUR</span>
                <span class="footer-tagline-centered">Literature you want to read</span>
                <p class="footer-legal"><a href="/tos">Terms</a> · <a href="/privacy">Privacy</a></p>
                <nav class="footer-nav-centered">
                    <a href="/">Home</a>
                    <a href="/stories">Stories</a>
                    <a href="/feed">Feed</a>
                    <a href="/about">About</a>
                </nav>
            </div>
            <div class="footer-rain-right" id="footerRainRight"></div>

            <style>
        
            .skip-link:focus { top: 0; }
    /* Skin switcher row (Raconteur / Raconteur+) — top of classic header */
    .skin-switch-row { display: flex; justify-content: center; padding-bottom: 1rem; width: 100%; }
             .footer-quotes { flex: 1; position: relative; min-height: 300px; overflow: hidden; padding-bottom: 2rem; }
              .tw-rain { position: absolute; inset: 0; pointer-events: none; }
              .tw-drop { position: absolute; top: -30px; font-family: 'Lora', serif; font-style: italic; color: #e4ddc8; font-size: 0.95rem; white-space: nowrap; opacity: 0.9; animation: tw-rain-fall linear forwards; }
              .tw-drop.is-author { color: #a8b89c; font-style: normal; font-size: 0.72rem; letter-spacing: 2px; text-transform: uppercase; }
              .footer-nav { margin-left: auto; }
              @keyframes tw-rain-fall {
                0% { transform: translateY(0) rotate(var(--rot)); opacity: 0; }
                8% { opacity: 0.9; }
                92% { opacity: 0.9; }
                100% { transform: translateY(var(--fall)) rotate(var(--rot)); opacity: 0; }
              }
              @media (prefers-reduced-motion: reduce) {
                .tw-drop { animation: none; opacity: 0; }
              }
              @media (max-width: 768px) {
            * {
             max-width: 100%;
            box-sizing: border-box;
           }
          body {
           overflow-x: hidden;
           }
          }
          
            a:focus-visible,
            button:focus-visible,
            input:focus-visible,
            textarea:focus-visible,
            select:focus-visible,
            [tabindex]:focus-visible {
            outline: 2px solid #c8a24a;
            outline-offset: 2px;
            }
            </style>

            <script>
              const QUOTES = [
                { text: "There is nothing to writing. All you do is sit down at a typewriter and bleed.", author: "Ernest Hemingway" },
                { text: "We are all apprentices in a craft where no one ever becomes a master.", author: "Ernest Hemingway" },
                { text: "Prose is architecture, not interior decoration.", author: "Ernest Hemingway" },
                { text: "Writing is mainly work.", author: "E.B. White" },
                { text: "All you have to do is write one true sentence. Write the truest sentence that you know.", author: "Ernest Hemingway" },
                { text: "Get it down. Take chances. It may be bad, but it’s the only way you can do anything really good.", author: "William Faulkner" },
                { text: "You can’t wait for inspiration, you have to go after it with a club.", author: "Jack London" },
                { text: "It is perfectly okay to write garbage—as long as you edit brilliantly.", author: "C. J. Cherryh" },
                { text: "You can always edit a bad page. You can’t edit a blank page.", author: "Jodi Picoult" },
                { text: "If you don’t have time to read, you don’t have the time (or the tools) to write. Simple as that.", author: "Stephen King" },
                { text: "The road to hell is paved with adverbs.", author: "Stephen King" },
                { text: "The difference between the almost right word and the right word is really a large matter. ’tis the difference between the lightning bug and the lightning.", author: "Mark Twain" },
                { text: "Don’t tell me the moon is shining; show me the glint of light on broken glass.", author: "Anton Chekhov" },
                { text: "Read, read, read. Read everything — trash, classics, good and bad, and see how they do it. Just like a carpenter who works as an apprentice and studies the master. Read! You’ll absorb it. Then write.", author: "William Faulkner" },
                { text: "There is no greater agony than bearing an untold story inside you.", author: "Maya Angelou" },
                { text: "You can make anything by writing.", author: "C.S. Lewis" },
                { text: "Write what should not be forgotten.", author: "Isabel Allende" },
                { text: "Good fiction’s job is to comfort the disturbed and disturb the comfortable.", author: "David Foster Wallace" },
                { text: "I write entirely to find out what I’m thinking, what I’m looking at, what I see, and what it means. What I want and what I fear.", author: "Joan Didion" },
                { text: "You have to write the book that wants to be written. And if the book will be too difficult for grown-ups, then you write it for children.", author: "Madeleine L’Engle" },
                { text: "The worst enemy to creativity is self-doubt.", author: "Sylvia Plath" },
                { text: "Not that the story need be long, but it will take a long while to make it short.", author: "Henry David Thoreau" },
                { text: "A blank piece of paper is God’s way of telling us how hard it is to be God.", author: "Sidney Sheldon" },
                { text: "You don’t write because you want to say something; you write because you have something to say.", author: "F. Scott Fitzgerald" }
              ];

              const leftEl = document.getElementById('footerRainLeft');
              const rightEl = document.getElementById('footerRainRight');
              if (leftEl && rightEl) {
                const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                let qi = 0;
                const drop = (text: string, isAuthor: boolean, target: HTMLElement) => {
                  const s = document.createElement('span');
                  s.className = 'tw-drop' + (isAuthor ? ' is-author' : '');
                  s.textContent = isAuthor ? '— ' + text : text;
                  const fallDist = 260 + Math.random() * 60;
                  const dur = 5 + Math.random() * 2.5;
                  s.style.left = (4 + Math.random() * 80) + '%';
                  s.style.setProperty('--fall', fallDist + 'px');
                  s.style.setProperty('--rot', (Math.random() * 8 - 4).toFixed(1) + 'deg');
                  s.style.animationDuration = dur + 's';
                  s.addEventListener('animationend', () => s.remove());
                  target.appendChild(s);
                };
                const playQuote = () => {
                  const q = QUOTES[qi++ % QUOTES.length];
                  const words = q.text.split(' ');
                  let wi = 0;
                  const nextWord = () => {
                    if (wi >= words.length) {
                      setTimeout(() => {
                        drop(q.author, true, leftEl);
                        drop(q.author, true, rightEl);
                        setTimeout(playQuote, 1400);
                      }, 500);
                      return;
                    }
                    drop(words[wi], false, leftEl);
                    drop(words[wi++], false, rightEl);
                    setTimeout(nextWord, 230 + Math.random() * 140);
                  };
                  nextWord();
                };
                if (reduced) {
                  const q = QUOTES[0];
                  drop(q.text, false, leftEl);
                  drop(q.text, false, rightEl);
                  setTimeout(() => { drop(q.author, true, leftEl); drop(q.author, true, rightEl); }, 600);
                } else {
                  playQuote();
                }
              }
            </script>

            <p class="footer-fineprint">Made for writers, by a writer · © {new Date().getFullYear()} Raconteur Classic</p>
        </div>
    </footer>
    )}
<style>
        .site-header.on-story {
        background: var(--bg, #1e2420);
        position: relative;
        z-index: 2;
    }
</style>
        <script is:inline>
      // Service worker disabled — unregister any previously registered one + clear caches
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then((regs) => regs.forEach((r) => r.unregister()));
      }
      if ('caches' in window) {
        caches.keys().then((keys) => keys.forEach((k) => caches.delete(k)));
      }
    </script>
</body>
</html>

<style is:global>
       /* === RESET & BASE === */
    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
        background-color: #f7f0dd;
        color: #2e2a22;
        font-family: 'Lora', Georgia, serif;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        position: relative;
    }


    /* Respect readers who prefer no motion */
    @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            animation-duration: 0.001ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.001ms !important;
            scroll-behavior: auto !important;
        }
    }

    main { flex: 1; }

        ::selection {
        background: #3d5a3c;
        color: #f4ede0;
    }

    /* === CENTERED HEADER === */
    .site-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2.5rem 2rem 0;
        max-width: 1100px;
        width: 100%;
        margin: 0 auto;
    }

    .logo-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        line-height: 1;
        transition: opacity 0.2s;
    }

    .logo-block:hover { opacity: 0.75; }

    .logo {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2.2rem, 5vw, 3.2rem);
        font-weight: 900;
        letter-spacing: 6px;
        color: #ffffff;
        text-shadow: 0 1px 10px rgba(0, 0, 0, 0.4);
        padding-left: 6px; /* optical balance for letter-spacing */
    }

    .tagline {
        font-family: 'Lora', serif;
        font-style: italic;
        font-size: 0.95rem;
        color: #f4ede0; /* Bright cream, same as the logo */
      /* ... keep the rest of the styles ... */
        text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
        letter-spacing: 0.5px;
        margin-top: 0.6rem;
    }

    .header-divider {
        width: 100%;
        max-width: 760px;
        height: 1px;
        background: rgba(255, 255, 255, 0.4);
        margin: 1.6rem 0 1.1rem;
    }

    nav {
        display: flex;
        gap: 2.4rem;
        padding-bottom: 1.6rem;
    }

    nav a {
        text-decoration: none;
        color: #ffffff;
        text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
        font-size: 0.95rem;
        letter-spacing: 0.5px;
        transition: color 0.2s;
        position: relative;
    }

    nav a::after {
        content: '';
        position: absolute;
        bottom: -5px;
        left: 0;
        width: 100%;
        height: 1px;
        background: #ffffff;
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.3s ease;
    }

    nav a:hover { color: rgba(255, 255, 255, 0.75); }
    nav a:hover::after {
        transform: scaleX(1);
        transform-origin: left;
    }

    /* === FOOTER — cinematic centered brand + side word-rain === */
    .site-footer {
        background: #232e26;
        color: #c8d0bc;
        padding: 0;
        margin-top: 4rem;
        position: relative;
        overflow: hidden;
    }

    .footer-inner.footer-cinematic {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 320px;
        max-width: 100%;
        padding: 4rem 2rem 2rem;
    }

    .footer-center-stack {
        position: relative;
        z-index: 10;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.8rem;
    }

    .footer-logo-stretched {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 900;
        letter-spacing: 0.35em;
        color: #f4ede0;
        padding-left: 0.35em;
        line-height: 1;
    }

    .footer-tagline-centered {
        font-family: 'Lora', serif;
        font-style: italic;
        font-size: clamp(1rem, 2vw, 1.4rem);
        color: #a8b89c;
        letter-spacing: 0.08em;
        margin-bottom: 1.5rem;
    }

        .footer-legal {
        margin-top: 0.8rem; font-size: 0.75rem; color: #8a9478;
    }
    .footer-legal a { color: #a8b89c; text-decoration: none; }
    .footer-legal a:hover { text-decoration: underline; }

    .footer-nav-centered {
        display: flex;
        gap: 2.5rem;
    }

    .footer-nav-centered a {
        font-family: 'Playfair Display', serif;
        font-size: 1.1rem;
        color: #d8d0bc;
        text-decoration: none;
        letter-spacing: 0.05em;
        transition: color 0.3s, transform 0.3s;
    }

    .footer-nav-centered a:hover {
        color: #f4ede0;
        transform: translateY(-2px);
    }

    /* Word-rain columns — left and right of the footer */
    .footer-rain-left,
    .footer-rain-right {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 28%;
        overflow: hidden;
        pointer-events: none;
        z-index: 1;
    }

    .footer-rain-left { left: 0; }
    .footer-rain-right { right: 0; }

    .tw-drop {
        position: absolute;
        top: -30px;
        font-family: 'Lora', serif;
        font-style: italic;
        color: #e4ddc8;
        font-size: 0.95rem;
        white-space: nowrap;
        opacity: 0.9;
        animation: tw-rain-fall linear forwards;
    }

    .tw-drop.is-author {
        color: #a8b89c;
        font-style: normal;
        font-size: 0.72rem;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    @keyframes tw-rain-fall {
        0% { transform: translateY(0) rotate(var(--rot)); opacity: 0; }
        8% { opacity: 0.9; }
        92% { opacity: 0.9; }
        100% { transform: translateY(var(--fall)) rotate(var(--rot)); opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
        .tw-drop { animation: none; opacity: 0; }
    }

    @media (max-width: 768px) {
        .footer-rain-left, .footer-rain-right { width: 18%; }
        .footer-nav-centered { gap: 1.5rem; }
    }

    .footer-fineprint {
        text-align: center;
        font-style: italic;
        font-size: 0.82rem;
        color: #7d8568;
        padding: 2rem;
        border-top: 1px solid #2f3d32;
        letter-spacing: 0.3px;
        position: relative;
        z-index: 10;
        width: 100%;
        margin-top: 2rem;
    }

    /* === MOBILE === */
    @media (max-width: 640px) {
        .site-header { padding: 1.8rem 1.2rem 0; }
        .logo { letter-spacing: 4px; padding-left: 4px; }
        .tagline { font-size: 0.82rem; }
        nav { gap: 1.4rem; flex-wrap: wrap; justify-content: center; }
        nav a { font-size: 0.88rem; }
    }
    .auth-area {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 1.2rem;
        margin-top: 0;
        font-size: 0.98rem;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .auth-area a {
       color: #f4ede0; /* Bright cream */
      /* ... keep the rest ... */
        text-decoration: none;
        transition: color 0.2s;
    }

    .auth-area a:hover { color: #a8b89c; }

    .auth-area .auth-signup {
        padding: 0.55rem 1.5rem;
        border: 2px solid rgba(244, 237, 224, 0.55);
        border-radius: 999px;
        transition: all 0.2s;
    }

    .auth-area .auth-signup:hover {
        background: #f4ede0;
        color: #1e2420;
    }

        .auth-hello  {  color :  #a8b89c ;  font-style :  italic ; }
    /* === Notification bell === */
    .notif-wrap  {  position :  relative ;  display :  inline-flex ; }
    .notif-bell  {
      background :  transparent ;  border :  none ;  cursor :  pointer ;
      font-size :  1.1rem ;  position :  relative ;  padding :  0.2rem ;
    }
    .notif-dot  {
      position :  absolute ;  top :  0 ;  right :  0 ;
      width :  8px ;  height :  8px ;  border-radius :  50% ;
      background :  #a85a32 ;  border :  1px solid #1e2420 ;
    }
    .notif-panel  {
      position :  absolute ;  top :  calc(100% + 0.6rem) ;  right :  0 ;
      width :  320px ;  max-height :  420px ;  overflow-y :  auto ;
      background :  #1e2420 ;  border :  1px solid rgba(168,184,156,0.2) ;
      border-radius :  8px ;  box-shadow :  0 10px 30px rgba(0,0,0,0.5) ;
      z-index :  1001 ;
    }
    .notif-head  {
      padding :  0.8rem 1rem ;  font-family :  'Playfair Display', serif ;
      font-size :  0.95rem ;  color :  #f4ede0 ;  border-bottom :  1px solid rgba(228,221,200,0.1) ;
    }
    .notif-item  {
      display :  flex ;  gap :  0.6rem ;  align-items :  flex-start ;
      padding :  0.7rem 1rem ;  text-decoration :  none ;  color :  inherit ;
      border-bottom :  1px solid rgba(228,221,200,0.05) ;
    }
    .notif-item.unread  {  background :  rgba(168,90,50,0.08) ; }
    .notif-item:hover  {  background :  rgba(244,237,224,0.05) ; }
    .notif-icon  {  font-size :  0.95rem ; }
    .notif-text  {  flex :  1 ;  font-size :  0.85rem ;  color :  #d8d0bc ;  line-height :  1.4 ; }
