        /* Search Styles — consolidated (pill) */

        /* Header Layout */
        .header-nav-container {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 2rem;
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 1rem 2rem;
    }
    .nav-left, .nav-center, .nav-right {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }
    .nav-left { justify-self: start; }
    .nav-center { justify-self: center; }
    .nav-right {
      justify-self: end;
      margin-left: 0;
      flex-wrap: wrap;
      justify-content: flex-end;
    }
    /* PHONE: PIC1 — Stories/About on same row, Log in/Sign up on next row centered together */
    @media (max-width: 640px) {
      .header-nav-container { display: flex; flex-direction: column; align-items: center; gap: 0.7rem; padding: 0.8rem 1rem; }
      .nav-left { order: 1; width: 100%; justify-content: center; }
      .nav-left .search-wrapper { width: 90vw; max-width: 280px; }
      .nav-center { order: 2; gap: 1.6rem; }
      .nav-right { order: 3; width: 100%; justify-content: center; }
      .nav-right .auth-area { justify-content: center; width: 100%; gap: 1rem; }
      .header-divider { margin: 1rem 0 0.6rem; }
      .hero { min-height: 520px; }
      .hero-overlay { padding: 2.2rem 1.2rem 3.5rem; }
      .scroll-cue { bottom: 0.9rem; }
      .hero-cta { margin-bottom: 0.6rem; }
    }
    @media (min-width: 641px) and (max-width: 900px) {
      .header-nav-container { gap: 1rem; padding: 0.8rem 1rem; }
      .search-wrapper { width: 210px; }
      .nav-center { gap: 1.4rem; }
    }
    .header-nav-container { max-width: 1320px; }
    .nav-right { flex-wrap: nowrap; }
    .nav-right a, .nav-right .notif-wrap { white-space: nowrap; }
    .nav-right .auth-area { gap: 1.2rem; font-size: 0.98rem; }
    .nav-center a {
      color: #f4ede0; /* Bright cream */
      /* ... keep the rest ... */
      text-decoration: none;
      font-size: 0.95rem;
      transition: color 0.2s;
    }
    .nav-center a:hover { color: #a8b89c; }

    /* YouTube-Style Search */
    .search-wrapper {
      display: flex;
      align-items: center;
      background: rgba(244, 237, 224, 0.05);
      border: 1px solid rgba(228, 221, 200, 0.2);
