# Raconteur environment variables — copy to .env and fill in real values.
# NEVER commit the real .env (it is gitignored).

# Supabase project (Supabase Dashboard → Settings → API)
# PUBLIC_ vars are exposed to the browser — use the anon key only, never the service key.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY secrets (never prefix these with PUBLIC_)
# Supabase Dashboard → Settings → API → service_role (secret!)
SUPABASE_SERVICE_ROLE_KEY=

# Weekly digest job (/api/send-digest?key=...) — any long random string
DIGEST_SECRET=

# Resend API key (resend.com → API Keys)
RESEND_API_KEY=
# Sender address for the digest email. onboarding@resend.dev only delivers to
# your own account email — verify a domain in Resend and set e.g.
# DIGEST_FROM_EMAIL=weekly@yourdomain.com before launch.
DIGEST_FROM_EMAIL=
